---
interface Props {
  title: string;
  description: string;
  image?: string;
}
const {
  title,
  description,
  image = "/assets/logo.webp",
} = Astro.props;
// Self-referencing canonical: the current path resolved against the configured
// `site` origin (astro.config.mjs), so every page points at its own absolute
// https://www.kamranfertility.com URL. Falls back to the request origin only if
// `site` is ever unset.
const origin = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, origin);
const imageURL = new URL(image, origin);

