---
interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
}
const {
  title,
  description,
  image = "/assets/logo.webp", // TODO: replace with a 1200x630 share image (doctor / clinic photo)
  imageAlt = "Dr. Kamran Saleem fertility clinic, Lahore",
} = Astro.props;

const SITE = "https://www.kamranfertility.com";
const origin = Astro.site ?? new URL(Astro.url.origin);

// ── Canonical URL ─────────────────────────────────────────────────────────
// FIX: the build was emitting "/index.html" as the homepage canonical, which
// splits ranking signals between "/" and "/index.html". Normalise the path:
//   "/index.html"                    -> "/"
//   "/services/assessment/index.html"-> "/services/assessment"
//   "/foo.html"                      -> "/foo"
//   trailing slashes removed (except root) to match the site's URL style.
let path = Astro.url.pathname
  .replace(/\/index\.html$/, "/")
  .replace(/\.html$/, "");
if (path.length > 1) path = path.replace(/\/+$/, "");

const canonicalURL = new URL(path, origin);
const imageURL = new URL(image, origin);
const isHome = path === "/";

// ── Opening hours (per branch) ───────────────────────────────────────────
// FIX: the old schema gave every branch "Mon-Sat 11:00-21:00", which does not
// match the hours shown on the site. Hours below follow the "Locations" block
// on the homepage. CONFIRM WITH THE CLINIC before publishing, especially DHA:
// the site says "Daily 3-6pm" and also "Saturday & Sunday: Closed".
const hours = (days: string[], opens: string, closes: string) => ({
  "@type": "OpeningHoursSpecification",
  dayOfWeek: days,
  opens,
  closes,
});

// ── Structured data (schema.org JSON-LD) ─────────────────────────────────
const graph: Record<string, unknown>[] = [
  {
    "@type": "WebSite",
    "@id": `${SITE}/#website`,
    url: `${SITE}/`,
    name: "Kamran Fertility Clinic",
    alternateName: "Dr. Kamran Saleem",
    description:
      "Unhurried, evidence-based fertility consultations with Dr. Kamran Saleem in Lahore.",
    publisher: { "@id": `${SITE}/#clinic` },
    inLanguage: "en",
  },
  {
    "@type": "MedicalClinic",
    "@id": `${SITE}/#clinic`,
    name: "Kamran Fertility Clinic",
    url: `${SITE}/`,
    logo: `${SITE}/assets/logo.webp`,
    image: `${SITE}/assets/logo.webp`,
    description:
      "Doctor-led, evidence-based fertility care in Lahore: honest answers, clear options, and a plan built around your timeline and your values.",
    telephone: "+92-314-8432789",
    medicalSpecialty: "Reproductive Medicine",
    founder: { "@id": `${SITE}/#dr-kamran` },
    employee: { "@id": `${SITE}/#dr-kamran` },
    // Clinic-level hours removed: hours differ by branch (see locations below).
    // TODO: add real profiles (Google Business Profile, Facebook, Instagram,
    // LinkedIn). A wa.me link is not a "sameAs" profile, so it was removed.
    // sameAs: ["https://www.facebook.com/...", "https://www.instagram.com/..."],
    department: [
      { "@id": `${SITE}/locations/dha-lahore#location` },
      { "@id": `${SITE}/locations/mm-alam-road-lahore#location` },
      { "@id": `${SITE}/locations/shalamar-lahore#location` },
    ],
    areaServed: { "@type": "City", name: "Lahore" },
  },
  {
    "@type": "Physician",
    "@id": `${SITE}/#dr-kamran`,
    name: "Dr. Kamran Saleem",
    image: `${SITE}/assets/dr-kamran.webp`,
    jobTitle: "Reproductive Health Specialist",
    medicalSpecialty: "Reproductive Medicine",
    hasCredential: [
      {
        "@type": "EducationalOccupationalCredential",
        credentialCategory: "MBBS - Bachelor of Medicine, Bachelor of Surgery",
      },
      {
        "@type": "EducationalOccupationalCredential",
        credentialCategory:
          "Dip GUM & Ven (UK) - Diploma in Genitourinary Medicine and Venereology",
      },
    ],
    // TODO: add the PMDC registration number here as an `identifier` once
    // confirmed, e.g. identifier: { "@type": "PropertyValue", name: "PMDC Registration No.", value: "..." }
    worksFor: { "@id": `${SITE}/#clinic` },
    // FIX: was the homepage; point to the doctor's own page.
    url: `${SITE}/dr-kamran-saleem`,
  },
  {
    "@type": "MedicalClinic",
    "@id": `${SITE}/locations/dha-lahore#location`,
    name: "Kamran Fertility Clinic - Rasheed Hospital, DHA Lahore",
    url: `${SITE}/locations/dha-lahore`,
    telephone: "+92-314-8432789",
    parentOrganization: { "@id": `${SITE}/#clinic` },
    medicalSpecialty: "Reproductive Medicine",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Rasheed Hospital, Main Boulevard, DHA Defence",
      addressLocality: "Lahore",
      addressRegion: "Punjab",
      addressCountry: "PK",
    },
    // TODO: add geo coordinates: geo: { "@type": "GeoCoordinates", latitude: 0, longitude: 0 }
    // CONFIRM: Mon-Fri assumed because the site also lists Sat/Sun as closed.
    openingHoursSpecification: [
      hours(["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], "15:00", "18:00"),
    ],
  },
  {
    "@type": "MedicalClinic",
    "@id": `${SITE}/locations/mm-alam-road-lahore#location`,
    name: "Kamran Fertility Clinic - TAMC, M.M. Alam Road",
    url: `${SITE}/locations/mm-alam-road-lahore`,
    telephone: "+92-314-8432789",
    parentOrganization: { "@id": `${SITE}/#clinic` },
    medicalSpecialty: "Reproductive Medicine",
    address: {
      "@type": "PostalAddress",
      streetAddress: "TAMC, M.M. Alam Road",
      addressLocality: "Lahore",
      addressRegion: "Punjab",
      addressCountry: "PK",
    },
    // Wednesday only; other days are by appointment so they are not listed.
    openingHoursSpecification: [hours(["Wednesday"], "12:00", "15:00")],
  },
  {
    "@type": "MedicalClinic",
    "@id": `${SITE}/locations/shalamar-lahore#location`,
    name: "Kamran Fertility Clinic - Shahnaz Hospital, Shalamar",
    url: `${SITE}/locations/shalamar-lahore`,
    telephone: "+92-314-8432789",
    parentOrganization: { "@id": `${SITE}/#clinic` },
    medicalSpecialty: "Reproductive Medicine",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Shahnaz Hospital, Shalamar Link Road",
      addressLocality: "Lahore",
      addressRegion: "Punjab",
      postalCode: "54000",
      addressCountry: "PK",
    },
    openingHoursSpecification: [hours(["Monday", "Thursday"], "18:00", "21:00")],
  },
];

// FIX: FAQPage markup must match FAQ content that is visible on the page.
// The FAQ only appears on the homepage, so the markup is now homepage-only
// (it was previously injected into every page).
if (isHome) {
  graph.push({
    "@type": "FAQPage",
    "@id": `${SITE}/#faq`,
    mainEntity: [
      {
        "@type": "Question",
        name: "Do I need a confirmed diagnosis before booking?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "No. Many patients come in with questions, concerns, or previous reports. The consultation helps us understand your situation and explain appropriate next steps.",
        },
      },
      {
        "@type": "Question",
        name: "What happens during the first consultation?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Dr. Kamran Saleem reviews your medical history, listens to your concerns, and discusses any prior tests. Options are explained clearly, with recommendations only when medically appropriate.",
        },
      },
      {
        "@type": "Question",
        name: "Do you recommend tests or treatments for everyone?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "No. Tests and treatments are recommended only when they're likely to provide useful information or benefit your care.",
        },
      },
      {
        "@type": "Question",
        name: "Do you offer second opinions on previous treatments?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Yes. We regularly review prior recommendations and help you understand your options moving forward.",
        },
      },
    ],
  });
}

const schema = { "@context": "https://schema.org", "@graph": graph };
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<!-- Favicon. TODO: also add /favicon.ico and a 180x180 apple-touch-icon -->
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/favicon.png" />
<!-- Primary meta -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<link rel="canonical" href={canonicalURL} />
<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Kamran Fertility Clinic" />
<meta property="og:locale" content="en_PK" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={imageAlt} />
<!-- Twitter (twitter:url is not a real tag, removed) -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={imageAlt} />
<!-- Structured data (schema.org JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<!--
  GA4 slot - uncomment and set the Measurement ID when ready.
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag("js", new Date());
    gtag("config", "G-XXXXXXXXXX");
  </script>
-->
