---
import TreatmentPage from "../components/TreatmentPage.astro";

const T = "/services/fertility-treatment";
const A = "/services/assessment";
const L = "/locations";

const page = {
  slug: "success-stories",
  name: "Patient Success Stories",
  title: "Patient Reviews & Success Stories | Kamran Fertility Lahore",
  description: "Real Google reviews from patients of Dr. Kamran Saleem, a Lahore fertility specialist with 25 years' experience. Honest, unhurried, evidence-based care.",
  eyebrow: "Patient Success Stories in Lahore",
  h1: "Patient Success Stories & Reviews in Lahore",
  waText: "Hello, I would like to book a fertility consultation with Dr. Kamran Saleem.",
  ctaLabel: "Book a consultation",
  heroSub: [
    "Starting fertility treatment can feel overwhelming. Before any procedure, most couples want to feel listened to, understood and treated honestly.",
    "Here, patients of Dr. Kamran Saleem describe what their visit was like, in their own unedited words from Google. Outcomes vary between individuals and no result is guaranteed.",
  ].join(" "),
  leadIn: [
    { rich: ["These reviews describe patients' consultation and care experience at Kamran Fertility Clinic. To learn about the doctor behind them, see ", ["Dr. Kamran Saleem", "/dr-kamran-saleem"], ", or explore our ", ["fertility assessment & diagnosis", A], " and ", ["fertility treatment", T], " services."] },
  ],
  sections: [
    {
      id: "why-couples-trust-dr-kamran",
      title: "Why Couples Trust Dr. Kamran Saleem",
      intro: "Experience, clear communication and an evidence-based approach shape every consultation.",
      icon: "clipboard",
      body: [
        { ul: [
          "25 years' experience in reproductive health and fertility, covering male and female concerns",
          "MBBS (1988) and a Diploma in Genito-Urinary Medicine & Venereology from the University of Liverpool, UK (1998)",
          "Tests and treatments recommended only when they are likely to inform decisions",
          "New-patient consultations of 45 to 60 minutes, ending with a written plan built around your timeline and values",
        ] },
        { rich: ["Read his full profile on the ", ["About Dr. Kamran Saleem", "/dr-kamran-saleem"], " page."] },
      ],
    },
    {
      id: "review-attiya-jabeen",
      title: "“Proper Assessment and Personalized Guidance”",
      intro: "Attiya Jabeen · Google review · 5 stars",
      icon: "clipboard",
      body: [
        "“I had a very positive experience with Kamran Fertility Clinic. The information provided was clear, professional, and focused on helping patients understand their fertility concerns and available options. I especially appreciated the emphasis on proper assessment and personalized guidance rather than unnecessary treatment.”",
        { rich: ["What stood out: clear information and a focus on assessment first. Learn about our ", ["fertility assessment & diagnosis", A], " or our ", ["fertility treatment options", T], "."] },
      ],
    },
    {
      id: "review-fazal-khan",
      title: "A Doctor Who Listened Carefully",
      intro: "Fazal Khan · Google review · 5 stars",
      icon: "flask",
      body: [
        "“We visited Kamran fertility clinic Lahore. The doctor and stuff were very experienced and polite especially Dr kamran listened us very carefully and do the indepth analysis of our treatment and provided the detailed consultation on treatment. I would highly recommend it to everyone thank you Dr.kamran”",
        { rich: ["What stood out: careful listening and a detailed consultation. Read about ", ["Dr. Kamran Saleem's experience and approach", "/dr-kamran-saleem"], " or explore ", ["fertility treatment in Lahore", T], "."] },
      ],
    },
    {
      id: "review-kinza-bibi",
      title: "“I Felt Comfortable Throughout the Process”",
      intro: "Kinza Bibi · Google review · 5 stars",
      icon: "route",
      body: [
        "“I had a very good experience at Kamran Fertility Clinic. The doctor was professional, kind, and took the time to explain everything clearly. The staff was also cooperative and welcoming. I felt comfortable throughout the process and would definitely recommend the clinic to anyone looking for fertility care in Lahore.”",
        { rich: ["What stood out: kind, clear explanations and a welcoming team. See our Lahore locations: ", ["DHA", `${L}/dha-lahore`], ", ", ["M.M. Alam Road", `${L}/mm-alam-road-lahore`], " and ", ["Shalamar", `${L}/shalamar-lahore`], "."] },
      ],
    },
    {
      id: "review-yands-khan",
      title: "Satisfied with the Consultation and Treatment Plan",
      intro: "Yands Khan · Google review · 5 stars",
      icon: "calendar",
      body: [
        "“Yesterday I visited Kamran fertility clinic in Lahore and I'm surprisingly satisfied with the consultation and treatment plan. Thank you Dr kamran”",
        { rich: ["What stood out: a clear plan after the first visit. Browse our ", ["fertility treatment options", T], " or read about ", ["support and second opinions", "/services/support"], "."] },
      ],
    },
    {
      id: "review-ali-malik",
      title: "Knowledgeable, Outstanding Service",
      intro: "Ali Malik · Google review · 5 stars",
      icon: "compare",
      body: [
        "“Kamran fertility clinic is the one of the best fertility clinic. The services are outstanding he is really knowledgeable Dr. I would highly recommend him.”",
        { rich: ["What stood out: the doctor's knowledge. Meet ", ["Dr. Kamran Saleem", "/dr-kamran-saleem"], " and read our ", ["fertility resources", "/resources"], "."] },
      ],
    },
    {
      id: "review-absar-alam",
      title: "A Good Listener with Detailed Observation",
      intro: "Absar Alam · Google review · 4 stars",
      icon: "clipboard",
      body: [
        "“Doctor sahb are very good listener and do detailed observation. I would recommend them.”",
        { rich: ["What stood out: listening and detail. Learn about ", ["hormonal analysis", `${A}/hormonal-analysis`], ", ", ["semen analysis", `${A}/semen-analysis`], " and ", ["second opinions", "/services/support"], "."] },
      ],
    },
    {
      id: "what-patients-mention-most",
      title: "What Patients Mention Most",
      intro: "Counted across the six reviews above, the same themes keep appearing.",
      icon: "compare",
      body: [
        { ul: [
          "4 of 6 mention thorough assessment, analysis or a clear treatment plan",
          "4 of 6 say they would recommend the clinic or the doctor",
          "3 of 6 highlight clear, detailed explanations",
          "2 of 6 praise careful listening, and 2 of 6 the doctor's knowledge and experience",
          "2 of 6 mention a polite, welcoming staff",
        ] },
      ],
    },
    {
      id: "how-we-publish-reviews",
      title: "How We Publish Reviews",
      intro: "Trust depends on honesty, so we keep this page simple and verifiable.",
      icon: "route",
      body: [
        "We publish reviews exactly as patients wrote them, including the 4-star review, and we do not edit or select them to change their meaning. Reviews describe individual experiences of care. They are not a promise of any medical result.",
        { rich: ["You can ", ["read every review on Google", "https://www.google.com/maps/search/?api=1&query=Kamran+Fertility+Clinic+Lahore"], " to check for yourself."] },
      ],
    },
  ],
  faqs: [
    { q: "Are these reviews genuine?", a: "Yes. They are public Google reviews, reproduced as the patients wrote them, with the reviewer's name as shown on Google." },
    { q: "Will my experience be the same?", a: "Every patient's history is different, and no clinic can guarantee a pregnancy. Your consultation explains what is realistic for you." },
    { q: "Do I need a diagnosis before booking?", a: "No. Many patients come with questions or earlier reports. The consultation helps explain appropriate next steps." },
    { q: "Can I leave a review?", a: "Yes, and we welcome honest feedback. You can share your experience on Google after your visit." },
  ],
  closingHeading: "Fertility Care in Lahore with Dr. Kamran Saleem",
  closingParas: [
    "Whatever stage you are at, you will not be rushed or judged. Dr. Kamran Saleem will review your history and any reports, explain your options honestly and outline a plan built around your circumstances.",
    "You can ask about consultation fees before confirming your appointment.",
  ],
  resources: [
    { href: "/resources/fertility-assessment-in-lahore", category: "Fertility Assessment", title: "Fertility Assessment in Lahore" },
    { href: "/resources/female-infertility-treatment", category: "Fertility Assessment", title: "Female Infertility: Treatment and Next Steps" },
    { href: "/resources/pcos-and-fertility", category: "Fertility Assessment", title: "PCOS and Fertility" },
  ],
  close: {
    heading: "Ready to Book Your Consultation?",
    body: "Message the clinic on WhatsApp and share your history or previous reports, so your first visit can focus on your questions.",
    cta: "Book a consultation",
  },
};
---

<TreatmentPage {...page} />
