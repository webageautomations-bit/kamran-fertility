---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import CloseContact from "../../components/CloseContact.astro";

// ─────────────────────────────────────────────────────────────────────────────
// BEFORE PUBLISHING: resolve every line marked  >>> CONFIRM.
// Empty values hide their block, so the page stays honest by default.
// Medical page (YMYL): do not publish a claim you cannot prove.
//
// CLAIMS THAT MUST BE VERIFIED BEFORE PUBLISHING:
//  1. "25 years of experience" (what it covers: fertility practice vs total medical experience)
//  2. Marham 5.0 rating and 32 reviews (re-check live)
//  3. On-site parking at Rasheed Hospital
//  4. Monday to Friday, 3pm to 6pm (visible text, schema and Google Business Profile must all agree)
//  5. Confidentiality statement
//  6. Exact doctor designation and PMDC registration
//  7. Which services are performed at Rasheed Hospital vs a partner facility
//  8. Medical sections reviewed by Dr. Kamran; Urdu section reviewed by a native Urdu medical reader
//  9. Schema: MedicalClinic address, Physician profile, and the Marham sameAs URL
// ─────────────────────────────────────────────────────────────────────────────
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Locations", href: "/locations" },
  { label: "DHA Lahore" },
];

const hospitalName = "Rasheed Hospital";
const address = "Rasheed Hospital, Main Boulevard, Defence, Lahore";
// >>> CONFIRM: phase / block / plot / floor / room, e.g. "Phase X, Plot Y, 2nd floor".
const addressDetail = "";
// >>> CONFIRM: one or two real landmarks and entrance directions. Empty = hidden.
const landmarkNote = "";
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
const phoneDisplay = "+92 314 8432789";
const phoneHref = "tel:+923148432789";
const whatsappHref = "https://wa.me/923148432789";
const hours = "Monday to Friday, 3:00pm to 6:00pm. Closed Saturday and Sunday"; // >>> CONFIRM

// >>> CONFIRM: put the real consultation fee here, e.g. "Consultation fee: Rs. X."
const feeStatement =
  "Fees are explained up front, with no obligation to proceed. Message us on WhatsApp for the current consultation fee.";
// >>> CONFIRM + EDIT: say exactly where egg collection, the embryology lab and embryo transfer take place.
const ivfSiteNote =
  "Before you commit to any treatment, we tell you exactly where each stage of IVF or ICSI is carried out.";
// >>> CONFIRM: PMDC / PMC registration, e.g. "PMDC registration no. 12345-P". Empty = hidden.
const registration = "";
// >>> CONFIRM: what the 25 years covers (fertility practice vs. total medical experience).
const experienceLine = "25 years of experience in reproductive health and fertility";
// >>> CONFIRM: re-check live on Marham before publishing.
const marhamRating = "5.0";
const marhamCount = "32";
const lastUpdated = "November 2026";
// >>> CONFIRM: ISO date (e.g. "2026-11-03") ONLY after Dr. Kamran has actually reviewed this page. Empty = no "reviewed" claim.
const lastReviewedISO = "";
// >>> CONFIRM against the HFEA before turning on (set true). Figures are UK national averages, not this clinic's results.
const showAgeTable = false;
const ageRates = [
  { age: "18 to 34", rate: "about 35%" },
  { age: "35 to 37", rate: "about 26%" },
  { age: "38 to 39", rate: "about 18%" },
  { age: "40 to 42", rate: "about 10%" },
  { age: "43 to 44", rate: "about 5%" },
];

// >>> CONFIRM: which stages happen at Rasheed Hospital and which at a partner facility.
// List ONLY services you have verified. If both lists are empty, the generic line is shown instead.
const onSiteServices: string[] = []; // e.g. "Consultation and examination", "Ultrasound scans", "Treatment planning"
const offSiteServices: string[] = []; // e.g. "Egg collection", "Embryology laboratory work", "Embryo transfer"
const offSiteFacilityNote = ""; // e.g. name and address of the partner facility
// >>> CONFIRM: real local information. Empty = hidden.
const entranceDirections = ""; // e.g. "Enter from ... gate, take the lift to the 2nd floor, consultation room ..."
const hospitalPhoto = ""; // e.g. "/assets/rasheed-hospital-entrance.webp" (a genuine exterior photo)
const hospitalPhotoAlt = "Entrance of Rasheed Hospital on Main Boulevard, Defence, Lahore";
// Optional internal links. Add a URL ONLY if that page exists. Empty = no link is shown.
const links = { male: "", icsi: "", iui: "", pcos: "", loss: "", urdu: "" };
const reviewedDisplay = lastReviewedISO
  ? new Date(lastReviewedISO).toLocaleDateString("en-GB", { month: "long", year: "numeric" })
  : "";

const pageUrl = "https://www.kamranfertility.com/locations/dha-lahore";

const services = [
  {
    h: "Infertility assessment and fertility tests in Lahore",
    body: "Your first visit starts with a full history for both partners. Dr. Kamran then recommends only the tests you need, which may include semen analysis, hormone blood tests, a pelvic ultrasound and, where indicated, a check of the fallopian tubes. If you already have recent reports, bring them so tests are not repeated unnecessarily.",
    href: "/services/assessment",
    cta: "Learn more about infertility assessment and diagnosis →",
  },
  {
    h: "IVF treatment in DHA Lahore: consultation and planning",
    body: "IVF (in vitro fertilisation), often called test tube baby treatment, may be advised for blocked fallopian tubes, significant male-factor infertility, reduced ovarian reserve, endometriosis, unexplained infertility, or when simpler treatments have not worked. Dr. Kamran explains the stages, the risks, what affects success and the likely cost before you decide.",
    href: "/services/fertility-treatment",
    cta: "Explore IVF and fertility treatment →",
  },
  {
    h: "ICSI treatment in Lahore",
    body: "ICSI (intracytoplasmic sperm injection) is a form of IVF in which a single sperm is injected directly into an egg. It is commonly considered when sperm count, movement or shape is significantly reduced, or when earlier IVF showed poor fertilisation. It is not needed in every IVF cycle, and your semen analysis and wider assessment guide the choice.",
    href: links.icsi || undefined,
    cta: "Learn more about ICSI →",
  },
  {
    h: "IUI treatment in Lahore and ovulation induction",
    body: "IUI (intrauterine insemination) places prepared sperm in the uterus around ovulation. It may suit selected couples, for example some with ovulation problems or mild sperm abnormalities, provided the fallopian tubes are open. It is not suitable for everyone, and significant tubal damage usually points to a different treatment. Ovulation tracking and induction can be used on their own or alongside IUI.",
    href: links.iui || undefined,
    cta: "Learn more about IUI →",
  },
  {
    h: "PCOS fertility treatment in Lahore",
    body: "PCOS can make ovulation irregular, but it does not mean IVF is automatically needed. Women are assessed for cycle pattern, ovulation and hormone levels first. Where appropriate, lifestyle measures and ovulation-inducing medication are considered before assisted treatments such as IUI or IVF.",
    href: links.pcos || undefined,
    cta: "Learn more about PCOS and fertility →",
  },
  {
    h: "IVF second opinion in Lahore",
    body: "If treatment elsewhere has not worked, or you have been given different recommendations, bring your records for an independent review: medication charts, scan reports, and any embryo or cycle summaries. Dr. Kamran explains what may have contributed to the outcome and what your options are.",
    href: "/services/support",
    cta: "Read about second opinions →",
  },
];

const maleCauses = [
  { lead: "Sperm production problems.", body: "Low count, poor movement or abnormal shape, often found on semen analysis. Causes include hormonal problems, medicines, previous illness or surgery, and sometimes genetic factors." },
  { lead: "Varicocele.", body: "Swollen veins around the testicle, described as the most common reversible cause of male infertility. It can be examined clinically and confirmed by scrotal ultrasound where needed." },
  { lead: "Infections and inflammation.", body: "Conditions such as epididymitis, orchitis and some sexually transmitted infections can affect sperm production or block sperm transport. Dr. Kamran's training in genito-urinary medicine is relevant to assessing these." },
  { lead: "Blockages.", body: "If sperm are made but cannot pass through the ducts, they may be low or absent in the ejaculate. The cause and the options depend on the assessment." },
  { lead: "Hormonal and lifestyle factors.", body: "Low testosterone or other hormonal problems, smoking, heavy alcohol use, drugs, obesity and some medicines can reduce sperm quality." },
];

const timing = [
  "Under 35: after 12 months of regular, unprotected intercourse without pregnancy.",
  "Age 35 to 39: after 6 months.",
  "Age 40 or over: promptly, without waiting.",
  "Sooner at any age with very irregular or absent periods, a known condition such as PCOS or endometriosis, previous pelvic infection or surgery, or a known or suspected male factor.",
];

const initialTests = [
  { test: "History and examination", shows: "Cycle pattern, previous pregnancies, medical and surgical history for both partners", who: "Both partners" },
  { test: "Semen analysis", shows: "Sperm count, movement, shape and volume", who: "Male partner" },
  { test: "Hormone blood tests", shows: "Ovulation, ovarian reserve (AMH), thyroid, prolactin, chosen from your history", who: "Mostly the female partner" },
  { test: "Pelvic ultrasound", shows: "Uterus and ovaries, PCOS features, fibroids, cysts, antral follicles", who: "Female partner" },
];

const selectedTests = [
  { test: "Fallopian tube assessment (such as HSG)", when: "A history of pelvic infection, tubal or pelvic surgery, ectopic pregnancy, or when IUI is being considered", note: "Tube status is one part of the picture. It does not on its own decide between IUI and IVF; age, sperm quality, ovarian reserve and how long you have been trying also matter." },
  { test: "Uterine cavity assessment", when: "Abnormal ultrasound findings, repeated miscarriage or repeated failed embryo transfers", note: "Not needed for every patient." },
  { test: "Scrotal ultrasound", when: "An abnormal examination or semen result, or a suspected varicocele or testicular problem", note: "Not a routine test for every man." },
  { test: "Infection screening", when: "Symptoms, a history of infection, or findings that suggest inflammation", note: "Done on clinical grounds, not routinely." },
  { test: "Repeat or extended male tests", when: "After an abnormal first semen analysis", note: "Results can vary between samples, so a repeat is usually advised before conclusions are drawn." },
  { test: "Genetic tests", when: "Very low or absent sperm count, repeated pregnancy loss, or a relevant family history", note: "Chosen case by case, with counselling." },
];

const steps = [
  { lead: "Book on WhatsApp.", body: "Tell us your preferred day and we confirm a time in the 3pm to 6pm window." },
  { lead: "Bring your records.", body: "Previous reports, scans, semen analysis and any medication history. Both partners are welcome." },
  { lead: "Consultation.", body: "Dr. Kamran reviews your history, examines where needed, and explains what may be contributing to the delay in conceiving." },
  { lead: "Plan.", body: "You leave with a clear next step: further tests, a treatment plan, or reassurance." },
];

const costFactors = [
  "Your diagnosis, and whether IUI, IVF or ICSI is appropriate",
  "Medication type and dose, which differ from patient to patient",
  "Whether extra procedures such as embryo freezing or male-factor procedures are needed",
  "The number of treatment cycles required",
  "Which facility performs each stage of treatment",
];

const costQuestions = [
  "What exactly is included in the quoted amount?",
  "Are medicines included, or paid separately?",
  "Is ICSI, embryo freezing and storage included or extra?",
  "Are monitoring scans and follow-up visits included?",
  "What happens to the cost if the cycle is cancelled or repeated?",
];

const lifestyle = [
  "Stop smoking and avoid recreational drugs; both partners benefit.",
  "Keep alcohol low. For men, heavy drinking can reduce sperm production.",
  "Aim for a healthy weight, as being very underweight or overweight can affect ovulation and sperm quality.",
  "Ask your doctor about folic acid before you conceive.",
  "Tell your doctor about every medicine you take, including those bought without a prescription.",
];

const faqs = [
  {
    q: "Where can I consult a fertility specialist in DHA Lahore?",
    a: "Dr. Kamran Saleem, a fertility specialist and andrologist, consults at Rasheed Hospital, Main Boulevard, Defence, Lahore. Clinic hours are Monday to Friday, 3pm to 6pm, and the clinic is closed at weekends. Message us on WhatsApp at +92 314 8432789 before travelling so we can confirm your appointment slot.",
  },
  {
    q: "Do you offer IVF treatment in DHA Lahore?",
    a: `Consultations, diagnosis and treatment planning for IUI, IVF and ICSI take place at ${hospitalName}. ${ivfSiteNote}`,
  },
  {
    q: "How much does IVF cost in Lahore?",
    a: `The cost depends on your diagnosis, medication, any extra procedures such as embryo freezing, and the number of cycles. Dr. Kamran gives an individual estimate after assessment, so you know the likely cost before you decide. ${feeStatement}`,
  },
  {
    q: "When should we see a fertility specialist?",
    a: "Couples are generally advised to see a fertility specialist after 12 months of regular, unprotected intercourse if the woman is under 35, and after 6 months if she is 35 or older. Women over 40 should seek evaluation promptly. See a specialist sooner for irregular cycles, known conditions such as PCOS or endometriosis, or suspected male-factor infertility.",
  },
  {
    q: "What tests are done for infertility in Lahore?",
    a: "Assessment starts with a history for both partners, then only the tests that are indicated. Common tests include semen analysis, hormone blood tests, a pelvic ultrasound, and sometimes a test of the fallopian tubes. Bring previous reports so tests are not repeated unnecessarily.",
  },
  {
    q: "Can male infertility be treated?",
    a: "Many causes of male infertility can be treated or managed. A varicocele, for example, is described as the most common reversible cause. Dr. Kamran, an andrologist, starts with semen analysis, hormone levels and your history. Options range from treating an underlying condition to assisted treatment such as IUI or ICSI.",
  },
  {
    q: "Does a low sperm count mean we cannot have a baby?",
    a: "No. A low count lowers the chance of natural conception, but many couples still conceive naturally or with treatment. If no sperm are found in the ejaculate, the cause, such as a blockage or a hormonal problem, needs specialist assessment because the options depend on it. A repeat test is often advised.",
  },
  {
    q: "Can infections affect male fertility?",
    a: "Yes. Infections and inflammation of the testicles, epididymis or reproductive tract, including some sexually transmitted infections, can reduce sperm quality or block sperm transport. If you have had repeated infections or symptoms, tell Dr. Kamran. Screening and treatment, where needed, can be part of the assessment.",
  },
  {
    q: "Can PCOS be treated without IVF?",
    a: "Many women with PCOS conceive without IVF. Depending on the assessment, options may include lifestyle measures, ovulation-inducing medication and IUI. IVF is considered when these are unsuitable or have not worked. Dr. Kamran assesses your cycles, ovulation and hormones first, then explains which options suit your situation.",
  },
  {
    q: "What is the difference between IVF and ICSI?",
    a: "In standard IVF, eggs and sperm are placed together in a laboratory so fertilisation can occur. In ICSI, a single sperm is injected directly into each egg. ICSI is often considered when sperm numbers or movement are significantly reduced. Which approach suits you depends on your semen analysis and treatment history.",
  },
  {
    q: "What are the chances of IVF success?",
    a: "Success depends mainly on the woman's age, the cause of infertility, sperm and embryo quality, and previous treatment. Chances fall as age rises, and no clinic can guarantee a pregnancy. Dr. Kamran discusses realistic expectations for your age, test results and history before you decide whether to start.",
  },
  {
    q: "What are the risks of IVF?",
    a: "Possible risks include ovarian hyperstimulation syndrome (OHSS), multiple pregnancy if more than one embryo is transferred, ectopic pregnancy, and emotional strain. Treatment is planned and monitored to reduce these risks, and a cycle may not result in pregnancy. Dr. Kamran explains the risks that apply to you before you consent.",
  },
  {
    q: "Do both partners need to attend, and what should we bring?",
    a: "A joint visit gives the fullest picture, but either partner may attend first. Bring hormone panels, ultrasound reports, semen analysis, previous treatment records, any IUI or IVF cycle summaries and a list of current medicines. This avoids repeating tests and lets Dr. Kamran focus on your next step.",
  },
  {
    q: "Can I get an IVF second opinion in Lahore?",
    a: "Yes. Bring your complete records, including medication charts, scan reports and any embryo or cycle summaries. Dr. Kamran reviews them, explains what may have contributed to the outcome and sets out your options, whether that is a change of approach, further tests or a different treatment.",
  },
  {
    q: "Do I need an appointment, and is parking available?",
    a: "Yes, please confirm by WhatsApp before you travel. Clinic hours are a three-hour window, Monday to Friday from 3pm to 6pm, so we confirm a slot with you first. On-site parking is available for patients at Rasheed Hospital. Message +92 314 8432789 with your preferred day.",
  },
  {
    q: "Is the first fertility consultation confidential?",
    a: "Yes. Assessments are handled confidentially. Your history, test results and treatment discussions are kept private, and you decide who attends with you. There is no pressure to start treatment on the first visit, and you are welcome to ask questions about privacy before sharing sensitive information.",
  },
  {
    q: "What if my fertility tests are normal?",
    a: "Normal initial results are reassuring but do not rule out a problem, because standard tests cannot assess everything, such as egg quality. When no cause is found, this is called unexplained infertility. Dr. Kamran then considers your age and how long you have been trying, and discusses options from continued attempts with ovulation tracking to IUI or IVF.",
  },
  {
    q: "How does age affect fertility?",
    a: "A woman's fertility declines with age because the number and quality of eggs fall, with a faster decline after the mid-30s. Male age can also affect sperm quality, usually more gradually. This is why assessment is advised sooner at 35 and over, and why Dr. Kamran weighs age carefully when planning treatment.",
  },
  {
    q: "When should I seek help after a miscarriage?",
    a: "A single miscarriage is common and does not usually need an extensive work-up. Guidelines differ, with some advising assessment after two consecutive losses and others after three, and earlier if you are 35 or older or the loss was later in pregnancy. Seek urgent care for heavy bleeding or severe pain in pregnancy.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalClinic",
      "@id": `${pageUrl}#clinic`,
      name: "Dr. Kamran Saleem Fertility Clinic - DHA Lahore",
      url: pageUrl,
      image: "https://www.kamranfertility.com/assets/dr-kamran.webp",
      telephone: "+923148432789",
      description:
        "Fertility specialist and andrologist consultations for infertility assessment, IVF, ICSI, IUI, male infertility, PCOS and second opinions at Rasheed Hospital, DHA Lahore.",
      address: {
        "@type": "PostalAddress",
        streetAddress: addressDetail ? `${addressDetail}, Main Boulevard, Defence` : "Rasheed Hospital, Main Boulevard, Defence",
        addressLocality: "Lahore",
        addressRegion: "Punjab",
        addressCountry: "PK",
      },
      containedInPlace: { "@type": "Hospital", name: hospitalName },
      areaServed: ["DHA Lahore", "Defence, Lahore", "Cavalry Ground, Lahore", "Lahore"],
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          opens: "15:00",
          closes: "18:00",
        },
      ],
      // >>> CONFIRM: exact Marham profile URL, and that it genuinely represents this doctor.
      sameAs: ["https://www.marham.pk/doctors/lahore/andrologist/dr-kamran-saleem"],
      employee: { "@id": "https://www.kamranfertility.com/dr-kamran-saleem#physician" },
    },
    {
      "@type": "Physician",
      "@id": "https://www.kamranfertility.com/dr-kamran-saleem#physician",
      name: "Dr. Kamran Saleem",
      url: "https://www.kamranfertility.com/dr-kamran-saleem",
      image: "https://www.kamranfertility.com/assets/dr-kamran.webp",
      description:
        "Fertility specialist and andrologist in Lahore offering infertility assessment, IUI, IVF and ICSI treatment planning, male infertility care and second opinions.",
      alumniOf: { "@type": "CollegeOrUniversity", name: "University of Liverpool" },
    },
    {
      "@type": "MedicalWebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: "IVF & Fertility Specialist in DHA Lahore | Dr. Kamran Saleem",
      inLanguage: "en",
      about: { "@type": "MedicalCondition", name: "Infertility" },
      medicalAudience: { "@type": "MedicalAudience", audienceType: "Patient" },
      ...(lastReviewedISO
        ? { lastReviewed: lastReviewedISO, reviewedBy: { "@id": "https://www.kamranfertility.com/dr-kamran-saleem#physician" } }
        : {}),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.kamranfertility.com/" },
        { "@type": "ListItem", position: 2, name: "Locations", item: "https://www.kamranfertility.com/locations" },
        { "@type": "ListItem", position: 3, name: "DHA Lahore", item: pageUrl },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: { "@type": "Answer", text: item.a },
      })),
    },
  ],
};
---

<Layout
  title="IVF & Fertility Specialist DHA Lahore | Dr. Kamran Saleem"
  description="See Dr. Kamran Saleem, fertility specialist & andrologist, at Rasheed Hospital, DHA Lahore for IVF, ICSI, IUI, male infertility, PCOS and second opinions."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <PageHero
    eyebrow="DHA Lahore"
    title="IVF & Fertility Specialist in DHA Lahore"
    sub={[
      "If you are looking for an IVF specialist in DHA Lahore, Dr. Kamran Saleem, a fertility specialist and andrologist, sees patients at Rasheed Hospital, Main Boulevard, Defence, Lahore. Book an infertility assessment, IVF consultation, male infertility check-up or second opinion.",
      "Both partners are assessed. Consultations cover fertility tests, treatment planning for IUI, IVF and ICSI where appropriate, PCOS and ovulation problems, and second opinions for couples already treated elsewhere in Lahore.",
    ]}
    breadcrumbs={breadcrumbs}
    cta="Message us on WhatsApp"
  />

  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-3xl px-5 sm:px-8" data-reveal>
      <h2 class="font-heading text-xl font-bold text-ink">Infertility specialist in DHA Lahore: quick answer</h2>
      <p class="mt-4 leading-relaxed text-body">
        Dr. Kamran Saleem consults at {hospitalName}, Main Boulevard, Defence, Lahore, Monday to
        Friday, 3pm to 6pm. He assesses both partners and advises on IUI, IVF and ICSI where
        appropriate, male infertility, PCOS and second opinions. Message {phoneDisplay} on
        WhatsApp to confirm your appointment before you travel.
      </p>
      <p class="mt-4 leading-relaxed text-body">
        Infertility is common and treatable in many cases. The World Health Organization estimates
        that about 1 in 6 people worldwide experience it at some point, and that rates are similar
        in lower- and higher-income countries. It is a medical condition, not a personal failing,
        and it can involve either partner.
      </p>
    </div>
  </section>

  <section class="bg-cloud py-16 md:py-20">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <div data-reveal>
        <h2 class="font-heading text-xl font-bold text-ink">Fertility clinic in DHA Lahore: details</h2>
        <dl class="mt-4 space-y-3 text-sm">
          <div>
            <dt class="font-semibold text-ink">Clinic</dt>
            <dd class="text-body">{hospitalName}, DHA Lahore</dd>
          </div>
          <div>
            <dt class="font-semibold text-ink">Address</dt>
            <dd class="text-body">{addressDetail ? `${addressDetail}, ` : ""}{address}</dd>
          </div>
          {landmarkNote && (
            <div>
              <dt class="font-semibold text-ink">Landmark</dt>
              <dd class="text-body">{landmarkNote}</dd>
            </div>
          )}
          <div>
            <dt class="font-semibold text-ink">Doctor</dt>
            <dd class="text-body">Dr. Kamran Saleem, fertility specialist and andrologist. MBBS (1988), Diploma in Genito-Urinary Medicine &amp; Venereology, University of Liverpool (1998){registration ? `. ${registration}` : ""}</dd>
          </div>
          <div>
            <dt class="font-semibold text-ink">Hours</dt>
            <dd class="text-body">{hours}</dd>
          </div>
          <div>
            <dt class="font-semibold text-ink">Phone / WhatsApp</dt>
            <dd><a href={phoneHref} class="text-azure hover:underline">{phoneDisplay}</a></dd>
          </div>
          <div>
            <dt class="font-semibold text-ink">Parking</dt>
            <dd class="text-body">Yes, on-site parking for patients</dd>
          </div>
          <div>
            <dt class="font-semibold text-ink">Consultation fee</dt>
            <dd class="text-body">{feeStatement}</dd>
          </div>
        </dl>
        <p class="mt-4 text-sm leading-relaxed text-body">
          Because clinic hours here are a three-hour daily window, please message us on WhatsApp
          before travelling so we can confirm your slot.
        </p>
        <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 font-semibold text-azure hover:underline">
            Book on WhatsApp →
          </a>
          <a href={mapsHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 font-semibold text-azure hover:underline">
            Get directions on Google Maps →
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-3xl px-5 sm:px-8" data-reveal>
      <h2 class="font-heading text-xl font-bold text-ink">Where treatment happens: Rasheed Hospital and other facilities</h2>
      <p class="mt-4 leading-relaxed text-body">
        Consultations, examination, diagnosis and treatment planning take place at {hospitalName}.
        {ivfSiteNote}
      </p>
      {onSiteServices.length > 0 && (
        <>
          <h3 class="mt-6 font-semibold text-ink">At {hospitalName}</h3>
          <ul class="mt-2 list-disc space-y-1 pl-6 leading-relaxed text-body">
            {onSiteServices.map((item) => <li>{item}</li>)}
          </ul>
        </>
      )}
      {offSiteServices.length > 0 && (
        <>
          <h3 class="mt-6 font-semibold text-ink">At a partner or treatment facility</h3>
          <ul class="mt-2 list-disc space-y-1 pl-6 leading-relaxed text-body">
            {offSiteServices.map((item) => <li>{item}</li>)}
          </ul>
          {offSiteFacilityNote && <p class="mt-3 leading-relaxed text-body">{offSiteFacilityNote}</p>}
        </>
      )}
    </div>
  </section>

  <section class="bg-cloud py-16 md:py-20">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
