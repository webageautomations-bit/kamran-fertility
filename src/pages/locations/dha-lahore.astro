---
// src/pages/locations/dha-lahore.astro
// Uses the site's own menu/footer via Layout. Match import path + props to your other pages.
import Layout from "../../layouts/Layout.astro";
const base = "https://www.kamranfertility.com";
const S = "/services/assessment";
const T = "/services/fertility-treatment";
const url = `${base}/locations/dha-lahore`;
const title = "Fertility Clinic DHA Lahore | Dr. Kamran Saleem";
const description = "Fertility consultations in DHA Lahore with Dr. Kamran Saleem at Rasheed Hospital, Main Boulevard. Semen analysis, hormone tests, PCOS, IUI, IVF and ICSI planning. Mon–Fri, 3–6 PM.";
const wa = "https://wa.me/923148432789?text=" + encodeURIComponent("Hello, I would like to book a consultation with Dr. Kamran Saleem at the DHA Lahore clinic.");
const maps = "https://www.google.com/maps/search/?api=1&query=Rasheed%20Hospital%2C%20Main%20Boulevard%2C%20Defence%2C%20Lahore";

const icons = {
  pin: '<path d="M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  parking: '<rect x="4" y="4" width="16" height="16" rx="4"/><path d="M10 16V8h3a2.5 2.5 0 010 5h-3"/>',
  route: '<circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="6" r="2.5"/><path d="M8.5 18H15a3 3 0 000-6H9a3 3 0 010-6h6.5"/>',
  phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z"/>',
  chat: '<path d="M4 5h16v11H9l-5 4z"/><path d="M8 10h8M8 13h5"/>',
  users: '<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.4"/><path d="M3 20a6 6 0 0112 0M15 15a5 5 0 016 5"/>',
  building: '<path d="M4 21V5l8-2 8 2v16M9 21v-5h6v5M8 9h2M14 9h2M8 13h2M14 13h2"/>',
  door: '<path d="M6 21V4h12v17M4 21h16"/><circle cx="14.5" cy="12.5" r=".8"/>',
  doc: '<rect x="6" y="3" width="12" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/>',
  shield: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/>',
  scope: '<path d="M9 3v7a4 4 0 008 0V3M13 14v3a4 4 0 004 4"/><circle cx="19" cy="14" r="2"/>',
  flask: '<path d="M9 3h6M10 3v6l-5 9a2 2 0 002 3h10a2 2 0 002-3l-5-9V3"/>',
  wave: '<path d="M3 12h3l2-6 4 12 3-9 2 3h4"/>',
  heart: '<path d="M12 21s-7-4.5-7-10a4 4 0 017-2.6A4 4 0 0119 11c0 5.5-7 10-7 10z"/>',
};

const toc = [["glance","At a glance"],["why","Why this clinic"],["services","Services in DHA"],["areas","Areas served"],["first-visit","First visit"],["find-us","Find us"],["faq","FAQ"],["locations","All clinics"]];

const glance = [
  ["Address", "pin", "Main Boulevard, Defence", "#find-us"],
  ["Hours", "clock", "Mon–Fri, 3–6 PM", "#hours"],
  ["Parking", "parking", "On-site for patients", "#find-us"],
  ["Directions", "route", "Open in Google Maps", maps],
  ["WhatsApp", "chat", "+92 314 8432789", wa],
  ["Areas", "users", "DHA, Cantt, Askari", "#areas"],
];

const why = [
  ["UK-qualified oversight", "shield", "Care under Dr. Kamran Saleem, whose Liverpool diploma in genito-urinary medicine is relevant to reproductive tract infections, male subfertility and hormonal assessment."],
  ["45–60 minute first visit", "clock", "Time to review your full history, previous failed cycles and reports, and to ask questions without feeling rushed."],
  ["Private setting", "door", "Private consultation rooms and male sample collection facilities at Rasheed Hospital, with your privacy and dignity protected."],
  ["Booking by WhatsApp", "chat", "Message us and we confirm a slot before you travel, so you are not left waiting in a queue."],
];

const services = [
  ["Consultation", "doc", "New patient evaluation: history, pelvic history, review of earlier reports and a clear diagnostic plan. Second opinions for unexplained IVF/ICSI failures, recurrent early pregnancy loss or persistently low AMH.", `<a href='${S}'>Assessment</a> · <a href='/services/support'>Second opinions</a>`],
  ["Semen analysis", "flask", "WHO 6th Edition: volume, concentration, total motile count and strict (Kruger) morphology. DNA fragmentation (DFI) and semen culture where indicated.", `<a href='${S}/semen-analysis'>Semen analysis</a>`],
  ["Female hormone tests", "wave", "AMH, day 2/3 FSH, LH, estradiol and day 21 progesterone to verify ovulation.", `<a href='${S}/female-fertility-hormone-test'>Hormone tests</a>`],
  ["Ultrasound & monitoring", "scope", "Transvaginal ultrasound for antral follicle count, endometrial thickness, fibroids and ovarian cysts. Serial follicle tracking in natural or letrozole cycles to time intercourse or IUI.", `<a href='${S}/female-fertility-assessment'>Female assessment</a>`],
  ["Ovulation induction & PCOS", "heart", "Letrozole or clomiphene with ultrasound monitoring.", `<a href='${T}/pcos'>PCOS treatment</a>`],
  ["IUI, IVF & ICSI planning", "building", "IUI with semen preparation and intrauterine placement. IVF, ICSI and frozen embryo transfer protocols planned here; before you commit, we tell you where each stage is carried out.", `<a href='${T}/iui'>IUI</a> · <a href='${T}/ivf'>IVF</a> · <a href='${T}/icsi'>ICSI</a> · <a href='${T}/fet'>FET</a>`],
];

const dha = ["Phase 1","Phase 2","Phase 3","Phase 4","Phase 5","Phase 6","Phase 7","Phase 8","Phase 9 Town","DHA Rahbar"];
const near = ["Lahore Cantt","Cavalry Ground","Askari 1–11","Bedian Road","Walton Road","Officers Colony"];

const steps = [
  ["Book on WhatsApp", "chat", "Message +92 314 8432789 with your preferred day. We confirm a time between 3 and 6 PM, Monday to Friday."],
  ["Bring your records", "doc", "Blood work, semen analysis, pelvic ultrasounds and surgical summaries. Both partners are welcome."],
  ["Consultation", "scope", "Dr. Kamran reviews your history, examines or scans where needed, and explains what may be affecting your fertility in plain language."],
  ["Written plan", "route", "You leave with a clear next step: lifestyle changes, timed intercourse, baseline tests or assisted treatment. No pressure to start treatment."],
];

const faqs = [
  ["Where is Dr. Kamran Saleem's DHA clinic located?", "Dr. Kamran Saleem consults at Rasheed Hospital, Main Boulevard, Defence (DHA Phase 5/6), Lahore. On-site parking is available for patients."],
  ["What are the consultation timings at the DHA Lahore clinic?", "Consultations are held Monday to Friday, 3:00 PM to 6:00 PM. The clinic is closed on Saturdays, Sundays and public holidays."],
  ["Can semen analysis be done at the DHA location?", "Yes. Rasheed Hospital provides private sample collection rooms, and samples are assessed to WHO 6th Edition standards. Follow the laboratory's instructions on abstinence before giving a sample."],
  ["How do I book an appointment at the DHA clinic?", "Send a WhatsApp message to +92 314 8432789 with your preferred day. We confirm a slot in the 3:00–6:00 PM window before you travel."],
  ["How much is the consultation fee?", "Fees are explained up front, with no obligation to proceed. Message us on WhatsApp for the current consultation fee."],
  ["Do both partners need to attend, and what should we bring?", "A joint visit gives the fullest picture, but either partner may attend first. Bring previous blood work, semen analysis reports, pelvic ultrasounds, surgical summaries and any IUI or IVF cycle records so tests are not repeated unnecessarily."],
  ["Do you offer IVF at the DHA clinic?", "Consultation, diagnosis and treatment planning for IUI, IVF and ICSI take place at Rasheed Hospital. Before you commit to treatment, we tell you where each stage of IVF or ICSI is carried out."],
];

const locations = [
  ["DHA Lahore: Rasheed Hospital", "Main Boulevard, DHA Defence, Lahore", "Mon–Fri 3:00 PM – 6:00 PM (closed Sat & Sun)", "/locations/dha-lahore", true],
  ["Gulberg: TAMC", "M.M. Alam Road, Lahore", "Wednesday 12:00 PM – 3:00 PM (other days by appointment)", "/locations/mm-alam-road-lahore", false],
  ["Shalamar: Shahnaz Hospital", "Shalamar Link Road, Lahore (54000)", "Monday & Thursday 6:00 PM – 9:00 PM", "/locations/shalamar-lahore", false],
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": ["MedicalClinic", "LocalBusiness"], "@id": url + "#clinic",
      name: "Kamran Fertility Clinic – DHA Lahore (Rasheed Hospital)", url, image: base + "/assets/logo.webp", logo: base + "/assets/logo.webp",
      description: "Doctor-led fertility consultations in DHA Lahore: infertility assessment, semen analysis, hormone tests, PCOS and ovulation induction, IUI, and IVF/ICSI planning and second opinions.",
      telephone: "+923148432789", medicalSpecialty: ["Obstetric", "Urologic"],
      address: { "@type": "PostalAddress", streetAddress: "Rasheed Hospital, Main Boulevard, Defence", addressLocality: "Lahore", addressRegion: "Punjab", addressCountry: "PK" },
      hasMap: maps,
      openingHoursSpecification: [{ "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday","Tuesday","Wednesday","Thursday","Friday"], opens: "15:00", closes: "18:00" }],
      areaServed: ["DHA Lahore","Lahore Cantt","Cavalry Ground","Askari, Lahore","Bedian Road, Lahore"].map(n => ({ "@type": "Place", name: n })),
      amenityFeature: { "@type": "LocationFeatureSpecification", name: "On-site patient parking", value: true },
      contactPoint: { "@type": "ContactPoint", contactType: "appointments", telephone: "+923148432789", availableLanguage: ["English","Urdu"] },
      employee: { "@id": base + "/dr-kamran-saleem#physician" },
      parentOrganization: { "@type": "Organization", name: "Kamran Fertility Clinic", url: base + "/" } },
    { "@type": "Physician", "@id": base + "/dr-kamran-saleem#physician", name: "Dr. Kamran Saleem", url: base + "/dr-kamran-saleem",
      image: base + "/assets/logo.webp", medicalSpecialty: ["Obstetric", "Urologic"], telephone: "+923148432789",
      description: "Fertility specialist and andrologist. MBBS (1988); Diploma in Genito-Urinary Medicine & Venereology, University of Liverpool (1998). PMDC registered.",
      worksFor: { "@id": url + "#clinic" } },
    { "@type": "BreadcrumbList", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: base + "/" },
      { "@type": "ListItem", position: 2, name: "Locations", item: base + "/locations" },
      { "@type": "ListItem", position: 3, name: "DHA Lahore", item: url } ] },
    { "@type": "FAQPage", mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) },
  ],
};
---
<Layout title={title} description={description}>
<link rel="canonical" href={url} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={base + "/assets/logo.webp"} />
<meta property="og:locale" content="en_PK" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="geo.region" content="PK-PB" />
<meta name="geo.placename" content="DHA, Lahore" />
<div class="ivf">
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<main>
<section class="hero"><div class="w hgrid">
  <div>
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/locations">Locations</a> / DHA Lahore</nav>
    <p class="eye"><svg viewBox="0 0 24 24" set:html={icons.pin} /> Rasheed Hospital · Main Boulevard · Defence</p>
    <h1>Fertility Clinic in DHA Lahore</h1>
    <p class="sub">Dr. Kamran Saleem, a UK-qualified fertility specialist and andrologist, consults at Rasheed Hospital on Main Boulevard. First visits run 45–60 minutes, so there is time to go through your history, earlier reports and any previous treatment.</p>
    <p><a class="btn" href={wa}>Book on WhatsApp</a> <a class="btn ghost" href={maps}>Get directions</a></p>
    <p class="mini">MBBS (1988) · Diploma, University of Liverpool (1998) · PMDC registered · 25+ years in reproductive health · <a href="/dr-kamran-saleem">About the doctor</a></p>
  </div>
  <div class="hside">
    <div class="pass" id="hours">
      <p class="passhead"><span class="ic dk"><svg viewBox="0 0 24 24" set:html={icons.pin} /></span> Rasheed Hospital, DHA</p>
      <ul class="facts">
        <li><svg viewBox="0 0 24 24" set:html={icons.building} /><span>Main Boulevard, Defence (Phase 5/6), Lahore</span></li>
        <li><svg viewBox="0 0 24 24" set:html={icons.parking} /><span>On-site parking for patients</span></li>
        <li><svg viewBox="0 0 24 24" set:html={icons.phone} /><span><a href="tel:+923148432789">+92 314 8432789</a></span></li>
      </ul>
      <div class="week" role="img" aria-label="Open Monday to Friday 3 PM to 6 PM. Closed Saturday and Sunday.">
        {["M","T","W","T","F"].map(d => <span class="on">{d}<b>3–6</b></span>)}<span>S<b>off</b></span><span>S<b>off</b></span>
      </div>
      <p class="passnote">Please message before travelling so we can confirm your slot.</p>
    </div>
  </div>
</div></section>

<div class="w layout">
  <aside class="toc" aria-label="On this page"><p>On this page</p>
    {toc.map(([id, l]) => <a href={`#${id}`}>{l}</a>)}
    <a class="btn sm" href={wa}>Book now</a>
  </aside>
  <div class="content">
    <p class="review"><b>Medically authored &amp; reviewed by</b> Dr. Kamran Saleem (MBBS 1988; Diploma, University of Liverpool 1998; PMDC registered) · Last updated November 2026</p>

    <section id="glance">
      <h2>Where is the fertility clinic in DHA Lahore?</h2>
      <p>Kamran Fertility Clinic sees patients at Rasheed Hospital, Main Boulevard, DHA Phase 5/6, Lahore. It serves couples from DHA Phases 1–9, Cantt, Cavalry Ground, Askari and Bedian Road, with semen analysis, female hormone tests (AMH, FSH, LH), ultrasound follicle monitoring, and treatment planning for PCOS, IUI, IVF and ICSI.</p>
      <div class="ovwrap">
        <p class="ovtitle">Clinic at a Glance</p>
        <div class="ovrow">
          {glance.map(([l, ic, t, h], i) => (
            <>
              <a class="ov" href={h}>
                <span class="ovl">{l}</span>
                <span class="disc"><svg viewBox="0 0 24 24" set:html={icons[ic]} /></span>
                <span class="ovt">{t}</span>
              </a>
              {i < glance.length - 1 ? <span class="chev" aria-hidden="true"><svg viewBox="0 0 36 22"><path d="M3 3l7 8-7 8M14 3l7 8-7 8M25 3l7 8-7 8" /></svg></span> : null}
            </>
          ))}
        </div>
      </div>
    </section>

    <section id="why">
      <h2>Doctor-led fertility care in DHA, Lahore</h2>
      <p>Reproductive care close to home matters when both partners have busy schedules. Our approach is unhurried evaluation, medical transparency and ethical care: we order only the investigations you need and build a plan around you, with no pressure to start treatment or have surgery.</p>
      <div class="cards">
        {why.map(([h, i, p]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p>{p}</p></div>)}
      </div>
    </section>

    <section id="services">
      <h2>Services at the DHA clinic</h2>
      <p>Assessment, cycle monitoring and treatment planning are available locally, so routine appointments do not need a trip across Lahore.</p>
      <div class="tw"><table>
        <thead><tr><th>Service</th><th>What is available</th><th>Learn more</th></tr></thead>
        <tbody>{services.map(([n, i, d, l]) => <tr><th scope="row"><svg class="ti" viewBox="0 0 24 24" set:html={icons[i]} />{n}</th><td>{d}</td><td set:html={l} /></tr>)}</tbody>
      </table></div>
    </section>

    <section id="areas">
      <h2>Areas we serve around Defence</h2>
      <p>Rasheed Hospital on Main Boulevard is convenient for residents across DHA and nearby neighbourhoods.</p>
      <div class="areas">
        <figure class="radar">
          <svg viewBox="0 0 320 320" role="img" aria-label="Diagram of areas served around Rasheed Hospital, DHA Lahore">
            <circle cx="160" cy="160" r="140" class="r3"/><circle cx="160" cy="160" r="96" class="r2"/><circle cx="160" cy="160" r="52" class="r1"/>
            <g class="spoke"><path d="M160 160L60 70M160 160L262 82M160 160L274 214M160 160L214 288M160 160L70 260"/></g>
            <g class="dot"><circle cx="60" cy="70" r="6"/><circle cx="262" cy="82" r="6"/><circle cx="274" cy="214" r="6"/><circle cx="214" cy="288" r="6"/><circle cx="70" cy="260" r="6"/></g>
            <g class="lbl"><text x="60" y="52" text-anchor="middle">Askari</text><text x="262" y="64" text-anchor="middle">Cantt</text><text x="276" y="240" text-anchor="end">Cavalry Ground</text><text x="214" y="310" text-anchor="middle">Bedian Road</text><text x="70" y="284" text-anchor="middle">DHA Phases 1–9</text></g>
            <g transform="translate(160 160)"><circle r="26" class="core"/><g transform="translate(-14 -15) scale(1.17)" class="mk" set:html={icons.pin} /></g>
          </svg>
          <figcaption>Areas served (schematic, not to scale)</figcaption>
        </figure>
        <div>
          <h3>DHA Lahore</h3>
          <ul class="tags">{dha.map(a => <li><svg viewBox="0 0 24 24" set:html={icons.pin} />{a}</li>)}</ul>
          <h3 style="margin-top:22px">Nearby</h3>
          <ul class="tags">{near.map(a => <li><svg viewBox="0 0 24 24" set:html={icons.pin} />{a}</li>)}</ul>
        </div>
      </div>
    </section>

    <section id="first-visit">
      <h2>What to expect at your first visit</h2>
      <ol class="steps">
        {steps.map(([h, i, p], n) => (
          <li class="step">
            <div class="media"><span class="ph"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span></div>
            <div><span class="num">Step {n + 1}</span><h3>{h}</h3><p>{p}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section id="find-us">
      <h2>Find us in DHA</h2>
      <div class="findgrid">
        <div>
          <ul class="tick loc">
            <li><svg viewBox="0 0 24 24" set:html={icons.pin} /><span><b>Rasheed Hospital</b><br />Main Boulevard, Defence, Lahore</span></li>
            <li><svg viewBox="0 0 24 24" set:html={icons.clock} /><span>Mon–Fri, 3:00 PM – 6:00 PM<br />Closed Saturday, Sunday and public holidays</span></li>
            <li><svg viewBox="0 0 24 24" set:html={icons.parking} /><span>On-site parking for patients</span></li>
            <li><svg viewBox="0 0 24 24" set:html={icons.chat} /><span>Booking by WhatsApp: <a href={wa}>+92 314 8432789</a></span></li>
          </ul>
          <a class="btn" href={maps}>Open in Google Maps</a>
        </div>
        <iframe title="Map of Rasheed Hospital, Main Boulevard, DHA Lahore" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=Rasheed+Hospital,+Main+Boulevard,+DHA+Defence,+Lahore&output=embed"></iframe>
      </div>
    </section>

    <section id="faq">
      <h2>Frequently Asked Questions</h2>
      {faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
    </section>
  </div>
</div>

<section class="cta" id="locations"><div class="w">
  <h2>Book your consultation in DHA Lahore</h2>
  <p>Take the first step toward clear, honest fertility answers close to home. Dr. Kamran Saleem also sees patients at two other Lahore clinics; hours differ at each.</p>
  <a class="btn" href={wa}>Message us on WhatsApp</a>
  <div class="cards c3 locs">
    {locations.map(([n, a, h, l, here]) => <a class="card link" href={l}><span class="ic dk"><svg viewBox="0 0 24 24" set:html={icons.pin} /></span><h3>{n}{here ? " (this page)" : ""}</h3><p>{a}</p><p class="hrs">{h}</p></a>)}
  </div>
  <p style="margin-top:22px"><a style="color:#fff" href="/locations">All locations</a> · <a style="color:#fff" href={S}>Assessment</a> · <a style="color:#fff" href={T}>Fertility treatment</a> · <a style="color:#fff" href="/services/support">Second opinions</a></p>
</div></section>
<p class="w legal">This page is general information, not a substitute for professional medical advice, diagnosis or treatment. Outcomes vary and no result is guaranteed.</p>
</main>
</div>
</Layout>

<style is:global>
  .ivf{--c-primary:#2563eb;--c-dark:#0b1f4b;--c-accent:#4cc9f0;--c-tint:#eef5ff;--c-bg:#fff;--c-text:#1e2a4a;--c-muted:#5b6b8c;--c-line:#dbe6f6;
    margin:0;background:var(--c-bg);color:var(--c-text);font:16px/1.7 Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
  .ivf *{box-sizing:border-box}
  .ivf a{color:var(--c-primary)}
  .ivf .w{max-width:1120px;margin:0 auto;padding:0 20px}
  .ivf h1,.ivf h2,.ivf h3{line-height:1.2;color:var(--c-dark);margin:0 0 .5em}
  .ivf h2{font-size:clamp(24px,3vw,32px);margin-top:0}
  .ivf svg{width:26px;height:26px;fill:none;stroke:var(--c-primary);stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex:none}
  .ivf :focus-visible{outline:3px solid var(--c-accent);outline-offset:3px;border-radius:6px}
  .ivf .btn{display:inline-block;background:linear-gradient(135deg,#3b82f6,#1d4ed8);box-shadow:0 6px 14px rgba(29,78,216,.28);color:#fff;padding:13px 24px;border-radius:999px;font-weight:600;text-decoration:none}
  .ivf .btn.sm{padding:8px 16px;font-size:14px}
  .ivf .btn.ghost{background:transparent;border:1.5px solid #fff;color:#fff;box-shadow:none}
  .ivf .hero{background:radial-gradient(circle at 85% 20%,#2f6df0 0,transparent 45%),linear-gradient(135deg,var(--c-dark),var(--c-primary));color:#fff;padding:48px 0 60px}
  .ivf .hero h1{color:#fff;font-size:clamp(32px,5vw,48px)}
  .ivf .hero a{color:#fff}
  .ivf .hgrid{display:grid;grid-template-columns:1.25fr 1fr;gap:40px;align-items:center}
  .ivf .crumb{font-size:13px;opacity:.85;margin-bottom:14px}
  .ivf .eye{display:flex;align-items:center;gap:8px;text-transform:uppercase;letter-spacing:.12em;font-size:12.5px;font-weight:700;color:var(--c-accent);margin:0 0 8px}
  .ivf .eye svg{width:18px;height:18px;stroke:var(--c-accent)}
  .ivf .sub{opacity:.92}.ivf .mini{font-size:13.5px;opacity:.85}
  .ivf .pass{background:#fff;color:var(--c-text);border-radius:20px;padding:24px;box-shadow:0 24px 50px -20px rgba(0,0,0,.5)}
  .ivf .passhead{display:flex;align-items:center;gap:12px;font-weight:700;font-size:18px;color:var(--c-dark);margin:0 0 14px}
  .ivf .facts{list-style:none;margin:0 0 16px;padding:0}
  .ivf .facts li{display:flex;gap:12px;align-items:center;padding:10px 0;border-top:1px solid var(--c-line);font-size:15px}
  .ivf .pass a{color:var(--c-primary)}
  .ivf .week{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}
  .ivf .week span{text-align:center;font-size:13px;padding:9px 0 7px;border-radius:10px;background:var(--c-tint);color:var(--c-muted)}
  .ivf .week span.on{background:linear-gradient(135deg,#3b82f6,#1d4ed8);color:#fff;font-weight:700}
  .ivf .week b{display:block;font-size:10.5px;font-weight:500;opacity:.9}
  .ivf .passnote{font-size:13px;color:var(--c-muted);margin:12px 0 0}
