      <p>Following proper testing preparation ensures maximum accuracy for your diagnostic panel:</p>
      <ol class="steps">
        {prep.map(([h, d], i) => (
          <li class="step">
            <div class="media"><span class="ph"><svg viewBox="0 0 24 24" set:html={icons[['clip','inject','flask','bolt','check'][i]]} /></span></div>
            <div class="body"><span class="num">Step {i + 1}</span><h3>{h}</h3><p>{d}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section id="pathways">
