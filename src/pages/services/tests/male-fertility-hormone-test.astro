        {related.map(([n, h, d]) => <a class="card link" href={h}><h3>{n}</h3><p>{d}</p></a>)}
      </div>
    </section>

    <section id="faq">
      <h2>Frequently Asked Questions</h2>
      {faqs.map(([q, ans]) => <details><summary>{q}</summary><p set:html={ans} /></details>)}
    </section>
  </div>
</div>

<section class="cta" id="locations"><div class="w">
  <h2>Book Your Male Fertility Hormone Test in Lahore</h2>
