---
import TreatmentPage from "../../../components/TreatmentPage.astro";

const T = "/services/fertility-treatment";
const A = "/services/assessment";

const page = {
  slug: "semen-analysis",
  name: "Semen Analysis Assessment",
  title: "Semen Analysis Test & Report Review | Kamran Fertility Clinic",
  description: "Book a semen analysis consultation or report review with Dr. Kamran Saleem. Understand sample instructions, sperm count, motility, morphology and next steps.",
  eyebrow: "Semen Analysis Assessment",
  h1: "Semen Analysis Assessment and Report Review",
  waText: "Hello, I would like to book a semen analysis assessment with Dr. Kamran Saleem.",
  ctaLabel: "Book an assessment",
  heroSub: [
    "A semen analysis evaluates features of a semen sample, such as sperm count, motility and shape, that may be relevant to fertility.",
    "The consultation can help you understand the test process, review an existing report, and discuss whether further evaluation is needed.",
  ].join(" "),
  leadIn: [
    { rich: ["This assessment is part of a wider fertility evaluation. The tests selected depend on your history, symptoms and previous results. Explore the related ", ["Fertility Assessment & Diagnosis", A], " pathway, or read the educational guide ", ["Understanding a Semen Analysis", "/resources/understanding-a-semen-analysis"], "."] },
  ],
  sections: [
    {
      id: "semen-analysis-purpose",
      title: "What a Semen Analysis Evaluates",
      intro: "The laboratory examines a semen sample using defined methods and reports several characteristics.",
      icon: "flask",
      body: [
        "A semen analysis commonly reports semen volume, sperm concentration or count, movement (motility) and shape (morphology). The report should be interpreted using the laboratory’s own reference information and your clinical history.",
        "The test is one part of a fertility evaluation. It does not by itself prove or rule out the ability to conceive.",
      ],
    },
    {
      id: "understanding-report-terms",
      title: "Common Terms in a Semen Report",
      intro: "Reports use technical words that can be confusing without context.",
      icon: "compare",
      body: [
        { ul: [
          "Volume: the amount of semen in the sample",
          "Concentration and total count: how many sperm are present",
          "Motility: the proportion of sperm that move, and how they move",
          "Morphology: the proportion of sperm with a typical shape",
          "Other findings such as pH, liquefaction, white blood cells or sperm agglutination, depending on the laboratory",
        ] },
        { rich: ["For a plain-language explanation, read ", ["Understanding a Semen Analysis", "/resources/understanding-a-semen-analysis"], "."] },
      ],
    },
    {
      id: "when-semen-analysis",
      title: "When a Semen Analysis May Be Requested",
      intro: "It is often considered when investigating difficulty conceiving or a known male reproductive concern.",
      icon: "calendar",
      body: [
        { ul: [
          "As part of an initial fertility evaluation, usually after 12 months of trying without conception",
          "Sooner when a partner is 35 or older or there is a known concern",
          "After a previous result that needs review",
          "When a clinician is assessing a relevant medical history",
          "To help decide whether further male fertility investigations are needed",
        ] },
      ],
    },
    {
      id: "sample-preparation",
      title: "Preparing to Provide a Sample",
      intro: "Follow the specific collection and abstinence instructions given by the laboratory.",
      icon: "clipboard",
      body: [
        { ul: [
          "Confirm the recommended abstinence period with the testing laboratory",
          "Use the collection container and method supplied or approved by the laboratory",
          "Tell the laboratory if any of the sample was lost during collection",
          "Follow instructions for delivery time and temperature",
          "Report recent fever or illness and relevant medicines",
        ] },
        "Samples that are incomplete, delayed or collected without following instructions can affect the result. If anything went wrong, tell the laboratory so the report can be read correctly.",
      ],
    },
    {
      id: "reviewing-semen-report",
      title: "How the Report Is Reviewed",
      intro: "A clinician considers the pattern of findings rather than one number in isolation.",
      icon: "compare",
      body: [
        "Semen parameters can vary between samples. Depending on the result and clinical context, repeat analysis or additional evaluation may be discussed.",
        { rich: ["For a broader work-up, see ", ["male infertility assessment", `${A}/male-infertility`], ". Other relevant pages include ", ["male fertility testing", `${A}/male-fertility-test`], " and ", ["hormonal analysis", `${A}/hormonal-analysis`], ". For educational background, read ", ["Male Fertility Test: What to Know", "/resources/male-fertility-test"], "."] },
      ],
    },
    {
      id: "after-semen-analysis",
      title: "What Happens After the Result",
      intro: "The next step depends on the report and the rest of your fertility evaluation.",
      icon: "route",
      body: [
        { ul: [
          "A result within the laboratory range may lead to a focus on other parts of the evaluation",
          "A borderline or abnormal result may lead to a repeat test",
          "Persistent abnormal findings may lead to examination, hormone tests or further investigation",
        ] },
        { rich: ["A partner may also benefit from a ", ["female fertility assessment", `${A}/female-fertility-test`], " or ", ["ovulation test", `${A}/ovulation-test`], ". If treatment becomes relevant, see our ", ["fertility treatment", T], " services."] },
      ],
    },
  ],
  faqs: [
    { q: "Does an abnormal semen analysis mean I cannot have children?", a: "Not necessarily. Results need to be interpreted in context, and further evaluation may clarify what they mean." },
    { q: "How should I prepare for semen analysis?", a: "Follow the laboratory’s instructions about abstinence, collection and sample delivery. Requirements can vary by laboratory." },
    { q: "Can a semen analysis diagnose every cause of infertility?", a: "No. It evaluates the sample but may not identify every underlying cause. Further assessment may be recommended." },
    { q: "Why might I need to repeat a semen analysis?", a: "Semen parameters vary from one sample to another, so a clinician may ask for a repeat test before drawing conclusions from one result." },
    { q: "How long does it take to get semen analysis results?", a: "This depends on the laboratory. Ask when you provide the sample, and bring the full report for review." },
    { q: "Can I get a report reviewed without a new test?", a: "Yes. Bring your existing report, including the laboratory name and date, and the clinician can discuss what it may mean and whether more testing is needed." },
  ],
  closingHeading: "Semen Analysis Review with Dr. Kamran Saleem",
  closingParas: [
    "Dr. Kamran Saleem can review your history and available reports, discuss whether this assessment is appropriate, and explain possible next steps. The exact tests and plan depend on your individual circumstances.",
    "You can ask about the consultation and any separate test fees before confirming an appointment.",
  ],
  resources: [
    { href: "/resources/understanding-a-semen-analysis", category: "Fertility Assessment", title: "Understanding a Semen Analysis" },
    { href: "/resources/male-fertility-test", category: "Fertility Assessment", title: "Male Fertility Test" },
    { href: "/resources/male--infertility-consultation", category: "Fertility Assessment", title: "Male Infertility Consultation" },
  ],
  close: {
    heading: "Need Help Choosing the Right Assessment?",
    body: "Bring your previous semen report and share your history when booking so the consultation can focus on your questions.",
    cta: "Book an assessment",
  },
};
---

<TreatmentPage {...page} />
