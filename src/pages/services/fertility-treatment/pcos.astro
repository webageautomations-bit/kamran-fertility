---
// src/pages/services/fertility-treatment/pcos.astro
// Uses the site's own menu/footer via Layout. Match the import path + props to TreatmentPage.astro.
import Layout from "../../../layouts/Layout.astro";
const base = "https://www.kamranfertility.com";
const T = "/services/fertility-treatment";
const url = `${base}${T}/pcos`;
const title = "PCOS Fertility Treatment in Lahore | Dr. Kamran Saleem";
const description = "PCOS fertility treatment in Lahore with UK-qualified Dr. Kamran Saleem. Letrozole ovulation induction, metabolic care and safe IVF. Book an unhurried consult.";
const wa = "https://wa.me/923148432789?text=" + encodeURIComponent("Hello, I would like to book a PCOS fertility consultation with Dr. Kamran Saleem.");

const icons = {
  flask: '<path d="M9 3h6M10 3v6l-5 9a2 2 0 002 3h10a2 2 0 002-3l-5-9V3"/>',
  inject: '<path d="M4 20l9-9M13 11l-2-2 5-5 4 4-5 5zM3 21l2-1"/>',
  bolt: '<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',
  target: '<circle cx="12" cy="12" r="4"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/>',
  cells: '<circle cx="8" cy="8" r="3"/><circle cx="16" cy="8" r="3"/><circle cx="12" cy="16" r="3"/>',
  merge: '<circle cx="9" cy="12" r="5"/><path d="M14 12h7M18 9l3 3-3 3"/>',
  heart: '<path d="M12 21s-7-4.5-7-10a4 4 0 017-2.6A4 4 0 0119 11c0 5.5-7 10-7 10z"/>',
  check: '<path d="M5 12l5 5 9-10"/>',
  clip: '<rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4h6v3H9zM9 12h6M9 16h6"/>',
  alert: '<path d="M12 3l10 18H2zM12 10v5M12 18h.01"/>',
  snow: '<path d="M12 2v20M4 7l16 10M20 7L4 17M9 4l3 2 3-2M9 20l3-2 3 2"/>',
  shield: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/>',
  dna: '<path d="M7 3c0 6 10 6 10 12s-10 6-10 6M17 3c0 6-10 6-10 12s10 6 10 6M8 8h8M8 16h8"/>',
  layers: '<path d="M12 3l9 5-9 5-9-5zM3 13l9 5 9-5"/>',
  calendar: '<rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/>',
  leaf: '<path d="M5 19c0-9 5-14 15-14 0 10-5 15-14 15M5 19l8-8"/>',
  scope: '<circle cx="10" cy="10" r="6"/><path d="M15 15l6 6M10 7v6M7 10h6"/>',
  drop: '<path d="M12 3s6 7 6 11a6 6 0 01-12 0c0-4 6-11 6-11z"/>',
  pulse: '<path d="M3 12h4l2-6 4 12 2-6h6"/>',
  skin: '<circle cx="12" cy="12" r="9"/><path d="M9 10h.01M15 10h.01M9 15c1.5 1.5 4.5 1.5 6 0"/>',
  scale: '<path d="M12 3v18M5 21h14M5 7h14M5 7l-3 7a3 3 0 006 0zM19 7l-3 7a3 3 0 006 0z"/>',
};

const toc = [["what-is-pcos","What is PCOS"],["understanding","How PCOS affects fertility"],["rotterdam","Diagnosis"],["symptoms","Beyond infertility"],["pcos-pathway","Care pathway"],["success-rates","Success rates"],["ohss-safety","OHSS safety"],["cost","Cost"],["faq","FAQ"]];

const overview = [
  { l: "Screening", h: "#step-1", art: '<rect x="37" y="14" width="26" height="7" rx="3" fill="#3b82f6" stroke="#0b1f4b" stroke-width="2"/><rect x="39" y="19" width="22" height="64" rx="11" fill="#e0eeff" stroke="#0b1f4b" stroke-width="3"/><rect x="42" y="44" width="16" height="36" rx="8" fill="#4cc9f0"/><circle cx="47" cy="56" r="2.5" fill="#ffffff"/><circle cx="54" cy="66" r="2" fill="#ffffff"/><circle cx="48" cy="74" r="2.5" fill="#ffffff"/>' },
  { l: "Metabolic Prep", h: "#step-2", art: '<circle cx="50" cy="50" r="40" fill="#3b82f6"/><path d="M50 20s18 20 18 34a18 18 0 01-36 0c0-14 18-34 18-34z" fill="#fff"/><path d="M42 56a8 8 0 008 8" stroke="#2563eb" stroke-width="3" fill="none" stroke-linecap="round"/>' },
  { l: "Ovulation Induction", h: "#step-3", art: '<circle cx="50" cy="50" r="32" fill="#fff" opacity=".75"/><circle cx="50" cy="50" r="18" fill="#60a5fa" stroke="#2563eb" stroke-width="2"/><circle cx="50" cy="50" r="7" fill="#0b1f4b"/>' },
  { l: "Advanced ART", h: "#step-4", art: '<circle cx="50" cy="50" r="38" fill="#fff" opacity=".7"/><g fill="#93c5fd" stroke="#2563eb" stroke-width="2"><circle cx="36" cy="38" r="11"/><circle cx="60" cy="34" r="11"/><circle cx="68" cy="56" r="11"/><circle cx="46" cy="66" r="11"/><circle cx="31" cy="58" r="11"/><circle cx="50" cy="50" r="11"/></g><g fill="#0b1f4b"><circle cx="36" cy="38" r="4"/><circle cx="60" cy="34" r="4"/><circle cx="68" cy="56" r="4"/><circle cx="46" cy="66" r="4"/><circle cx="31" cy="58" r="4"/><circle cx="50" cy="50" r="4"/></g>' },
];

const steps = [
  { t: "Endocrine & metabolic screening", time: "Cycle Day 2 or 3", icon: "clip", d: `Hormones (FSH, LH with LH:FSH ratio, AMH, estradiol, prolactin, TSH), androgens (total and free testosterone, DHEAS, SHBG), metabolic tests (fasting glucose, fasting insulin with HOMA-IR, HbA1c, lipids) and a transvaginal scan. See our <a href="/services/assessment/hormonal-analysis">hormonal analysis</a> service.` },
  { t: "Lifestyle, metabolic & glycemic optimization", time: "4–12 weeks", icon: "leaf", d: "Myo-inositol with D-chiro-inositol (commonly used in a 40:1 ratio), metformin where insulin resistance or high BMI is confirmed, and a low-glycemic Mediterranean diet with regular activity. A modest 5–10% weight loss can restore ovulation in many women who are overweight." },
  { t: "Targeted ovulation induction", time: "Cycle Days 3–7 onward", icon: "inject", d: `Letrozole is the first-line drug, with low-dose step-up FSH if oral drugs fail. 2–3 ultrasounds track a lead follicle to 18–22 mm, then an hCG trigger and timed intercourse over 36–48 hours. Full details on our <a href="${T}/ovulation-induction">ovulation induction</a> page.` },
  { t: "Advanced ART progression", time: "After 3–6 ovulatory cycles", icon: "layers", d: `If pregnancy has not occurred, or male or tubal factors exist, care moves to <a href="${T}/iui">IUI</a> or <a href="${T}/ivf">IVF</a>/<a href="${T}/icsi">ICSI</a> with a GnRH agonist trigger and freeze-all strategy, followed by <a href="${T}/fet">frozen embryo transfer</a>.` },
];

const rotterdam = [
  ["1. Oligo-ovulation or anovulation", "Cycles longer than 35 days, unpredictable bleeding or no periods (amenorrhea)", "Cycle tracking, Day 21 serum progesterone"],
  ["2. Hyperandrogenism (clinical or biochemical)", "Excess facial or body hair (hirsutism), persistent adult acne or thinning scalp hair", "Free and total testosterone, DHEAS, SHBG, Ferriman-Gallwey score"],
  ["3. Polycystic ovarian morphology", "20 or more antral follicles per ovary, or ovarian volume above 10 mL", "High-resolution transvaginal ultrasound"],
];

const symptoms = [
  ["Anovulatory infertility", "Irregular or absent egg release prevents natural conception.", "calendar"],
  ["Insulin resistance", "Over 65% of women with PCOS show insulin resistance. High insulin drives ovarian androgens and worsens anovulation.", "drop"],
  ["Skin changes", "Hirsutism, persistent acne and acanthosis nigricans (dark, velvety patches on the neck, armpits or groin).", "skin"],
  ["Metabolic & heart risks", "Higher risk of type 2 diabetes, abnormal lipids, fatty liver and gestational diabetes.", "pulse"],
  ["Endometrial protection", "Long gaps without ovulation leave the lining exposed to estrogen alone, raising the risk of endometrial hyperplasia.", "layers"],
  ["Often excellent reserve", "PCOS usually means abundant eggs, so the long-term outlook is good when treatment is managed safely.", "heart"],
];

const whyCards = [
  ["High LH and insulin", "Raised LH and hyperinsulinemia stop a single follicle from maturing normally.", "bolt"],
  ["\"String of pearls\"", "Many small follicles (2–9 mm) collect at the ovary's edge without releasing an egg.", "cells"],
  ["Multi-system condition", "PCOS affects follicles, cycles, insulin sensitivity and overall hormone balance.", "dna"],
];

const rates = [
  ["Letrozole induction + timed intercourse", "75% – 85%", "18% – 22%", "55% – 65%", "First-line; high single-follicle ovulation and good lining"],
  ["Induction + IUI", "80% – 88%", "18% – 24%", "50% – 60%", "Useful with mild male factor or cervical hostility"],
  ["IVF / ICSI (freeze-all FET)", "Egg retrieval", "42% – 50%", "70% – 82%", "High egg yield; strong cumulative results with blastocyst transfers"],
];

const safety = [
  ["Low starting doses", "We begin with the smallest effective medication dose.", "scale"],
  ["Mandatory ultrasound monitoring", "A trigger is withheld or the cycle cancelled if more than 3 mature follicles develop in a non-IVF cycle.", "scope"],
  ["GnRH agonist trigger", "In IVF, this replaces hCG and greatly reduces OHSS risk.", "bolt"],
  ["Freeze-all strategy", `All embryos are vitrified and transferred later in a <a href="${T}/fet">natural or prepared FET cycle</a>.`, "snow"],
];

const costRows = [
  ["Consultation", "Fee confirmed before your appointment"],
  ["Oral ovulation induction package", "An affordable first step compared with immediate IVF"],
  ["Monitoring and diagnostics", "Itemized ultrasound tracking, metabolic blood work and hormone tests, with no hidden fees"],
];

const faqs = [
  ["Can I get pregnant naturally with PCOS?", "Yes. Many women with mild PCOS ovulate spontaneously and conceive naturally. When ovulation is irregular or absent, first-line treatment with Letrozole restores regular egg release in most women, often without any invasive procedure."],
  ["Why is Letrozole preferred over Clomid for PCOS?", "Large international trials show Letrozole gives higher ovulation and live birth rates and fewer twin pregnancies than Clomiphene in women with PCOS. It also avoids the anti-estrogen effects of Clomiphene on the uterine lining and cervical mucus."],
  ["What does Metformin do for PCOS fertility?", "Metformin improves how cells use glucose and lowers circulating insulin. Lower insulin means less ovarian androgen production, which helps restore regular cycles and improves response to ovulation medicines."],
  ["Does losing weight help PCOS fertility?", "Yes, for women who are overweight. Losing 5–10% of body weight can lower androgens and restore ovulation in many women. Women with a healthy weight are treated for insulin resistance and ovulation without any weight advice."],
  ["How many Letrozole cycles should I try?", "Usually 3 to 6 ovulatory cycles. If you have not conceived by then, or if male or tubal factors are found, Dr. Kamran reviews your plan and may advise IUI or IVF."],
  ["Is IVF safe with PCOS?", "Yes, with the right protocol. Low-dose stimulation, a GnRH agonist trigger and a freeze-all approach greatly reduce the risk of ovarian hyperstimulation syndrome (OHSS)."],
];

const treatments = [
  ["Ovulation Induction", "ovulation-induction", "Letrozole and low-dose FSH with follicle tracking."],
  ["IUI Treatment", "iui", "Washed sperm placed in the uterus around ovulation."],
  ["IVF Treatment", "ivf", "A safe freeze-all approach for high responders."],
  ["Frozen Embryo Transfer", "fet", "Transfer in a prepared cycle with no OHSS risk."],
  ["Male Infertility Treatment", "male-infertility", "Testing and treatment when male factor co-exists."],
  ["PGT Genetic Testing", "pgt", "Screen blastocysts for chromosome errors."],
];

const locations = [
  ["Rasheed Hospital", "Main Boulevard, DHA Defence", "Daily 3:00pm–6:00pm (Sat & Sun closed)", "/locations/dha-lahore"],
  ["TAMC", "M.M. Alam Road, Gulberg", "Wednesday 12:00pm–3:00pm, other days by appointment", "/locations/mm-alam-road-lahore"],
  ["Shahnaz Hospital", "Shalamar Link Road", "Monday & Thursday 6:00pm–9:00pm", "/locations/shalamar-lahore"],
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "MedicalWebPage", "@id": url, url, name: title, description, inLanguage: "en-PK", lastReviewed: "2026-11",
      reviewedBy: { "@type": "Physician", name: "Dr. Kamran Saleem" }, about: { "@id": url + "#condition" } },
    { "@type": "MedicalCondition", "@id": url + "#condition", name: "Polycystic Ovary Syndrome (PCOS)", alternateName: "PCOS infertility",
      description: "An endocrine and metabolic disorder marked by irregular ovulation, raised androgens and polycystic ovarian morphology, and a leading cause of anovulatory infertility.",
      possibleTreatment: [{ "@type": "MedicalTherapy", name: "Letrozole ovulation induction" }, { "@type": "MedicalTherapy", name: "Metformin and inositol therapy" }, { "@type": "MedicalProcedure", name: "IVF with freeze-all strategy" }] },
    { "@type": "Physician", "@id": base + "/dr-kamran-saleem#physician", name: "Dr. Kamran Saleem", alumniOf: "University of Liverpool", identifier: "PMDC Registered", medicalSpecialty: "Reproductive Endocrinology and Infertility" },
    { "@type": "MedicalClinic", "@id": base + "/#clinic", name: "Kamran Fertility Clinic", url: base, telephone: "+923148432789",
      location: ["Rasheed Hospital (DHA Defence)", "TAMC Clinic (M.M. Alam Road, Gulberg)", "Shahnaz Hospital (Shalamar Link Road)"].map(n => ({ "@type": "Place", name: n, address: { "@type": "PostalAddress", addressLocality: "Lahore", addressRegion: "Punjab", addressCountry: "PK" } })) },
    { "@type": "BreadcrumbList", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: base + "/" },
      { "@type": "ListItem", position: 2, name: "Fertility Treatment", item: base + T },
      { "@type": "ListItem", position: 3, name: "PCOS Fertility Treatment", item: url } ] },
    { "@type": "FAQPage", mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) },
  ],
};
---
<Layout title={title} description={description}>
<div class="ivf">
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<main>
<section class="hero"><div class="w hgrid">
  <div>
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href={T}>Fertility Treatment</a> / PCOS</nav>
    <p class="eye">Doctor-led · Evidence-based · Lahore</p>
    <h1>PCOS Fertility Treatment in Lahore</h1>
    <p class="sub">Polycystic ovary syndrome (PCOS) is the most common cause of ovulation problems in women. With a Rotterdam-based diagnosis, metabolic care and first-line Letrozole <a href={`${T}/ovulation-induction`}>ovulation induction</a>, most women with PCOS ovulate, and many conceive within 3 to 6 cycles. Dr. Kamran Saleem starts with the gentlest effective step and moves to <a href={`${T}/iui`}>IUI</a> or <a href={`${T}/ivf`}>IVF</a> only when you need it.</p>
    <p><a class="btn" href={wa}>Book a PCOS consultation</a> <a class="btn ghost" href="#pcos-pathway">See the care pathway</a></p>
    <p class="mini">Start with a <a href="/services/assessment/hormonal-analysis">hormonal analysis</a> or a full <a href="/services/assessment">fertility assessment</a>.</p>
  </div>
  <div class="hside">
    <ul class="facts">
      <li><b>75–80%+</b> of women with PCOS ovulate on treatment</li>
      <li><b>55–65%</b> cumulative pregnancy in 3–6 cycles</li>
      <li><b>25+</b> years in reproductive health</li>
      <li><b>3</b> Lahore locations</li>
    </ul>
  </div>
</div></section>

<div class="w layout">
  <aside class="toc" aria-label="On this page"><p>On this page</p>
    {toc.map(([id, l]) => <a href={`#${id}`}>{l}</a>)}
    <a class="btn sm" href={wa}>Book now</a>
  </aside>
  <div class="content">
    <p class="review"><b>Medically reviewed:</b> Dr. Kamran Saleem (MBBS 1988; UK Dip GUM &amp; Ven, University of Liverpool 1998; PMDC registered) · Follows ESHRE/ASRM PCOS guidelines and Rotterdam criteria · Last review November 2026 · <a href="/dr-kamran-saleem">About the doctor</a></p>

    <section id="what-is-pcos">
      <h2>What Is PCOS Fertility Management?</h2>
      <p>PCOS is a complex endocrine and metabolic condition with hormone imbalance, irregular or absent ovulation, raised androgens and polycystic-looking ovaries. It is the leading cause of anovulatory infertility. With a careful diagnosis, metabolic therapy (metformin or inositols) and first-line Letrozole induction, over 75% to 80% of women with PCOS ovulate, and cumulative pregnancy rates reach 55% to 65% within 3 to 6 cycles.</p>
      <div class="cards">
        {whyCards.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p>{p}</p></div>)}
      </div>
    </section>

    <section id="understanding">
      <h2>How PCOS Affects Fertility</h2>
      <p>PCOS affects an estimated 15% to 20% of women of reproductive age in Pakistan. It is not an isolated fertility problem. It changes follicle development, menstrual regularity, insulin sensitivity and hormone balance together.</p>
      <p>In a normal cycle, FSH from the pituitary gland makes one dominant follicle mature and release an egg. In PCOS, high LH and high insulin disrupt that process. Instead of one follicle maturing, many small ones (2–9 mm) gather along the ovary's edge, giving the classic "string of pearls" look on ultrasound, and no egg is released.</p>
      <div class="callout"><b>Good news.</b> PCOS usually comes with a large egg supply. When ovulation is restored safely, the long-term chance of pregnancy is excellent.</div>
    </section>

    <section id="rotterdam">
      <h2>How PCOS Is Diagnosed: Rotterdam Criteria</h2>
      <p>PCOS is diagnosed when at least two of these three criteria are present, after other causes such as thyroid disease and high prolactin have been excluded.</p>
      <div class="tw"><table>
        <thead><tr><th>Criterion</th><th>What we look for</th><th>How we test</th></tr></thead>
        <tbody>{rotterdam.map(r => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td></tr>)}</tbody>
      </table></div>
      <p class="note">Not sure which applies to you? A <a href="/services/assessment/hormonal-analysis">hormonal analysis</a> and scan usually give the answer in one visit.</p>
    </section>

    <section id="symptoms">
      <h2>PCOS Beyond Infertility</h2>
      <p>PCOS affects more than fertility, so treatment looks at your whole health.</p>
      <div class="cards">
        {symptoms.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p>{p}</p></div>)}
      </div>
    </section>

    <section id="pcos-pathway">
      <h2>The PCOS Care Pathway, Step by Step</h2>
      <p>Treatment follows four phases that favor natural ovulation, metabolic health and safety. Most women progress only as far as they need to.</p>
      <div class="ovwrap">
        <p class="ovtitle">PCOS Care at a Glance</p>
        <div class="ovrow">
          {overview.map((o, i) => (
            <>
              <a class="ov" href={o.h}>
                <span class="ovl">{o.l}</span>
                <span class="disc"><svg viewBox="0 0 100 100" set:html={o.art} /></span>
                <span class="ovn">{i + 1}</span>
              </a>
              {i < overview.length - 1 ? <span class="chev" aria-hidden="true"><svg viewBox="0 0 36 22"><path d="M3 3l7 8-7 8M14 3l7 8-7 8M25 3l7 8-7 8" /></svg></span> : null}
            </>
          ))}
        </div>
        <p class="ovhint">Select a stage to jump to its full explanation below.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step" id={`step-${i + 1}`}>
            <div class="media"><span class="ph"><svg viewBox="0 0 24 24" set:html={icons[s.icon]} /></span></div>
            <div class="body"><span class="num">Phase {i + 1} · {s.time}</span><h3>{s.t}</h3><p set:html={s.d} /></div>
          </li>
        ))}
      </ol>
    </section>

    <section id="success-rates">
      <h2>Pregnancy Success Rates With PCOS</h2>
      <p>Because PCOS usually means abundant eggs, outcomes are excellent when stimulation is managed safely.</p>
      <div class="tw"><table>
        <thead><tr><th>Treatment</th><th>Ovulation rate</th><th>Pregnancy per cycle</th><th>Cumulative (3–6 cycles)</th><th>Key points</th></tr></thead>
        <tbody>{rates.map(r => <tr>{r.map(c => <td>{c}</td>)}</tr>)}</tbody>
      </table></div>
      <ul class="tick">
        <li>Letrozole is the first choice because it gives high single-follicle ovulation with a healthy lining</li>
        <li>Adding IUI helps when mild male factor or cervical mucus problems exist</li>
        <li>IVF with freeze-all gives the highest cumulative success for women who need it</li>
      </ul>
      <p class="note">Outcomes vary with age, weight, partner factors and other conditions. No result is guaranteed.</p>
    </section>

    <section id="ohss-safety">
      <h2>OHSS Safety for High-Responder PCOS Patients</h2>
      <p>PCOS ovaries carry many follicles, so aggressive or unmonitored stimulation can cause ovarian hyperstimulation syndrome (OHSS). Our protocols are built to prevent it.</p>
      <div class="cards">
        {safety.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p set:html={p} /></div>)}
      </div>
      <div class="callout"><b>Safety rule.</b> If more than 3 mature follicles develop in a non-IVF cycle, the trigger is withheld or the cycle is converted to IVF to prevent a multiple pregnancy.</div>
    </section>

    <section id="cost">
      <h2>PCOS Treatment Cost in Lahore: Transparent Fees</h2>
      <p>Fees are explained clearly before treatment starts. Oral ovulation induction costs far less than IVF, which is why it is the first step. For comparison see <a href="/resources/ivf-treatment-cost-in-pakistan">IVF treatment cost in Pakistan</a>.</p>
      <div class="tw"><table>
        <thead><tr><th>Item</th><th>What to expect</th></tr></thead>
        <tbody>{costRows.map(r => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td></tr>)}</tbody>
      </table></div>
    </section>

    <section id="faq">
      <h2>Frequently Asked Questions</h2>
      {faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
    </section>
  </div>
</div>

<section class="band"><div class="w">
  <h2>Related fertility treatments</h2>
  <div class="cards c3">
    {treatments.map(([n, s, d]) => <a class="card link" href={`${T}/${s}`}><h3>{n}</h3><p>{d}</p></a>)}
  </div>
  <p><a href={T}>See all fertility treatments →</a> · <a href="/services/assessment/hormonal-analysis">Hormonal analysis</a> · <a href="/services/assessment/semen-analysis">Semen analysis</a> · <a href="/services/support">Support &amp; Second Opinions</a></p>
</div></section>

<section class="cta"><div class="w">
  <h2>Schedule Your Unhurried PCOS Consultation</h2>
  <p>Overcoming PCOS-related fertility problems starts with an accurate diagnosis and a plan built around you. Dr. Kamran Saleem gives you 45–60 minutes. Bring prior scans, hormone reports and menstrual cycle records. WhatsApp +92 314 8432789.</p>
  <a class="btn" href={wa}>Book a PCOS Consultation</a>
  <div class="cards c3 locs">
    {locations.map(([n, a, h, l]) => <a class="card link" href={l}><h3>{n}</h3><p>{a}</p><p class="hrs">{h}</p></a>)}
  </div>
</div></section>
</main>
</div>
</Layout>

<style is:global>
  .ivf{--c-primary:#2563eb;--c-dark:#0b1f4b;--c-accent:#4cc9f0;--c-tint:#eef5ff;--c-bg:#fff;--c-text:#1e2a4a;--c-muted:#5b6b8c;--c-line:#dbe6f6;
    margin:0;background:var(--c-bg);color:var(--c-text);font:16px/1.7 Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
  .ivf *{box-sizing:border-box}
  .ivf a{color:var(--c-primary)}
  .ivf .w{max-width:1120px;margin:0 auto;padding:0 20px}
  .ivf h1,.ivf h2,.ivf h3{line-height:1.2;color:var(--c-dark);margin:0 0 .5em}
  .ivf h2{font-size:clamp(24px,3vw,32px);margin-top:0}
  .ivf .content h3{font-size:19px;margin-top:22px}
