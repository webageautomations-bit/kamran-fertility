---
// src/pages/services/fertility-treatment/iui.astro
// Uses the site's own menu/footer via Layout. Match the import path + props to TreatmentPage.astro.
import Layout from "../../../layouts/Layout.astro";
const base = "https://www.kamranfertility.com";
const T = "/services/fertility-treatment";
const url = `${base}${T}/iui`;
const title = "IUI Treatment in Lahore | Success Rates, Cost & Process | Dr. Kamran Saleem";
const description = "Consult UK-qualified fertility specialist Dr. Kamran Saleem for Intrauterine Insemination (IUI) in Lahore. Clear success rates, transparent cost breakdown, and unhurried care across DHA, M.M. Alam Rd & Shalamar.";
const wa = "https://wa.me/923148432789?text=" + encodeURIComponent("Hello, I would like to book an IUI consultation with Dr. Kamran Saleem.");

const icons = {
  flask: '<path d="M9 3h6M10 3v6l-5 9a2 2 0 002 3h10a2 2 0 002-3l-5-9V3"/>',
  inject: '<path d="M4 20l9-9M13 11l-2-2 5-5 4 4-5 5zM3 21l2-1"/>',
  bolt: '<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',
  target: '<circle cx="12" cy="12" r="4"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/>',
  cells: '<circle cx="8" cy="8" r="3"/><circle cx="16" cy="8" r="3"/><circle cx="12" cy="16" r="3"/>',
  merge: '<circle cx="9" cy="12" r="5"/><path d="M14 12h7M18 9l3 3-3 3"/>',
  heart: '<path d="M12 21s-7-4.5-7-10a4 4 0 017-2.6A4 4 0 0119 11c0 5.5-7 10-7 10z"/>',
  check: '<path d="M5 12l5 5 9-10"/>',
  clip: '<rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4h6v3H9zM9 12h6M9 16h6"/>',
  alert: '<path d="M12 3l10 18H2zM12 10v5M12 18h.01"/>',
};

const toc = [["what-is-iui","What is IUI"],["iui-vs-ivf","IUI vs IVF vs ICSI"],["who-needs-iui","Who needs IUI"],["not-recommended","When not advised"],["iui-process","Step by step"],["natural-vs-stimulated","Natural vs stimulated"],["success-rates","Success rates"],["ethics","Ethics"],["cost","Cost"],["faq","FAQ"]];

const overview = [
  { l: "Tests & Diagnosis", h: "#step-1", art: '<rect x="37" y="14" width="26" height="7" rx="3" fill="#3b82f6" stroke="#0b1f4b" stroke-width="2"/><rect x="39" y="19" width="22" height="64" rx="11" fill="#e0eeff" stroke="#0b1f4b" stroke-width="3"/><rect x="42" y="44" width="16" height="36" rx="8" fill="#4cc9f0"/><circle cx="47" cy="56" r="2.5" fill="#ffffff"/><circle cx="54" cy="66" r="2" fill="#ffffff"/><circle cx="48" cy="74" r="2.5" fill="#ffffff"/>' },
  { l: "Ovulation Stimulation", h: "#step-2", art: '<g transform="rotate(-40 52 46)"><rect x="30" y="39" width="38" height="14" rx="3" fill="#fff" stroke="#0b1f4b" stroke-width="2.5"/><rect x="44" y="39" width="14" height="14" fill="#3b82f6" stroke="#0b1f4b" stroke-width="2"/><rect x="68" y="43" width="14" height="6" fill="#fff" stroke="#0b1f4b" stroke-width="2.5"/><rect x="82" y="37" width="4" height="18" rx="2" fill="#0b1f4b"/><path d="M30 46H16" stroke="#0b1f4b" stroke-width="2"/></g><rect x="22" y="76" width="26" height="11" rx="5.5" fill="#fff" stroke="#0b1f4b" stroke-width="2.5"/><path d="M35 76v11" stroke="#0b1f4b" stroke-width="2"/><rect x="54" y="80" width="22" height="10" rx="5" fill="#0b1f4b"/>' },
  { l: "Monitoring & Trigger", h: "#step-3", art: '<circle cx="50" cy="50" r="32" fill="#fff" opacity=".75"/><circle cx="50" cy="50" r="18" fill="#60a5fa" stroke="#2563eb" stroke-width="2"/><circle cx="50" cy="50" r="7" fill="#0b1f4b"/>' },
  { l: "Sperm Preparation", h: "#step-4", art: '<circle cx="50" cy="50" r="40" fill="#3b82f6"/><g fill="#fff"><ellipse cx="30" cy="34" rx="6" ry="4"/><ellipse cx="62" cy="48" rx="6" ry="4"/><ellipse cx="34" cy="66" rx="6" ry="4"/></g><g stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round"><path d="M36 34q8-6 14 0t14 0"/><path d="M68 48q8-6 12 0"/><path d="M40 66q8-6 14 0t12 0"/></g>' },
  { l: "Insemination", h: "#step-5", art: '<circle cx="50" cy="50" r="38" fill="#fff" stroke="#2563eb" stroke-width="5"/><circle cx="44" cy="52" r="11" fill="#fff" stroke="#0b1f4b" stroke-width="2"/><circle cx="44" cy="52" r="3.5" fill="#0b1f4b"/><path d="M62 38l11-6M64 48l13-2M62 58l11 5" stroke="#0b1f4b" stroke-width="1.8" stroke-linecap="round"/>' },
  { l: "Luteal Support & Test", h: "#step-6", art: '<circle cx="50" cy="50" r="38" fill="#fff" opacity=".7"/><g fill="#93c5fd" stroke="#2563eb" stroke-width="2"><circle cx="36" cy="38" r="11"/><circle cx="60" cy="34" r="11"/><circle cx="68" cy="56" r="11"/><circle cx="46" cy="66" r="11"/><circle cx="31" cy="58" r="11"/><circle cx="50" cy="50" r="11"/></g><g fill="#0b1f4b"><circle cx="36" cy="38" r="4"/><circle cx="60" cy="34" r="4"/><circle cx="68" cy="56" r="4"/><circle cx="46" cy="66" r="4"/><circle cx="31" cy="58" r="4"/><circle cx="50" cy="50" r="4"/></g>' },
];

const steps = [
  { t: "Diagnostic workup", time: "Before the cycle", icon: "clip", d: `Tubal patency (HSG or HyCoSy), a Day 2/3 ultrasound with antral follicle count, a hormone panel (AMH, FSH, LH, estradiol, TSH, prolactin) and a <a href="/services/assessment/semen-analysis">semen analysis</a> with wash yield.` },
  { t: "Ovulation protocol", time: "Days 3–7", icon: "inject", d: `Either a natural cycle, or Letrozole (2.5–5 mg) or Clomiphene (50–100 mg) for 5 days to grow 1–2 follicles. Low-dose injectable FSH is added in select cases. See <a href="${T}/ovulation-induction">ovulation induction</a>.` },
  { t: "Follicle monitoring & trigger", time: "Days 10–14", icon: "bolt", d: "Serial ultrasounds track follicles toward 18–22 mm and a lining over 7.5 mm with a triple-line pattern. An hCG trigger then induces ovulation." },
  { t: "Sperm preparation", time: "Day of IUI", icon: "flask", d: "After 2–4 days of abstinence, density-gradient centrifugation and swim-up isolate the most motile, normal sperm in 0.3–0.5 mL of culture medium." },
  { t: "Insemination", time: "Under 5 minutes", icon: "target", d: "A soft, flexible catheter places the prepared sperm in the upper uterine cavity. You rest 10–15 minutes, then resume light daily activity." },
  { t: "Luteal support & pregnancy test", time: "14 days later", icon: "check", d: "Progesterone supports the lining for 14 days, followed by a quantitative blood Beta-hCG test." },
];

const advantages = [
  ["Bypasses cervical mucus", "Removes a barrier that can trap sperm because of antisperm antibodies, infection or anatomical change.", "check"],
  ["Shorter sperm journey", "Sperm are placed close to the tubes, so more viable sperm reach the egg.", "target"],
  ["Laboratory washing", "Removes seminal fluid, prostaglandins and debris that would cause painful cramping if placed in the uterus.", "flask"],
  ["Precise timing", "Insemination is synchronized with an hCG trigger or LH surge for the freshly released egg.", "bolt"],
];

const compare = [
  ["Main indication", "Mild male factor, cervical factor, unexplained subfertility", "Tubal blockage, endometriosis, unexplained infertility", "Severe male factor, failed IVF"],
  ["Fertilization", "Natural, inside the fallopian tube", "Natural, in a laboratory dish", "One sperm injected into the egg"],
  ["Sperm needed", "Adequate count and motility", "Moderate to high count", "One viable sperm per egg"],
  ["Invasiveness", "Non-surgical, no anesthesia", "Surgical egg retrieval", "Egg retrieval plus micromanipulation"],
];

const suit = [
  ["Fallopian tubes", "At least one open, healthy tube (HSG or HyCoSy)", "Both tubes blocked, hydrosalpinx or adhesions"],
  ["Sperm", "Post-wash total motile count above 5 million", "Severe oligospermia, azoospermia or severe teratozoospermia"],
  ["Ovulation", "Normal, or PCOS that responds to oral drugs", "Ovarian failure or no response to stimulation"],
  ["Uterus", "Normal cavity", "Large fibroids, Asherman's syndrome or unmanaged polyps"],
  ["History", "New to treatment, or after timed intercourse", "Several failed IUI cycles"],
];

const who = [
  ["Mild male factor", `Slightly reduced count, motility or volume where washing still yields enough motile sperm. See <a href="${T}/male-infertility">male infertility treatment</a>.`, "cells"],
  ["Unexplained subfertility", "Normal semen analysis and open tubes, with no conception after 12+ months.", "heart"],
  ["Cervical factor", "Hostile or scanty mucus, cervical stenosis or prior cervical surgery (conization/LEEP).", "merge"],
  ["PCOS & ovulation problems", "Ovulation induction combined with precisely timed insemination.", "inject"],
  ["Sexual or ejaculatory difficulty", "Erectile dysfunction, retrograde ejaculation or severe vaginismus.", "clip"],
];

const avoid = [
  ["Both tubes blocked", `Sperm cannot meet the egg in the tube, so <a href="${T}/ivf">IVF</a> is required.`],
  ["Severe male factor", `Total motile count under 5 million after washing, or DNA fragmentation above 30%. These cases need <a href="${T}/icsi">ICSI</a>.`],
  ["Stage III–IV endometriosis", "Distorts the pelvis and damages tubal movement."],
  ["Age over 38–40 or low AMH", "AMH below 0.8 ng/mL or advanced age makes IVF with blastocyst culture the better path."],
  ["Active pelvic infection", "Any uterine or cervical infection must be fully treated first."],
];

const cycles = [
  ["Natural cycle", "LH surge tracking, no drugs", "8% – 12%", "Under 1%", "Cervical factor, physical difficulty, young women"],
  ["Letrozole", "2.5–5 mg for 5 days plus hCG", "14% – 18%", "3% – 5% twins", "PCOS, anovulation, unexplained"],
  ["Low-dose FSH", "Injections plus hCG", "18% – 22%", "8% – 12% twins", "Failed oral cycles, older age, close monitoring"],
];

const rates = [
  ["Under 35", "15% – 20%", "12% – 18%", "38% – 48%", "Mild stimulation for 1–2 follicles"],
  ["35 – 37", "12% – 16%", "10% – 14%", "28% – 36%", "Careful follicle tracking"],
  ["38 – 40", "6% – 10%", "5% – 8%", "15% – 22%", "Maximum 2–3 cycles, then IVF"],
  ["Over 40", "2% – 5%", "1% – 3%", "Under 8%", "Early move to IVF or ICSI"],
];

const faqs = [
  ["Is IUI painful?", "IUI is virtually painless. You may feel brief discomfort as the soft catheter passes through the cervix, similar to a routine pelvic exam. No anesthesia or sedation is needed."],
  ["How many IUI cycles should we try before moving to IVF?", "Usually up to 3 well-timed cycles. If pregnancy has not occurred, Dr. Kamran re-evaluates the diagnosis and advises IVF or ICSI."],
  ["What sperm count is needed for IUI?", "A post-wash total motile sperm count of 10 million or more gives the best results. Pregnancy is possible between 5 and 10 million, and below 5 million ICSI is preferred."],
  ["Do I need bed rest after IUI?", "No. Rest on the table for 10 to 15 minutes, then resume normal daily activity, work and light walking. Prolonged bed rest does not raise success."],
  ["How is IUI different from IVF?", "IUI places washed sperm in the uterus and fertilization happens naturally in the tube. IVF fertilizes eggs in the laboratory and transfers an embryo, with higher success per cycle."],
  ["Can IUI cause twins or triplets?", "In a natural cycle the risk is similar to natural conception. Medicated cycles raise the chance of twins, so ultrasound monitoring ensures the trigger is given only when 1 to 2 lead follicles develop."],
];

const treatments = [
  ["IVF Treatment", "ivf", "For blocked tubes, age or failed IUI."],
  ["ICSI", "icsi", "One sperm injected into an egg for severe male factor."],
  ["Ovulation Induction & PCOS", "ovulation-induction", "Medication and monitoring to restore ovulation."],
  ["Male Infertility Treatment", "male-infertility", "Testing and treatment for low count and hormonal causes."],
  ["Frozen Embryo Transfer", "fet", "Thawed embryos transferred in a prepared cycle."],
  ["Egg & Sperm Freezing", "fertility-preservation", "Freezing before cancer treatment or planned delay."],
];

const locations = [
  ["Rasheed Hospital", "Main Boulevard, DHA Defence", "Daily 3:00pm–6:00pm (Sat & Sun closed)", "/locations/dha-lahore"],
  ["TAMC", "M.M. Alam Road, Gulberg", "Wednesday 12:00pm–3:00pm, other days by appointment", "/locations/mm-alam-road-lahore"],
  ["Shahnaz Hospital", "Shalamar Link Road", "Monday & Thursday 6:00pm–9:00pm", "/locations/shalamar-lahore"],
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "MedicalWebPage", "@id": url, url, name: title, description, inLanguage: "en-PK", lastReviewed: "2026-11",
      reviewedBy: { "@type": "Physician", name: "Dr. Kamran Saleem" }, about: { "@id": url + "#procedure" } },
    { "@type": "MedicalProcedure", "@id": url + "#procedure", name: "Intrauterine Insemination (IUI)", alternateName: "IUI Treatment Lahore",
      description: "A minimally invasive fertility treatment in which laboratory-washed, motile sperm is placed directly into the uterus around ovulation.",
      bodyLocation: "Reproductive System", relevantSpecialty: { "@type": "MedicalSpecialty", name: "Reproductive Endocrinology and Infertility" },
      performedBy: { "@type": "Physician", name: "Dr. Kamran Saleem", alumniOf: "University of Liverpool", identifier: "PMDC Registered" } },
    { "@type": "MedicalClinic", "@id": base + "/#clinic", name: "Kamran Fertility Clinic", url: base, telephone: "+923148432789",
      location: ["Rasheed Hospital (DHA Defence)", "TAMC Clinic (M.M. Alam Road, Gulberg)", "Shahnaz Hospital (Shalamar Link Road)"].map(n => ({ "@type": "Place", name: n, address: { "@type": "PostalAddress", addressLocality: "Lahore", addressRegion: "Punjab", addressCountry: "PK" } })) },
    { "@type": "BreadcrumbList", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: base + "/" },
      { "@type": "ListItem", position: 2, name: "Fertility Treatment", item: base + T },
      { "@type": "ListItem", position: 3, name: "IUI Treatment", item: url } ] },
    { "@type": "FAQPage", mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) },
  ],
};
---
<Layout title={title} description={description}>
<div class="ivf">
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<main>
<section class="hero"><div class="w hgrid">
  <div>
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href={T}>Fertility Treatment</a> / IUI Treatment</nav>
    <p class="eye">Doctor-led · Evidence-based · Lahore</p>
    <h1>IUI Treatment in Lahore</h1>
    <p class="sub">Intrauterine insemination (IUI) is a non-surgical fertility treatment in which washed, highly motile sperm is placed directly into the uterus around ovulation. It bypasses the cervical barrier and shortens the sperm's journey, while fertilization still happens naturally inside the body. Dr. Kamran Saleem recommends it when your results support it, and moves you to <a href={`${T}/ivf`}>IVF</a> or <a href={`${T}/icsi`}>ICSI</a> when they do not.</p>
    <p><a class="btn" href={wa}>Book an IUI consultation</a> <a class="btn ghost" href="#iui-process">See the process</a></p>
    <p class="mini">Not sure yet? Start with a <a href="/services/assessment/semen-analysis">semen analysis</a> or <a href="/services/assessment">fertility assessment</a>.</p>
  </div>
  <div class="hside">
    <ul class="facts">
      <li><b>12–18%</b> live birth per cycle, under 35</li>
      <li><b>&lt;5</b> minutes, no anesthesia</li>
      <li><b>25+</b> years in reproductive health</li>
      <li><b>3</b> Lahore locations</li>
    </ul>
  </div>
</div></section>

<div class="w layout">
  <aside class="toc" aria-label="On this page"><p>On this page</p>
    {toc.map(([id, l]) => <a href={`#${id}`}>{l}</a>)}
    <a class="btn sm" href={wa}>Book now</a>
  </aside>
  <div class="content">
    <p class="review"><b>Medically reviewed:</b> Dr. Kamran Saleem (MBBS 1988; Diploma, University of Liverpool 1998; PMDC registered) · Last review November 2026 · <a href="/dr-kamran-saleem">About the doctor</a></p>

    <section id="what-is-iui">
      <h2>What Is IUI and How Does It Work?</h2>
      <p>In natural conception, most sperm are lost crossing the vagina and cervical mucus. IUI places a concentrated sample of healthy, motile sperm in the upper uterine cavity, close to the opening of the fallopian tubes, at the time an egg is released. Unlike IVF and ICSI, fertilization takes place inside the body, with no egg retrieval, no anesthesia and no embryo laboratory.</p>
      <div class="cards">
        {advantages.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p>{p}</p></div>)}
      </div>
    </section>

    <section id="iui-vs-ivf">
      <h2>IUI vs IVF vs ICSI</h2>
      <p>These are different treatments, not steps on a fixed ladder.</p>
      <div class="tw"><table>
        <thead><tr><th></th><th>IUI</th><th><a href={`${T}/ivf`}>IVF</a></th><th><a href={`${T}/icsi`}>ICSI</a></th></tr></thead>
        <tbody>{compare.map(r => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td><td>{r[3]}</td></tr>)}</tbody>
      </table></div>
      <p class="note">More: <a href="/resources/ivf-vs-iui">IVF vs IUI</a>.</p>
    </section>

    <section id="who-needs-iui">
      <h2>Who Needs IUI?</h2>
      <p>IUI relies on natural fertilization in the tubes, so Dr. Kamran checks a few prerequisites first.</p>
      <div class="tw"><table>
        <thead><tr><th>Feature</th><th>Suitable for IUI</th><th>IVF or ICSI indicated</th></tr></thead>
        <tbody>{suit.map(r => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td></tr>)}</tbody>
      </table></div>
      <p>IUI commonly helps in these situations:</p>
      <div class="cards">
        {who.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p set:html={p} /></div>)}
      </div>
    </section>

    <section id="not-recommended">
      <h2>When IUI Is Not Recommended</h2>
      <p>To avoid wasted cycles and expense, IUI is not advised in these situations.</p>
      <div class="cards">
        {avoid.map(([h, p]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons.alert} /></span><h3>{h}</h3><p set:html={p} /></div>)}
      </div>
    </section>

    <section id="iui-process">
      <h2>The IUI Process, Step by Step</h2>
      <p>Every cycle is tailored to your results. The procedure itself takes under five minutes.</p>
      <div class="ovwrap">
        <p class="ovtitle">IUI Process at a Glance</p>
        <div class="ovrow">
          {overview.map((o, i) => (
            <>
              <a class="ov" href={o.h}>
                <span class="ovl">{o.l}</span>
                <span class="disc"><svg viewBox="0 0 100 100" set:html={o.art} /></span>
                <span class="ovn">{i + 1}</span>
              </a>
              {i < overview.length - 1 ? <span class="chev" aria-hidden="true"><svg viewBox="0 0 36 22"><path d="M3 3l7 8-7 8M14 3l7 8-7 8M25 3l7 8-7 8" /></svg></span> : null}
            </>
          ))}
        </div>
        <p class="ovhint">Select a stage to jump to its full explanation below.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step" id={`step-${i + 1}`}>
            <div class="media"><span class="ph"><svg viewBox="0 0 24 24" set:html={icons[s.icon]} /></span></div>
            <div class="body"><span class="num">Step {i + 1} · {s.time}</span><h3>{s.t}</h3><p set:html={s.d} /></div>
          </li>
        ))}
      </ol>
    </section>

    <section id="natural-vs-stimulated">
      <h2>Natural vs Stimulated IUI</h2>
      <p>The choice depends on how regularly you ovulate, your test results and the balance between success and multiple pregnancy risk.</p>
      <div class="tw"><table>
        <thead><tr><th>Cycle</th><th>Method</th><th>Success per cycle</th><th>Multiple pregnancy</th><th>Best for</th></tr></thead>
        <tbody>{cycles.map(r => <tr>{r.map(c => <td>{c}</td>)}</tr>)}</tbody>
      </table></div>
      <div class="callout"><b>Safety rule.</b> If more than 3 mature follicles develop, the cycle is cancelled or converted to IVF to prevent a high-order multiple pregnancy.</div>
    </section>

    <section id="success-rates">
      <h2>IUI Success Rates by Age</h2>
      <p>Success depends mainly on age, the cause of subfertility, post-wash sperm count and the lining.</p>
      <div class="tw"><table>
        <thead><tr><th>Age</th><th>Clinical pregnancy (per cycle)</th><th>Live birth (per cycle)</th><th>Live birth, 3 cycles</th><th>Strategy</th></tr></thead>
        <tbody>{rates.map(r => <tr>{r.map(c => <td>{c}</td>)}</tr>)}</tbody>
      </table></div>
      <ul class="tick">
        <li>A post-wash total motile count of 10 million or more gives the best results</li>
        <li>Two mature follicles raise the odds, with careful monitoring against multiples</li>
        <li>An 8–12 mm lining with a triple-line pattern at trigger gives the best implantation chance</li>
        <li>Under 3 years of subfertility does better than over 5 years</li>
      </ul>
      <p class="note">Outcomes vary and no result is guaranteed. If IUI is not working, see <a href={`${T}/ivf`}>IVF treatment</a>.</p>
    </section>

    <section id="ethics">
      <h2>Ethical and Legal Compliance in Pakistan</h2>
      <p>Treatment follows Pakistani law and Federal Shariat Court rulings on assisted reproduction.</p>
      <ul class="tick">
        <li>Only the legally wedded husband's sperm and the wife's uterus are used</li>
        <li>Donor sperm, donor eggs and surrogacy are not offered</li>
        <li>Double-witness verification at every laboratory step</li>
      </ul>
    </section>

    <section id="cost">
      <h2>IUI Cost in Lahore: Transparent Fees</h2>
      <p>IUI costs far less than a full IVF cycle. Fees are explained upfront with no hidden charges. For comparison see <a href="/resources/ivf-treatment-cost-in-pakistan">IVF treatment cost in Pakistan</a>.</p>
      <div class="cols">
        <div class="card"><h3>What a cycle includes</h3><ul class="tick"><li>Unhurried 45–60 minute consultation with Dr. Kamran</li><li>2–3 follicle-tracking ultrasounds</li><li>Sperm preparation and insemination</li></ul></div>
        <div class="card"><h3>Charged as needed</h3><ul class="tick"><li>Tubal patency test (HSG) and hormone panel, if not already done</li><li>Oral medication or injections and the trigger shot</li></ul></div>
      </div>
    </section>

    <section id="faq">
      <h2>Frequently Asked Questions</h2>
      {faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
    </section>
  </div>
</div>

<section class="band"><div class="w">
  <h2>Related fertility treatments</h2>
  <div class="cards c3">
    {treatments.map(([n, s, d]) => <a class="card link" href={`${T}/${s}`}><h3>{n}</h3><p>{d}</p></a>)}
  </div>
  <p><a href={T}>See all fertility treatments →</a> · <a href="/services/assessment/hormonal-analysis">Hormonal analysis</a> · <a href="/services/support">Support &amp; Second Opinions</a></p>
</div></section>

<section class="cta"><div class="w">
  <h2>Schedule Your Unhurried Consultation</h2>
  <p>Whether you are considering IUI as a first step or want a second opinion, you get a 45–60 minute consultation. Bring prior records, blood tests, scans and semen reports. WhatsApp +92 314 8432789.</p>
  <a class="btn" href={wa}>Book an IUI Consultation</a>
  <div class="cards c3 locs">
    {locations.map(([n, a, h, l]) => <a class="card link" href={l}><h3>{n}</h3><p>{a}</p><p class="hrs">{h}</p></a>)}
  </div>
</div></section>
</main>
</div>
</Layout>

<style is:global>
