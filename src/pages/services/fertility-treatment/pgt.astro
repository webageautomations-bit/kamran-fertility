  ["ICSI", "icsi", "Required for every PGT cycle."],
  ["Frozen Embryo Transfer", "fet", "Transfer of your tested euploid embryo."],
  ["IUI Treatment", "iui", "Washed sperm placed in the uterus around ovulation."],
