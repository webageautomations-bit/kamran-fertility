const description = "Preimplantation Genetic Testing (PGT-A, PGT-M, PGT-SR) in Lahore with UK-qualified fertility specialist Dr. Kamran Saleem. Age-wise euploidy data, biopsy safety, transparent costs and unhurried care across DHA, M.M. Alam Rd & Shalamar.";
const wa = "https://wa.me/923148432789?text=" + encodeURIComponent("Hello, I would like to book a PGT (genetic testing) consultation with Dr. Kamran Saleem.");

const icons = {
