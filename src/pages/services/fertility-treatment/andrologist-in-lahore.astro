---
// src/pages/services/fertility-treatment/andrologist-in-lahore.astro   (URL: /services/fertility-treatment/andrologist-in-lahore)
import Layout from "../../../layouts/Layout.astro";
const base = "https://www.kamranfertility.com";
const AS = "/services/assessment", TS = "/services/tests", TR = "/services/fertility-treatment";
const url = `${base}${TR}/andrologist-in-lahore`;
const title = "Andrologist in Lahore | Male Fertility Specialist | Dr. Kamran";
const description = "See an andrologist in Lahore for low sperm count, azoospermia, abnormal semen reports and hormone problems. Book with Dr. Kamran Saleem on WhatsApp.";
const phone = "+92 314 8432789";
const wa = "https://wa.me/923148432789?text=" + encodeURIComponent("Hello, I would like to book a male fertility consultation with Dr. Kamran Saleem.");
const doctorImg = "/assets/dr-kamran.webp";
const reviewed = "2026-11-20";

const I = {
  drop: '<path d="M12 3s6 6.5 6 11a6 6 0 01-12 0c0-4.5 6-11 6-11z"/>',
  cells: '<circle cx="8" cy="8" r="3"/><circle cx="16" cy="8" r="3"/><circle cx="12" cy="16" r="3"/>',
  bolt: '<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',
  scan: '<path d="M4 8V5a1 1 0 011-1h3M16 4h3a1 1 0 011 1v3M20 16v3a1 1 0 01-1 1h-3M8 20H5a1 1 0 01-1-1v-3M4 12h16"/>',
  shield: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/>',
  flask: '<path d="M9 3h6M10 3v6l-5 9a2 2 0 002 3h10a2 2 0 002-3l-5-9V3"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  chat: '<path d="M4 5h16v11H9l-5 4z"/>',
  clip: '<rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4h6v3H9zM9 12h6M9 16h6"/>',
  heart: '<path d="M12 21s-7-4.5-7-10a4 4 0 017-2.6A4 4 0 0119 11c0 5.5-7 10-7 10z"/>',
  pin: '<path d="M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  alert: '<path d="M12 3l10 18H2zM12 10v5M12 18h.01"/>',
  dna: '<path d="M7 3c0 6 10 6 10 12s-10 6-10 6M17 3c0 6-10 6-10 12M8 7h8M8 17h8"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/>',
  award: '<circle cx="12" cy="9" r="5"/><path d="M8.5 13.5L7 21l5-3 5 3-1.5-7.5"/>',
  lock: '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/>',
};
const ic = (n) => `<svg viewBox="0 0 24 24" aria-hidden="true">${I[n]}</svg>`;

const stats = [["25 yrs","Reproductive health experience"],["3","Lahore clinics"],["45-60 min","First consultation"],["100%","Private & respectful"]];

const when = [
  ["clock","Trying for 12+ months","No pregnancy after a year of regular, unprotected intercourse. Check after 6 months if your partner is 35 or older."],
  ["flask","Abnormal semen report","Low count, weak movement, abnormal shape, or low volume."],
  ["drop","No sperm in semen","Azoospermia needs a proper work-up to find the cause."],
  ["alert","Swelling, pain or heaviness","A varicocele or another testicular problem may be present."],
  ["bolt","Low desire or sexual concerns","Hormone problems can affect desire, erections and sperm."],
  ["heart","IUI or IVF did not work","The male side may not have been fully checked."],
];

const conds = [
  ["drop","Low sperm count","Fewer sperm than the normal range. Many causes are treatable.",`${TS}/semen-analysis`,"About semen analysis"],
  ["cells","Azoospermia","No sperm found in the sample. Blocked or not produced. The type decides the plan.",`${TR}/male-infertility`,"Male infertility care"],
  ["scan","Poor movement or shape","Sperm that swim poorly or have an abnormal shape.",`${TS}/semen-analysis`,"Read your report"],
  ["shield","Varicocele","Enlarged veins around the testicle. Not every one needs treatment.",`${AS}/male-fertility-assessment`,"Male assessment"],
  ["bolt","Hormone problems","Testosterone, FSH, LH or prolactin out of balance.",`${TS}/male-fertility-hormone-test`,"Male hormone test"],
  ["dna","Genetic causes","Selected men with very low or zero sperm may need genetic tests.",`${AS}/male-fertility-assessment`,"What is tested"],
];

const steps = [
  ["chat","Talk","You share how long you have been trying, your health history and past treatment."],
  ["clip","Review","We read your old semen reports, blood tests and treatment records."],
  ["flask","Test","Only tests that will change your plan. No test for the sake of testing."],
  ["award","Plan","A clear next step in simple words. You decide the pace."],
];

const tests = [
  ["Semen analysis","Volume, count, movement, shape, vitality",`${TS}/semen-analysis`],
  ["Male hormone test","FSH, LH, testosterone, prolactin",`${TS}/male-fertility-hormone-test`],
  ["Scrotal ultrasound","Varicocele and testicular structure",`${AS}/male-fertility-assessment`],
  ["Semen culture / urine test","When infection is suspected",`${AS}/male-fertility-assessment`],
  ["Genetic tests","Selected cases only",`${AS}/male-fertility-assessment`],
  ["Sperm DNA fragmentation","Selected cases, such as repeated treatment failure",`${AS}/male-fertility-assessment`],
];
const who = [["Semen volume","1.4 mL"],["Sperm concentration","16 million/mL"],["Total sperm number","39 million / ejaculate"],["Total motility","42%"],["Progressive motility","30%"],["Normal shape","4%"],["Vitality (live sperm)","54%"]];

const treat = [
  ["Treat the cause","Infection, hormone problem or a medicine that affects sperm. Lifestyle advice where it helps.",`${AS}/male-fertility-assessment`,"Start with an assessment"],
  ["Male infertility care","Low count, azoospermia and surgical sperm retrieval (PESA, TESE, micro-TESE) in selected men.",`${TR}/male-infertility`,"Male infertility care"],
  ["IUI","Prepared sperm placed in the uterus around ovulation. For selected couples.",`${TR}/iui`,"IUI treatment"],
  ["IVF and ICSI","When natural conception is unlikely. ICSI places one sperm into one egg.",`${TR}/icsi`,"ICSI treatment"],
  ["Sperm freezing","Store sperm before treatment or surgery.",`${TR}/fertility-preservation`,"Egg & sperm freezing"],
  ["Second opinion","Independent review after failed cycles or unclear reports.","/services/support","Second opinions"],
];

const locs = [
  ["DHA – Rasheed Hospital","Main Boulevard, DHA Defence, Lahore","Daily 3:00–6:00 PM · Sat & Sun closed","/locations/dha-lahore"],
  ["Gulberg III – TAMC Clinic","M.M. Alam Road, Lahore","Wednesday 12:00–3:00 PM · Other days by appointment","/locations/mm-alam-road-lahore"],
  ["Shalamar – Shahnaz Hospital","Shalamar Link Road, Lahore","Monday & Thursday 6:00–9:00 PM","/locations/shalamar-lahore"],
];

const faqs = [
  ["What does an andrologist treat?","An andrologist treats male reproductive health problems. These include male infertility, low sperm count, no sperm in semen, poor sperm movement, varicocele, male hormone problems and some sexual health concerns."],
  ["When should I see an andrologist?","See one if you have tried to conceive for 12 months, or 6 months if your partner is 35 or older. Also go if your semen report is abnormal, you have scrotal swelling or pain, or you have hormone or sexual concerns."],
  ["Can low sperm count be treated?","Often, yes, depending on the cause. Hormone problems, some infections and some varicoceles can be treated. If that is not enough, IUI, IVF or ICSI may be discussed."],
  ["Does a low sperm count mean I cannot have children?","No. A low count can reduce the chance of pregnancy, but it does not make it impossible. Movement, shape and your partner's fertility also matter."],
  ["Can azoospermia be treated?","Sometimes. A blockage may be treated or bypassed. In non-obstructive cases, some men can have sperm retrieved by TESE or micro-TESE, then used with ICSI. Your tests decide."],
  ["What is the difference between an andrologist and a urologist?","A urologist treats the urinary system and male reproductive organs. An andrologist focuses on male fertility, sperm health and male hormones. The two overlap."],
  ["Do I need hormone tests for low sperm count?","Often yes. FSH, LH and testosterone show whether a hormone problem is affecting sperm production. Your doctor decides from your reports and symptoms."],
  ["Does every male fertility problem need IVF or ICSI?","No. Some men improve once the cause is treated. IVF and ICSI are advised only when they are the right option for the couple."],
  ["Should I take testosterone or steroids to boost sperm?","No. If you want to father a child, testosterone and anabolic steroids can lower or stop sperm production. Speak to a doctor first."],
  ["Is my consultation private?","Yes. Your visit and your reports are handled with full confidentiality."],
  ["How do I book an andrologist in Lahore?",`Message Kamran Fertility Clinic on WhatsApp at ${phone}. Choose DHA, Gulberg III or Shalamar and we will confirm your appointment.`],
];

const hrs = (d, o, c) => [{ "@type": "OpeningHoursSpecification", dayOfWeek: d, opens: o, closes: c }];
const clinicId = base + "/#clinic";
const place = (name, street, d, o, c, l) => ({ "@type": "Place", name, url: base + l, address: { "@type": "PostalAddress", streetAddress: street, addressLocality: "Lahore", addressRegion: "Punjab", addressCountry: "PK" }, openingHoursSpecification: hrs(d, o, c) });
const schema = { "@context": "https://schema.org", "@graph": [
  { "@type": "MedicalWebPage", "@id": url, url, name: title, description, inLanguage: "en-PK", lastReviewed: reviewed, reviewedBy: { "@id": base + "/dr-kamran-saleem#physician" }, publisher: { "@id": clinicId }, breadcrumb: { "@id": url + "#breadcrumb" }, about: { "@type": "MedicalSpecialty", name: "Andrology" } },
  { "@type": "MedicalClinic", "@id": clinicId, name: "Kamran Fertility Clinic", url: base, telephone: "+923148432789", logo: base + "/assets/logo.webp", image: base + doctorImg,
    location: [
      place("Rasheed Hospital (DHA Defence)", "Main Boulevard, DHA Defence", ["Monday","Tuesday","Wednesday","Thursday","Friday"], "15:00", "18:00", "/locations/dha-lahore"),
      place("TAMC Clinic (M.M. Alam Road, Gulberg III)", "M.M. Alam Road, Gulberg III", ["Wednesday"], "12:00", "15:00", "/locations/mm-alam-road-lahore"),
      place("Shahnaz Hospital (Shalamar Link Road)", "Shalamar Link Road", ["Monday","Thursday"], "18:00", "21:00", "/locations/shalamar-lahore") ] },
  { "@type": "Physician", "@id": base + "/dr-kamran-saleem#physician", name: "Dr. Kamran Saleem", url: base + "/dr-kamran-saleem", image: base + doctorImg, medicalSpecialty: "Andrology", description: "MBBS 1988; Diploma in Genito-Urinary Medicine & Venereology, University of Liverpool (1998); 25 years' experience in reproductive health.", worksFor: { "@id": clinicId } },
  { "@type": "BreadcrumbList", "@id": url + "#breadcrumb", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: base + "/" },
    { "@type": "ListItem", position: 2, name: "Services", item: base + "/services" },
    { "@type": "ListItem", position: 3, name: "Fertility Treatment", item: base + TR },
    { "@type": "ListItem", position: 4, name: "Andrologist in Lahore", item: url } ] },
  { "@type": "FAQPage", mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) },
] };
---
<Layout title={title} description={description}>
<div class="ivf">
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<main>

<section class="hero"><div class="w hgrid">
  <div>
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/services">Services</a> / <a href={TR}>Fertility Treatment</a> / Andrologist in Lahore</nav>
    <p class="eye">Male fertility · Sperm health · Hormones</p>
    <h1>Andrologist in Lahore for Male Fertility and Sperm Problems</h1>
    <p class="lead">Clear answers, calm care, and a plan you understand.</p>
    <p class="sub">Trying for a baby with no result? Got an abnormal semen report? Dr. Kamran Saleem finds out what is affecting your sperm health and explains your options in simple words.</p>
    <p class="actions"><a class="btn" href={wa}>Book on WhatsApp</a> <a class="btn ghost" href="#visit">What happens in a visit</a></p>
    <ul class="badges">
      <li><span class="bi" set:html={ic("lock")} /> Private consultation</li>
      <li><span class="bi" set:html={ic("award")} /> MBBS · Dip GUM &amp; Ven (UK)</li>
      <li><span class="bi" set:html={ic("pin")} /> DHA · Gulberg · Shalamar</li>
    </ul>
  </div>
  <div class="photo">
    <div class="arch"><img src={doctorImg} alt="Dr. Kamran Saleem, andrologist and male fertility specialist in Lahore" width="480" height="560" loading="eager" /></div>
    <div class="float f1"><b>25 years</b><span>in reproductive health</span></div>
    <div class="float f2"><b>Dr. Kamran Saleem</b><span>Male fertility specialist</span></div>
    <svg class="orb o1" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="46"/></svg>
    <svg class="orb o2" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="46"/></svg>
  </div>
</div></section>

<div class="w"><div class="stats"><div class="statgrid">{stats.map(([n, l]) => <div class="stat"><b>{n}</b><span>{l}</span></div>)}</div></div></div>

<div class="w band">
  <p class="kick">The short answer</p>
  <h2>What Is an Andrologist?</h2>
  <div class="snippet"><p>An andrologist is a doctor for male reproductive health. This covers male infertility, sperm problems, male hormones and some sexual and urogenital concerns. In many couples who cannot conceive, the male partner is part of the cause. That is why a male check is a first step, not a last one.</p></div>
  <p>We find the cause first. Treatment follows the diagnosis. We do not start supplements or medicines without a reason.</p>
  <p class="more">Not sure if you need an andrologist or a urologist? A urologist treats the urinary system and male organs more broadly. An andrologist focuses on sperm, fertility and male hormones. If your main concern is having a baby, start with a <a href={`${AS}/male-fertility-assessment`}>male fertility assessment</a>.</p>
</div>

<section class="alt"><div class="w">
  <p class="kick">Timing</p><h2>When Should You See an Andrologist?</h2>
  <div class="cards">{when.map(([i, h, p]) => <div class="card"><span class="ic" set:html={ic(i)} /><h3>{h}</h3><p>{p}</p></div>)}</div>
  <p class="more">Both partners matter. See our <a href={AS}>couple fertility assessment</a> for a full evaluation of both of you.</p>
</div></section>

<section><div class="w">
  <p class="kick">Conditions</p><h2>Male Fertility Problems We Evaluate</h2>
  <p class="intro">Not sure which one applies to you? That is normal. The tests tell us.</p>
  <div class="cards">{conds.map(([i, h, p, l, t]) => <a class="card link" href={l}><span class="ic" set:html={ic(i)} /><h3>{h}</h3><p>{p}</p><span class="go">{t} →</span></a>)}</div>
  <div class="warn"><span class="ic" set:html={ic("alert")} /><p><b>Important:</b> If you want to father a child, do not take testosterone or anabolic steroids on your own. They can lower or stop sperm production.</p></div>
</div></section>

<section class="alt" id="visit"><div class="w">
  <p class="kick">Your first visit</p><h2>What Happens at Your Consultation</h2>
  <ol class="steps">{steps.map(([i, h, p], n) => <li><span class="num">{n + 1}</span><span class="ic" set:html={ic(i)} /><h3>{h}</h3><p>{p}</p></li>)}</ol>
  <p class="more">No reports yet? Book anyway. The doctor will tell you what to test. Not every man needs every test.</p>
</div></section>

<section><div class="w">
  <p class="kick">Diagnosis</p><h2>Tests You May Need</h2>
  <div class="tw"><table>
    <thead><tr><th>Test</th><th>Why it is done</th><th></th></tr></thead>
    <tbody>{tests.map(([a, b, l]) => <tr><th scope="row">{a}</th><td>{b}</td><td><a href={l}>Details →</a></td></tr>)}</tbody>
  </table></div>
  <p class="more">See every test with timing on our <a href={TS}>fertility tests</a> page.</p>

  <h3 class="sh">Understand your semen report (WHO 6th Edition, 2021)</h3>
  <div class="tw narrow"><table>
    <thead><tr><th>Measure</th><th>Lower reference limit</th></tr></thead>
    <tbody>{who.map(([a, b]) => <tr><th scope="row">{a}</th><td>{b}</td></tr>)}</tbody>
  </table></div>
  <p class="note">These are not pass or fail marks. A man below a limit can still father a child, and a man within range is not guaranteed to be fertile. Results change between samples and are affected by fever, illness and days of abstinence. Always have your report read by a doctor. <a href={`${TS}/semen-analysis`}>Read about semen analysis →</a></p>
</div></section>

<section class="alt"><div class="w">
  <p class="kick">After diagnosis</p><h2>Treatment Options</h2>
  <p class="intro">Treatment depends on the cause. Many men need only the right diagnosis first.</p>
  <div class="cards">{treat.map(([h, p, l, t]) => <a class="card link" href={l}><h3>{h}</h3><p>{p}</p><span class="go">{t} →</span></a>)}</div>
  <p class="more">Browse all <a href={TR}>fertility treatments</a> or read <a href="/resources">patient guides</a>.</p>
</div></section>

<section><div class="w dgrid">
  <div class="dphoto"><img src={doctorImg} alt="Dr. Kamran Saleem" width="420" height="500" loading="lazy" /></div>
  <div>
    <p class="kick">Meet the doctor</p><h2>Dr. Kamran Saleem</h2>
    <p>A fertility specialist who believes good care starts with listening. Every consultation is clear, respectful and based on medical evidence, with no pressure.</p>
    <ul class="tick">
      <li>MBBS – King Edward Medical University / Punjab University (1988)</li>
      <li>Diploma in Genito-Urinary Medicine &amp; Venereology – University of Liverpool, UK (1998)</li>
      <li>25 years' experience in reproductive health and fertility</li>
      <li>Semen analysis interpretation and hormone assessment</li>
    </ul>
    <p class="actions"><a class="btn" href={wa}>Book a consultation</a> <a class="btn line" href="/dr-kamran-saleem">About Dr. Kamran</a></p>
    <p class="more"><a href="/success-stories">Read patient stories →</a></p>
  </div>
</div></section>

<section class="alt"><div class="w">
  <p class="kick">Find us</p><h2>Andrologist Consultation Locations in Lahore</h2>
  <div class="cards c3">{locs.map(([n, a, h, l]) => <a class="card link" href={l}><span class="ic" set:html={ic("pin")} /><h3>{n}</h3><p>{a}</p><p class="hrs">{h}</p><span class="go">Clinic page →</span></a>)}</div>
  <p class="more">Timings can change. Please confirm on WhatsApp before you visit. <a href="/locations">View all locations →</a></p>
  <p class="more"><b>What to bring:</b> previous semen and blood reports, records of past IUI or IVF, a list of medicines and supplements, and your partner's reports if you have them.</p>
</div></section>

<section><div class="w narrowc">
  <p class="kick">Questions</p><h2>Frequently Asked Questions</h2>
  {faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
</div></section>

<section class="cta"><div class="w">
  <h2>Book Your Male Fertility Consultation in Lahore</h2>
  <p>You do not have to figure this out alone. A clear diagnosis is the first step to the right treatment. We usually reply the same day.</p>
  <p class="actions c"><a class="btn" href={wa}>Book via WhatsApp</a> <a class="btn ghost" href="tel:+923148432789">Call {phone}</a></p>
  <p class="links"><a href={`${AS}/male-fertility-assessment`}>Male assessment</a> · <a href={`${TS}/semen-analysis`}>Semen analysis</a> · <a href={`${TS}/male-fertility-hormone-test`}>Hormone test</a> · <a href={`${TR}/male-infertility`}>Male infertility care</a> · <a href="/services/support">Second opinions</a></p>
  <p class="disc"><b>Medical disclaimer:</b> This page gives general information only. It is not a substitute for a personal medical assessment, diagnosis or treatment. Treatment depends on your clinical findings and medical history. We do not provide emergency care. For severe pain, fever or sudden swelling, seek urgent medical attention.</p>
</div></section>

</main>
</div>
</Layout>

<style is:global>
  .ivf{--c-primary:#2563eb;--c-dark:#0b1f4b;--c-accent:#4cc9f0;--c-tint:#eef5ff;--c-bg:#fff;--c-text:#1e2a4a;--c-muted:#5b6b8c;--c-line:#dbe6f6;
    --serif:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;
    margin:0;background:var(--c-bg);color:var(--c-text);font:16px/1.75 Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
  .ivf *{box-sizing:border-box}
  .ivf a{color:var(--c-primary)}
  .ivf .w{max-width:1120px;margin:0 auto;padding:0 20px}
  .ivf section{padding:68px 0}.ivf .alt{background:linear-gradient(180deg,#f6faff,#eef5ff)}
  .ivf h1,.ivf h2,.ivf h3{line-height:1.2;color:var(--c-dark);margin:0 0 .5em}
  .ivf h1,.ivf h2{font-family:var(--serif);font-weight:700;letter-spacing:-.01em}
  .ivf h2{font-size:clamp(26px,3.2vw,36px)}.ivf h3{font-size:18px}
  .ivf .kick{margin:0 0 8px;font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--c-primary)}
  .ivf .intro{max-width:60ch;color:var(--c-muted)}
  .ivf .more{margin-top:20px;color:var(--c-muted);font-size:15px}
  .ivf .sh{margin:40px 0 14px}
  .ivf .btn{display:inline-block;background:linear-gradient(135deg,#3b82f6,#1d4ed8);box-shadow:0 8px 18px rgba(29,78,216,.28);color:#fff!important;padding:14px 26px;border-radius:999px;font-weight:600;text-decoration:none;transition:transform .15s}
  .ivf .btn:hover{transform:translateY(-2px)}
  .ivf .btn.ghost{background:transparent;box-shadow:none;border:1.5px solid rgba(255,255,255,.7)}
  .ivf .btn.line{background:#fff;color:var(--c-primary)!important;border:1.5px solid var(--c-primary);box-shadow:none}
  .ivf .actions{margin:22px 0 14px;display:flex;gap:12px;flex-wrap:wrap}.ivf .actions.c{justify-content:center}
  .ivf .ic{display:grid;place-items:center;width:48px;height:48px;border-radius:14px;background:var(--c-tint);margin-bottom:14px}
  .ivf svg{width:26px;height:26px;fill:none;stroke:var(--c-primary);stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
  /* hero */
  .ivf .hero{position:relative;overflow:hidden;background:radial-gradient(900px 420px at 85% 0,rgba(76,201,240,.28),transparent 60%),linear-gradient(135deg,#071538,var(--c-primary));color:#fff;padding:52px 0 110px}
  .ivf .hero h1{color:#fff;font-size:clamp(32px,4.8vw,48px);margin-bottom:.3em}
  .ivf .hero a:not(.btn){color:#fff}
  .ivf .hgrid{display:grid;grid-template-columns:1.25fr 1fr;gap:48px;align-items:center}
  .ivf .crumb{font-size:13px;opacity:.85;margin-bottom:16px}
  .ivf .eye{text-transform:uppercase;letter-spacing:.14em;font-size:12.5px;font-weight:700;color:var(--c-accent);margin:0 0 8px}
  .ivf .lead{font-family:var(--serif);font-size:clamp(19px,2.2vw,23px);font-style:italic;opacity:.95;margin:0 0 12px}
  .ivf .sub{opacity:.92;max-width:56ch}
  .ivf .badges{list-style:none;display:flex;flex-wrap:wrap;gap:10px;margin:22px 0 0;padding:0}
  .ivf .badges li{display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.22);border-radius:999px;padding:7px 14px 7px 8px;font-size:13.5px;backdrop-filter:blur(6px)}
  .ivf .bi{display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:rgba(255,255,255,.16)}
  .ivf .bi svg{width:15px;height:15px;stroke:#fff}
  .ivf .photo{position:relative;max-width:400px;margin:0 auto;width:100%}
