---
// src/pages/services/fertility-treatment/fet.astro
// Uses the site's own menu/footer via Layout. Match the import path + props to TreatmentPage.astro.
import Layout from "../../../layouts/Layout.astro";
const base = "https://www.kamranfertility.com";
const T = "/services/fertility-treatment";
const url = `${base}${T}/fet`;
const title = "Frozen Embryo Transfer (FET) in Lahore | Success Rates, Cost & Process | Dr. Kamran Saleem";
const description = "Frozen Embryo Transfer (FET) in Lahore with UK-qualified fertility specialist Dr. Kamran Saleem. Age-wise success rates, natural vs HRT protocols, transparent costs and unhurried care across DHA, M.M. Alam Rd & Shalamar.";
const wa = "https://wa.me/923148432789?text=" + encodeURIComponent("Hello, I would like to book a Frozen Embryo Transfer (FET) consultation with Dr. Kamran Saleem.");

const icons = {
  flask: '<path d="M9 3h6M10 3v6l-5 9a2 2 0 002 3h10a2 2 0 002-3l-5-9V3"/>',
  inject: '<path d="M4 20l9-9M13 11l-2-2 5-5 4 4-5 5zM3 21l2-1"/>',
  bolt: '<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',
  target: '<circle cx="12" cy="12" r="4"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/>',
  cells: '<circle cx="8" cy="8" r="3"/><circle cx="16" cy="8" r="3"/><circle cx="12" cy="16" r="3"/>',
  merge: '<circle cx="9" cy="12" r="5"/><path d="M14 12h7M18 9l3 3-3 3"/>',
  heart: '<path d="M12 21s-7-4.5-7-10a4 4 0 017-2.6A4 4 0 0119 11c0 5.5-7 10-7 10z"/>',
  check: '<path d="M5 12l5 5 9-10"/>',
  clip: '<rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4h6v3H9zM9 12h6M9 16h6"/>',
  alert: '<path d="M12 3l10 18H2zM12 10v5M12 18h.01"/>',
  snow: '<path d="M12 2v20M4 7l16 10M20 7L4 17M9 4l3 2 3-2M9 20l3-2 3 2"/>',
  shield: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/>',
  dna: '<path d="M7 3c0 6 10 6 10 12s-10 6-10 6M17 3c0 6-10 6-10 12s10 6 10 6M8 8h8M8 16h8"/>',
  layers: '<path d="M12 3l9 5-9 5-9-5zM3 13l9 5 9-5"/>',
  calendar: '<rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/>',
  leaf: '<path d="M5 19c0-9 5-14 15-14 0 10-5 15-14 15M5 19l8-8"/>',
};

const toc = [["what-is-fet","What is FET"],["why-fet","Why FET"],["indications","Who benefits"],["vitrification","Vitrification"],["fresh-vs-frozen","Fresh vs frozen"],["protocols","Natural vs HRT"],["fet-process","Step by step"],["success-rates","Success rates"],["preparation","Before & after"],["ethics","Ethics"],["cost","Cost"],["faq","FAQ"]];

const overview = [
  { l: "Evaluation", h: "#step-1", art: '<rect x="37" y="14" width="26" height="7" rx="3" fill="#3b82f6" stroke="#0b1f4b" stroke-width="2"/><rect x="39" y="19" width="22" height="64" rx="11" fill="#e0eeff" stroke="#0b1f4b" stroke-width="3"/><rect x="42" y="44" width="16" height="36" rx="8" fill="#4cc9f0"/><circle cx="47" cy="56" r="2.5" fill="#ffffff"/><circle cx="54" cy="66" r="2" fill="#ffffff"/><circle cx="48" cy="74" r="2.5" fill="#ffffff"/>' },
  { l: "Lining Priming", h: "#step-2", art: '<circle cx="50" cy="50" r="32" fill="#fff" opacity=".75"/><circle cx="50" cy="50" r="18" fill="#60a5fa" stroke="#2563eb" stroke-width="2"/><circle cx="50" cy="50" r="7" fill="#0b1f4b"/>' },
  { l: "Embryo Thawing", h: "#step-3", art: '<circle cx="50" cy="50" r="40" fill="#3b82f6"/><g stroke="#fff" stroke-width="3" stroke-linecap="round" fill="none"><path d="M50 22v56M26 36l48 28M74 36L26 64"/><path d="M43 27l7 5 7-5M43 73l7-5 7 5"/></g>' },
  { l: "Embryo Transfer", h: "#step-4", art: '<circle cx="50" cy="50" r="38" fill="#fff" stroke="#2563eb" stroke-width="5"/><circle cx="50" cy="56" r="13" fill="#93c5fd" stroke="#0b1f4b" stroke-width="2"/><circle cx="50" cy="56" r="4" fill="#0b1f4b"/><path d="M50 18v26" stroke="#0b1f4b" stroke-width="3" stroke-linecap="round"/><path d="M44 24l6-6 6 6" stroke="#0b1f4b" stroke-width="2.5" fill="none" stroke-linecap="round"/>' },
  { l: "Luteal Support & Test", h: "#step-5", art: '<circle cx="50" cy="50" r="38" fill="#fff" opacity=".7"/><g fill="#93c5fd" stroke="#2563eb" stroke-width="2"><circle cx="36" cy="38" r="11"/><circle cx="60" cy="34" r="11"/><circle cx="68" cy="56" r="11"/><circle cx="46" cy="66" r="11"/><circle cx="31" cy="58" r="11"/><circle cx="50" cy="50" r="11"/></g><g fill="#0b1f4b"><circle cx="36" cy="38" r="4"/><circle cx="60" cy="34" r="4"/><circle cx="68" cy="56" r="4"/><circle cx="46" cy="66" r="4"/><circle cx="31" cy="58" r="4"/><circle cx="50" cy="50" r="4"/></g>' },
];

const steps = [
  { t: "Pre-FET diagnostic re-evaluation", time: "Before the cycle", icon: "clip", d: "We review your prior uterine cavity evaluation (3D ultrasound, saline-infusion sonogram or hysteroscopy) to rule out polyps, fibroids or intrauterine adhesions. Baseline hormonal screening and partner viral screening are confirmed." },
  { t: "Endometrial priming & lining tracking", time: "Cycle Day 2/3 onward", icon: "layers", d: `Either exogenous estrogen (HRT protocol) or tracking of your own ovulation. Serial ultrasounds measure lining thickness, triple-line pattern and sub-endometrial blood flow. See <a href="#protocols">natural vs HRT protocols</a>.` },
  { t: "Embryo thawing & re-expansion check", time: "Morning of transfer", icon: "snow", d: "The embryology laboratory thaws your vitrified blastocyst through a series of warming solutions. The embryologist checks re-expansion and membrane integrity under high magnification before loading." },
  { t: "Ultrasound-guided transfer", time: "About 10 minutes", icon: "target", d: "A soft outer catheter is guided through the cervix under real-time abdominal ultrasound. A fine inner catheter then places the embryo in a micro-droplet of culture medium about 1.5 cm below the top of the uterus. No anesthesia is needed." },
  { t: "Luteal support & pregnancy test", time: "10–12 days later", icon: "check", d: "Micronized vaginal progesterone and oral dydrogesterone keep the lining stable. A quantitative blood Beta-hCG test 10–12 days after blastocyst transfer confirms pregnancy." },
];

const whyCards = [
  ["Better endometrial timing", "Without high stimulation hormones, the lining returns to a natural, balanced state before implantation.", "calendar"],
  ["Protects against OHSS", "A freeze-all strategy removes the late-onset risk of ovarian hyperstimulation syndrome.", "shield"],
  ["Genetic testing ready", "Embryos can wait safely while PGT-A or PGT-M results are processed.", "dna"],
  ["Flexible family building", "Spare embryos can be used years later without repeating egg retrieval.", "heart"],
];

const indications = [
  ["OHSS prevention", "High antral follicle count, high AMH or PCOS with high estradiol. Freezing all embryos removes the risk of late-onset OHSS.", "shield"],
  ["Raised progesterone on trigger day", "A progesterone rise above 1.5 ng/mL before retrieval desynchronizes the lining. Transfer in a later cycle restores timing.", "bolt"],
  ["Preimplantation genetic testing", "Embryos biopsied for PGT-A or PGT-M must be vitrified while sequencing results are processed.", "dna"],
  ["Sub-optimal lining in a fresh cycle", "If the lining misses 7.5–12 mm or a triple-line pattern, embryos are frozen until a dedicated cycle.", "layers"],
  ["Family building & preservation", "Freeze extra high-grade embryos for future siblings and transfer them years later.", "heart"],
];

const freezing = [
  ["Cooling rate", "Slow, controlled cooling", "Over 15,000°C per minute"],
  ["Ice crystal risk", "Higher, can damage cells", "Glass-like solid, no damaging crystals"],
  ["Post-thaw survival", "About 60–70%", "Over 98–99%"],
  ["Developmental potential", "Reduced", "Comparable to fresh blastocysts"],
  ["Storage", "Liquid nitrogen", "Liquid nitrogen at −196°C, stable long term"],
];

const vitCards = [
  ["No ice crystals", "Liquid nitrogen at −196°C and strong cryoprotectants turn cell fluid into a glass-like solid.", "snow"],
  ["Superior post-thaw viability", "Vitrified blastocysts keep over 98–99% cell integrity on thawing.", "check"],
  ["Long-term stability", "Embryos stay in liquid nitrogen storage without loss of cellular viability over time.", "shield"],
];

const compare = [
  ["Endometrial synchronization", "Can be impaired by high stimulation hormones", "Perfected with natural or HRT preparation"],
  ["OHSS risk", "Moderate to high in hyper-responders", "Very low, late-onset OHSS avoided"],
  ["Implantation rate (under 35)", "30% – 38%", "38% – 46%"],
  ["Ectopic pregnancy risk", "Slightly higher due to uterine contractions", "Lower"],
  ["Obstetric outcomes", "Higher incidence of low birth weight", "Lower incidence of small-for-gestational-age babies"],
  ["Genetic testing compatibility", "Not compatible with multi-day PGT", "Fully compatible with PGT-A and PGT-M"],
];

const protoCompare = [
  ["Ideal candidates", "Irregular cycles, PCOS, anovulation, or a need for precise scheduling", "Regular ovulatory cycles and a healthy endometrial response"],
  ["Lining preparation", "Oral or transdermal estradiol for 10–14 days from Day 2/3", "Your own hormones, no synthetic estrogen"],
  ["Monitoring", "Ultrasound for lining 7.5–12 mm, no active follicles; serum progesterone check", "Follicle tracking from Day 8–10 until the lead follicle reaches 18–20 mm"],
  ["Ovulation", "Suppressed", "Induced with an hCG trigger once lining exceeds 7.5 mm"],
  ["Progesterone", "Started when the lining is ready (vaginal or intramuscular)", "Natural, with luteal support as advised"],
  ["Transfer timing", "After 120 hours of progesterone (Day 5 blastocyst)", "6 days after the trigger"],
];

const rates = [
  ["Under 35", "45% – 52%", "40% – 48%", "68% – 75%", "High euploidy; optimal receptivity"],
  ["35 – 37", "35% – 42%", "32% – 38%", "58% – 64%", "Blastocyst grading is critical"],
  ["38 – 40", "22% – 28%", "20% – 26%", "40% – 48%", "PGT-A strongly advised"],
  ["41 – 42", "12% – 16%", "10% – 14%", "22% – 28%", "Individual luteal protocol and PGT-A selection"],
  ["Over 42", "4% – 8%", "3% – 6%", "Under 12%", "Comprehensive counseling required"],
];

const prepCards = [
  ["Lining target", "Minimum 7.5 mm, ideally 8–11 mm, with a clear triple-line pattern.", "layers"],
  ["Thyroid & prolactin", "TSH optimized below 2.5 mIU/L to lower the risk of early pregnancy loss.", "flask"],
  ["Lifestyle & nutrition", "Mediterranean-style diet, caffeine under 200 mg a day and light walking.", "leaf"],
];

const afterCards = [
  ["No strict bed rest", "Prolonged bed rest does not raise implantation rates. Resume light daily activity straight away.", "check"],
  ["Avoid strenuous activity", "No high-impact exercise, lifting over 5 kg, hot baths or saunas during the two-week wait.", "alert"],
  ["Stay on progesterone", "Never change or stop it without instruction from Dr. Kamran Saleem.", "shield"],
];

const faqs = [
  ["Is a Frozen Embryo Transfer better than a fresh transfer?", "For many patients, yes. FET lets the body recover from stimulation hormones so the lining returns to a natural state. Studies show equal or higher live birth rates and a much lower risk of OHSS."],
  ["How long can embryos remain safely frozen?", "Embryos vitrified at -196°C in liquid nitrogen remain biologically stable for many years. Published clinical data shows no decline in viability or pregnancy success after 10 or more years of storage."],
  ["Is the FET catheter insertion painful?", "No. Transfer is a gentle procedure of about 10 minutes through the vagina and cervix with a soft catheter. It needs no anesthesia or sedation."],
  ["How soon after a fresh IVF cycle can I do an FET?", "Most patients can have an FET within 1 to 2 menstrual cycles after egg retrieval, which allows the ovaries to recover and hormones to settle."],
  ["Do I need bed rest after the transfer?", "No. Rest for a short while on the table, then resume light daily activity. Avoid strenuous exercise and heavy lifting until your pregnancy test."],
  ["Which FET protocol is right for me?", "It depends on cycle regularity and hormone profile. HRT suits irregular cycles and PCOS, while natural or modified natural cycles suit regular ovulation. Dr. Kamran advises after reviewing your records."],
];

const treatments = [
  ["IVF Treatment", "ivf", "Egg retrieval, fertilization and embryo culture."],
  ["ICSI", "icsi", "One sperm injected into an egg for severe male factor."],
  ["IUI Treatment", "iui", "Washed sperm placed in the uterus around ovulation."],
  ["Ovulation Induction & PCOS", "ovulation-induction", "Medication and monitoring to restore ovulation."],
  ["Male Infertility Treatment", "male-infertility", "Testing and treatment for low count and hormonal causes."],
  ["Egg & Sperm Freezing", "fertility-preservation", "Freezing before cancer treatment or planned delay."],
];

const locations = [
  ["Rasheed Hospital", "Main Boulevard, DHA Defence", "Daily 3:00pm–6:00pm (Sat & Sun closed)", "/locations/dha-lahore"],
  ["TAMC", "M.M. Alam Road, Gulberg", "Wednesday 12:00pm–3:00pm, other days by appointment", "/locations/mm-alam-road-lahore"],
  ["Shahnaz Hospital", "Shalamar Link Road", "Monday & Thursday 6:00pm–9:00pm", "/locations/shalamar-lahore"],
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "MedicalWebPage", "@id": url, url, name: title, description, inLanguage: "en-PK", lastReviewed: "2026-11",
      reviewedBy: { "@type": "Physician", name: "Dr. Kamran Saleem" }, about: { "@id": url + "#procedure" } },
    { "@type": "MedicalProcedure", "@id": url + "#procedure", name: "Frozen Embryo Transfer (FET)", alternateName: "FET Treatment Lahore",
      description: "A fertility procedure in which vitrified embryos from a previous IVF or ICSI cycle are thawed and transferred into a carefully prepared uterus.",
      bodyLocation: "Reproductive System", relevantSpecialty: { "@type": "MedicalSpecialty", name: "Reproductive Endocrinology and Infertility" },
      performedBy: { "@type": "Physician", name: "Dr. Kamran Saleem", alumniOf: "University of Liverpool", identifier: "PMDC Registered" } },
    { "@type": "MedicalClinic", "@id": base + "/#clinic", name: "Kamran Fertility Clinic", url: base, telephone: "+923148432789",
      location: ["Rasheed Hospital (DHA Defence)", "TAMC Clinic (M.M. Alam Road, Gulberg)", "Shahnaz Hospital (Shalamar Link Road)"].map(n => ({ "@type": "Place", name: n, address: { "@type": "PostalAddress", addressLocality: "Lahore", addressRegion: "Punjab", addressCountry: "PK" } })) },
    { "@type": "BreadcrumbList", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: base + "/" },
      { "@type": "ListItem", position: 2, name: "Fertility Treatment", item: base + T },
      { "@type": "ListItem", position: 3, name: "Frozen Embryo Transfer", item: url } ] },
    { "@type": "FAQPage", mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) },
  ],
};
---
<Layout title={title} description={description}>
<div class="ivf">
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<main>
<section class="hero"><div class="w hgrid">
  <div>
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href={T}>Fertility Treatment</a> / Frozen Embryo Transfer</nav>
    <p class="eye">Doctor-led · Evidence-based · Lahore</p>
    <h1>Frozen Embryo Transfer (FET) in Lahore</h1>
    <p class="sub">Frozen embryo transfer (FET) thaws high-quality embryos from a previous <a href={`${T}/ivf`}>IVF</a> or <a href={`${T}/icsi`}>ICSI</a> cycle and places them in a carefully prepared uterus. Separating egg retrieval from transfer lets the lining return to a natural, balanced state, which improves receptivity and removes the stimulation-related risks of a fresh transfer. Dr. Kamran Saleem tailors every cycle to your hormones and your embryos.</p>
    <p><a class="btn" href={wa}>Book an FET consultation</a> <a class="btn ghost" href="#fet-process">See the process</a></p>
    <p class="mini">Planning a transfer? Bring your embryo freezing reports and recent lining scans to the first visit.</p>
  </div>
  <div class="hside">
    <ul class="facts">
      <li><b>38–46%</b> pregnancy per transfer, under 35</li>
      <li><b>98%+</b> post-thaw survival with vitrification</li>
      <li><b>25+</b> years in reproductive health</li>
      <li><b>3</b> Lahore locations</li>
    </ul>
  </div>
</div></section>

<div class="w layout">
  <aside class="toc" aria-label="On this page"><p>On this page</p>
    {toc.map(([id, l]) => <a href={`#${id}`}>{l}</a>)}
    <a class="btn sm" href={wa}>Book now</a>
  </aside>
  <div class="content">
    <p class="review"><b>Medically reviewed:</b> Dr. Kamran Saleem (MBBS 1988; UK Dip GUM &amp; Ven, University of Liverpool 1998; PMDC registered) · Practice follows ASRM, ESHRE and WHO guidance · Last review November 2026 · <a href="/dr-kamran-saleem">About the doctor</a></p>

    <section id="what-is-fet">
      <h2>What Is Frozen Embryo Transfer?</h2>
      <p>FET is an assisted reproductive procedure in which embryos created in an earlier IVF or ICSI cycle are thawed and gently transferred into the uterus. Because the transfer happens in a separate, dedicated cycle, the endometrium is prepared under controlled conditions. This improves receptivity and live birth rates, and it removes the risk of ovarian hyperstimulation syndrome (OHSS) linked to fresh transfers. In Pakistan, FET achieves per-transfer success of 38% to 46% in women under 35, with cumulative success of about 65% to 72% across multiple cycles.</p>
      <div class="cards">
        {whyCards.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p>{p}</p></div>)}
      </div>
    </section>

    <section id="why-fet">
      <h2>Why FET Has Become a Primary Strategy in ART</h2>
      <p>Fresh transfers were once the norm, performed straight after ovarian stimulation. Research reviewed by ESHRE and ASRM shows that very high estrogen levels during a fresh cycle can impair endometrial receptivity and shift the implantation window.</p>
      <p>At Kamran Fertility Clinic, FET follows a patient-first, doctor-led pathway led by Dr. Kamran Saleem. Embryos are preserved at the blastocyst stage (Day 5/6) by ultra-rapid vitrification with near-complete post-thaw survival. The lining is then prepared under controlled, physiological conditions to maximize implantation precision and maternal-fetal safety.</p>
    </section>

    <section id="indications">
      <h2>Who Benefits Most From FET?</h2>
      <p>FET is recommended across a wide range of situations to improve outcomes and protect your health.</p>
      <div class="cards">
        {indications.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p>{p}</p></div>)}
      </div>
    </section>

    <section id="vitrification">
      <h2>Ultra-Rapid Vitrification vs Slow Freezing</h2>
      <p>The shift from slow freezing to vitrification is one of the biggest advances in embryology.</p>
      <div class="tw"><table>
        <thead><tr><th>Feature</th><th>Traditional slow freezing</th><th>Ultra-rapid vitrification</th></tr></thead>
        <tbody>{freezing.map(r => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td></tr>)}</tbody>
      </table></div>
      <div class="cards">
        {vitCards.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p>{p}</p></div>)}
      </div>
    </section>

    <section id="fresh-vs-frozen">
      <h2>Fresh vs Frozen Embryo Transfer</h2>
      <p>Understanding the trade-offs helps you decide with your specialist.</p>
      <div class="tw"><table>
        <thead><tr><th>Clinical feature</th><th>Fresh transfer</th><th>Frozen transfer (FET)</th></tr></thead>
        <tbody>{compare.map(r => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td></tr>)}</tbody>
      </table></div>
      <p class="note">Rates are typical clinical ranges and vary with age and embryo quality.</p>
    </section>

    <section id="protocols">
      <h2>Natural vs HRT (Programmed) FET</h2>
      <p>Dr. Kamran customizes preparation to your cycle regularity and hormone profile so the lining is receptive when the embryo is transferred.</p>
      <div class="tw"><table>
        <thead><tr><th></th><th>Programmed / HRT cycle</th><th>Natural / modified natural cycle</th></tr></thead>
        <tbody>{protoCompare.map(r => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td></tr>)}</tbody>
      </table></div>
      <div class="callout"><b>Which is better?</b> Neither is better for everyone. HRT gives precise scheduling for irregular cycles and PCOS. A natural cycle avoids synthetic estrogen when you ovulate regularly.</div>
    </section>

    <section id="fet-process">
      <h2>The FET Process, Step by Step</h2>
      <p>Every FET follows a five-phase protocol designed for comfort, safety and precision. The transfer itself takes about ten minutes.</p>
      <div class="ovwrap">
        <p class="ovtitle">FET Process at a Glance</p>
        <div class="ovrow">
          {overview.map((o, i) => (
            <>
              <a class="ov" href={o.h}>
                <span class="ovl">{o.l}</span>
                <span class="disc"><svg viewBox="0 0 100 100" set:html={o.art} /></span>
                <span class="ovn">{i + 1}</span>
              </a>
              {i < overview.length - 1 ? <span class="chev" aria-hidden="true"><svg viewBox="0 0 36 22"><path d="M3 3l7 8-7 8M14 3l7 8-7 8M25 3l7 8-7 8" /></svg></span> : null}
            </>
          ))}
        </div>
        <p class="ovhint">Select a stage to jump to its full explanation below.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step" id={`step-${i + 1}`}>
            <div class="media"><span class="ph"><svg viewBox="0 0 24 24" set:html={icons[s.icon]} /></span></div>
            <div class="body"><span class="num">Phase {i + 1} · {s.time}</span><h3>{s.t}</h3><p set:html={s.d} /></div>
          </li>
        ))}
      </ol>
    </section>

    <section id="success-rates">
      <h2>FET Success Rates by Age</h2>
      <p>Embryo quality and the mother's age at egg retrieval are the main drivers of success. These figures reflect realistic expectations for vitrified blastocyst transfers.</p>
      <div class="tw"><table>
        <thead><tr><th>Age at freezing</th><th>Implantation per blastocyst</th><th>Clinical pregnancy per transfer</th><th>Cumulative, 3 FET cycles</th><th>Key factors</th></tr></thead>
        <tbody>{rates.map(r => <tr>{r.map(c => <td>{c}</td>)}</tr>)}</tbody>
      </table></div>
      <ul class="tick">
        <li>Blastocyst grade and age at freezing matter most</li>
        <li>PGT-A helps select chromosomally normal embryos from age 38</li>
        <li>An 8–11 mm lining with a triple-line pattern gives the best implantation chance</li>
      </ul>
      <p class="note">Outcomes vary and no result is guaranteed. Dr. Kamran explains what the numbers mean for your embryos at your consultation.</p>
    </section>

    <section id="preparation">
      <h2>Before and After Your Transfer</h2>
      <p>Evidence-based steps that support implantation.</p>
      <h3>Pre-transfer optimization</h3>
      <div class="cards">
        {prepCards.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p>{p}</p></div>)}
      </div>
      <h3>Post-transfer care</h3>
      <div class="cards">
        {afterCards.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p>{p}</p></div>)}
      </div>
    </section>

    <section id="ethics">
      <h2>Islamic Jurisprudence and Legal Compliance in Pakistan</h2>
      <p>All assisted reproduction in Pakistan operates under legal and ethical frameworks, including Federal Shariat Court rulings.</p>
      <ul class="tick">
        <li>FET is permissible only with embryos created from the husband's sperm and wife's eggs within a valid marriage (Nikkah)</li>
        <li>Donor eggs, donor sperm and surrogacy are not offered</li>
        <li>Dual-witness barcoding at every cryo-storage, thawing and transfer step to protect genetic identity</li>
      </ul>
    </section>

    <section id="cost">
      <h2>FET Cost in Lahore: Transparent Fees</h2>
      <p>All consultation fees and treatment costs are explained upfront, before the cycle begins. For comparison see <a href="/resources/ivf-treatment-cost-in-pakistan">IVF treatment cost in Pakistan</a>.</p>
      <div class="cols">
        <div class="card"><h3>What the FET procedure includes</h3><ul class="tick"><li>Thawing of vitrified blastocysts</li><li>Embryology laboratory handling</li><li>Ultrasound-guided embryo transfer</li><li>Immediate post-procedure care</li></ul></div>
        <div class="card"><h3>Itemized separately</h3><ul class="tick"><li>Priming medicines (estrogen, progesterone, prenatal vitamins) by dose</li><li>Annual storage fees for remaining frozen embryos, clearly outlined</li></ul></div>
      </div>
    </section>

    <section id="faq">
      <h2>Frequently Asked Questions</h2>
      {faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
    </section>
  </div>
</div>

<section class="band"><div class="w">
  <h2>Related fertility treatments</h2>
  <div class="cards c3">
    {treatments.map(([n, s, d]) => <a class="card link" href={`${T}/${s}`}><h3>{n}</h3><p>{d}</p></a>)}
  </div>
  <p><a href={T}>See all fertility treatments →</a> · <a href="/services/assessment/hormonal-analysis">Hormonal analysis</a> · <a href="/services/support">Support &amp; Second Opinions</a></p>
</div></section>

<section class="cta"><div class="w">
  <h2>Schedule Your Unhurried FET Consultation</h2>
  <p>Whether this is your first transfer or you want a second opinion on cycle timing, you get a 45–60 minute consultation with Dr. Kamran Saleem. Bring previous IVF records, blastocyst freezing reports and recent lining scans. WhatsApp +92 314 8432789.</p>
  <a class="btn" href={wa}>Book an FET Consultation</a>
  <div class="cards c3 locs">
    {locations.map(([n, a, h, l]) => <a class="card link" href={l}><h3>{n}</h3><p>{a}</p><p class="hrs">{h}</p></a>)}
  </div>
</div></section>
</main>
</div>
</Layout>

