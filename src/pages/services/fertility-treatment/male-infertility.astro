  pill: '<rect x="3" y="9" width="18" height="7" rx="3.5" transform="rotate(-35 12 12)"/><path d="M9 8l6 8"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21v-1a8 8 0 0116 0v1"/>',
};

const toc = [["what-is","What it means"],["symptoms","Signs"],["causes","Causes"],["when-to-see","When to see a doctor"],["diagnosis","Semen test"],["conditions","Common problems"],["treatment","Treatment steps"],["retrieval","No sperm? Retrieval"],["success-rates","Success rates"],["lifestyle","Daily habits"],["ethics","Privacy"],["cost","Cost"],["faq","FAQ"]];

const overview = [
  { l: "Semen Test", h: "#step-1", art: '<rect x="37" y="14" width="26" height="7" rx="3" fill="#3b82f6" stroke="#0b1f4b" stroke-width="2"/><rect x="39" y="19" width="22" height="64" rx="11" fill="#e0eeff" stroke="#0b1f4b" stroke-width="3"/><rect x="42" y="44" width="16" height="36" rx="8" fill="#4cc9f0"/><circle cx="47" cy="56" r="2.5" fill="#ffffff"/><circle cx="54" cy="66" r="2" fill="#ffffff"/><circle cx="48" cy="74" r="2.5" fill="#ffffff"/>' },
  { l: "Blood Tests & Scan", h: "#step-2", art: '<circle cx="50" cy="50" r="32" fill="#fff" opacity=".75"/><circle cx="50" cy="50" r="18" fill="#60a5fa" stroke="#2563eb" stroke-width="2"/><circle cx="50" cy="50" r="7" fill="#0b1f4b"/>' },
  { l: "Medicines", h: "#step-3", art: '<circle cx="50" cy="50" r="40" fill="#3b82f6"/><g fill="#fff"><rect x="22" y="40" width="56" height="20" rx="10" transform="rotate(-35 50 50)"/></g><path d="M50 36l0 28" stroke="#3b82f6" stroke-width="3" transform="rotate(-35 50 50)"/>' },
  { l: "Sperm Retrieval", h: "#step-4", art: '<circle cx="50" cy="50" r="38" fill="#fff" stroke="#2563eb" stroke-width="5"/><circle cx="44" cy="52" r="11" fill="#fff" stroke="#0b1f4b" stroke-width="2"/><circle cx="44" cy="52" r="3.5" fill="#0b1f4b"/><path d="M62 38l11-6M64 48l13-2M62 58l11 5" stroke="#0b1f4b" stroke-width="1.8" stroke-linecap="round"/>' },
  { l: "ICSI", h: "#step-5", art: '<circle cx="50" cy="50" r="38" fill="#fff" opacity=".7"/><g fill="#93c5fd" stroke="#2563eb" stroke-width="2"><circle cx="36" cy="38" r="11"/><circle cx="60" cy="34" r="11"/><circle cx="68" cy="56" r="11"/><circle cx="46" cy="66" r="11"/><circle cx="31" cy="58" r="11"/><circle cx="50" cy="50" r="11"/></g><g fill="#0b1f4b"><circle cx="36" cy="38" r="4"/><circle cx="60" cy="34" r="4"/><circle cx="68" cy="56" r="4"/><circle cx="46" cy="66" r="4"/><circle cx="31" cy="58" r="4"/><circle cx="50" cy="50" r="4"/></g>' },
];

const steps = [
  { t: "Semen test", time: "First visit", icon: "flask", d: `We test a semen sample after 2–4 days without ejaculation. When needed, we also check for damage inside the sperm's DNA. You can book this on our <a href="/services/assessment/semen-analysis">semen analysis</a> page.` },
  { t: "Blood tests and a check-up", time: "Within days", icon: "clip", d: `The doctor examines you. You may need a scrotal scan and blood tests for hormones such as testosterone. See <a href="/services/assessment/hormonal-analysis">hormonal analysis</a>.` },
  { t: "Medicines and healthy changes", time: "Up to 3 months", icon: "pill", d: "We treat infections, fix hormone problems and may advise vitamins and antioxidants. Sperm take about 3 months to grow, so changes need that long to show." },
  { t: "Sperm retrieval, if needed", time: "Day surgery", icon: "scope", d: "If there is no sperm in the semen, a small procedure can collect sperm directly from the testicle or the tube next to it." },
  { t: "ICSI", time: "With your wife's cycle", icon: "target", d: `In <a href="${T}/icsi">ICSI</a>, the lab places one healthy sperm inside each egg. Mild cases may try <a href="${T}/iui">IUI</a> first.` },
];

const symptomCards = [
  ["Not getting pregnant", "The main sign is no pregnancy after a year of regular unprotected sex. Most men have no other sign.", "calendar"],
  ["Sexual problems", "Low desire, painful or weak erections, or little or no fluid when ejaculating.", "heart"],
  ["Changes in the testicles", "Swelling, heaviness, or testicles that feel small, soft or missing.", "alert"],
  ["Signs of low testosterone", "Less facial or body hair, breast enlargement or low energy.", "pulse"],
  ["Past health history", "Mumps, an undescended testicle, hernia surgery, injury, infections or cancer treatment.", "clip"],
  ["No signs at all", "Many men with poor sperm feel completely healthy. Only a semen test can tell.", "user"],
];

const causeCards = [
  ["Varicocele", "Swollen veins in the scrotum make the testicles too hot. This lowers sperm and testosterone.", "fire"],
  ["Infections", "Infections of the prostate, the tube next to the testicle or the urinary tract can harm or block sperm.", "shield"],
  ["Hormone problems", "If the body's hormone signals are weak, the testicles make fewer sperm.", "pulse"],
  ["Genetic causes", "Some men are born with gene or chromosome changes, or without the tube that carries sperm.", "dna"],
  ["Medicines and treatments", "Testosterone injections, long-term steroids, some antidepressants, ulcer or arthritis drugs, and cancer treatment.", "pill"],
  ["Long-term illness", "Diabetes and other illnesses can lower sperm quality and sexual function.", "drop"],
  ["Ejaculation problems", "Erection problems or ejaculation going backward into the bladder stop sperm from reaching the woman.", "heart"],
  ["Daily habits", "Smoking, obesity, heat, pollution and poor diet damage sperm.", "leaf"],
  ["Blockage", "A blocked tube from infection, injury or birth differences can stop sperm from coming out.", "layers"],
];

const who = [
  ["Semen amount", "1.4 mL or more", "How well the tubes and glands work", "Too little semen"],
  ["Sperm per mL", "16 million or more", "How many sperm the testicles make", "Low count, or no sperm at all"],
  ["Total sperm", "39 million or more", "Total supply in one sample", "Low supply"],
  ["Moving sperm (total)", "42% or more", "Share of sperm that move", "Poor movement"],
  ["Forward-moving sperm", "30% or more", "Sperm that swim straight ahead", "Important for natural pregnancy and IUI"],
  ["Normal shape", "4% or more", "Head, middle and tail look normal", "Many oddly shaped sperm"],
  ["Live sperm", "54% or more", "Tells dead sperm from still-but-alive sperm", "Checked when no sperm move"],
  ["Semen pH", "7.2 or more", "Balance that protects sperm", "Low pH can mean a blockage"],
  ["White blood cells", "Under 1 million per mL", "Signs of infection or swelling", "Possible infection"],
  ["DNA damage (DFI)", "Under 15% is ideal", "Breaks in sperm DNA", "Above 30% can cause failed treatment or miscarriage"],
];

const conditions = [
  ["Azoospermia (no sperm)", "About 1 in 10 infertile men has no sperm in the semen. Sometimes sperm are made but blocked. Sometimes the testicle makes very few or none, because of genes, undescended testicles or mumps.", "drop"],
  ["Low count, slow and odd-shaped sperm", "Doctors call this OAT. It is often linked to varicocele, hormones or damage from daily habits.", "cells"],
  ["Damaged sperm DNA", "A man can have a normal count and still struggle if the DNA inside the sperm is damaged. It can cause weak embryos and early miscarriage.", "dna"],
  ["Varicocele", "Swollen scrotal veins raise heat and lower oxygen. Both harm sperm and testosterone.", "fire"],
];

const medical = [
  ["Hormone injections", "hCG or hMG injections help men with very low hormone signals to restart sperm production.", "inject"],
  ["Hormone tablets", "Clomiphene or Anastrozole help the body make more of its own testosterone in selected men.", "pill"],
  ["Antioxidant vitamins", "A 3-month plan may include CoQ10, vitamins C and E, zinc and L-carnitine to protect sperm from damage.", "leaf"],
  ["Treating infection and varicocele", "Antibiotics for proven infection, and referral for varicocele surgery when it is needed.", "shield"],
];

const retrieval = [
  ["TESA", "Needle takes a small sample from the testicle", "A blockage (sperm are made normally)", "Simple, minimal cut"],
  ["PESA", "Fine needle collects sperm from the tube next to the testicle", "A blocked sperm tube", "Simple, minimal cut"],
  ["Micro-TESE", "Surgeon uses a microscope to find the healthy sperm-making tubes", "Testicle makes little or no sperm", "Day surgery with anesthesia"],
];

const prognosis = [
  ["Mildly low count (10–15 million/mL)", "IUI or timed sex, with ovulation medicine for the wife", "15% – 20% (with IUI)", "Gentle treatment is a good first step"],
  ["Very low count (under 5 million/mL)", "ICSI with the normal semen sample", "35% – 42%", "ICSI skips the steps that sperm struggle with"],
  ["Blocked tubes, no sperm", "TESA or PESA, then ICSI", "38% – 45%", "Sperm are made normally, so retrieval usually works"],
  ["Testicle makes no sperm", "Micro-TESE, then ICSI", "30% – 38%", "Sperm are found in about 45–60% of men"],
  ["High DNA damage (above 30%)", "3 months of antioxidants, then ICSI with careful sperm selection", "35% – 40%", "Better sperm choice may lower miscarriage risk"],
];

const lifestyle = [
  ["Quit smoking, cut alcohol", "Both lower count, movement and DNA quality.", "alert"],
  ["Keep the testicles cool", "Avoid hot baths, saunas, tight underwear and a laptop on your lap.", "fire"],
  ["Keep a healthy weight", "Extra weight lowers testosterone. Regular exercise helps.", "pulse"],
  ["Eat well", "Fruit, vegetables, nuts, fish and whole grains support healthy sperm.", "leaf"],
  ["Check your medicines", "Never stop a prescribed medicine on your own, but ask us if it could affect fertility.", "pill"],
  ["Sleep and stress", "Poor sleep and long-term stress can upset hormones and sexual function.", "heart"],
];

const faqs = [
  ["Can a man with zero sperm have his own child?", "Often, yes. Sperm can be collected from the testicle in about 45–60% of men whose testicles make very few sperm. If the problem is only a blockage, collection usually works. The sperm are then used for ICSI."],
  ["What is the difference between TESA and Micro-TESE?", "TESA uses a needle and suits men whose sperm are made normally but blocked. Micro-TESE uses a surgical microscope to find tiny pockets of sperm in men whose testicles make very little."],
  ["Why does sperm DNA damage matter?", "Damaged sperm can still fertilize an egg, but the embryo may grow poorly or be lost early. Three months of antioxidants and careful sperm selection may improve results."],
  ["How long is recovery after Micro-TESE?", "It is day surgery with anesthesia. Most men do light activity again in 2–3 days and fully recover in 7–10 days."],
  ["Can male infertility be cured?", "Many causes can be treated. Even severe cases often have a route to your own biological child through ICSI. A full check-up shows which route suits you."],
  ["When should a man be tested?", "A semen test is one of the first tests for any couple who has not conceived. Do not wait if you are over 35 or have known risk factors."],
  ["Will my results stay private?", "Yes. Visits take place in a private setting. Results are shared only with you and, with your consent, your wife."],
];

const treatments = [
  ["ICSI", "icsi", "One sperm placed inside each egg."],
  ["IUI Treatment", "iui", "Washed sperm placed in the womb for mild cases."],
  ["IVF Treatment", "ivf", "Egg collection, fertilization and embryo transfer."],
  ["PGT Genetic Testing", "pgt", "Checks embryos when genetics are a worry."],
  ["PCOS Fertility Treatment", "pcos", "When the wife also has ovulation problems."],
  ["Egg & Sperm Freezing", "fertility-preservation", "Freeze sperm before treatment or surgery."],
];

const locations = [
  ["Rasheed Hospital", "Main Boulevard, DHA Defence", "Daily 3:00pm–6:00pm (Sat & Sun closed)", "/locations/dha-lahore"],
  ["TAMC", "M.M. Alam Road, Gulberg", "Wednesday 12:00pm–3:00pm, other days by appointment", "/locations/mm-alam-road-lahore"],
  ["Shahnaz Hospital", "Shalamar Link Road", "Monday & Thursday 6:00pm–9:00pm", "/locations/shalamar-lahore"],
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "MedicalWebPage", "@id": url, url, name: title, description, inLanguage: "en-PK", lastReviewed: "2026-11", medicalAudience: "Patient",
      reviewedBy: { "@type": "Physician", name: "Dr. Kamran Saleem" }, about: { "@id": url + "#condition" } },
    { "@type": "MedicalCondition", "@id": url + "#condition", name: "Male Infertility", alternateName: "Male factor subfertility",
      description: "Reduced ability of a man to help a couple conceive, due to low sperm count, poor movement, abnormal shape, DNA damage or absence of sperm.",
      possibleTreatment: [{ "@type": "MedicalTherapy", name: "Hormonal and antioxidant therapy" }, { "@type": "MedicalProcedure", name: "Micro-TESE" }, { "@type": "MedicalProcedure", name: "ICSI" }] },
    { "@type": "Physician", "@id": base + "/dr-kamran-saleem#physician", name: "Dr. Kamran Saleem", alumniOf: "University of Liverpool", identifier: "PMDC Registered", medicalSpecialty: "Reproductive Endocrinology and Infertility" },
    { "@type": "MedicalClinic", "@id": base + "/#clinic", name: "Kamran Fertility Clinic", url: base, telephone: "+923148432789",
      location: ["Rasheed Hospital (DHA Defence)", "TAMC Clinic (M.M. Alam Road, Gulberg)", "Shahnaz Hospital (Shalamar Link Road)"].map(n => ({ "@type": "Place", name: n, address: { "@type": "PostalAddress", addressLocality: "Lahore", addressRegion: "Punjab", addressCountry: "PK" } })) },
    { "@type": "BreadcrumbList", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: base + "/" },
      { "@type": "ListItem", position: 2, name: "Fertility Treatment", item: base + T },
      { "@type": "ListItem", position: 3, name: "Male Infertility Treatment", item: url } ] },
    { "@type": "FAQPage", mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) },
  ],
};
---
<Layout title={title} description={description}>
<div class="ivf">
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<main>
<section class="hero"><div class="w hgrid">
  <div>
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href={T}>Fertility Treatment</a> / Male Infertility</nav>
    <p class="eye">Private · Doctor-led · Lahore</p>
    <h1>Male Infertility Treatment in Lahore</h1>
    <p class="sub">In about 4 out of 10 couples who cannot conceive, the problem lies with the man. Yet it is the least talked about. Dr. Kamran Saleem has 25+ years of experience and a UK qualification in genito-urinary medicine. He offers testing, medicines, sperm retrieval surgery and <a href={`${T}/icsi`}>ICSI</a> in a private and respectful setting. Even men with no sperm in the semen often have a way to become fathers.</p>
    <p><a class="btn" href={wa}>Book a private consultation</a> <a class="btn ghost" href="#treatment">See the treatment steps</a></p>
    <p class="mini">Not sure where to start? Begin with a <a href="/services/assessment/semen-analysis">semen test</a>. It is simple and tells us a lot.</p>
  </div>
  <div class="hside">
    <ul class="facts">
      <li><b>40–50%</b> of couples have a male cause</li>
      <li><b>70–80%</b> of eggs fertilize with ICSI</li>
      <li><b>45–60%</b> sperm found in men with very low production</li>
      <li><b>25+</b> years of experience</li>
    </ul>
  </div>
</div></section>

<div class="w layout">
  <aside class="toc" aria-label="On this page"><p>On this page</p>
    {toc.map(([id, l]) => <a href={`#${id}`}>{l}</a>)}
    <a class="btn sm" href={wa}>Book now</a>
  </aside>
  <div class="content">
    <p class="review"><b>Medically reviewed:</b> Dr. Kamran Saleem (MBBS 1988; UK Dip GUM &amp; Ven, University of Liverpool 1998; PMDC registered) · Follows ASRM, ESHRE and WHO 6th Edition (2021) guidance · Last review November 2026 · <a href="/dr-kamran-saleem">About the doctor</a></p>

    <section id="what-is">
      <h2>What Is Male Infertility?</h2>
      <p>Male infertility means a man's sperm cannot help a couple get pregnant, usually after one year of regular sex without protection.</p>
      <p>To get pregnant, healthy sperm must swim into the woman's body and join with an egg. The embryo then settles in the womb. Each step depends on how many sperm there are, how well they move, what shape they have and whether their DNA is healthy.</p>
      <p>In Pakistan, the woman is often tested first and the man is tested late, or not at all. That wastes time and money. Testing both partners early is the better way.</p>
      <div class="callout"><b>Fertility is a shared issue.</b> Treatment works best when both partners are checked together. See how we check women on our <a href="/services/assessment">fertility assessment</a> page.</div>
    </section>

    <section id="symptoms">
      <h2>Signs of Male Infertility</h2>
      <p>Most men feel fine. That is why male infertility is easy to miss. The most common sign is simply not getting pregnant.</p>
      <div class="cards">
        {symptomCards.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p>{p}</p></div>)}
      </div>
    </section>

    <section id="causes">
      <h2>What Causes Male Infertility?</h2>
      <p>The cause may be in making sperm, moving sperm out, or the quality of the sperm. Often there is more than one cause.</p>
      <div class="cards">
        {causeCards.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p>{p}</p></div>)}
      </div>
      <p class="note">In some men no cause is found. Treatment can still help.</p>
    </section>

    <section id="when-to-see">
      <h2>When Should You See a Doctor?</h2>
      <p>Both partners should be checked together if:</p>
      <ul class="tick">
        <li>You are under 35 and have tried for 12 months</li>
        <li>You are 35 or older and have tried for 6 months</li>
        <li>You had an undescended testicle, testicle surgery, mumps, cancer treatment or sexual difficulty, even sooner</li>
        <li>A past semen test was abnormal</li>
      </ul>
      <p>A simple semen test is often enough to show if a male cause exists. Infertility is stressful and many people feel judged. Getting clear answers early helps. Want another opinion on earlier results? See <a href="/services/support">support and second opinions</a>.</p>
    </section>

    <section id="diagnosis">
      <h2>The Semen Test: What the Numbers Mean</h2>
      <p>We follow the World Health Organization (WHO) 2021 standards. These numbers are the lowest normal values. A result below them points to a problem, but it does not mean a man cannot be a father.</p>
      <div class="tw"><table>
        <thead><tr><th>Test</th><th>Normal (WHO lowest limit)</th><th>What it shows</th><th>If it is low or high</th></tr></thead>
        <tbody>{who.map(r => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td><td>{r[3]}</td></tr>)}</tbody>
      </table></div>
      <p class="note">Results can change from day to day, so we often repeat the test after 2–3 months.</p>
    </section>

    <section id="conditions">
      <h2>Common Male Fertility Problems</h2>
      <div class="cards">
        {conditions.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p>{p}</p></div>)}
      </div>
    </section>

    <section id="treatment">
      <h2>Treatment Step by Step</h2>
      <p>We start with the gentlest option that fits your results. Many men do not need every step.</p>
      <div class="ovwrap">
        <p class="ovtitle">Your Care at a Glance</p>
        <div class="ovrow">
          {overview.map((o, i) => (
            <>
              <a class="ov" href={o.h}>
                <span class="ovl">{o.l}</span>
                <span class="disc"><svg viewBox="0 0 100 100" set:html={o.art} /></span>
                <span class="ovn">{i + 1}</span>
              </a>
              {i < overview.length - 1 ? <span class="chev" aria-hidden="true"><svg viewBox="0 0 36 22"><path d="M3 3l7 8-7 8M14 3l7 8-7 8M25 3l7 8-7 8" /></svg></span> : null}
            </>
          ))}
        </div>
        <p class="ovhint">Tap a stage to jump to its details below.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step" id={`step-${i + 1}`}>
            <div class="media"><span class="ph"><svg viewBox="0 0 24 24" set:html={icons[s.icon]} /></span></div>
            <div class="body"><span class="num">Step {i + 1} · {s.time}</span><h3>{s.t}</h3><p set:html={s.d} /></div>
          </li>
        ))}
      </ol>
      <h3>Medicines and hormone treatment</h3>
      <div class="cards">
        {medical.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p>{p}</p></div>)}
      </div>
      <p class="note">Studies on vitamins and antioxidants give mixed results, so we use them selectively and repeat your test to see if they help.</p>
    </section>

    <section id="retrieval">
      <h2>No Sperm in the Semen? Sperm Retrieval Can Help</h2>
      <p>If the semen has no sperm, we can often collect sperm directly from the testicle or the tube next to it. The sperm are then used in <a href={`${T}/icsi`}>ICSI</a>. The method depends on whether the problem is a blockage or low production.</p>
      <div class="tw"><table>
        <thead><tr><th>Procedure</th><th>How it works</th><th>Best for</th><th>Notes</th></tr></thead>
        <tbody>{retrieval.map(r => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td><td>{r[3]}</td></tr>)}</tbody>
      </table></div>
      <div class="callout"><b>Micro-TESE</b> is the best surgical option when the testicle makes very little sperm. Sperm are found in about 45–60% of men. Collected sperm can be frozen, so your wife's egg collection can be planned calmly. See <a href={`${T}/fertility-preservation`}>sperm freezing</a>.</div>
    </section>

    <section id="success-rates">
      <h2>Success Rates</h2>
      <p>These are typical results when the wife is under 35.</p>
      <div class="tw"><table>
        <thead><tr><th>Problem</th><th>Usual first treatment</th><th>Live birth per cycle</th><th>Good to know</th></tr></thead>
        <tbody>{prognosis.map(r => <tr>{r.map(c => <td>{c}</td>)}</tr>)}</tbody>
      </table></div>
      <p class="note">Results depend a lot on your wife's age and egg quality. Nothing is guaranteed. If sperm DNA or genes are a worry, ask about <a href={`${T}/pgt`}>PGT genetic testing</a>.</p>
    </section>

    <section id="lifestyle">
      <h2>Daily Habits That Help Sperm</h2>
      <p>Sperm take about 3 months to grow. Healthy changes need that long to show up in a new test.</p>
      <div class="cards">
        {lifestyle.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p>{p}</p></div>)}
      </div>
    </section>

    <section id="ethics">
      <h2>Privacy and Legal Rules in Pakistan</h2>
      <p>Our care follows Pakistani law and Federal Shariat Court rulings.</p>
      <ul class="tick">
        <li>Only the husband's sperm and wife's eggs are used. Donor sperm and surrogacy are not offered</li>
        <li>Two staff members check the identity of every sample and dish</li>
        <li>Private visits in a respectful setting. Your medical details stay confidential</li>
      </ul>
    </section>

    <section id="cost">
      <h2>How Much Does It Cost in Lahore?</h2>
      <p>You will know the cost before any test or procedure. For the full cycle cost see <a href="/resources/ivf-treatment-cost-in-pakistan">IVF treatment cost in Pakistan</a>.</p>
      <div class="cols">
        <div class="card"><h3>Tests</h3><ul class="tick"><li>Semen test and DNA damage test</li><li>Hormone blood tests: testosterone, FSH, LH, prolactin, thyroid</li></ul></div>
        <div class="card"><h3>Sperm retrieval (Micro-TESE / TESA)</h3><ul class="tick"><li>Operating theater and microscope</li><li>Lab handling of the sperm</li><li>Timing with your wife's ICSI cycle</li></ul></div>
      </div>
    </section>

    <section id="faq">
      <h2>Common Questions</h2>
      {faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
    </section>
  </div>
</div>

<section class="band"><div class="w">
  <h2>Related fertility treatments</h2>
  <div class="cards c3">
    {treatments.map(([n, s, d]) => <a class="card link" href={`${T}/${s}`}><h3>{n}</h3><p>{d}</p></a>)}
  </div>
  <p><a href={T}>See all fertility treatments →</a> · <a href="/services/assessment/semen-analysis">Semen analysis</a> · <a href="/services/assessment/hormonal-analysis">Hormonal analysis</a> · <a href="/services/support">Support &amp; Second Opinions</a></p>
</div></section>

<section class="cta"><div class="w">
  <h2>Book a Private Male Fertility Consultation</h2>
  <p>Worried about a semen result, a low count or no sperm? You will get clear answers and a plan. Dr. Kamran Saleem gives you a private 45–60 minute visit. Bring any earlier semen and hormone reports. WhatsApp +92 314 8432789.</p>
  <a class="btn" href={wa}>Book a Private Consultation</a>
  <div class="cards c3 locs">
    {locations.map(([n, a, h, l]) => <a class="card link" href={l}><h3>{n}</h3><p>{a}</p><p class="hrs">{h}</p></a>)}
  </div>
</div></section>
</main>
</div>
</Layout>

