---
import TreatmentPage from "../../../components/TreatmentPage.astro";

const T = "/services/fertility-treatment";

const page = {
  slug: "ivf",
  name: "IVF Treatment",
  title: "IVF Treatment in Lahore: Process, Cost & Rates | Dr. Kamran",
  description:
    "Consult UK-qualified specialist Dr. Kamran Saleem for doctor-led IVF in Lahore. Transparent costs, high success rates, & ethical care in DHA, Gulberg & Shalamar.",
  eyebrow: "IVF Treatment",
  h1: "IVF Treatment in Lahore",
  waText: "Hello, I would like to book an IVF consultation with Dr. Kamran Saleem.",
  ctaLabel: "Book an IVF consultation",
  heroSub: [
    "In vitro fertilization (IVF), often called test tube baby treatment, combines eggs and sperm in a laboratory and transfers the resulting embryo to the uterus.",
    "At Kamran Fertility Clinic, Dr. Kamran Saleem (MBBS 1988; Diploma, University of Liverpool 1998; PMDC registered) plans each cycle around your test results and explains every stage, risk and cost before treatment begins.",
    "IVF is recommended when your findings point to it, not as a default.",
  ].join(" "),
  leadIn: [
    { rich: ["Not sure whether IVF is the right step yet? Start with our ", ["Fertility Assessment & Diagnosis", "/services/assessment"], " service, so any recommendation is based on your results."] },
  ],
  sections: [
    {
      id: "what-is-ivf",
      title: "What Is IVF (In Vitro Fertilization)?",
      intro: "IVF means fertilization in a laboratory dish instead of inside the body.",
      icon: "flask",
      body: [
        "Medication encourages the ovaries to develop several mature eggs. These are collected, fertilized with sperm in an embryology laboratory, and grown for three to six days to the blastocyst stage. The best embryo can then be transferred to the uterus, or frozen for a later transfer. The pregnancy develops in the womb as usual.",
        { rich: ["IVF is one of several assisted reproductive treatments. Depending on your results, a simpler option such as ", ["IUI", `${T}/iui`], " may be appropriate first, or ", ["ICSI", `${T}/icsi`], " may be added to IVF when sperm factors require it."] },
      ],
    },
    {
      id: "who-needs-ivf",
      title: "Who May Need IVF?",
      intro: "IVF is considered when the cause of infertility, or the time already spent trying, makes simpler treatment unlikely to work.",
      icon: "user",
      body: [
        "IVF may be recommended in situations such as:",
        { ul: [
          "Tubal factor: blocked, damaged or absent fallopian tubes, hydrosalpinx or severe pelvic adhesions",
          "Moderate to severe endometriosis affecting egg quality, the tubes or implantation",
          "Reduced ovarian reserve (low AMH or antral follicle count) or age 35 and over, where time matters",
          "Male-factor infertility such as low count or poor motility, with or without ICSI",
          "Unexplained infertility, or unsuccessful IUI cycles after careful review",
          "A known genetic condition where embryo testing (PGT) is being considered",
        ] },
        { rich: ["Equally important is who does not need IVF yet. Many couples are first asked to repeat a test, correct a hormone problem or try a lower-intensity treatment such as ", ["ovulation induction", `${T}/ovulation-induction`], ". Your plan follows your findings, not a standard package."] },
      ],
    },
    {
      id: "pre-ivf-tests",
      title: "Before You Start: Tests and Preparation",
      intro: "These results decide your protocol and starting dose.",
      icon: "calendar",
      body: [
        { ul: [
          "AMH and antral follicle count ultrasound: measures ovarian reserve and sets the stimulation dose",
          "Baseline hormone panel (FSH, LH, estradiol, TSH, prolactin): excludes thyroid, prolactin or pituitary causes",
          "Semen analysis including DNA fragmentation where relevant: guides the choice between standard IVF and ICSI",
          "Pelvic ultrasound and, where needed, hysteroscopy: checks the uterine cavity for fibroids, polyps or adhesions",
          "Blood group, rubella immunity and general health clearance",
        ] },
        { rich: ["Read more about ", ["hormonal analysis", "/services/assessment/hormonal-analysis"], " and ", ["semen analysis", "/services/assessment/semen-analysis"], "."] },
      ],
    },
    {
      id: "ivf-process-step-by-step",
      title: "The IVF Process, Step by Step",
      intro: "A typical IVF cycle takes around four to six weeks from the start of medication to the pregnancy test.",
      icon: "calendar",
      body: [
        { h3: "1. Assessment and planning" },
        "Hormone tests, a pelvic ultrasound with antral follicle count, a semen analysis, and a check of the uterine cavity where needed decide your protocol.",
        { h3: "2. Ovarian stimulation (about 8 to 14 days)" },
        "Daily FSH injections, sometimes with LH, grow several follicles. Ultrasound scans track growth every few days so the dose can be adjusted, and a second medication stops the eggs being released too early.",
        { h3: "3. Trigger injection" },
        "When the follicles reach the right size, a trigger injection matures the eggs. Retrieval is timed for roughly 34 to 36 hours later.",
        { h3: "4. Egg retrieval" },
        "A 15 to 20 minute procedure under sedation. A fine needle, guided by ultrasound, collects the eggs through the vaginal wall. There are no cuts, and most women go home the same day.",
        { h3: "5. Fertilization: IVF or ICSI" },
        { rich: ["Eggs and sperm are combined in the laboratory, or a single sperm is injected into each mature egg when ", ["ICSI", `${T}/icsi`], " is indicated."] },
        { h3: "6. Embryo culture and grading" },
        { rich: ["Embryos are grown for up to five or six days to the blastocyst stage, then graded and the strongest selected. ", ["Genetic testing (PGT)", `${T}/pgt`], " is considered only in selected cases."] },
        { h3: "7. Embryo transfer" },
        { rich: ["A thin catheter places the selected embryo in the uterus under ultrasound guidance, usually without anesthesia. Surplus good-quality embryos can be frozen; see ", ["Frozen Embryo Transfer (FET)", `${T}/fet`], "."] },
        { h3: "8. Pregnancy test" },
        "A blood test is usually done 10 to 14 days after transfer. Testing at home too early can give a misleading result.",
      ],
    },
    {
      id: "ivf-injections-and-medication",
      title: "IVF Injections and Medication",
      intro: "The injections are the part most people worry about, and often turn out to be easier than expected.",
      icon: "bolt",
      body: [
        { ul: [
          "Gonadotropins (FSH, sometimes with LH) that stimulate several follicles to grow",
          "GnRH antagonist or agonist, which prevents the eggs being released too early",
          "A trigger injection that matures the eggs before retrieval",
          "Progesterone, to support the uterine lining after embryo transfer",
          "Estrogen tablets or patches in frozen embryo transfer cycles",
        ] },
        "Most injections are small shots under the skin, given with pre-filled pens, and you are shown how to give them. Doses are individual, which is why monitoring scans matter.",
        "Bloating, mood changes, headaches and bruising are common. Severe abdominal pain, rapid weight gain, repeated vomiting or breathlessness are not, and should be reported urgently.",
      ],
    },
    {
      id: "ivf-success-rates",
      title: "IVF Success Rates in Pakistan: Realistic Metrics",
      intro: "We report live births per cycle, not early positive tests. No clinic can promise a result.",
      icon: "heart",
      body: [
        "Approximate live birth rates with the woman's own eggs, by age (single cycle, then cumulative over three cycles):",
        { ul: [
          "Under 35: 35% to 40% per cycle, 65% to 72% over three cycles. Single blastocyst transfer is recommended to avoid twins",
          "35 to 37: 25% to 30% per cycle, 52% to 60% over three cycles",
          "38 to 40: 15% to 20% per cycle, 35% to 42% over three cycles. PGT-A may be considered",
          "41 to 42: 6% to 10% per cycle, 18% to 24% over three cycles",
          "Over 42: 2% to 4% per cycle, under 10% over three cycles",
        ] },
        "Outcomes vary between individuals and no result is guaranteed. Beyond age, the main factors are ovarian reserve, embryo quality, sperm quality, the uterus and the underlying diagnosis. Dr. Kamran will give you an honest individual estimate, including when the likely benefit of IVF is low.",
      ],
    },
    {
      id: "ivf-risks-and-complications",
      title: "IVF Risks and Possible Complications",
      intro: "IVF is widely used and generally safe, but it is a medical treatment with real risks that should be discussed before you start.",
      icon: "shield",
      body: [
        { ul: [
          "Ovarian hyperstimulation syndrome (OHSS): an exaggerated response to stimulation. Severe cases are uncommon, and careful monitoring or a freeze-all approach is used to prevent them.",
          "Multiple pregnancy: twins or triplets carry higher risks. Transferring a single good-quality embryo greatly reduces this.",
          "Procedure-related risks: rare bleeding or infection during egg retrieval, plus the small risks of sedation.",
          "Ectopic pregnancy and miscarriage: related mainly to tubal disease, age and embryo quality.",
          "Emotional strain: waiting, cost and uncertainty are heavy. Asking for support is reasonable.",
        ] },
        "Seek urgent medical attention for severe abdominal pain, heavy bleeding, fever, difficulty breathing or very rapid weight gain during treatment. We do not provide emergency care.",
      ],
    },
    {
      id: "ethical-compliance",
      title: "Ethical and Legal Compliance in Pakistan",
      intro: "All treatment follows Pakistani law and Federal Shariat Court rulings on assisted reproduction.",
      icon: "shield",
      body: [
        { ul: [
          "Only the legal husband's sperm and the legally wedded wife's eggs are used",
          "Donor eggs, donor sperm, donor embryos and surrogacy are not offered",
          "Double-witness verification is used at every stage of egg collection, sperm preparation, fertilization and embryo transfer",
        ] },
      ],
    },
    {
      id: "ivf-cost-in-lahore",
      title: "IVF Cost in Lahore: Transparent Fees",
      intro: "A single fixed IVF price would be misleading, because cycles differ.",
      icon: "coin",
      body: [
        "The package covers scans during stimulation, consultations with Dr. Kamran, egg retrieval with theater and nursing care, embryology laboratory work to blastocyst stage, and ultrasound-guided embryo transfer. These are disclosed upfront because they vary by patient:",
        { ul: [
          "Stimulation medication, prescribed per your AMH and age",
          "ICSI, if indicated",
          "Embryo freezing and annual storage",
          "Sperm retrieval or PGT biopsy",
        ] },
        "Add-ons deserve scrutiny. Several popular ones have limited evidence of benefit for most patients, and we suggest them only where there is a clear clinical reason.",
        { rich: ["An itemized estimate is explained before you commit. For a wider overview, see our guide to ", ["IVF treatment cost in Pakistan", "/resources/ivf-treatment-cost-in-pakistan"], "."] },
      ],
    },
    {
      id: "ivf-after-unsuccessful-cycle",
      title: "IVF After an Unsuccessful Cycle or at Another Clinic",
      intro: "A negative result is painful, but it is information, not necessarily a final answer.",
      icon: "refresh",
      body: [
        "Bring the cycle summary: protocol, number of eggs, fertilization results, embryo grades and transfer details. Reviewing these often shows whether the difficulty was ovarian response, fertilization, embryo development or implantation.",
        { rich: ["You can also request an independent view through our ", ["Support & Second Opinions", "/services/support"], " service."] },
      ],
    },
    {
      id: "ivf-vs-iui-vs-icsi",
      title: "IVF, IUI or ICSI: How They Differ",
      intro: "These are different treatments, not steps on a fixed ladder.",
      icon: "compare",
      body: [
        { ul: [
          "IUI places prepared sperm in the uterus and fertilization still happens in the body. It suits only open tubes and adequate sperm quality.",
          "IVF fertilizes eggs outside the body and transfers an embryo. It bypasses tubal problems and allows embryo selection and freezing.",
          "ICSI is a laboratory technique used within IVF, where one sperm is injected into one egg when sperm factors make standard IVF unreliable.",
        ] },
        { rich: ["Read more: ", ["IUI treatment", `${T}/iui`], ", ", ["ICSI treatment", `${T}/icsi`], ", ", ["male infertility treatment", `${T}/male-infertility`], " and ", ["IVF vs IUI", "/resources/ivf-vs-iui"], "."] },
      ],
    },
    {
      id: "why-dr-kamran",
      title: "Why Choose Dr. Kamran Saleem",
      intro: "Doctor-led care with time to listen.",
      icon: "user",
      body: [
        { ul: [
          "25 years of experience in reproductive health and fertility",
          "Unhurried 45 to 60 minute consultations to review history, reports and concerns",
          "Doctor-led care, with scans, protocol changes and transfer planning handled by Dr. Kamran for continuity",
        ] },
        { rich: ["Learn more ", ["about Dr. Kamran Saleem", "/dr-kamran-saleem"], " or see our ", ["clinic locations", "/locations"], " in DHA, M.M. Alam Road and Shalamar."] },
      ],
    },
  ],
  faqs: [
    { q: "What is IVF treatment?", a: "IVF (in vitro fertilization) is a treatment in which eggs are collected, fertilized with sperm in a laboratory, and the resulting embryo is transferred to the uterus. It is used when simpler treatment is unlikely to work or has not worked." },
    { q: "Is IVF the same as test tube baby treatment?", a: "Yes. Test tube baby is the popular name for IVF. Fertilization happens in a laboratory dish, but the pregnancy develops in the mother's womb in the usual way." },
    { q: "How long does one IVF cycle take?", a: "Ovarian stimulation usually takes 8 to 14 days, followed by egg retrieval, fertilization, embryo development and transfer. From the start of medication to the pregnancy test is typically four to six weeks, longer if embryos are frozen for a later transfer." },
    { q: "Is IVF painful?", a: "Injections can sting or bruise. Egg retrieval is done under sedation, so you should not feel it, though cramping and bloating are common afterwards. Embryo transfer is usually painless." },
    { q: "Will IVF work on the first attempt?", a: "It can, but nobody can promise it. Success depends mainly on age, ovarian reserve, embryo quality and the cause of infertility. Many people need more than one transfer, which is why embryo freezing and cumulative results matter." },
    { q: "How much does IVF cost in Lahore?", a: "The cost depends on your medication, whether ICSI, freezing or genetic testing are needed, and how many transfers are required. You will receive an itemized estimate during your consultation, before any treatment begins." },
    { q: "Can I travel or work after an embryo transfer?", a: "Light daily activity is fine and prolonged bed rest is unnecessary. Avoid heavy lifting, strenuous exercise and hot baths during the two-week wait." },
    { q: "What happens to surplus embryos?", a: "Good-quality embryos can be frozen and stored for a later frozen embryo transfer, avoiding the need for full ovarian stimulation again." },
    { q: "When can I take a pregnancy test after embryo transfer?", a: "A blood test is usually done about 10 to 14 days after transfer. Testing earlier at home can show a false negative, or a false positive caused by the trigger injection." },
    { q: "Do I need ICSI with IVF?", a: "Not always. ICSI is used mainly for male-factor infertility, previous fertilization failure or surgically retrieved sperm. For couples without those issues, routine ICSI has not been shown to improve live birth rates." },
  ],
  closingHeading: "IVF Treatment in Lahore With Dr. Kamran Saleem",
  closingParas: [
    "At Kamran Fertility Clinic, Dr. Kamran Saleem provides IVF treatment planning for women and men in Lahore, with 25 years of experience in reproductive health and fertility.",
    "Your plan is based on your own results: whether IVF is the right treatment, which protocol suits you, whether ICSI or embryo freezing is needed, and what each stage will cost.",
    "We are open about which stages are managed in the clinic and which are coordinated with partner laboratories, so you know exactly what to expect before you begin.",
  ],
  resources: [
    { href: "/resources/ivf-treatment-in-lahore", category: "Fertility Treatment", title: "IVF Treatment in Lahore: Cost, Process, Tests & Choosing the Right Clinic" },
    { href: "/resources/ivf-treatment-cost-in-pakistan", category: "Fertility Treatment", title: "IVF Treatment Cost in Pakistan 2026" },
    { href: "/resources/ivf-vs-iui", category: "Treatments", title: "IVF vs IUI: understanding the difference" },
  ],
  close: {
    heading: "Ready to Talk About IVF?",
    body: "Bring any previous reports, semen analysis or treatment summaries to your consultation, so your IVF plan starts from the facts.",
    cta: "Book an IVF Consultation",
  },
};
---

<TreatmentPage {...page} />
