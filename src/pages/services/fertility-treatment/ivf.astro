---
// src/pages/services/fertility-treatment/ivf.astro
// Uses the site's own menu/footer via Layout. Fix the import path + props to match TreatmentPage.astro.
// Colors are the --c-* variables in <style>.
import Layout from "../../../layouts/Layout.astro";
// Photos: set `image` (and `alt`) on any step, or `heroImage`, to a file in /public/assets/. Icons show until then.
const base = "https://www.kamranfertility.com";
const T = "/services/fertility-treatment";
const url = `${base}${T}/ivf`;
const title = "IVF Treatment in Lahore: Process, Cost & Rates | Dr. Kamran";
const description = "Consult UK-qualified specialist Dr. Kamran Saleem for doctor-led IVF in Lahore. Transparent costs, high success rates, & ethical care in DHA, Gulberg & Shalamar.";
const wa = "https://wa.me/923148432789?text=" + encodeURIComponent("Hello, I would like to book an IVF consultation with Dr. Kamran Saleem.");
const heroImage = ""; // e.g. "/assets/ivf-hero.webp"

const icons = {
  flask: '<path d="M9 3h6M10 3v6l-5 9a2 2 0 002 3h10a2 2 0 002-3l-5-9V3"/>',
  inject: '<path d="M4 20l9-9M13 11l-2-2 5-5 4 4-5 5zM3 21l2-1"/>',
  bolt: '<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',
  target: '<circle cx="12" cy="12" r="4"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/>',
  cells: '<circle cx="8" cy="8" r="3"/><circle cx="16" cy="8" r="3"/><circle cx="12" cy="16" r="3"/>',
  merge: '<circle cx="9" cy="12" r="5"/><path d="M14 12h7M18 9l3 3-3 3"/>',
  heart: '<path d="M12 21s-7-4.5-7-10a4 4 0 017-2.6A4 4 0 0119 11c0 5.5-7 10-7 10z"/>',
  check: '<path d="M5 12l5 5 9-10"/>',
  clip: '<rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4h6v3H9zM9 12h6M9 16h6"/>',
};

const toc = [
  ["what-is-ivf", "What is IVF"], ["who-needs-ivf", "Who needs IVF"], ["pre-ivf-tests", "Tests"],
  ["ivf-process", "Step by step"], ["medication", "Injections"], ["success-rates", "Success rates"],
  ["risks", "Risks"], ["ethics", "Ethics"], ["cost", "Cost"], ["compare", "IVF vs IUI vs ICSI"], ["faq", "FAQ"],
];

const steps = [
  { t: "Assessment & planning", time: "Before day 1", icon: "clip", image: "", alt: "Fertility consultation with Dr. Kamran Saleem", d: "Hormone tests, an ultrasound with antral follicle count and a semen analysis decide your protocol and starting dose." },
  { t: "Ovarian stimulation", time: "8–14 days", icon: "inject", image: "", alt: "IVF stimulation injection pen", d: "Daily FSH injections, sometimes with LH, grow several follicles. Scans every few days adjust the dose, and a second medicine stops early ovulation." },
  { t: "Trigger injection", time: "34–36 h before retrieval", icon: "bolt", image: "", alt: "IVF trigger injection", d: "When follicles reach the right size, one precisely timed injection matures the eggs." },
  { t: "Egg retrieval", time: "15–20 minutes", icon: "target", image: "", alt: "Ultrasound-guided egg retrieval", d: "Under sedation, a fine needle guided by ultrasound collects the eggs. No cuts, and most women go home the same day." },
  { t: "Fertilization: IVF or ICSI", time: "Same day", icon: "merge", image: "", alt: "Embryology laboratory fertilization", d: `Eggs and sperm are combined in the laboratory, or one sperm is injected into each mature egg when <a href="${T}/icsi">ICSI</a> is indicated.` },
  { t: "Embryo culture & grading", time: "Day 3 to 5/6", icon: "cells", image: "", alt: "Blastocyst embryo in the laboratory", d: `Embryos grow to blastocyst stage and the strongest are graded. <a href="${T}/pgt">Genetic testing (PGT)</a> is used only in selected cases.` },
  { t: "Embryo transfer", time: "Usually no anesthesia", icon: "heart", image: "", alt: "Ultrasound-guided embryo transfer", d: `A thin catheter places the embryo in the uterus. Surplus embryos can be frozen for <a href="${T}/fet">Frozen Embryo Transfer (FET)</a>.` },
  { t: "Pregnancy test", time: "10–14 days later", icon: "check", image: "", alt: "Blood pregnancy test", d: "A blood test confirms the result. Testing at home too early can mislead." },
];

const overview = [
  { l: "Tests & Diagnosis", h: "#step-1", art: '<rect x="37" y="14" width="26" height="7" rx="3" fill="#3b82f6" stroke="#0b1f4b" stroke-width="2"/><rect x="39" y="19" width="22" height="64" rx="11" fill="#e0eeff" stroke="#0b1f4b" stroke-width="3"/><rect x="42" y="44" width="16" height="36" rx="8" fill="#4cc9f0"/><circle cx="47" cy="56" r="2.5" fill="#ffffff"/><circle cx="54" cy="66" r="2" fill="#ffffff"/><circle cx="48" cy="74" r="2.5" fill="#ffffff"/>' },
  { l: "Ovarian Stimulation", h: "#step-2", art: '<g transform="rotate(-40 52 46)"><rect x="30" y="39" width="38" height="14" rx="3" fill="#fff" stroke="#0b1f4b" stroke-width="2.5"/><rect x="44" y="39" width="14" height="14" fill="#3b82f6" stroke="#0b1f4b" stroke-width="2"/><rect x="68" y="43" width="14" height="6" fill="#fff" stroke="#0b1f4b" stroke-width="2.5"/><rect x="82" y="37" width="4" height="18" rx="2" fill="#0b1f4b"/><path d="M30 46H16" stroke="#0b1f4b" stroke-width="2"/></g><rect x="22" y="76" width="26" height="11" rx="5.5" fill="#fff" stroke="#0b1f4b" stroke-width="2.5"/><path d="M35 76v11" stroke="#0b1f4b" stroke-width="2"/><rect x="54" y="80" width="22" height="10" rx="5" fill="#0b1f4b"/>' },
  { l: "Egg Retrieval", h: "#step-4", art: '<circle cx="50" cy="50" r="32" fill="#fff" opacity=".75"/><circle cx="50" cy="50" r="18" fill="#60a5fa" stroke="#2563eb" stroke-width="2"/><circle cx="50" cy="50" r="7" fill="#0b1f4b"/>' },
  { l: "Sperm Collection", h: "#step-4", art: '<circle cx="50" cy="50" r="40" fill="#3b82f6"/><g fill="#fff"><ellipse cx="30" cy="34" rx="6" ry="4"/><ellipse cx="62" cy="48" rx="6" ry="4"/><ellipse cx="34" cy="66" rx="6" ry="4"/></g><g stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round"><path d="M36 34q8-6 14 0t14 0"/><path d="M68 48q8-6 12 0"/><path d="M40 66q8-6 14 0t12 0"/></g>' },
  { l: "Fertilization", h: "#step-5", art: '<circle cx="50" cy="50" r="38" fill="#fff" stroke="#2563eb" stroke-width="5"/><circle cx="44" cy="52" r="11" fill="#fff" stroke="#0b1f4b" stroke-width="2"/><circle cx="44" cy="52" r="3.5" fill="#0b1f4b"/><path d="M62 38l11-6M64 48l13-2M62 58l11 5" stroke="#0b1f4b" stroke-width="1.8" stroke-linecap="round"/>' },
  { l: "Embryo Transfer", h: "#step-7", art: '<circle cx="50" cy="50" r="38" fill="#fff" opacity=".7"/><g fill="#93c5fd" stroke="#2563eb" stroke-width="2"><circle cx="36" cy="38" r="11"/><circle cx="60" cy="34" r="11"/><circle cx="68" cy="56" r="11"/><circle cx="46" cy="66" r="11"/><circle cx="31" cy="58" r="11"/><circle cx="50" cy="50" r="11"/></g><g fill="#0b1f4b"><circle cx="36" cy="38" r="4"/><circle cx="60" cy="34" r="4"/><circle cx="68" cy="56" r="4"/><circle cx="46" cy="66" r="4"/><circle cx="31" cy="58" r="4"/><circle cx="50" cy="50" r="4"/></g>' },
];

const who = [
  ["Tubal factor", "Blocked, damaged or absent tubes, hydrosalpinx or severe adhesions.", "flask"],
  ["Endometriosis", "Moderate to severe disease affecting egg quality, tubes or implantation.", "target"],
  ["Reduced ovarian reserve", "Low AMH or antral follicle count, or age 35 and over, where time matters.", "clip"],
  ["Male factor", `Low count or poor motility, with or without <a href="${T}/icsi">ICSI</a>. See <a href="${T}/male-infertility">male infertility treatment</a>.`, "cells"],
  ["Unexplained infertility", `No conception despite treatment, or unsuccessful <a href="${T}/iui">IUI</a> cycles after careful review.`, "heart"],
  ["Genetic conditions", "Where embryo testing before transfer is being considered.", "merge"],
];

const tests = [
  ["AMH & antral follicle count", "Ovarian reserve", "Sets the stimulation dose"],
  ["<a href='/services/assessment/hormonal-analysis'>Hormone panel</a>", "FSH, LH, estradiol, TSH, prolactin", "Excludes thyroid or pituitary causes"],
  ["<a href='/services/assessment/semen-analysis'>Semen analysis</a>", "Count, motility, morphology, DNA fragmentation", "Standard IVF or ICSI"],
  ["Pelvic ultrasound / hysteroscopy", "Uterine cavity, fibroids, polyps, adhesions", "Healthy lining for implantation"],
  ["Blood group, rubella immunity", "General health clearance", "Protects mother and baby"],
];

const rates = [
  ["Under 35", "35% – 40%", "65% – 72%", "Single blastocyst transfer to avoid twins"],
  ["35 – 37", "25% – 30%", "52% – 60%", "Blastocyst culture, careful dosing"],
  ["38 – 40", "15% – 20%", "35% – 42%", "Reserve optimization, PGT-A considered"],
  ["41 – 42", "6% – 10%", "18% – 24%", "Low-dose stimulation"],
  ["Over 42", "2% – 4%", "< 10%", "Realistic expectations"],
];

const compare = [
  ["Where fertilization happens", "In the body", "In the laboratory", "In the laboratory"],
  ["How", "Prepared sperm placed in the uterus", "Eggs and sperm combined in a dish", "One sperm injected into one egg"],
  ["Best suited to", "Open tubes, adequate sperm", "Tubal disease, age, failed IUI", "Significant sperm problems, earlier fertilization failure"],
  ["Embryo selection & freezing", "No", "Yes", "Yes"],
];

const faqs = [
  ["What is IVF treatment?", "IVF (in vitro fertilization) is a treatment in which eggs are collected, fertilized with sperm in a laboratory, and the resulting embryo is transferred to the uterus. It is used when simpler treatment is unlikely to work or has not worked."],
  ["Is IVF the same as test tube baby treatment?", "Yes. Test tube baby is the popular name for IVF. Fertilization happens in a laboratory dish, but the pregnancy develops in the mother's womb in the usual way."],
  ["How long does one IVF cycle take?", "Stimulation takes 8 to 14 days, followed by retrieval, fertilization, embryo development and transfer. From the start of medication to the pregnancy test is typically four to six weeks, longer if embryos are frozen for a later transfer."],
  ["Is IVF painful?", "Injections can sting or bruise. Egg retrieval is done under sedation, so you should not feel it, though cramping and bloating are common afterwards. Embryo transfer is usually painless."],
  ["Will IVF work on the first attempt?", "It can, but nobody can promise it. Success depends mainly on age, ovarian reserve, embryo quality and the cause of infertility. Many people need more than one transfer."],
  ["How much does IVF cost in Lahore?", "Cost depends on medication, whether ICSI, freezing or genetic testing are needed, and how many transfers are required. You receive an itemized estimate at your consultation, before treatment begins."],
  ["Can I travel or work after embryo transfer?", "Light daily activity is fine and bed rest is unnecessary. Avoid heavy lifting, strenuous exercise and hot baths during the two-week wait."],
  ["What happens to surplus embryos?", "Good-quality embryos can be frozen and stored for a later frozen embryo transfer, avoiding full stimulation again."],
  ["When can I take a pregnancy test?", "A blood test about 10 to 14 days after transfer. Earlier home tests can give false results."],
  ["Do I need ICSI with IVF?", "Not always. ICSI is used mainly for male-factor infertility, previous fertilization failure or surgically retrieved sperm. Routine ICSI has not been shown to improve live birth rates for other couples."],
];

const treatments = [
  ["ICSI", "icsi", "One sperm injected into an egg when sperm factors make standard IVF unreliable."],
  ["IUI", "iui", "Prepared sperm placed in the uterus at ovulation."],
  ["Frozen Embryo Transfer", "fet", "Thawed embryos transferred in a cycle prepared for the lining."],
  ["Embryo Genetic Testing (PGT)", "pgt", "Embryo testing for chromosomal or inherited conditions."],
  ["Ovulation Induction & PCOS", "ovulation-induction", "Medication and monitoring to restore ovulation."],
  ["Male Infertility Treatment", "male-infertility", "Testing and treatment for low count, varicocele and hormonal causes."],
];

const locations = [
  ["Rasheed Hospital", "Main Boulevard, DHA Defence", "Daily 3:00pm–6:00pm (Sat & Sun closed)", "/locations/dha-lahore"],
  ["TAMC", "M.M. Alam Road, Gulberg", "Wednesday 12:00pm–3:00pm, other days by appointment", "/locations/mm-alam-road-lahore"],
  ["Shahnaz Hospital", "Shalamar Link Road", "Monday & Thursday 6:00pm–9:00pm", "/locations/shalamar-lahore"],
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "MedicalWebPage", "@id": url, url, name: title, description, inLanguage: "en-PK",
      about: { "@type": "MedicalProcedure", name: "In Vitro Fertilization (IVF)" },
      lastReviewed: "2026-11",
      reviewedBy: { "@type": "Physician", name: "Dr. Kamran Saleem" } },
    { "@type": "BreadcrumbList", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: base + "/" },
      { "@type": "ListItem", position: 2, name: "Fertility Treatment", item: base + T },
      { "@type": "ListItem", position: 3, name: "IVF Treatment", item: url } ] },
    { "@type": "FAQPage", mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) },
  ],
};
---
<Layout title={title} description={description}>
<div class="ivf">
<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<main>
<section class="hero"><div class="w hgrid">
  <div>
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/services/fertility-treatment">Fertility Treatment</a> / IVF Treatment</nav>
    <p class="eye">Doctor-led · Evidence-based · Lahore</p>
    <h1>IVF Treatment in Lahore</h1>
    <p class="sub">In vitro fertilization (IVF), often called test tube baby treatment, combines eggs and sperm in a laboratory and transfers the resulting embryo to the uterus. Dr. Kamran Saleem plans each cycle around your results and explains every stage, risk and cost first. IVF is recommended when your findings point to it, not as a default.</p>
    <p><a class="btn" href={wa}>Book an IVF consultation</a> <a class="btn ghost" href="#ivf-process">See the process</a></p>
    <p class="mini">Not sure yet? Start with <a href="/services/assessment">Fertility Assessment &amp; Diagnosis</a>.</p>
  </div>
  <div class="hside">
    {heroImage ? <img src={heroImage} alt="IVF treatment with Dr. Kamran Saleem, Lahore" width="560" height="420" fetchpriority="high" /> : null}
    <ul class="facts">
      <li><b>25+</b> years in reproductive health</li>
      <li><b>45–60</b> min unhurried consultations</li>
      <li><b>3</b> Lahore locations</li>
      <li><b>100%</b> married couple's own eggs and sperm</li>
    </ul>
  </div>
</div></section>

<div class="w layout">
  <aside class="toc" aria-label="On this page"><p>On this page</p>
    {toc.map(([id, l]) => <a href={`#${id}`}>{l}</a>)}
    <a class="btn sm" href={wa}>Book now</a>
  </aside>

  <div class="content">
    <p class="review"><b>Medically reviewed:</b> Dr. Kamran Saleem (MBBS 1988; Diploma, University of Liverpool 1998; PMDC registered) · Last review November 2026 · <a href="/dr-kamran-saleem">About the doctor</a></p>

    <section id="what-is-ivf">
      <h2>What Is IVF (In Vitro Fertilization)?</h2>
      <p>Medication encourages the ovaries to develop several mature eggs. These are collected, fertilized with sperm in an embryology laboratory and grown for three to six days to the blastocyst stage. The best embryo is then transferred to the uterus, or frozen for later. The pregnancy develops in the womb as usual.</p>
      <p>IVF is one of several assisted treatments. Depending on your results, <a href={`${T}/iui`}>IUI</a> may suit you first, or <a href={`${T}/icsi`}>ICSI</a> may be added to IVF.</p>
    </section>

    <section id="who-needs-ivf">
      <h2>Who May Need IVF?</h2>
      <p>IVF is considered when the cause of infertility, or time already spent trying, makes simpler treatment unlikely to work.</p>
      <div class="cards">
        {who.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p set:html={p} /></div>)}
      </div>
      <p class="note">Equally important is who does not need IVF yet. Many couples first correct a hormone problem or try <a href={`${T}/ovulation-induction`}>ovulation induction</a>. Your plan follows your findings, not a package.</p>
    </section>

    <section id="pre-ivf-tests">
      <h2>Before You Start: Tests and Preparation</h2>
      <div class="tw"><table>
        <thead><tr><th>Test</th><th>What it shows</th><th>Why it matters</th></tr></thead>
        <tbody>{tests.map(r => <tr><td set:html={r[0]} /><td>{r[1]}</td><td>{r[2]}</td></tr>)}</tbody>
      </table></div>
    </section>

    <section id="ivf-process">
      <h2>The IVF Process, Step by Step</h2>
      <p>A typical cycle takes about four to six weeks from the start of medication to the pregnancy test.</p>
      <div class="ovwrap">
        <p class="ovtitle">IVF Process at a Glance</p>
        <div class="ovrow">
          {overview.map((o, i) => (
            <>
              <a class="ov" href={o.h}>
                <span class="ovl">{o.l}</span>
                <span class="disc"><svg viewBox="0 0 100 100" set:html={o.art} /></span>
                <span class="ovn">{i + 1}</span>
              </a>
              {i < overview.length - 1 ? <span class="chev" aria-hidden="true"><svg viewBox="0 0 36 22"><path d="M3 3l7 8-7 8M14 3l7 8-7 8M25 3l7 8-7 8" /></svg></span> : null}
            </>
          ))}
        </div>
        <p class="ovhint">Select a stage to jump to its full explanation below.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step" id={`step-${i + 1}`}>
            <div class="media">
              {s.image ? <img src={s.image} alt={s.alt} width="320" height="240" loading="lazy" /> : <span class="ph"><svg viewBox="0 0 24 24" set:html={icons[s.icon]} /></span>}
            </div>
            <div class="body"><span class="num">Step {i + 1} · {s.time}</span><h3>{s.t}</h3><p set:html={s.d} /></div>
          </li>
        ))}
      </ol>
    </section>

    <section id="medication">
      <h2>IVF Injections and Medication</h2>
      <div class="cols">
        <ul class="tick">
          <li>Gonadotropins (FSH, sometimes LH) to grow follicles</li>
          <li>GnRH antagonist or agonist to stop early ovulation</li>
          <li>Trigger injection to mature the eggs</li>
          <li>Progesterone to support the lining after transfer</li>
          <li>Estrogen tablets or patches in frozen transfer cycles</li>
        </ul>
        <div class="callout"><b>What to expect.</b> Most injections are small shots under the skin with pre-filled pens, and you are shown how. Bloating, mood changes and bruising are common. Severe abdominal pain, rapid weight gain, repeated vomiting or breathlessness are not, so report them urgently.</div>
      </div>
    </section>

    <section id="success-rates">
      <h2>IVF Success Rates in Pakistan: Realistic Metrics</h2>
      <p>We report live births per cycle, not early positive tests. Figures are for the woman's own eggs.</p>
      <div class="tw"><table>
        <thead><tr><th>Age</th><th>Live birth (single cycle)</th><th>Cumulative, 3 cycles</th><th>Focus</th></tr></thead>
        <tbody>{rates.map(r => <tr>{r.map(c => <td>{c}</td>)}</tr>)}</tbody>
      </table></div>
      <p class="note">Outcomes vary and no result is guaranteed. Beyond age, the main factors are ovarian reserve, embryo quality, sperm quality, the uterus and the diagnosis. You receive an honest individual estimate, including when the likely benefit is low.</p>
    </section>

    <section id="risks">
      <h2>Risks and Possible Complications</h2>
      <div class="cards">
        <div class="card"><h3>OHSS</h3><p>An exaggerated response to stimulation. Severe cases are uncommon and prevented by monitoring or a freeze-all approach.</p></div>
        <div class="card"><h3>Multiple pregnancy</h3><p>Twins carry higher risks. Transferring a single good-quality embryo greatly reduces this.</p></div>
        <div class="card"><h3>Other risks</h3><p>Rare bleeding or infection at retrieval, sedation risks, ectopic pregnancy, miscarriage and emotional strain.</p></div>
      </div>
      <p class="note">Seek urgent medical attention for severe pain, heavy bleeding, fever or breathlessness. We do not provide emergency care.</p>
    </section>

    <section id="ethics">
      <h2>Ethical and Legal Compliance in Pakistan</h2>
      <p>All treatment follows Pakistani law and Federal Shariat Court rulings on assisted reproduction.</p>
      <ul class="tick">
        <li>Only the legal husband's sperm and the legally wedded wife's eggs are used</li>
        <li>Donor eggs, donor sperm, donor embryos and surrogacy are not offered</li>
        <li>Double-witness verification at every laboratory stage</li>
      </ul>
    </section>

    <section id="cost">
      <h2>IVF Cost in Lahore: Transparent Fees</h2>
      <p>A single fixed price would mislead, because cycles differ. An itemized estimate is explained before you commit. See our guide to <a href="/resources/ivf-treatment-cost-in-pakistan">IVF treatment cost in Pakistan</a>.</p>
      <div class="cols">
        <div class="card"><h3>Included in the package</h3><ul class="tick"><li>Scans during stimulation</li><li>Consultations with Dr. Kamran</li><li>Egg retrieval with theater and nursing care</li><li>Embryology and blastocyst culture</li><li>Ultrasound-guided embryo transfer</li></ul></div>
        <div class="card"><h3>Disclosed upfront</h3><ul class="tick"><li>Stimulation medication (varies by dose)</li><li>ICSI, if indicated</li><li>Embryo freezing and annual storage</li><li>Sperm retrieval or PGT biopsy</li></ul></div>
      </div>
      <p class="note">Add-ons such as time-lapse imaging or assisted hatching have limited evidence for most patients, so we suggest them only with a clear clinical reason.</p>
    </section>

    <section id="compare">
      <h2>IVF, IUI or ICSI: How They Differ</h2>
      <div class="tw"><table>
        <thead><tr><th></th><th><a href={`${T}/iui`}>IUI</a></th><th>IVF</th><th><a href={`${T}/icsi`}>ICSI</a></th></tr></thead>
        <tbody>{compare.map(r => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td><td>{r[3]}</td></tr>)}</tbody>
      </table></div>
      <p class="note">More: <a href="/resources/ivf-vs-iui">IVF vs IUI</a>. Had IVF elsewhere? Get an independent view through <a href="/services/support">Support &amp; Second Opinions</a>.</p>
    </section>

    <section id="why">
      <h2>Why Choose Dr. Kamran Saleem</h2>
      <div class="cards">
        <div class="card"><h3>25+ years' experience</h3><p>Reproductive health and fertility care. <a href="/dr-kamran-saleem">Meet the doctor</a>.</p></div>
        <div class="card"><h3>Unhurried consultations</h3><p>45 to 60 minutes to review history, reports and concerns.</p></div>
        <div class="card"><h3>Doctor-led care</h3><p>Scans, protocol changes and transfer planning led by Dr. Kamran for continuity.</p></div>
      </div>
    </section>

    <section id="faq">
      <h2>Frequently Asked Questions</h2>
      {faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
    </section>
  </div>
</div>

<section class="band"><div class="w">
  <h2>Other fertility treatments</h2>
  <div class="cards c3">
    {treatments.map(([n, s, d]) => <a class="card link" href={`${T}/${s}`}><h3>{n}</h3><p>{d}</p></a>)}
  </div>
  <p><a href={T}>See all fertility treatments →</a> · <a href="/resources/ivf-treatment-in-lahore">IVF in Lahore: cost, tests &amp; choosing a clinic</a></p>
</div></section>

<section class="cta"><div class="w">
  <h2>Ready to Talk About IVF?</h2>
  <p>Bring previous reports, semen analysis or treatment summaries so your plan starts from the facts. We usually reply the same day.</p>
  <a class="btn" href={wa}>Book an IVF Consultation</a>
  <div class="cards c3 locs">
    {locations.map(([n, a, h, l]) => <a class="card link" href={l}><h3>{n}</h3><p>{a}</p><p class="hrs">{h}</p></a>)}
  </div>
</div></section>
</main>

<p class="legal w">Medical disclaimer: this page is for general education and is not a substitute for professional medical advice. Outcomes vary and no result is guaranteed. © 2026 Dr. Kamran Saleem.</p>
</div>
</Layout>

<style is:global>
