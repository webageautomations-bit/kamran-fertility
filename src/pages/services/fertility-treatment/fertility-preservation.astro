  ["Risky work", "Exposure to radiation, industrial chemicals or other hazards.", "briefcase"],
  ["Backup for IVF or ICSI", "Collection anxiety, travel, or a sperm count that changes from day to day.", "flask"],
  ["Falling sperm count", "Men with severe oligospermia who want to store samples before sperm disappear. See <a href=\"" + T + "/male-infertility\">male infertility treatment</a>.", "drop"],
];

const onco = [
  ["24–48 hour appointments", "Priority access at our DHA, Gulberg and Shalamar clinics.", "clock"],
  ["Random-start stimulation", "Women can begin stimulation at any point in the menstrual cycle, so cancer treatment is not delayed.", "bolt"],
  ["Teamwork with your doctors", "We speak directly with your oncologist or surgeon to fit freezing into your care plan.", "heart"],
];

const compare = [
  ["Who it is for", "Women planning ahead, or facing treatment", "Men facing treatment, risk or low count", "Married couples who already have embryos"],
  ["What is frozen", "Mature unfertilized eggs", "Washed, healthy sperm", "Fertilized embryos (blastocysts)"],
  ["Process", "Stimulation and egg retrieval", "Simple semen sample", "IVF/ICSI cycle, then embryo freezing"],
  ["Use later", `Thawed and fertilized with <a href="${T}/icsi">ICSI</a>`, `Used for <a href="${T}/iui">IUI</a>, IVF or ICSI`, `Thawed and transferred in a <a href="${T}/fet">frozen transfer</a>`],
];

const rates = [
  ["Under 35", "10 – 15", "92% – 96%", "65% – 80%"],
  ["35 – 37", "15 – 20", "88% – 94%", "50% – 65%"],
  ["38 – 40", "20 – 25", "85% – 90%", "30% – 45%"],
  ["Over 40", "Individual assessment", "80% – 85%", "15% – 25%"],
];

const storage = [
  ["−196°C liquid nitrogen", "At this temperature biological activity stops, so eggs and sperm do not age while frozen.", "snow"],
  ["Many years of storage", "Healthy babies have been born from eggs and sperm stored for 10 years or more.", "calendar"],
  ["Double-witness checks", "Two staff members verify identity at every freezing and thawing step.", "shield"],
];

const checklist = [
  "You are a woman aged 28–38 who wants to protect future fertility while focusing on career or personal goals",
  "You have a family history of early menopause or a low AMH result",
  "You face chemotherapy, radiotherapy or pelvic surgery",
  "You are in an IVF or ICSI cycle and your husband travels often or finds sample collection stressful",
  "You want an unhurried, honest medical opinion from a UK-qualified specialist",
];

const faqs = [
  ["How long can frozen eggs or sperm stay in storage?", "For many years. At −196°C, biological activity stops, so eggs and sperm do not age. Healthy births have been reported from eggs and sperm stored for 10 to 15 years or longer. Storage is renewed yearly."],
  ["Does egg freezing use up my future eggs?", "No. In a normal cycle your body starts a group of follicles, but only one matures and the rest are lost. Stimulation medicine rescues some of those eggs that would have been lost that month. It does not meaningfully reduce your long-term supply."],
  ["Is egg retrieval painful?", "No. It takes about 15 minutes under light sedation, so you are comfortable throughout. You may feel mild cramps afterwards, which usually settle within 24 to 48 hours. Most women go home within 1–2 hours."],
  ["How many eggs should I freeze?", "It depends on your age and AMH. As a guide, 10–15 eggs under 35, 15–20 at 35–37 and 20–25 at 38–40. More than one cycle may be needed. Dr. Kamran will give you a personal target."],
  ["What is the best age to freeze eggs?", "Younger is better, because egg quality falls with age, especially after 35. Many women freeze between 28 and 35, but older women can still benefit from an honest assessment."],
  ["Does freezing guarantee a baby later?", "No. Success depends on your age when the eggs are frozen, the number of eggs and later steps such as fertilization and embryo transfer. We explain realistic odds before you decide."],
  ["How do I get started in Lahore?", "Message us on WhatsApp or book a visit at DHA, Gulberg or Shalamar. We check your AMH and do an ultrasound, then outline a personal plan."],
];

const treatments = [
  ["IVF Treatment", "ivf", "Egg retrieval, fertilization and embryo transfer."],
  ["ICSI", "icsi", "How thawed eggs are fertilized later."],
  ["Frozen Embryo Transfer", "fet", "The final step when using frozen embryos."],
  ["IUI Treatment", "iui", "Use of frozen sperm for mild male factor."],
  ["Male Infertility Treatment", "male-infertility", "Testing and treatment for low or no sperm."],
  ["PGT Genetic Testing", "pgt", "Screen embryos before transfer."],
];

const locations = [
  ["Rasheed Hospital", "Main Boulevard, DHA Defence", "Daily 3:00pm–6:00pm (Sat & Sun closed)", "/locations/dha-lahore"],
  ["TAMC", "M.M. Alam Road, Gulberg", "Wednesday 12:00pm–3:00pm, other days by appointment", "/locations/mm-alam-road-lahore"],
  ["Shahnaz Hospital", "Shalamar Link Road", "Monday & Thursday 6:00pm–9:00pm", "/locations/shalamar-lahore"],
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "MedicalWebPage", "@id": url, url, name: title, description, inLanguage: "en-PK", lastReviewed: "2026-11", medicalAudience: "Patient",
      reviewedBy: { "@type": "Physician", name: "Dr. Kamran Saleem" }, about: { "@id": url + "#procedure" } },
    { "@type": "MedicalProcedure", "@id": url + "#procedure", name: "Fertility Preservation (Egg and Sperm Freezing)", alternateName: "Egg freezing, sperm cryopreservation, oncofertility",
      description: "Freezing and storing eggs by vitrification or sperm by controlled cryopreservation in liquid nitrogen at -196°C to protect future fertility.",
      bodyLocation: "Reproductive System", relevantSpecialty: { "@type": "MedicalSpecialty", name: "Reproductive Endocrinology and Infertility" },
      performedBy: { "@type": "Physician", name: "Dr. Kamran Saleem", alumniOf: "University of Liverpool", identifier: "PMDC Registered" } },
    { "@type": "MedicalClinic", "@id": base + "/#clinic", name: "Kamran Fertility Clinic", url: base, telephone: "+923148432789",
      location: ["Rasheed Hospital (DHA Defence)", "TAMC Clinic (M.M. Alam Road, Gulberg)", "Shahnaz Hospital (Shalamar Link Road)"].map(n => ({ "@type": "Place", name: n, address: { "@type": "PostalAddress", addressLocality: "Lahore", addressRegion: "Punjab", addressCountry: "PK" } })) },
    { "@type": "BreadcrumbList", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: base + "/" },
      { "@type": "ListItem", position: 2, name: "Fertility Treatment", item: base + T },
      { "@type": "ListItem", position: 3, name: "Fertility Preservation", item: url } ] },
    { "@type": "FAQPage", mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) },
  ],
};
---
<Layout title={title} description={description}>
<div class="ivf">
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<main>
<section class="hero"><div class="w hgrid">
  <div>
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href={T}>Fertility Treatment</a> / Fertility Preservation</nav>
    <p class="eye">Private · Doctor-led · Lahore</p>
    <h1>Fertility Preservation in Lahore: Egg &amp; Sperm Freezing</h1>
    <p class="sub">Freeze your eggs or sperm today and keep your options open for tomorrow. Whether you want to plan your family around your career, or you face cancer treatment that could affect fertility, Dr. Kamran Saleem will guide you through a safe, private process. Frozen eggs and sperm are stored in liquid nitrogen at −196°C for later use in <a href={`${T}/ivf`}>IVF</a> or <a href={`${T}/icsi`}>ICSI</a>.</p>
    <p><a class="btn" href={wa}>Book a confidential consultation</a> <a class="btn ghost" href="#egg-freezing">See how it works</a></p>
    <p class="mini">Facing cancer treatment? Jump to our <a href="#oncofertility">24–48 hour fast-track</a>.</p>
  </div>
  <div class="hside">
    <ul class="facts">
      <li><b>90–95%+</b> of frozen eggs survive thawing</li>
      <li><b>−196°C</b> liquid nitrogen storage</li>
      <li><b>24–48 h</b> priority appointments for cancer patients</li>
      <li><b>25+</b> years in reproductive health</li>
    </ul>
  </div>
</div></section>

<div class="w layout">
  <aside class="toc" aria-label="On this page"><p>On this page</p>
    {toc.map(([id, l]) => <a href={`#${id}`}>{l}</a>)}
    <a class="btn sm" href={wa}>Book now</a>
  </aside>
  <div class="content">
    <p class="review"><b>Medically reviewed:</b> Dr. Kamran Saleem (MBBS 1988; UK Dip GUM &amp; Ven, University of Liverpool 1998; PMDC registered) · Follows ASRM and ESHRE cryopreservation guidelines · Last review November 2026 · <a href="/dr-kamran-saleem">About the doctor</a></p>

    <section id="what-is">
      <h2>What Is Fertility Preservation?</h2>
      <p>Fertility preservation means freezing and storing reproductive cells, which are eggs for women or sperm for men, so that you can use them later. Eggs are frozen by vitrification, a very fast method that turns them into a glass-like state. Sperm are frozen by controlled cryopreservation. Both are then kept in liquid nitrogen at −196°C.</p>
      <p>This locks in the quality of your cells at today's age. Frozen eggs survive thawing about 90–95% of the time in a good laboratory. It protects you from the natural decline of fertility with age, and from treatments such as chemotherapy that can harm eggs and sperm.</p>
      <div class="callout"><b>A plan, not a promise.</b> Freezing keeps your options open but cannot guarantee a baby. We explain your realistic chances before you decide, so there are no surprises.</div>
    </section>

    <section id="why-us">
      <h2>Why Choose Kamran Fertility Clinic?</h2>
      <p>Preserving fertility is a big personal and financial decision. We combine modern laboratory technology with honest, patient-first care.</p>
      <div class="cards">
        {whyCards.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p>{p}</p></div>)}
      </div>
    </section>

    <section id="who">
      <h2>Who Should Consider Freezing Their Fertility?</h2>
      <h3>Women: egg freezing</h3>
      <p>A woman is born with a fixed number of eggs. Both the number and the quality fall with age, and faster after 35. Freezing eggs while they are at their best gives you more time.</p>
      <div class="cards">
        {whoEgg.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p set:html={p} /></div>)}
      </div>
      <h3>Men: sperm freezing</h3>
      <p>Sperm quality can fall with age, medical treatment, work exposures or a testicular condition. Freezing a sample is simple and a very effective safeguard.</p>
      <div class="cards">
        {whoSperm.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p set:html={p} /></div>)}
      </div>
    </section>

    <section id="egg-freezing">
      <h2>Egg Freezing (Oocyte Vitrification), Step by Step</h2>
      <p>The whole process takes about two to three weeks from the start of your cycle. Most women keep working through it.</p>
      <div class="ovwrap">
        <p class="ovtitle">Egg Freezing at a Glance</p>
        <div class="ovrow">
          {overview.map((o, i) => (
            <>
              <a class="ov" href={o.h}>
                <span class="ovl">{o.l}</span>
                <span class="disc"><svg viewBox="0 0 100 100" set:html={o.art} /></span>
                <span class="ovn">{i + 1}</span>
              </a>
              {i < overview.length - 1 ? <span class="chev" aria-hidden="true"><svg viewBox="0 0 36 22"><path d="M3 3l7 8-7 8M14 3l7 8-7 8M25 3l7 8-7 8" /></svg></span> : null}
            </>
          ))}
        </div>
        <p class="ovhint">Tap a stage to jump to its details below.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step" id={`step-${i + 1}`}>
            <div class="media"><span class="ph"><svg viewBox="0 0 24 24" set:html={icons[s.icon]} /></span></div>
            <div class="body"><span class="num">Step {i + 1} · {s.time}</span><h3>{s.t}</h3><p set:html={s.d} /></div>
          </li>
        ))}
      </ol>
      <p class="note">Common side effects are bloating and mild discomfort during stimulation. The risk of OHSS is low with careful, individual dosing and monitoring.</p>
    </section>

    <section id="sperm-freezing">
      <h2>Sperm Freezing (Semen Cryopreservation), Step by Step</h2>
      <p>Sperm freezing is quick, painless and needs only a semen sample. It can be done in a single visit after screening.</p>
      <ol class="steps">
        {spermSteps.map((s, i) => (
          <li class="step" id={`sperm-step-${i + 1}`}>
            <div class="media"><span class="ph"><svg viewBox="0 0 24 24" set:html={icons[s.icon]} /></span></div>
            <div class="body"><span class="num">Step {i + 1} · {s.time}</span><h3>{s.t}</h3><p set:html={s.d} /></div>
          </li>
        ))}
      </ol>
      <div class="callout"><b>Tip:</b> If you are about to start treatment that may affect sperm, freeze more than one sample if your doctor advises. Stored sperm can later be used for <a href={`${T}/iui`}>IUI</a>, IVF or ICSI.</div>
    </section>

    <section id="oncofertility">
      <h2>Emergency Oncofertility Fast-Track</h2>
      <p>When you receive a cancer diagnosis, time matters. Chemotherapy and radiotherapy can permanently damage egg follicles and sperm-producing cells. Our fast-track gives you priority at every step.</p>
      <div class="cards">
        {onco.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p>{p}</p></div>)}
      </div>
      <div class="callout"><b>Need an urgent appointment?</b> Message us on <a href={wa}>WhatsApp (+92 314 8432789)</a> and say you are an oncofertility patient. We will find the earliest slot at DHA, Gulberg or Shalamar.</div>
    </section>

    <section id="compare">
      <h2>Egg, Sperm and Embryo Freezing Compared</h2>
      <p>Each option suits a different situation. Dr. Kamran will help you choose.</p>
      <div class="tw"><table>
        <thead><tr><th></th><th>Egg freezing</th><th>Sperm freezing</th><th>Embryo freezing</th></tr></thead>
        <tbody>{compare.map(r => <tr><th scope="row">{r[0]}</th><td set:html={r[1]} /><td set:html={r[2]} /><td set:html={r[3]} /></tr>)}</tbody>
      </table></div>
      <p class="note">Curious about the embryo route? Read about <a href={`${T}/fet`}>frozen embryo transfer</a> and <a href={`${T}/pgt`}>PGT genetic testing</a>.</p>
    </section>

    <section id="success-rates">
      <h2>Egg Freezing Success by Age</h2>
      <p>Your age on the day the eggs are frozen is the biggest factor in future success.</p>
      <div class="tw"><table>
        <thead><tr><th>Age when frozen</th><th>Suggested number of eggs</th><th>Survival after thawing</th><th>Chance of a live birth (per batch)</th></tr></thead>
        <tbody>{rates.map(r => <tr>{r.map(c => <td>{c}</td>)}</tr>)}</tbody>
      </table></div>
      <ul class="tick">
        <li>More eggs frozen means a higher chance of success</li>
        <li>Younger eggs have healthier chromosomes</li>
        <li>You may need more than one stimulation cycle to reach your target</li>
      </ul>
      <p class="note">These are estimates, not guarantees. Results depend on your age, egg number and laboratory quality, and on later fertilization and transfer.</p>
    </section>

    <section id="storage">
      <h2>How Safe Is Long-Term Storage?</h2>
      <p>Eggs and sperm are stored in specialized liquid nitrogen tanks. A fixed yearly fee covers maintenance, so you can keep them for as long as you need.</p>
      <div class="cards">
        {storage.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p>{p}</p></div>)}
      </div>
    </section>

    <section id="right-for-you">
      <h2>Is Fertility Preservation Right for You?</h2>
      <p>If two or more of these apply to you, a short consultation is worth booking.</p>
      <ul class="tick">
        {checklist.map(c => <li>{c}</li>)}
      </ul>
      <div class="callout"><b>Unsure?</b> That is completely normal. A first visit is only a conversation, with no pressure. You can also ask for a <a href="/services/support">second opinion</a>.</div>
    </section>

    <section id="ethics">
      <h2>Ethics and Legal Rules in Pakistan</h2>
      <p>Our care follows Pakistani law and Federal Shariat Court rulings on assisted reproduction.</p>
      <ul class="tick">
        <li>Frozen eggs and sperm can only be used by the husband and wife within a valid marriage. Donor eggs, donor sperm and surrogacy are not offered</li>
        <li>Written consent and double-witness identity checks at every step</li>
        <li>Private consultations and full confidentiality for all patients</li>
      </ul>
    </section>

    <section id="cost">
      <h2>Fertility Preservation Cost in Lahore</h2>
      <p>No surprise fees. You receive a clear breakdown before you start. For the cost of treatment cycles see <a href="/resources/ivf-treatment-cost-in-pakistan">IVF treatment cost in Pakistan</a>.</p>
      <div class="cols">
        <div class="card"><h3>Egg freezing package</h3><ul class="tick"><li>Initial assessment and counseling</li><li>Stimulation monitoring and egg retrieval</li><li>Embryology processing and vitrification</li><li>First 12 months of storage</li></ul></div>
        <div class="card"><h3>Sperm freezing package</h3><ul class="tick"><li>Semen analysis and lab washing</li><li>Freezing medium and cryopreservation</li><li>First 12 months of storage</li></ul></div>
      </div>
      <p class="note">Stimulation medicines are charged separately by dose. Yearly storage renewal is a fixed, predictable fee.</p>
    </section>

    <section id="faq">
      <h2>Frequently Asked Questions</h2>
      {faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
    </section>
  </div>
</div>

<section class="band"><div class="w">
  <h2>Related fertility treatments</h2>
  <div class="cards c3">
    {treatments.map(([n, s, d]) => <a class="card link" href={`${T}/${s}`}><h3>{n}</h3><p>{d}</p></a>)}
  </div>
  <p><a href={T}>See all fertility treatments →</a> · <a href="/services/assessment/hormonal-analysis">AMH &amp; hormonal analysis</a> · <a href="/services/assessment/semen-analysis">Semen analysis</a> · <a href="/services/support">Support &amp; Second Opinions</a></p>
</div></section>

<section class="cta"><div class="w">
  <h2>Take Control of Your Future Fertility</h2>
  <p>Do not let biological timing decide your plans. Book a private 45–60 minute consultation with Dr. Kamran Saleem to discuss your options. Bring any earlier AMH results, scans or semen reports. WhatsApp +92 314 8432789.</p>
  <a class="btn" href={wa}>Book a Confidential Consultation</a>
  <div class="cards c3 locs">
    {locations.map(([n, a, h, l]) => <a class="card link" href={l}><h3>{n}</h3><p>{a}</p><p class="hrs">{h}</p></a>)}
  </div>
</div></section>
</main>
</div>
</Layout>

