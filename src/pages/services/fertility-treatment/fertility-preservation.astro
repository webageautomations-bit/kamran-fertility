const toc = [["what-is","What is it"],["why-us","Why choose us"],["who","Who should consider it"],["egg-freezing","Egg freezing"],["sperm-freezing","Sperm freezing"],["oncofertility","Cancer fast-track"],["compare","Egg vs sperm vs embryo"],["success-rates","Success rates"],["storage","Storage & safety"],["right-for-you","Is it right for you"],["ethics","Ethics & law"],["cost","Cost"],["faq","FAQ"]];

const overview = [
  { l: "Baseline Assessment", h: "#step-1", art: '<rect x="37" y="14" width="26" height="7" rx="3" fill="#3b82f6" stroke="#0b1f4b" stroke-width="2"/><rect x="39" y="19" width="22" height="64" rx="11" fill="#e0eeff" stroke="#0b1f4b" stroke-width="3"/><rect x="42" y="44" width="16" height="36" rx="8" fill="#4cc9f0"/><circle cx="47" cy="56" r="2.5" fill="#ffffff"/><circle cx="54" cy="66" r="2" fill="#ffffff"/><circle cx="48" cy="74" r="2.5" fill="#ffffff"/>' },
  { l: "Stimulation", h: "#step-2", art: '<g transform="rotate(-40 52 46)"><rect x="30" y="39" width="38" height="14" rx="3" fill="#fff" stroke="#0b1f4b" stroke-width="2.5"/><rect x="44" y="39" width="14" height="14" fill="#3b82f6" stroke="#0b1f4b" stroke-width="2"/><rect x="68" y="43" width="14" height="6" fill="#fff" stroke="#0b1f4b" stroke-width="2.5"/><rect x="82" y="37" width="4" height="18" rx="2" fill="#0b1f4b"/><path d="M30 46H16" stroke="#0b1f4b" stroke-width="2"/></g><rect x="22" y="76" width="26" height="11" rx="5.5" fill="#fff" stroke="#0b1f4b" stroke-width="2.5"/><rect x="54" y="80" width="22" height="10" rx="5" fill="#0b1f4b"/>' },
  { l: "Monitoring", h: "#step-3", art: '<circle cx="50" cy="50" r="32" fill="#fff" opacity=".75"/><circle cx="50" cy="50" r="18" fill="#60a5fa" stroke="#2563eb" stroke-width="2"/><circle cx="50" cy="50" r="7" fill="#0b1f4b"/>' },
  { l: "Egg Retrieval", h: "#step-4", art: '<circle cx="50" cy="50" r="38" fill="#fff" stroke="#2563eb" stroke-width="5"/><circle cx="50" cy="56" r="17" fill="#93c5fd" stroke="#0b1f4b" stroke-width="2"/><circle cx="50" cy="56" r="6" fill="#0b1f4b"/><path d="M50 12v26" stroke="#4cc9f0" stroke-width="4" stroke-linecap="round"/>' },
  { l: "Vitrification & Storage", h: "#step-5", art: '<circle cx="50" cy="50" r="40" fill="#3b82f6"/><g stroke="#fff" stroke-width="3" stroke-linecap="round" fill="none"><path d="M50 22v56M26 36l48 28M74 36L26 64"/><path d="M43 27l7 5 7-5M43 73l7-5 7 5"/></g>' },
];

const steps = [
  { t: "Baseline assessment", time: "First visit", icon: "clip", d: `Your AMH blood level and an antral follicle count on a vaginal ultrasound show how your ovaries are likely to respond. See our <a href="/services/assessment/hormonal-analysis">hormonal analysis</a> page.` },
  { t: "Controlled ovarian stimulation", time: "About 10–12 days", icon: "inject", d: `You inject hormone medicine (rFSH) so that several follicles mature together instead of just one. Our approach is similar to <a href="${T}/ovulation-induction">ovulation induction</a>, but aimed at collecting more eggs.` },
  { t: "Ultrasound and hormone monitoring", time: "3–4 visits", icon: "scope", d: "Dr. Kamran Saleem tracks follicle growth and adjusts your doses to keep you safe and to get the best number of mature eggs." },
  { t: "Trigger injection and egg retrieval", time: "36 hours after trigger", icon: "target", d: "A trigger injection finishes egg maturation. About 36 hours later, a quick 15-minute procedure under light sedation collects the eggs. Most women go home within 1–2 hours." },
  { t: "Vitrification and cryo-storage", time: "Same day", icon: "snow", d: "Mature (MII) eggs are frozen in seconds by vitrification, which turns them into a glass-like state without damaging ice crystals. They are then stored in liquid nitrogen at −196°C." },
];

const spermSteps = [
  { t: "Diagnostic semen analysis", time: "First visit", icon: "flask", d: `We check count, forward movement, shape and live sperm using WHO 6th Edition standards. Book it on our <a href="/services/assessment/semen-analysis">semen analysis</a> page.` },
  { t: "Routine safety screening", time: "Same week", icon: "shield", d: "Standard blood tests make sure your sample can be stored safely alongside others." },
  { t: "Lab washing (density gradient)", time: "Day of freezing", icon: "cells", d: "The lab separates the most active, normally shaped sperm from the seminal fluid." },
  { t: "Cryoprotectant and freezing", time: "Same day", icon: "snow", d: "A protective freezing medium is added. Samples are cooled in controlled vapor and then placed in liquid nitrogen at −196°C." },
];

const whyCards = [
  ["UK-qualified specialist", "Dr. Kamran Saleem has 25+ years of experience and a UK diploma from the University of Liverpool.", "user"],
  ["Modern vitrification lab", "Ultra-rapid freezing gives high egg survival after thawing.", "snow"],
  ["Unhurried 45–60 minute visits", "Time to ask every question, with no pressure to start treatment.", "clock"],
  ["Clear, upfront fees", "You know the cost before starting, including yearly storage.", "check"],
  ["Private and respectful", "Confidential consultations for both women and men.", "lock"],
  ["Priority care for cancer patients", "24–48 hour appointments and immediate-start stimulation.", "ribbon"],
];

const whoEgg = [
  ["Planning for later", "Women aged about 28–38 who want to focus on study, career, timing or finding the right partner.", "calendar"],
  ["Before medical treatment", "Chemotherapy, pelvic radiotherapy or surgery that can affect the ovaries.", "ribbon"],
  ["Reproductive conditions", "Severe endometriosis, low AMH or a family history of early menopause.", "pulse"],
