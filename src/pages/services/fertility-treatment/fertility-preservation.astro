---
// src/pages/services/fertility-treatment/fertility-preservation.astro
// Uses the site's own menu/footer via Layout. Match the import path + props to TreatmentPage.astro.
import Layout from "../../../layouts/Layout.astro";
const base = "https://www.kamranfertility.com";
const T = "/services/fertility-treatment";
const url = `${base}${T}/fertility-preservation`;
const title = "Egg & Sperm Freezing in Lahore | Dr. Kamran Saleem";
const description = "Egg freezing and sperm freezing in Lahore with UK-qualified Dr. Kamran Saleem. Urgent oncofertility care, clear costs and private consults. Book on WhatsApp.";
const wa = "https://wa.me/923148432789?text=" + encodeURIComponent("Hello, I would like to book a fertility preservation (egg or sperm freezing) consultation with Dr. Kamran Saleem.");

const icons = {
  flask: '<path d="M9 3h6M10 3v6l-5 9a2 2 0 002 3h10a2 2 0 002-3l-5-9V3"/>',
