---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import ServiceBlock from "../../components/ServiceBlock.astro";
import CloseContact from "../../components/CloseContact.astro";

// Client-approved, SEO-written copy — reproduced verbatim. Do not reword,
// shorten, or add keywords without sign-off from the client's SEO team.
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Services" },
  { label: "Assessment & Diagnosis" },
];

const heroBody = [
  "Every fertility journey begins with understanding the cause before choosing a treatment. At Kamran Fertility Clinic, our experienced fertility specialist in Lahore provides a personalised Fertility Assessment for both men and women to identify the medical, hormonal, and lifestyle factors that may affect conception. Whether you have been trying to conceive naturally, experienced recurrent miscarriage, or simply want reassurance before starting your family, our evidence-based assessment helps you make informed decisions with confidence.",
  "As a trusted fertility clinic in Lahore, we provide comprehensive female fertility test, male fertility test in Lahore, hormone test for fertility, ovulation test, pelvic ultrasound, and semen analysis services. Every investigation is recommended only when clinically appropriate, ensuring you receive accurate diagnosis and a personalised treatment plan that may include IVF, ICSI, IUI, PGD, or PGT when required. Our goal is to explain every result clearly and guide you towards the most appropriate next step.",
];

// FAQ content — kept in one place so the visible accordion and the
// FAQPage schema below always stay in sync.
const faqs = [
  {
    q: "How much does a fertility assessment cost in Lahore?",
    a: "The consultation fee is shown upfront before you confirm your booking. Any recommended tests (hormone panel, ultrasound, semen analysis) are priced separately and only ordered when clinically appropriate — never as a routine package.",
  },
  {
    q: "Do I need a referral to book a fertility assessment?",
    a: "No referral is needed. You can message the clinic directly on WhatsApp to book a consultation with Dr. Kamran Saleem, whether or not you have previous test results.",
  },
  {
    q: "How soon will I get my test results?",
    a: "Most hormone and semen analysis results are ready within a few days. Your results are explained to you in plain language during a follow-up consultation, along with a written next-steps plan.",
  },
  {
    q: "Is a fertility assessment only for women, or should men be tested too?",
    a: "Both partners should ideally be assessed together, since male factors contribute to close to half of all infertility cases. A male fertility test (semen analysis and hormone testing) is a standard part of a complete evaluation.",
  },
];
---

<Layout
  title="Fertility Assessment in Lahore | Tests & Diagnosis – Dr. Kamran Saleem"
  description="Personalised fertility assessment in Lahore with Dr. Kamran Saleem — fertility tests, hormone testing, ultrasound & semen analysis, explained clearly."
>
  <!-- Structured data: helps Google and AI answer engines understand this
       as a medical service page with genuine FAQ content. Purely additive —
       does not touch any visible copy. -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "MedicalWebPage",
        "@id": "https://www.kamranfertility.com/services/assessment#webpage",
        "url": "https://www.kamranfertility.com/services/assessment",
        "name": "Fertility Assessment & Diagnosis by a Fertility Specialist in Lahore",
        "description": "Personalised fertility assessment in Lahore with Dr. Kamran Saleem — fertility tests, hormone testing, ultrasound & semen analysis, explained clearly.",
        "specialty": "Reproductive Medicine",
        "isPartOf": { "@id": "https://www.kamranfertility.com/#website" },
        "about": {
          "@type": "MedicalClinic",
          "name": "Kamran Fertility Clinic",
          "url": "https://www.kamranfertility.com/",
          "telephone": "+923148432789"
        }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.kamranfertility.com/" },
          { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.kamranfertility.com/#services" },
          { "@type": "ListItem", "position": 3, "name": "Assessment & Diagnosis", "item": "https://www.kamranfertility.com/services/assessment" }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqs.map((item) => ({
          "@type": "Question",
          "name": item.q,
          "acceptedAnswer": { "@type": "Answer", "text": item.a }
        }))
      }
    ]
  })} />

  <PageHero
    eyebrow="Assessment & Diagnosis"
    title="Fertility Assessment & Diagnosis by a Fertility Specialist in Lahore"
    sub={heroBody}
    breadcrumbs={breadcrumbs}
    cta="Message us on WhatsApp"
  />

  <!-- Page intro (relative z-10 keeps it above the hero's ambient bleed) -->
  <section class="bg-white py-16 md:py-20">
    <div class="relative z-10 mx-auto max-w-3xl px-5 text-center sm:px-8">
      <p class="mx-auto measure text-lg leading-relaxed text-body [margin-inline:auto]" data-reveal>
        No two fertility journeys are the same. Some patients only require
        reassurance through a few simple investigations, while others benefit
        from a more comprehensive evaluation. Our Fertility Assessment focuses on
        identifying the underlying cause of infertility without recommending
        unnecessary tests, allowing you to understand your reproductive health
        with confidence under the guidance of an experienced infertility
        specialist in Lahore.
      </p>
    </div>
  </section>

  <!-- Service blocks -->
  <section class="bg-white pb-20 md:pb-28">
    <div class="mx-auto max-w-6xl space-y-20 px-5 sm:px-8 md:space-y-28">
      <ServiceBlock
        id="fertility-assessment"
        title="Fertility Assessment & Diagnosis"
        intro="A comprehensive Fertility Assessment is the first step towards understanding why pregnancy has not occurred or identifying potential fertility concerns before treatment begins. Our specialists review your medical history, menstrual cycle, lifestyle, previous pregnancies, and any earlier fertility investigations before recommending appropriate diagnostic tests. Depending on your individual circumstances, your evaluation may include a female fertility test, male fertility test, hormone test for fertility, pelvic ultrasound, ovulation test, semen analysis, blood investigations, and screening for STIs/STDs where clinically indicated. A WHO-standard semen analysis test evaluates sperm count, motility, and morphology, helping us build a complete picture of reproductive health."
        relevantIf={[
          "You've been trying to conceive for 12 months, or 6 months if you're over 35.",
          "You have irregular periods or a known gynaecological condition.",
          "You have experienced miscarriage or previous pregnancy complications.",
          "You or your partner have had an abnormal semen analysis.",
          "You want to understand your fertility before planning pregnancy.",
        ]}
        whatToExpect={[
          "Consultation with a fertility specialist in Lahore",
          "Review of previous investigations and imaging",
          "Personalised hormone test for fertility, ovulation test, ultrasound, or semen analysis where appropriate",
          "A written explanation of your results and recommended next steps, including IVF, ICSI, or IUI only when clinically indicated",
        ]}
      >
        <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 4h-1a1 1 0 0 0 -1 1v3.5a5.5 5.5 0 0 0 11 0v-3.5a1 1 0 0 0 -1 -1h-1" />
          <path d="M8 15a6 6 0 1 0 12 0v-3" />
          <path d="M20 9m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
        </svg>
      </ServiceBlock>

      <ServiceBlock
        id="mens-fertility"
        title="Men's Fertility & Reproductive Health"
        intro="Male fertility contributes to almost half of infertility cases, making early evaluation an essential part of every fertility journey. Our male infertility specialist in Lahore provides confidential assessment of sperm health, hormone levels, reproductive history, and overall Men's Health. A comprehensive male fertility test in Lahore includes a WHO-standard semen analysis, hormone testing, and lifestyle assessment to identify factors affecting sperm quality, count, and motility. When necessary, advanced fertility options such as IUI, ICSI, or IVF are discussed based on your diagnosis rather than offered routinely."
        relevantIf={[
          "You have concerns about sperm count or motility.",
          "Previous semen analysis test results were abnormal.",
          "You have experienced infection, injury, or testicular surgery.",
          "You have noticed reduced libido or erectile dysfunction.",
          "You would like confidential STIs/STDs screening as part of your fertility assessment.",
        ]}
        whatToExpect={[
          "Confidential consultation with a male infertility specialist in Lahore",
          "Male fertility test",
          "WHO-standard semen analysis",
          "Hormone testing where clinically indicated",
          "Lifestyle recommendations and personalised treatment planning",
        ]}
        reversed
      >
        <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
          <path d="M6 21v-2a4 4 0 0 1 4 -4h4" />
          <path d="M15 19l2 2l4 -4" />
        </svg>
      </ServiceBlock>

      <ServiceBlock
        id="cycle-hormonal"
        title="Cycle, Hormonal & Ovulation Concerns"
        intro="Hormonal imbalance and irregular ovulation are among the most common causes of female infertility. Our comprehensive female fertility test evaluates menstrual health, ovarian reserve, ovulation, and reproductive hormones to identify conditions such as PCOS or thyroid disorders. Your assessment may include a hormone test for fertility, PCOS fertility test, ovulation test, pelvic ultrasound, and blood tests including AMH, FSH, and LH where appropriate. If fertility treatment becomes necessary, options such as IUI, IVF, ICSI, PGD, or PGT are discussed according to your individual diagnosis and treatment goals."
        relevantIf={[
          "Your periods are irregular or absent.",
          "You have symptoms of PCOS.",
          "You suspect hormonal imbalance.",
          "You're unsure whether you're ovulating.",
          "You have experienced recurrent miscarriage.",
        ]}
        whatToExpect={[
          "Review of menstrual and reproductive history",
          "Hormone test for fertility",
          "PCOS fertility test",
          "Ovulation test",
          "Pelvic ultrasound",
          "Personalised treatment recommendations",
        ]}
      >
        <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19.5 13.572l-7.5 7.428l-2.896 -2.868m-6.117 -8.104a5 5 0 0 1 9.013 -3.022a5 5 0 1 1 7.5 6.572" />
          <path d="M3 13h2l2 3l2 -6l1 3h3" />
        </svg>
      </ServiceBlock>
    </div>
  </section>

  <!-- Reassurance band (ice, so the CloseContact wave blends) -->
  <section class="bg-ice py-16 md:py-20">
    <div class="mx-auto max-w-3xl px-5 text-center sm:px-8" data-reveal>
      <p class="mx-auto measure font-heading text-xl font-bold leading-snug text-ink [margin-inline:auto] sm:text-2xl">
        Investigations are recommended only when they're clinically appropriate
        and likely to help — never as routine.
      </p>
    </div>
  </section>

  <!-- Related services — new, additive internal linking block -->
  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <h2 class="font-heading text-2xl font-bold text-ink sm:text-3xl text-center">
        Where an assessment can lead
      </h2>
      <p class="mx-auto measure mt-3 text-center text-body [margin-inline:auto]">
        Once your results are in, we'll walk you through what they mean and what,
        if anything, makes sense next.
      </p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        <a href="/services/fertility-treatment" class="block rounded-2xl border border-black/5 bg-ice p-6 transition hover:shadow-md">
          <h3 class="font-heading text-lg font-bold text-ink">Fertility Treatment</h3>
          <p class="mt-2 text-body">
            If your assessment points to a specific cause, explore IUI, IVF,
            ICSI, PGD and PGT options — recommended only when clinically indicated.
          </p>
        </a>
        <a href="/services/support" class="block rounded-2xl border border-black/5 bg-ice p-6 transition hover:shadow-md">
          <h3 class="font-heading text-lg font-bold text-ink">Support & Second Opinions</h3>
          <p class="mt-2 text-body">
            Already have test results or a previous treatment plan from
            elsewhere? Get an independent specialist review before deciding
            what's next.
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQs — new, additive; mirrors the FAQPage schema above -->
  <section class="bg-ice py-16 md:py-20">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <h2 class="font-heading text-2xl font-bold text-ink sm:text-3xl text-center">
        Fertility assessment: frequently asked questions
      </h2>
      <div class="mt-10 space-y-4">
        {faqs.map((item) => (
          <details class="group rounded-xl bg-white p-5 shadow-sm">
            <summary class="cursor-pointer list-none font-heading font-bold text-ink">
              {item.q}
            </summary>
            <p class="mt-3 text-body leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Related reading — new, additive internal linking to the blog -->
  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <h2 class="font-heading text-2xl font-bold text-ink sm:text-3xl text-center">
        Related reading
      </h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <a href="/resources/fertility-assessment-in-lahore" class="block rounded-2xl border border-black/5 p-5 transition hover:shadow-md">
          <p class="text-sm font-semibold text-primary">Fertility Treatment</p>
          <h3 class="mt-1 font-heading font-bold text-ink">Where Can You Get a Fertility Assessment in Lahore?</h3>
        </a>
        <a href="/resources/male-fertility-test" class="block rounded-2xl border border-black/5 p-5 transition hover:shadow-md">
          <p class="text-sm font-semibold text-primary">Diagnosis</p>
          <h3 class="mt-1 font-heading font-bold text-ink">Male fertility test: what it involves and what the results mean</h3>
        </a>
        <a href="/resources/understanding-a-semen-analysis" class="block rounded-2xl border border-black/5 p-5 transition hover:shadow-md">
          <p class="text-sm font-semibold text-primary">Diagnosis</p>
          <h3 class="mt-1 font-heading font-bold text-ink">Understanding a semen analysis</h3>
        </a>
        <a href="/resources/hormone-test--for-fertility" class="block rounded-2xl border border-black/5 p-5 transition hover:shadow-md">
          <p class="text-sm font-semibold text-primary">Fertility Treatment</p>
          <h3 class="mt-1 font-heading font-bold text-ink">Hormone Test for Fertility: Which Tests Do Women Need?</h3>
        </a>
        <a href="/resources/pcos-and-fertility" class="block rounded-2xl border border-black/5 p-5 transition hover:shadow-md">
          <p class="text-sm font-semibold text-primary">Women's health</p>
          <h3 class="mt-1 font-heading font-bold text-ink">PCOS and Fertility: Can You Get Pregnant with PCOS?</h3>
        </a>
        <a href="/resources/when-to-seek-fertility-consultation" class="block rounded-2xl border border-black/5 p-5 transition hover:shadow-md">
          <p class="text-sm font-semibold text-primary">Getting started</p>
          <h3 class="mt-1 font-heading font-bold text-ink">Fertility Consultation: When Should You Seek Advice?</h3>
        </a>
      </div>
    </div>
  </section>

  <CloseContact
    heading="Whatever stage you're at, you won't be rushed or judged."
    body="Speak with an experienced fertility specialist in Lahore to understand your fertility with confidence. Our team will explain every investigation, answer your questions, and recommend a personalised treatment plan based on your individual needs."
    cta="Book Consultation"
  />
</Layout>
