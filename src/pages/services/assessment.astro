---
// src/pages/services/assessment.astro   (URL: /services/assessment)
// Uses the site's own menu/footer via Layout. Match the import path + props to your other pages.
import Layout from "../../layouts/Layout.astro";
const base = "https://www.kamranfertility.com";
const AS = "/services/assessment";
const TS = "/services/tests";
const TR = "/services/fertility-treatment";
const url = `${base}${AS}`;
const title = "Fertility Assessment & Consultation Lahore | Dr. Kamran";
const description = "Fertility assessment and consultation in Lahore for men, women and couples. History review, targeted tests and clear next steps with Dr. Kamran Saleem.";
const phone = "+92 314 8432789";
const wa = "https://wa.me/923148432789?text=" + encodeURIComponent("Hello, I would like to book a fertility assessment and consultation with Dr. Kamran Saleem.");
const reviewed = "2026-11-18";
const reviewedLabel = "November 18, 2026";

// Fill these in when you want them shown on the page (leave empty to hide).
const consultFee = "";   // e.g. "PKR 5,000"
const pmdcNo = "";       // e.g. "12345-P"

const a = (h, t) => `<a href="${h}">${t}</a>`;
const L = {
  fAssess: a(`${AS}/female-fertility-assessment`, "Female Fertility Assessment"),
  mAssess: a(`${AS}/male-fertility-assessment`, "Male Fertility Assessment"),
  hub: a(TS, "individual fertility tests"),
  semen: a(`${TS}/semen-analysis`, "semen analysis"),
  semenCap: a(`${TS}/semen-analysis`, "Semen Analysis"),
  mHorm: a(`${TS}/male-fertility-hormone-test`, "male fertility hormone test"),
  fHorm: a(`${TS}/female-fertility-hormone-test`, "female fertility hormone test"),
  pcos: a(`${TR}/pcos`, "PCOS Treatment"),
  iui: a(`${TR}/iui`, "IUI Treatment"),
  ivf: a(`${TR}/ivf`, "IVF Treatment"),
  icsi: a(`${TR}/icsi`, "ICSI Treatment"),
  fet: a(`${TR}/fet`, "FET Procedures"),
  pgt: a(`${TR}/pgt`, "PGT Testing"),
  mTreat: a(`${TR}/male-infertility`, "Male Infertility Care"),
  second: a("/services/support", "Fertility Support and Second Opinions"),
  doc: a("/dr-kamran-saleem", "About Dr. Kamran Saleem"),
};

const icons = {
  users: '<circle cx="9" cy="8" r="3.5"/><circle cx="17" cy="9" r="2.5"/><path d="M2 20c0-3.5 3-5.5 7-5.5s7 2 7 5.5M16 14.5c3 0 6 1.5 6 4.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  chat: '<path d="M4 5h16v11H9l-5 4z"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/>',
  shield: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/>',
  flask: '<path d="M9 3h6M10 3v6l-5 9a2 2 0 002 3h10a2 2 0 002-3l-5-9V3"/>',
  scan: '<path d="M4 8V5a1 1 0 011-1h3M16 4h3a1 1 0 011 1v3M20 16v3a1 1 0 01-1 1h-3M8 20H5a1 1 0 01-1-1v-3M4 12h16"/>',
  heart: '<path d="M12 21s-7-4.5-7-10a4 4 0 017-2.6A4 4 0 0119 11c0 5.5-7 10-7 10z"/>',
  clip: '<rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4h6v3H9zM9 12h6M9 16h6"/>',
  check: '<path d="M5 12l5 5 9-10"/>',
  cells: '<circle cx="8" cy="8" r="3"/><circle cx="16" cy="8" r="3"/><circle cx="12" cy="16" r="3"/>',
  bolt: '<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',
  target: '<circle cx="12" cy="12" r="4"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/>',
  alert: '<path d="M12 3l10 18H2zM12 10v5M12 18h.01"/>',
  pin: '<path d="M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  tag: '<path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="8.5" r="1.2"/>',
};

const toc = [["what","What it is"],["compare","Assessment vs tests"],["when","When to book"],["partners","Both partners"],["framework","Five stages"],["services","Services"],["concerns","Common concerns"],["pathways","Treatment pathways"],["bring","What to bring"],["fees","Fees & locations"],["faq","FAQ"],["why","Why Dr. Kamran"]];

const facts = [["3","Lahore clinics"],["45-60 min","First consultation"],["Both","Partners evaluated"],["24 h","Typical lab reports"]];

const compare = [
  ["Primary Objective", "Comprehensive couple evaluation and identification of possible fertility factors", "Measuring individual biochemical or physiological parameters"],
  ["Medical Oversight", "Consultation and clinical interpretation by Dr. Kamran Saleem", "Laboratory testing and pathology reporting"],
  ["Diagnostic Scope", "Female, male and couple reproductive evaluation", "Individual investigations such as AMH or semen analysis"],
  ["Test Selection", "Targeted investigations based on medical history and clinical findings", "Specific tests requested or recommended"],
  ["Results", "Clinical interpretation and personalised next-step guidance", "Individual laboratory values requiring appropriate interpretation"],
  ["Outcome", "A fertility assessment and possible treatment roadmap", "Information about a specific reproductive or hormonal parameter"],
];

const when = [
  "You have been trying to conceive for 12 months without success.",
  "The female partner is 35 or older and you have been trying for six months without pregnancy.",
  "The female partner has irregular, infrequent or absent menstrual periods.",
  "There is a history of PCOS, endometriosis, pelvic infection or reproductive surgery.",
  "A previous semen analysis showed low sperm count, reduced motility or abnormal morphology.",
  "Either partner has a known reproductive or hormonal condition.",
  "You have experienced repeated pregnancy loss.",
  "You have undergone unsuccessful fertility treatment, including IVF or IUI.",
  "You want a specialist opinion before beginning fertility treatment.",
  "You are unsure whether previous fertility investigations were sufficient.",
];

// Male / female summaries (condensed; full detail lives on the dedicated pages)
const mf = [
  ["Male Fertility Consultation in Lahore", "user",
   "A male fertility consultation is an important part of evaluating a couple's reproductive health. Male factors contribute to a substantial proportion of fertility difficulties, and an assessment can help identify possible issues involving sperm production, sperm quality, sperm transport or reproductive hormones. Dr. Kamran Saleem sees men who are having difficulty conceiving with their partners, have received an abnormal semen analysis report or want a medical review of their reproductive health.",
   ["How long the couple has been trying, and previous pregnancies", "Previous semen analysis results and other investigations", "Medical conditions, infections, previous surgery, testicular injury, undescended testes or mumps", "Medicines, supplements and relevant lifestyle factors", "Physical examination when clinically appropriate", "Recommendations for semen analysis, hormone testing or further investigations when needed"],
   `Explore: ${L.mAssess} · ${L.semenCap} · ${L.mHorm}`],
  ["Female Fertility Consultation in Lahore", "heart",
   "A female fertility consultation focuses on understanding the factors that may affect ovulation, ovarian function, reproductive hormones, the uterus and fallopian tubes. Dr. Kamran Saleem sees women with delayed conception, irregular menstrual cycles, suspected PCOS, previous pregnancy loss or other reproductive health concerns. Previous blood tests, ultrasound reports and treatment records are reviewed where available.",
   ["Menstrual history and cycle regularity", "Previous pregnancies, miscarriages and fertility treatments", "History of PCOS, irregular ovulation, pelvic infection or surgery", "Ovarian reserve and review of previous AMH and hormone results", "Assessment of uterine and pelvic health, and tubal evaluation when indicated", "Medicines, supplements and relevant lifestyle factors"],
   `Explore: ${L.fAssess} · ${L.fHorm} · ${L.pcos}`],
];
const couple = [
  "How long the couple has been trying to conceive.",
  "Previous pregnancies and reproductive history.",
  "Menstrual cycle and ovulation patterns.",
  "Previous semen analysis and hormone reports.",
  "Previous miscarriages or unsuccessful fertility treatments.",
  "Relevant medical conditions and surgical history.",
  "Investigations that may be needed for either partner.",
  "Possible next steps based on the available findings.",
];

const stages = [
  { t: "Couple Consultation and Medical History Review", i: "user",
    intro: "Dr. Kamran Saleem conducts a detailed review of both partners' reproductive and medical history. Both partners are encouraged to attend together.",
    lead: "The consultation may cover:",
    list: ["Duration of trying to conceive.", "Previous pregnancies and miscarriages.", "Menstrual cycle patterns and ovulation history.", "Previous fertility treatments and their outcomes.", "Previous medical conditions and surgeries.", "Relevant medications and lifestyle factors.", "Existing blood tests, ultrasound reports and semen analysis results."],
    outro: "This initial discussion helps identify which aspects of fertility require further assessment." },
  { t: "Targeted Female Reproductive Evaluation", i: "heart",
    intro: "Female evaluation focuses on understanding ovulation, ovarian function, hormonal factors and reproductive anatomy.",
    paras: [["Ovarian Reserve Assessment:", "AMH testing and antral follicle count may help assess ovarian reserve. These findings provide information about egg quantity but do not independently determine whether natural conception is possible."],
            ["Ovulatory and Endocrine Profiling:", "Depending on menstrual history and symptoms, investigations may include FSH, LH, estradiol, TSH and prolactin. Progesterone testing may be used to assess ovulation when appropriately timed."],
            ["Structural and Uterine Assessment:", "Pelvic or transvaginal ultrasound may help evaluate the uterus, ovaries and endometrial lining. Further assessment of the fallopian tubes or uterine cavity may be recommended when clinically indicated."]],
    more: `Related: ${L.fAssess} · ${L.fHorm}` },
  { t: "Targeted Male Reproductive Evaluation", i: "flask",
    intro: "Male fertility assessment goes beyond checking sperm count. It considers sperm production, sperm movement, sperm shape, reproductive history and possible hormonal or structural factors.",
    paras: [["WHO 6th Edition Semen Analysis:", `A ${L.semen} evaluates parameters such as semen volume, sperm concentration, total sperm number, motility and morphology. Results should be interpreted alongside clinical history and other findings.`],
            ["Repeat Semen Analysis:", "Sperm parameters can vary between samples. A repeat test may be recommended when the first result is abnormal or does not provide enough information."],
            ["Physical Examination:", "Where appropriate, a clinical examination may help identify conditions such as varicocele, testicular abnormalities or other reproductive concerns."],
            ["Endocrine Evaluation:", `FSH, LH and testosterone testing (the ${L.mHorm}) may be considered when sperm numbers are low, azoospermia is present or symptoms suggest a hormonal issue. Additional tests depend on clinical findings.`],
            ["Advanced Sperm Diagnostics:", "Sperm DNA fragmentation testing, semen culture and genetic investigations may be considered in selected cases rather than as routine screening for every man."]],
    more: `Related: ${L.mAssess} · ${L.semenCap}` },
  { t: "Review and Interpretation of Results", i: "clip",
    intro: "Laboratory values and imaging reports need to be understood in the context of the patient's medical history. During the results review, Dr. Kamran Saleem explains the available findings in clear language and discusses:",
    list: ["Which findings are within expected ranges.", "Which results may require further investigation.", "Whether an abnormal result needs confirmation.", "Whether male and female factors may be contributing together.", "Whether additional tests or specialist referral may be appropriate.", "What the findings mean for the couple's next steps."],
    outro: "A single abnormal result does not always establish a final diagnosis. Further evaluation may be needed depending on the individual circumstances." },
  { t: "Personalised Fertility Management Plan", i: "target",
    intro: "After reviewing the clinical findings, the doctor discusses the appropriate next steps with the couple.",
    lead: "Depending on the assessment, these may include:",
    list: ["Advice on natural conception and fertile timing.", "Management of ovulatory or hormonal concerns.", "Further evaluation of male reproductive factors.", "Treatment of relevant underlying conditions.", "Referral for additional investigations.", "Discussion of IUI, IVF or ICSI when appropriate.", "Review of previous fertility treatment and alternative options."],
    outro: "The recommended approach depends on the diagnosis, age, reproductive history and individual circumstances of both partners." },
];

const services = [
  ["Female Fertility Assessment", "heart", "A female fertility assessment evaluates reproductive health, including ovarian reserve, menstrual cycle regularity, ovulation, hormonal balance and pelvic anatomy. It may be suitable for women planning pregnancy, experiencing delayed conception, irregular cycles or known reproductive conditions.", `${AS}/female-fertility-assessment`, "Explore Female Fertility Assessment"],
  ["Male Fertility Assessment", "user", "A male fertility assessment evaluates sperm production, sperm quality, reproductive history and relevant hormonal factors. It may include semen analysis interpretation, physical examination and additional investigations where clinically appropriate.", `${AS}/male-fertility-assessment`, "Explore Male Fertility Assessment"],
  ["Hormonal Analysis and Endocrine Profiling", "bolt", "Hormonal factors can affect ovulation, menstrual cycles and sperm production. Depending on symptoms and medical history, assessment may include AMH, FSH, LH, estradiol, progesterone, TSH, prolactin or testosterone. The specific tests selected depend on the clinical question being investigated.", `${TS}/female-fertility-hormone-test`, "Female Hormone Test", `${TS}/male-fertility-hormone-test`, "Male Hormone Test"],
  ["Ovulation and Follicular Monitoring", "scan", "Ovulation assessment helps determine whether an egg is being released and whether the menstrual cycle is suitable for natural conception or a planned fertility treatment. Depending on the clinical situation, assessment may involve menstrual history, appropriately timed blood tests and serial ultrasound monitoring of follicular development.", `${TR}/pcos`, "Ovulation and PCOS Management"],
  ["WHO 6th Edition Semen Analysis", "flask", "Semen analysis is a key investigation in male fertility assessment. It evaluates semen volume, sperm concentration, total sperm number, motility and morphology. A report should be interpreted in the context of the patient's medical history. An abnormal result may require repeat testing or further assessment before a diagnosis is made.", `${TS}/semen-analysis`, "Explore Semen Analysis"],
  ["Comprehensive Male Infertility Assessment", "cells", "Men with very low sperm counts, no sperm in the ejaculate or other significant reproductive concerns may need further investigation. Depending on initial findings, this may involve hormonal testing, physical examination, imaging, genetic evaluation or assessment for possible infection. Advanced investigations such as sperm DNA fragmentation testing are considered only in selected circumstances.", `${TR}/male-infertility`, "Explore Male Infertility Care"],
];

const concerns = [
  ["PCOS and Irregular Ovulation", "Women with polycystic ovary syndrome may experience irregular menstrual cycles or problems with ovulation. A fertility consultation can help review cycle patterns, previous diagnoses and relevant investigations.", `Related: ${L.pcos}`],
  ["Low Sperm Count and Abnormal Semen Results", "A low sperm count, reduced motility or abnormal morphology may require further evaluation. The doctor reviews the semen report alongside medical history and may recommend repeat testing or additional investigations.", `Related: ${L.mAssess} · ${L.semenCap}`],
  ["Unexplained Infertility", "Sometimes initial investigations do not identify a clear cause of difficulty conceiving. In these situations, the doctor reviews the available information to identify whether further assessment is needed and discusses reasonable next steps.", `Related: ${L.fAssess} · ${L.mAssess}`],
  ["Recurrent Pregnancy Loss", "A history of repeated pregnancy loss may require a separate evaluation of relevant medical, reproductive and hormonal factors. The appropriate investigations depend on the patient's history and previous findings.", `Related: ${L.second}`],
  ["Previous Unsuccessful IVF or IUI", "Couples who have undergone unsuccessful fertility treatment may benefit from a review of their previous investigations, treatment records and clinical history before deciding what to do next.", `Related: ${L.second}`],
];

const pathways = [
  ["Ovulation Induction and PCOS Management", "For women experiencing ovulatory problems, treatment may involve medication and monitoring when appropriate.", `${TR}/pcos`, "PCOS Treatment"],
  ["Intrauterine Insemination (IUI)", "IUI may be considered in selected cases depending on sperm parameters, tubal status and other clinical factors.", `${TR}/iui`, "IUI Treatment"],
  ["In Vitro Fertilization (IVF)", "IVF may be discussed for certain fertility conditions, including tubal factors and other indications.", `${TR}/ivf`, "IVF Treatment"],
  ["Intracytoplasmic Sperm Injection (ICSI)", "ICSI may be considered in selected cases involving significant male factor infertility or previous fertilisation difficulties.", `${TR}/icsi`, "ICSI Treatment"],
  ["Frozen Embryo Transfer (FET)", "FET may be discussed for couples who have cryopreserved embryos and are planning a subsequent transfer.", `${TR}/fet`, "FET Procedures"],
  ["Preimplantation Genetic Testing (PGT)", "PGT may be discussed for specific genetic or chromosomal indications following appropriate counselling.", `${TR}/pgt`, "PGT Testing"],
];

const bring = [
  "Previous blood test and hormone reports.",
  "AMH and other ovarian reserve results.",
  "Previous pelvic or transvaginal ultrasound reports.",
  "HSG or other fallopian tube investigation reports.",
  "Previous semen analysis results.",
  "Records of previous IVF, ICSI or IUI cycles.",
  "A list of current medicines and supplements.",
  "Details of previous medical conditions and surgeries.",
  "Menstrual cycle dates or records, where relevant.",
];

const locations = [
  ["DHA Defence Branch", "Rasheed Hospital, Main Boulevard, DHA Defence, Lahore", "3:00 PM–6:00 PM; Saturday and Sunday closed", "/locations/dha-lahore"],
  ["Gulberg III Branch", "TAMC Clinic, M.M. Alam Road, Gulberg III, Lahore", "Wednesday 12:00 PM–3:00 PM; other days by appointment", "/locations/mm-alam-road-lahore"],
  ["Shalamar Branch", "Shahnaz Hospital, Shalamar Link Road, Lahore", "Monday and Thursday 6:00 PM–9:00 PM", "/locations/shalamar-lahore"],
];

const related = [
  ["Female Fertility Assessment", `${AS}/female-fertility-assessment`, "Ovulation, ovarian reserve, hormones and pelvic anatomy."],
  ["Male Fertility Assessment", `${AS}/male-fertility-assessment`, "Sperm health, history, examination and hormones."],
  ["All Fertility Tests", TS, "Every individual diagnostic test, with timing and turnaround."],
  ["Semen Analysis", `${TS}/semen-analysis`, "WHO 6th Edition count, motility and morphology."],
  ["Male Fertility Hormone Test", `${TS}/male-fertility-hormone-test`, "Testosterone, FSH, LH, prolactin, estradiol and TSH."],
  ["Female Fertility Hormone Test", `${TS}/female-fertility-hormone-test`, "AMH, FSH, LH, estradiol and thyroid testing."],
  ["Fertility Treatment", TR, "PCOS, IUI, IVF, ICSI, FET and PGT pathways."],
  ["Male Infertility Care", `${TR}/male-infertility`, "Low count, azoospermia and sperm retrieval."],
  ["Support & Second Opinions", "/services/support", "An independent review of earlier reports and failed cycles."],
  ["Success Stories", "/success-stories", "Patient stories from our Lahore clinics."],
  ["Fertility Resources", "/resources", "Guides to results, timing and common questions."],
  ["About Dr. Kamran Saleem", "/dr-kamran-saleem", "Qualifications, experience and clinical approach."],
];

const faqs = [
  ["What happens during a fertility assessment in Lahore?", "A fertility assessment begins with a review of both partners' reproductive and medical histories. Dr. Kamran Saleem considers previous pregnancies, menstrual cycles, semen analysis reports, medical conditions and previous treatments. Further investigations are recommended according to the findings."],
  ["Should both partners attend a fertility consultation?", "Yes, when possible. Fertility difficulties can involve male factors, female factors or both. Evaluating both partners helps the doctor understand the complete reproductive picture and decide which investigations may be appropriate."],
  ["Where can I book a male fertility consultation in Lahore?", `You can contact Kamran Fertility Clinic to arrange a male fertility consultation with Dr. Kamran Saleem at ${a("/locations/dha-lahore", "Rasheed Hospital in DHA")}, ${a("/locations/mm-alam-road-lahore", "TAMC Clinic on M.M. Alam Road in Gulberg")} or ${a("/locations/shalamar-lahore", "Shahnaz Hospital on Shalamar Link Road")}. Appointment availability should be confirmed before visiting. See ${L.mAssess}.`],
  ["Where can I book a female fertility consultation in Lahore?", `Female fertility consultations are available through Kamran Fertility Clinic at its Lahore practice locations. The consultation may include a review of menstrual history, previous pregnancy records, ultrasound findings and relevant hormonal investigations. See ${L.fAssess}.`],
  ["When should a couple consult a fertility doctor?", "Generally, couples should consider an infertility assessment after 12 months of trying to conceive without success, or after six months when the female partner is 35 or older. Earlier evaluation may be appropriate if there are irregular periods, known reproductive conditions, previous reproductive surgery or other risk factors."],
  ["Do I need to complete all fertility tests before my first appointment?", "No. You do not need to order every fertility test before seeing a doctor. Bring any existing reports, and the doctor can advise which additional investigations, if any, may be useful."],
  ["What tests are included in a female fertility assessment?", `Depending on individual needs, a female assessment may involve review of menstrual cycles, ovulation, ovarian reserve, reproductive hormones, pelvic ultrasound and assessment of the fallopian tubes. Not all tests are required for every woman. See the ${L.fHorm}.`],
  ["What tests are included in a male fertility assessment?", `Male fertility evaluation commonly begins with medical and reproductive history and ${L.semen}. Depending on the results, further assessment may involve physical examination, reproductive hormone testing (${L.mHorm}), imaging or selected genetic investigations.`],
  ["Can I book a fertility consultation after an unsuccessful IVF or IUI cycle?", `Yes. Couples can seek a specialist review after unsuccessful fertility treatment. Previous treatment records, embryo or cycle information where available, semen analysis reports and relevant investigations can help the doctor understand what has already been evaluated. See ${L.second}.`],
  ["How much does a fertility assessment cost in Lahore?", `The consultation fee and investigation costs may be separate. Contact Kamran Fertility Clinic on ${phone} to confirm the current consultation fee, appointment availability and any additional costs before booking.`],
  ["Does a normal fertility assessment guarantee pregnancy?", "No. Fertility assessment helps identify possible contributing factors and guides further decisions, but no evaluation or treatment can guarantee pregnancy. Outcomes depend on many individual medical and reproductive factors."],
  ["How much does a fertility test cost in Lahore?", `Test fees depend on which investigations your history calls for, and they are confirmed before you book. For example, male fertility hormone tests start from PKR 4,000 for a single test and PKR 8,000–12,000 for a full profile. See the ${L.mHorm}, ${L.semen} and ${L.fHorm} pages.`],
  ["How do I know if I might be infertile?", "Many people have no symptoms. The usual sign is not conceiving after 12 months of regular, unprotected intercourse (six months if the female partner is 35 or older). Irregular or absent periods, known reproductive conditions or an abnormal semen report are reasons to be assessed sooner. Only an assessment can show whether a fertility problem exists."],
  ["What is the difference between a fertility check-up and a fertility assessment?", `A check-up often means a few standalone ${L.hub}. A doctor-led assessment reviews the history of both partners first and then selects the tests that are relevant, so results are interpreted in context.`],
  ["How long does a fertility assessment take?", "The first consultation takes 45 to 60 minutes. Tests such as ultrasound, blood draws and semen collection can be arranged at the clinic depending on the test and location, and most semen and hormone reports are ready within 24 hours. A results review then follows."],
  ["Is a fertility assessment painful or invasive?", "Most of it is history taking, ultrasound, blood tests and a private semen sample. If a tube or uterine-cavity investigation is needed, the doctor explains it and answers your questions beforehand."],
];

const strip = (s) => s.replace(/<[^>]+>/g, "");
const clinicId = base + "/#clinic";
const hrs = (days, o, c) => [{ "@type": "OpeningHoursSpecification", dayOfWeek: days, opens: o, closes: c }];
const place = (name, street, days, o, c, link) => ({ "@type": "Place", name, url: base + link, address: { "@type": "PostalAddress", streetAddress: street, addressLocality: "Lahore", addressRegion: "Punjab", addressCountry: "PK" }, openingHoursSpecification: hrs(days, o, c) });
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "MedicalWebPage", "@id": url, url, name: title, description, inLanguage: "en-PK", lastReviewed: reviewed, dateModified: reviewed,
      reviewedBy: { "@id": base + "/dr-kamran-saleem#physician" },
      about: { "@type": "MedicalProcedure", name: "Fertility assessment", description: "Doctor-led evaluation of both partners to understand possible reasons for difficulty conceiving." },
      breadcrumb: { "@id": url + "#breadcrumb" }, publisher: { "@id": clinicId } },
    { "@type": "MedicalClinic", "@id": clinicId, name: "Kamran Fertility Clinic", url: base, telephone: "+923148432789", logo: base + "/assets/logo.webp", image: base + "/assets/logo.webp",
      location: [
        place("Rasheed Hospital (DHA Defence)", "Main Boulevard, DHA Defence", ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], "15:00", "18:00", "/locations/dha-lahore"),
        place("TAMC Clinic (M.M. Alam Road, Gulberg III)", "M.M. Alam Road, Gulberg III", ["Wednesday"], "12:00", "15:00", "/locations/mm-alam-road-lahore"),
        place("Shahnaz Hospital (Shalamar Link Road)", "Shalamar Link Road", ["Monday", "Thursday"], "18:00", "21:00", "/locations/shalamar-lahore") ],
      availableService: ["Couple fertility consultation", "Male fertility assessment", "Female fertility assessment", "Semen analysis", "Fertility hormone tests", "Ovulation and follicular monitoring", "Second opinions"].map(n => ({ "@type": "MedicalProcedure", name: n })) },
    { "@type": "Physician", "@id": base + "/dr-kamran-saleem#physician", name: "Dr. Kamran Saleem", url: base + "/dr-kamran-saleem", description: "MBBS 1988; Diploma in Genito-Urinary Medicine & Venereology, University of Liverpool (1998); PMDC registered; 25+ years of clinical reproductive experience.", worksFor: { "@id": clinicId } },
    { "@type": "BreadcrumbList", "@id": url + "#breadcrumb", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: base + "/" },
      { "@type": "ListItem", position: 2, name: "Services", item: base + "/services" },
      { "@type": "ListItem", position: 3, name: "Fertility Assessment", item: url } ] },
    { "@type": "FAQPage", mainEntity: faqs.map(([q, ans]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: strip(ans) } })) },
  ],
};
---
<Layout title={title} description={description}>
<div class="ivf">
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<main>
<section class="hero"><div class="w hgrid">
  <div>
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/services">Services</a> / Fertility Assessment</nav>
    <p class="eye">Doctor-led · Both partners · Lahore</p>
    <h1>Fertility Assessment &amp; Consultation in Lahore</h1>
    <p class="lead">A clear evaluation for men, women and couples with Dr. Kamran Saleem</p>
    <p class="sub">Understand why pregnancy has not happened yet. Dr. Kamran reviews both partners' history and existing reports, chooses only the tests that are relevant, and explains what the findings mean and what to do next.</p>
    <p class="actions"><a class="btn" href={wa}>Book on WhatsApp</a> <a class="btn ghost" href="#framework">How the assessment works</a></p>
    <p class="mini">Phone / WhatsApp: <a href="tel:+923148432789">{phone}</a> · Individual tests only? See <a href={TS}>fertility tests</a></p>
  </div>
  <div class="hside">
    <div class="pinbox" aria-hidden="true">
      <svg class="pinart" viewBox="0 0 200 200">
        <defs><radialGradient id="ag" cx="40%" cy="35%" r="70%"><stop offset="0" stop-color="#ffffff"/><stop offset=".6" stop-color="#dbeafe"/><stop offset="1" stop-color="#93c5fd"/></radialGradient></defs>
        <circle cx="100" cy="100" r="92" fill="url(#ag)" stroke="#ffffff" stroke-width="6"/>
        <circle cx="82" cy="100" r="40" fill="#2563eb" fill-opacity=".28" stroke="#1d4ed8" stroke-width="3"/>
        <circle cx="118" cy="100" r="40" fill="#4cc9f0" fill-opacity=".38" stroke="#0b1f4b" stroke-width="3"/>
        <path d="M92 100l8 9 16-18" stroke="#0b1f4b" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <ul class="facts">
      <li><b>2</b> partners, one evaluation</li>
      <li><b>45-60 min</b> first consultation</li>
      <li><b>3</b> clinics: DHA, Gulberg, Shalamar</li>
    </ul>
  </div>
</div></section>

