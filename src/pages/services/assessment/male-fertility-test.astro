---
import TreatmentPage from "../../../components/TreatmentPage.astro";

const T = "/services/fertility-treatment";
const A = "/services/assessment";

const page = {
  slug: "male-infertility",
  name: "Male Infertility Assessment",
  title: "Male Infertility Assessment & Causes | Kamran Fertility Clinic",
  description: "Arrange a male infertility assessment with Dr. Kamran Saleem to review history, semen reports, possible causes and appropriate next investigations.",
  eyebrow: "Male Infertility Assessment",
  h1: "Male Infertility Assessment and Diagnostic Review",
  waText: "Hello, I would like to book a male infertility assessment with Dr. Kamran Saleem.",
  ctaLabel: "Book an assessment",
  heroSub: [
    "A male infertility assessment reviews possible factors affecting sperm production, sperm delivery and reproductive hormones.",
    "Dr. Kamran Saleem can discuss your history and previous reports and help identify which evaluations may be appropriate.",
  ].join(" "),
  leadIn: [
    { rich: ["This assessment is part of a wider fertility evaluation. The tests selected depend on your history, symptoms and previous results. Explore the related ", ["Fertility Assessment & Diagnosis", A], " pathway, or read the educational guide ", ["Male Infertility Consultation", "/resources/male--infertility-consultation"], "."] },
  ],
  sections: [
    {
      id: "male-assessment-consultation",
      title: "What a Male Infertility Assessment Involves",
      intro: "The evaluation looks for factors that may affect sperm production, sperm delivery or reproductive hormones.",
      icon: "clipboard",
      body: [
        "The consultation reviews medical and reproductive history, medicines, prior illnesses or surgery and any previous semen analysis.",
        { ul: [
          "How long you have been trying to conceive",
          "Previous semen analysis or fertility reports",
          "Relevant medical history and medicines",
          "Whether examination or further investigations may be appropriate",
        ] },
      ],
    },
    {
      id: "when-male-assessment",
      title: "When to Seek a Male Fertility Assessment",
      intro: "Assessment may be useful when conception has not occurred or a male reproductive concern is known.",
      icon: "calendar",
      body: [
        { ul: [
          "An abnormal semen analysis",
          "A history of testicular injury, surgery or certain infections",
          "A known hormonal or reproductive condition",
          "Sexual or ejaculation concerns that may affect conception",
          "No pregnancy after 12 months of trying, or sooner if a partner is 35 or older",
        ] },
      ],
    },
    {
      id: "possible-causes",
      title: "Possible Causes of Male Infertility",
      intro: "Causes are often grouped by where the problem lies, and sometimes more than one factor is present.",
      icon: "compare",
      body: [
        { ul: [
          "Sperm production problems, which may relate to hormones, genetics, infections, past testicular injury or heat exposure",
          "A varicocele, which is an enlargement of the veins around the testicle and is examined during assessment",
          "Blockage or problems with sperm transport or ejaculation",
          "Medicines, smoking, alcohol, recreational drugs or anabolic steroid use",
          "Other medical conditions or past treatment such as chemotherapy",
        ] },
        "In some men no clear cause is found. The assessment can still be useful in ruling out other explanations.",
      ],
    },
    {
      id: "possible-investigations",
      title: "Tests Are Chosen From the Findings",
      intro: "The consultation does not automatically mean a large test panel is needed.",
      icon: "flask",
      body: [
        "A clinician may recommend semen analysis, selected hormone tests or other investigations based on the history and initial findings. Further tests may be considered when sperm numbers are very low or no sperm are found.",
        { rich: ["For specific testing, see ", ["semen analysis", `${A}/semen-analysis`], ", ", ["male fertility testing", `${A}/male-fertility-test`], " or ", ["hormonal analysis", `${A}/hormonal-analysis`], "."] },
      ],
    },
    {
      id: "male-assessment-next-steps",
      title: "Planning the Next Step",
      intro: "The aim is to understand the findings and decide what further evaluation, if any, is needed.",
      icon: "route",
      body: [
        { ul: [
          "Review existing reports and any recommended tests",
          "Discuss possible causes without assuming a diagnosis",
          "Ask whether specialist referral or follow-up is appropriate",
          "Review costs before proceeding with additional investigations",
        ] },
        { rich: ["This page covers assessment and diagnosis only. If treatment becomes relevant after your results, it is discussed separately; see ", ["Male Infertility Treatment", "/resources/male-infertility--treatment"], " for an overview."] },
      ],
    },
    {
      id: "partner-evaluation",
      title: "Evaluating Both Partners Together",
      intro: "Fertility outcomes depend on both partners, so assessment is often arranged in parallel.",
      icon: "compare",
      body: [
        { rich: ["While a male assessment is under way, a female partner may benefit from a ", ["female fertility assessment", `${A}/female-fertility-test`], " and, where cycles are unclear, an ", ["ovulation test", `${A}/ovulation-test`], "."] },
      ],
    },
  ],
  faqs: [
    { q: "Should both partners be assessed?", a: "Fertility evaluation often considers both partners. The clinician can advise what assessments are appropriate based on your circumstances." },
    { q: "Do I need a semen analysis before booking?", a: "Not necessarily. If you already have one, bring it. The clinician can discuss whether it is useful or needs repeating." },
    { q: "Does an abnormal semen test mean infertility is permanent?", a: "No. A result needs interpretation in context, and next steps depend on the cause and the full assessment." },
    { q: "What are common causes of male infertility?", a: "They include sperm production problems, hormonal issues, varicocele, blockages, infections, medicines and lifestyle factors. Sometimes no cause is identified." },
    { q: "What happens after a male infertility assessment?", a: "The clinician reviews the findings with you, explains possible causes, and advises whether repeat tests, further investigations or follow-up are needed." },
    { q: "Does male infertility affect sexual performance?", a: "Not necessarily. Many men with fertility problems have normal sexual function, but sexual or ejaculation concerns can be discussed openly during the consultation." },
  ],
  closingHeading: "Male Infertility Assessment with Dr. Kamran Saleem",
  closingParas: [
    "Dr. Kamran Saleem can review your history and available reports, discuss whether this assessment is appropriate, and explain possible next steps. The exact tests and plan depend on your individual circumstances.",
    "You can ask about the consultation and any separate test fees before confirming an appointment.",
  ],
  resources: [
    { href: "/resources/male--infertility-consultation", category: "Fertility Assessment", title: "Male Infertility Consultation" },
    { href: "/resources/male-infertility--treatment", category: "Fertility Assessment", title: "Male Infertility Treatment" },
    { href: "/resources/understanding-a-semen-analysis", category: "Fertility Assessment", title: "Understanding a Semen Analysis" },
  ],
  close: {
    heading: "Need Help Choosing the Right Assessment?",
    body: "Share your history, symptoms or previous reports when booking so the consultation can focus on your questions.",
    cta: "Book an assessment",
  },
};
---

<TreatmentPage {...page} />
