---
import TreatmentPage from "../../../components/TreatmentPage.astro";

const T = "/services/fertility-treatment";
const A = "/services/assessment";

const page = {
  slug: "male-infertility",
  name: "Male Fertility Assessment",
  title: "Male Fertility Assessment in Lahore | Dr. Kamran Saleem",
  description: "Male fertility assessment in Lahore with Dr. Kamran Saleem: semen analysis review, hormone evaluation, varicocele examination and a clear plan for next steps.",
  eyebrow: "Male Fertility Assessment in Lahore",
  h1: "Male Fertility Assessment in Lahore",
  waText: "Hello, I would like to book a male fertility assessment with Dr. Kamran Saleem.",
  ctaLabel: "Book a male fertility assessment",
  heroSub: [
    "A male fertility assessment is a confidential clinical evaluation of sperm production, sperm quality, sperm delivery and the hormones that control them. Male factors contribute to roughly half of couples’ fertility difficulties, so early assessment of the man is an essential part of the process.",
    "With Dr. Kamran Saleem, the assessment starts with your history and any previous semen analysis reports, so only the investigations that answer a real question are advised.",
  ].join(" "),
  leadIn: [
    { rich: ["This assessment is part of a complete fertility evaluation for couples. The investigations chosen depend on your history, symptoms and earlier results. See the full ", ["Fertility Assessment & Diagnosis", A], " pathway, or read the guide to a ", ["male infertility consultation", "/resources/male--infertility-consultation"], "."] },
  ],
  sections: [
    {
      id: "what-male-assessment-includes",
      title: "What a Male Fertility Assessment Includes",
      intro: "A good assessment is built on a careful history first, then a focused examination and only the investigations that are needed.",
      icon: "clipboard",
      body: [
        "Your consultation is private and unhurried. Dr. Kamran Saleem reviews how long you have been trying to conceive, your general health, past illnesses or surgery, medicines and lifestyle, and any semen analysis you already have.",
        { ul: [
          "Reproductive and sexual history, including ejaculation or erection concerns that may affect conception",
          "Review of previous semen analysis reports, including the laboratory and the date",
          "Medical history such as mumps, infections, undescended testicles, hernia repair or testicular injury",
          "Medicines and exposures, including smoking, alcohol, anabolic steroids, testosterone treatment and heat exposure",
          "Clinical examination where appropriate, including a check for a varicocele",
          "Semen analysis, and hormone evaluation or scrotal ultrasound when the findings call for them",
        ] },
      ],
    },
    {
      id: "when-to-book",
      title: "When to Book a Male Fertility Assessment",
      intro: "Do not wait for the female partner’s results alone. The man can be assessed at the same time.",
      icon: "calendar",
      body: [
        { ul: [
          "You have been trying to conceive for 12 months, or for 6 months if your partner is 35 or older",
          "A previous semen analysis showed low count, reduced motility or abnormal shape",
          "You have had testicular injury, torsion, surgery, mumps or a genital infection",
          "You have a known hormonal condition, or you use anabolic steroids or testosterone",
          "You have low libido, erectile difficulty or problems with ejaculation",
          "Your partner has had a fertility problem and you want a complete picture",
        ] },
      ],
    },
    {
      id: "semen-analysis-review",
      title: "Semen Analysis: The Core of the Assessment",
      intro: "Semen analysis is the basic starting point for evaluating male fertility, and how it is interpreted matters as much as the numbers.",
      icon: "flask",
      body: [
        "The analysis looks at semen volume, sperm concentration, total count, motility and the proportion of normally shaped sperm. It is performed in a laboratory following the WHO laboratory manual, whose current sixth edition was published in 2021.",
        "Results can vary from one sample to the next, so a single abnormal result is not a diagnosis. Dr. Kamran Saleem reads the result alongside your history and examination, and may advise a repeat sample after an interval. Giving a sample after a short period of abstinence, usually two to seven days, helps keep results reliable.",
        { rich: ["Read more in ", ["Understanding a Semen Analysis", "/resources/understanding-a-semen-analysis"], " or see our ", ["semen analysis", `${A}/semen-analysis`], " service."] },
      ],
    },
    {
      id: "possible-causes",
      title: "Causes the Assessment Looks For",
      intro: "Causes are usually grouped by where the problem lies, and more than one factor can be present.",
      icon: "compare",
      body: [
        { ul: [
          "Sperm production problems linked to hormones, genetics, infection, past testicular injury or heat",
          "Varicocele, an enlargement of the veins around the testicle that is found on examination",
          "Blockage or problems with sperm transport or ejaculation",
          "Medicines and lifestyle factors, including smoking, alcohol, recreational drugs and anabolic steroids",
          "Medical conditions or earlier treatment such as chemotherapy",
          "Very low sperm numbers or no sperm in the semen, which need additional evaluation",
        ] },
        "In some men no clear cause is found. Even then, the assessment is useful because it rules out treatable conditions and helps you and your partner choose the next step.",
      ],
    },
    {
      id: "further-investigations",
      title: "When Further Investigations Are Needed",
      intro: "A large panel is not automatic. Additional investigations are ordered only when the first findings point to them.",
      icon: "flask",
      body: [
        { ul: [
          "Hormone evaluation, such as FSH, LH, testosterone and prolactin, when sperm numbers are low or there are signs of a hormonal cause",
          "Scrotal ultrasound when examination is difficult or a structural problem is suspected",
          "Genetic evaluation in selected cases, for example when sperm numbers are very low or absent",
          "Screening for infection where symptoms or history suggest it",
        ] },
        { rich: ["See also: ", ["hormonal analysis", `${A}/hormonal-analysis`], " and the overview ", ["male fertility assessment", `${A}/male-fertility-test`], "."] },
      ],
    },
    {
      id: "after-assessment",
      title: "What Happens After the Assessment",
      intro: "You leave with your findings explained in plain language and a clear idea of what comes next.",
      icon: "route",
      body: [
        { ul: [
          "A full explanation of each finding and what it does and does not mean",
          "Practical advice on lifestyle, medicines and timing where relevant",
          "A decision on repeat analysis, further investigations or referral",
          "A clear explanation of fees and follow-up before anything extra is arranged",
        ] },
        { rich: ["This page covers assessment and diagnosis. If treatment becomes relevant after your results, it is discussed separately; see ", ["male infertility treatment", "/resources/male-infertility--treatment"], " for an overview."] },
      ],
    },
    {
      id: "partner-evaluation",
      title: "Assessing Both Partners Together",
      intro: "Fertility depends on both partners, so the assessments are best done in parallel rather than one after the other.",
      icon: "compare",
      body: [
        { rich: ["While your assessment is under way, your partner may benefit from a ", ["female fertility assessment", `${A}/female-fertility-assessment`], " and, where cycles are unclear, an ", ["ovulation assessment", `${A}/ovulation-test`], ". Doing both together avoids lost months and gives a complete picture."] },
      ],
    },
  ],
  faqs: [
    { q: "What is a male fertility assessment?", a: "It is a clinical evaluation of the factors that affect a man’s fertility, including history, examination, semen analysis and, when needed, hormone evaluation or scrotal ultrasound." },
    { q: "Where can I get a male fertility assessment in Lahore?", a: "You can book a confidential male fertility assessment with Dr. Kamran Saleem at Kamran Fertility Clinic in Lahore. Message the clinic on WhatsApp to arrange a consultation." },
    { q: "Do I need a semen analysis before my appointment?", a: "Not necessarily. If you already have a report, bring it. Dr. Kamran Saleem will tell you whether it is enough or needs repeating, and can arrange a new sample if required." },
    { q: "How should I prepare for a semen analysis?", a: "Laboratories usually ask for two to seven days of abstinence before the sample. Tell the clinician about recent fever, illness or new medicines, as these can temporarily affect results." },
    { q: "Does one abnormal semen analysis mean I am infertile?", a: "No. Results vary between samples, and one result is not a diagnosis. The clinician interprets it with your history and examination and may advise a repeat." },
    { q: "What are the common causes of male infertility?", a: "They include sperm production problems, hormonal causes, varicocele, blockages, infections, certain medicines and lifestyle factors. In some men no cause is found." },
    { q: "Can lifestyle changes improve sperm quality?", a: "They can help in some men. Stopping smoking, reducing alcohol, avoiding anabolic steroids, managing weight and limiting heat exposure are commonly advised, though they cannot guarantee a change in results." },
    { q: "Does male infertility affect sexual performance?", a: "Not necessarily. Many men with fertility problems have normal sexual function. Any sexual or ejaculation concerns can be discussed openly and in confidence during the consultation." },
    { q: "How soon after the assessment will I know what to do next?", a: "Many findings can be discussed at the consultation. If a semen analysis or hormone results are pending, you will be told when to return for a full explanation and plan." },
  ],
  closingHeading: "Male Fertility Assessment with Dr. Kamran Saleem",
  closingParas: [
    "Dr. Kamran Saleem will review your history and any reports you bring, explain which parts of the assessment are appropriate and outline realistic next steps. The investigations and plan depend on your individual circumstances.",
    "You can ask about consultation fees and any separate investigation costs before confirming your appointment.",
  ],
  resources: [
    { href: "/resources/male--infertility-consultation", category: "Fertility Assessment", title: "Male Infertility Consultation" },
    { href: "/resources/male-infertility--treatment", category: "Fertility Assessment", title: "Male Infertility Treatment" },
    { href: "/resources/understanding-a-semen-analysis", category: "Fertility Assessment", title: "Understanding a Semen Analysis" },
  ],
  close: {
    heading: "Ready to Book Your Male Fertility Assessment?",
    body: "Bring any previous semen analysis reports and a list of your medicines, so your assessment can focus on your questions from the first visit.",
    cta: "Book a male fertility assessment",
  },
};
---

<TreatmentPage {...page} />
