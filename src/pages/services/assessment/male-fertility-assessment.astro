---
// src/pages/services/assessment/male-fertility-assessment.astro  (adjust the slug to match your site)
// Uses the site's own menu/footer via Layout. Match the import path + props to TreatmentPage.astro.
import Layout from "../../../layouts/Layout.astro";
const base = "https://www.kamranfertility.com";
const S = "/services/assessment";
const T = "/services/fertility-treatment";
const url = `${base}${S}/male-fertility-assessment`;
const title = "Male Fertility Assessment Lahore | Semen Test | Dr. Kamran";
const description = "Confidential male fertility assessment in Lahore: WHO semen analysis, varicocele exam, hormone & DNA tests with Dr. Kamran Saleem. DHA, Gulberg & Shalamar.";
const wa = "https://wa.me/923148432789?text=" + encodeURIComponent("Hello, I would like to book a confidential male fertility assessment with Dr. Kamran Saleem.");

const icons = {
  flask: '<path d="M9 3h6M10 3v6l-5 9a2 2 0 002 3h10a2 2 0 002-3l-5-9V3"/>',
  inject: '<path d="M4 20l9-9M13 11l-2-2 5-5 4 4-5 5zM3 21l2-1"/>',
  bolt: '<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',
  target: '<circle cx="12" cy="12" r="4"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/>',
  cells: '<circle cx="8" cy="8" r="3"/><circle cx="16" cy="8" r="3"/><circle cx="12" cy="16" r="3"/>',
  merge: '<circle cx="9" cy="12" r="5"/><path d="M14 12h7M18 9l3 3-3 3"/>',
  heart: '<path d="M12 21s-7-4.5-7-10a4 4 0 017-2.6A4 4 0 0119 11c0 5.5-7 10-7 10z"/>',
  check: '<path d="M5 12l5 5 9-10"/>',
  clip: '<rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4h6v3H9zM9 12h6M9 16h6"/>',
  alert: '<path d="M12 3l10 18H2zM12 10v5M12 18h.01"/>',
};

const toc = [["overview","Overview"],["matrix","Diagnostic matrix"],["when-to-book","When to book"],["deep-dive","Clinical deep-dive"],["preparation","Sample preparation"],["treatment-pathways","Conditions & treatment"],["couple","Couple-centered care"],["after","After assessment"],["next-steps","Treatment options"],["faq","FAQ"],["locations","Locations"]];

const overview = [
  { l: "Semen Analysis", h: "#d-1", art: '<circle cx="50" cy="50" r="40" fill="#3b82f6"/><g fill="#fff"><ellipse cx="30" cy="34" rx="6" ry="4"/><ellipse cx="62" cy="48" rx="6" ry="4"/><ellipse cx="34" cy="66" rx="6" ry="4"/></g><g stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round"><path d="M36 34q8-6 14 0t14 0"/><path d="M68 48q8-6 12 0"/><path d="M40 66q8-6 14 0t12 0"/></g>' },
  { l: "Repeat Confirmation", h: "#d-2", art: '<rect x="37" y="14" width="26" height="7" rx="3" fill="#3b82f6" stroke="#0b1f4b" stroke-width="2"/><rect x="39" y="19" width="22" height="64" rx="11" fill="#e0eeff" stroke="#0b1f4b" stroke-width="3"/><rect x="42" y="44" width="16" height="36" rx="8" fill="#4cc9f0"/><circle cx="47" cy="56" r="2.5" fill="#ffffff"/><circle cx="54" cy="66" r="2" fill="#ffffff"/><circle cx="48" cy="74" r="2.5" fill="#ffffff"/>' },
  { l: "Physical Exam", h: "#d-3", art: '<circle cx="50" cy="50" r="38" fill="#fff" stroke="#2563eb" stroke-width="5"/><circle cx="44" cy="52" r="11" fill="#fff" stroke="#0b1f4b" stroke-width="2"/><circle cx="44" cy="52" r="3.5" fill="#0b1f4b"/><path d="M62 38l11-6M64 48l13-2M62 58l11 5" stroke="#0b1f4b" stroke-width="1.8" stroke-linecap="round"/>' },
  { l: "Hormonal Profile", h: "#d-4", art: '<g transform="rotate(-40 52 46)"><rect x="30" y="39" width="38" height="14" rx="3" fill="#fff" stroke="#0b1f4b" stroke-width="2.5"/><rect x="44" y="39" width="14" height="14" fill="#3b82f6" stroke="#0b1f4b" stroke-width="2"/><rect x="68" y="43" width="14" height="6" fill="#fff" stroke="#0b1f4b" stroke-width="2.5"/><rect x="82" y="37" width="4" height="18" rx="2" fill="#0b1f4b"/><path d="M30 46H16" stroke="#0b1f4b" stroke-width="2"/></g><rect x="22" y="76" width="26" height="11" rx="5.5" fill="#fff" stroke="#0b1f4b" stroke-width="2.5"/><path d="M35 76v11" stroke="#0b1f4b" stroke-width="2"/><rect x="54" y="80" width="22" height="10" rx="5" fill="#0b1f4b"/>' },
  { l: "Scrotal Imaging", h: "#d-5", art: '<circle cx="50" cy="50" r="32" fill="#fff" opacity=".75"/><circle cx="50" cy="50" r="18" fill="#60a5fa" stroke="#2563eb" stroke-width="2"/><circle cx="50" cy="50" r="7" fill="#0b1f4b"/>' },
  { l: "Genetic & DNA Tests", h: "#d-6", art: '<circle cx="50" cy="50" r="38" fill="#fff" opacity=".7"/><g fill="#93c5fd" stroke="#2563eb" stroke-width="2"><circle cx="36" cy="38" r="11"/><circle cx="60" cy="34" r="11"/><circle cx="68" cy="56" r="11"/><circle cx="46" cy="66" r="11"/><circle cx="31" cy="58" r="11"/><circle cx="50" cy="50" r="11"/></g><g fill="#0b1f4b"><circle cx="36" cy="38" r="4"/><circle cx="60" cy="34" r="4"/><circle cx="68" cy="56" r="4"/><circle cx="46" cy="66" r="4"/><circle cx="31" cy="58" r="4"/><circle cx="50" cy="50" r="4"/></g>' },
];

const matrix = [
  ["<a href='/services/assessment/semen-analysis'>Baseline Semen Analysis</a>", "Microscopic & Macroscopic Evaluation", "Sample volume (≥1.4 mL), concentration (≥16 M/mL), total count (≥39 M), progressive motility (≥30%), strict morphology (≥4% normal forms).", "WHO 6th Edition (2021) standards. Establishes baseline sperm production and motility."],
  ["Repeat Semen Confirmation", "Confirmatory Analysis (2–3 weeks to 12 weeks apart)", "Evaluates intra-individual parameter fluctuations caused by fever, stress, or recent illness.", "EAU / AUA Guidelines: Mandatory confirmation before establishing a definitive diagnosis."],
  ["Clinical Physical Examination", "Specialist Palpation & Andrological Exam", "Testicular volume assessment, presence of vas deferens, varicoceles (enlarged scrotal veins), epididymal tenderness, hernia.", "Identifies treatable physical barriers (varicocele) or obstructive anatomical defects."],
  ["<a href='/services/assessment/hormonal-analysis'>Endocrine & Hormonal Profile</a>", "Fasting Blood Panel: Serum FSH, LH, Total Testosterone, Prolactin, Estradiol", "Pituitary-testicular axis signaling, Leydig cell testosterone production, Sertoli cell function (FSH).", "Indicated in sperm counts <15 million/mL, azoospermia, or symptoms of hypogonadism."],
  ["Scrotal & Pelvic Imaging", "High-Resolution Scrotal Color Doppler Ultrasound & TRUS", "Testicular parenchyma structure, subclinical varicocele detection, TRUS for suspected ejaculatory duct obstruction.", "Indicated for abnormal physical exams, scrotal pain, impalpable testes, or low-volume azoospermia."],
  ["Genetic & Molecular Screening", "Peripheral Karyotyping, Y-Microdeletion (AZFa/b/c), CFTR Gene Analysis", "Chromosomal abnormalities (e.g., Klinefelter syndrome 47,XXY), Y-chromosome microdeletions, CFTR mutations (CBAVD).", "Recommended in severe oligospermia (<5 million/mL) or non-obstructive/obstructive azoospermia."],
  ["Advanced Sperm Diagnostics", "Sperm DNA Fragmentation Index (DFI), Semen Culture / Infection Panel", "Chromatin integrity, leucocytospermia, bacterial pathogens in seminal fluid.", "Indicated in recurrent miscarriage, unexplained infertility, or failed IVF/ICSI cycles."],
];

const when = [
  ["Trying to Conceive for 12 Months", "You and your partner have been attempting pregnancy for 12 consecutive months without success (or 6 months if your female partner is age 35 or older).", "clip"],
  ["Previous Abnormal Semen Analysis", "An earlier test indicated low sperm count (oligospermia), poor sperm motility (asthenozoospermia), or high abnormal sperm shapes (teratozoospermia).", "alert"],
  ["History of Testicular or Genital Conditions", "You have a medical history of undescended testicles (cryptorchidism), testicular torsion, scrotal trauma, hernia repair, groin surgery, or mumps orchitis during adolescence.", "target"],
  ["Symptoms of Hormonal Dysfunction or Steroid Exposure", "You experience symptoms of androgen deficiency, or have a history of using anabolic steroids, testosterone replacement therapy (TRT), or hair-loss medications (e.g., finasteride).", "bolt"],
  ["Erectile or Ejaculatory Health Concerns", "You experience discomfort during ejaculation, low semen volume, retrograde ejaculation, or erectile health concerns.", "heart"],
  ["Proactive Couple Evaluation", "Your partner is undergoing a fertility evaluation, and you wish to arrange concurrent testing to ensure a coordinated diagnostic approach alongside her <a href='/services/assessment/female-fertility-assessment'>Female Fertility Assessment</a>.", "merge"],
];

const semen = [
  ["Volume", "Normal lower reference limit is 1.4 mL. Low volume (<1.4 mL) may indicate retrograde ejaculation, incomplete collection, hypogonadism, or ejaculatory duct obstruction."],
  ["Sperm Concentration & Total Count", "Normal threshold is ≥16 million sperm per mL, with a total sperm number of ≥39 million per ejaculate."],
  ["Motility", "Total motility (progressive + non-progressive) should reach ≥42%, with progressive motility (sperm swimming forward actively) at ≥30%."],
  ["Morphology", "Measured using Strict Tygerberg Criteria, where ≥4% normal sperm forms is considered normal."],
];

const exam = [
  ["Varicocele Screening", "Enlarged veins within the scrotum (varicoceles) elevate scrotal temperature, impairing sperm concentration, motility, and DNA integrity. Varicoceles are graded from Grade 1 (palpable during Valsalva maneuver) to Grade 3 (visibly evident). Surgical or radiological management of significant varicoceles often improves sperm quality."],
  ["Testicular Volume & Duct Patency", "Measuring testicular size using physical examination or ultrasound helps estimate functioning germ cell mass. Checking for the bilateral presence of the vas deferens rules out congenital absence."],
];

const hormones = [
  ["FSH (Follicle-Stimulating Hormone)", "High FSH levels indicate intrinsic testicular failure (the brain is sending signals, but testicles cannot produce sperm), whereas abnormally low FSH points to a pituitary or hypothalamic issue."],
  ["Luteinizing Hormone (LH) & Testosterone", "Evaluates Leydig cell function and overall androgen status."],
  ["Prolactin & Estradiol", "Checked if elevated prolactin (pituitary microadenoma) or estrogen imbalances are suspected of suppressing testosterone production."],
];

const genetic = [
  ["Karyotyping", "Detects chromosomal variations, such as Klinefelter Syndrome (47,XXY), a leading genetic cause of non-obstructive azoospermia."],
  ["Y-Chromosome Microdeletion Analysis", "Evaluates sub-microscopic deletions in the AZF region (AZFa, AZFb, AZFc) on the Y chromosome, indicated when sperm counts are <5 million/mL or in non-obstructive azoospermia."],
  ["CFTR Mutation Analysis", "Indicated in cases of Congenital Bilateral Absence of the Vas Deferens (CBAVD) to screen for Cystic Fibrosis gene mutations."],
  ["Sperm DNA Fragmentation Index (DFI)", "Evaluates double- and single-stranded DNA breaks in sperm heads, useful for investigating recurrent miscarriages or failed assisted reproduction cycles."],
];

const prep = [
  ["A. Ejaculatory Abstinence Guidelines", ["Mandatory Abstinence Window: Observe 2 to 7 days of ejaculatory abstinence before providing your sample (an abstinence period of 3 to 4 days is clinically optimal).", "Why Timing Matters: Abstaining for less than 2 days can lead to a falsely low semen volume and sperm count. Conversely, abstaining for more than 7 days causes old sperm to accumulate, significantly decreasing sperm motility and increasing DNA damage."]],
  ["B. Sample Collection Protocols", ["On-Site Private Collection: Dedicated, private sample collection rooms are available at our clinical facilities, ensuring complete privacy and comfort.", "Home Collection Guidelines: If a sample is collected at home, it must be produced using the sterile specimen container supplied by the laboratory. Do not use non-approved collection containers, soaps, or commercial lubricants, as they contain spermicidal chemicals that harm sperm parameters. Keep the container close to body temperature (inside a pocket against the body) and deliver it to the clinic laboratory within 45 to 60 minutes."]],
  ["C. What to Bring to Your First Consultation", ["Prior Diagnostic Reports: Physical or digital copies of past semen analysis reports, hormone tests, or scrotal ultrasounds.", "Surgical & Medical History Summary: Documentation of past surgeries (hernia repair, orchidopexy, varicocelectomy) or chronic medical conditions.", "Current Medications List: Complete list of current prescription medicines, blood pressure drugs, body-building supplements, or androgenic steroids.", "Partner's Medical Summary: Copies of any recent reports if your partner is undergoing a parallel Female Fertility Assessment."]],
];

const paths = [
  ["Sperm Parameter Abnormalities (Oligo / Astheno / Teratozoospermia)", `Treatment ranges from medical management and anti-estrogen therapy to specialized lab assistance. Mild to moderate cases may be treated with <a href="${T}/iui">Intrauterine Insemination (IUI)</a>, while severe parameter deficits are managed directly through <a href="${T}/icsi">Intracytoplasmic Sperm Injection (ICSI)</a> combined with <a href="${T}/ivf">In Vitro Fertilization (IVF)</a>.`, "cells"],
  ["Azoospermia (Obstructive vs Non-Obstructive)", `Obstructive Azoospermia (OA): Sperm is produced normally but blocked by physical obstructions. Sperm is retrieved surgically via Percutaneous Epididymal Sperm Aspiration (PESA) or Testicular Sperm Extraction (TESE) for use in <a href="${T}/icsi">ICSI treatment</a>. Non-Obstructive Azoospermia (NOA): Severe impairment of testicular sperm production. Selected patients benefit from Microscopic Testicular Sperm Extraction (Micro-TESE) to isolate focal areas of sperm production for ICSI.`, "target"],
  ["Varicocele & Hormonal Deficits", `Significant varicoceles causing pain, atrophy, or abnormal parameters may be managed surgically or via embolization. Hypogonadotropic hypogonadism responds successfully to targeted hCG / hMG hormonal therapy. See <a href="${T}/male-infertility">male infertility treatment</a>.`, "bolt"],
  ["Evidence-Based Lifestyle Guidance", "While severe genetic or anatomical issues require medical or surgical intervention, functional sperm impairments benefit from evidence-based lifestyle optimization over a 3-month spermatogenic cycle (smoking cessation, scrotal heat avoidance, weight optimization, and supervised antioxidant therapy with CoQ10, L-carnitine, Zinc, and Vitamin E).", "check"],
];

const faqs = [
  ["What is included in a comprehensive male fertility assessment?", "A comprehensive male fertility assessment includes an in-depth review of your medical and reproductive history, physical clinical examination (including varicocele screening), WHO 2021 standard semen analysis, and selective hormone blood testing or scrotal Doppler ultrasound when clinically indicated."],
  ["Why is a repeat semen analysis recommended after an abnormal result?", "Sperm production operates on a 70 to 90-day cycle, and sperm parameters naturally fluctuate due to recent fever, flu, stress, or medications. International guidelines (EAU/ASRM) require a confirmatory second semen analysis 2 to 3 weeks (or up to 12 weeks) after the initial test before establishing a definitive diagnosis."],
  ["How long should I abstain before providing a semen sample?", "You should observe an ejaculatory abstinence period of 2 to 7 days (ideally 3 to 4 days). Abstaining for less than 2 days can reduce sperm volume and count, while abstaining for more than 7 days reduces sperm motility and increases DNA damage."],
  ["Can I collect my semen sample at home?", "Yes, provided you use the sterile specimen container supplied by the clinic laboratory, do not use non-approved collection containers, keep the sample close to body temperature, and deliver it to the clinic lab within 45 to 60 minutes. Private sample collection rooms are also available at all clinic locations."],
  ["What is the difference between a basic semen analysis and an advanced assessment?", "A basic semen analysis measures sperm count, motility, and morphology under a microscope. A full clinical assessment includes physical examination by a specialist, hormonal axis testing, scrotal ultrasound imaging, genetic screening, and sperm DNA fragmentation testing when necessary to determine why parameters are abnormal."],
  ["If sperm count is zero (azoospermia), is biological fatherhood still possible?", "Yes, in many cases. Depending on whether azoospermia is obstructive or non-obstructive, advanced surgical techniques such as PESA, TESE, or Micro-TESE can often retrieve viable sperm directly from the reproductive tract for use in Intracytoplasmic Sperm Injection (ICSI)."],
  ["Should my partner undergo testing at the same time?", "Yes. Approximately 40% to 50% of fertility challenges involve male factors, often coexisting with female factor considerations. Evaluating both partners concurrently through a Female Fertility Assessment provides a complete picture and prevents diagnostic delays."],
];

const treatments = [
  ["Male Infertility Treatment", `${T}/male-infertility`, "Medical and surgical treatment for low count, varicocele and hormonal causes."],
  ["IUI Treatment", `${T}/iui`, "Washed sperm placed in the uterus for mild to moderate parameter problems."],
  ["ICSI Treatment", `${T}/icsi`, "One sperm injected into an egg, including surgically retrieved sperm."],
  ["IVF Treatment", `${T}/ivf`, "The full cycle in which ICSI is performed."],
  ["Female Fertility Assessment", `${S}/female-fertility-assessment`, "The parallel evaluation for your partner."],
  ["Second Opinions", "/services/support", "An independent review of earlier reports or treatment."],
];

const locations = [
  ["DHA Lahore: Rasheed Hospital", "Main Boulevard, DHA Defence, Lahore", "Daily 3:00 PM – 6:00 PM (Closed Saturday & Sunday)", "/locations/dha-lahore"],
  ["Gulberg: TAMC", "M.M. Alam Road, Lahore", "Wednesday 12:00 PM – 3:00 PM (other days by appointment / on-call)", "/locations/mm-alam-road-lahore"],
  ["Shalamar: Shahnaz Hospital", "Shalamar Link Road, Lahore (54000)", "Monday & Thursday 6:00 PM – 9:00 PM (other days closed)", "/locations/shalamar-lahore"],
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "MedicalWebPage", "@id": url, url, name: title, description, inLanguage: "en-PK",
      reviewedBy: { "@type": "Physician", name: "Dr. Kamran Saleem" },
      about: { "@type": "MedicalTest", name: "Male Fertility Assessment", usedToDiagnose: { "@type": "MedicalCondition", name: "Male infertility" } } },
    { "@type": "MedicalClinic", "@id": base + "/#clinic", name: "Kamran Fertility Clinic", url: base, telephone: "+923148432789",
      location: ["Rasheed Hospital (DHA Defence)", "TAMC (M.M. Alam Road, Gulberg)", "Shahnaz Hospital (Shalamar Link Road)"].map(n => ({ "@type": "Place", name: n, address: { "@type": "PostalAddress", addressLocality: "Lahore", addressRegion: "Punjab", addressCountry: "PK" } })) },
    { "@type": "BreadcrumbList", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: base + "/" },
      { "@type": "ListItem", position: 2, name: "Fertility Assessment", item: base + S },
      { "@type": "ListItem", position: 3, name: "Male Fertility Assessment", item: url } ] },
    { "@type": "FAQPage", mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) },
  ],
};
---
<Layout title={title} description={description}>
<div class="ivf">
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<main>
<section class="hero"><div class="w hgrid">
  <div>
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href={S}>Fertility Assessment</a> / Male Fertility Assessment</nav>
    <p class="eye">Confidential · Evidence-based · Lahore</p>
    <h1>Male Fertility Assessment in Lahore</h1>
    <p class="sub">A supportive, non-judgmental and strictly confidential evaluation of your reproductive history, physical health, endocrine balance and sperm parameters, led by Dr. Kamran Saleem. Male factors contribute to roughly 40% to 50% of couples' difficulty conceiving, and most can be understood with the right tests.</p>
    <p><a class="btn" href={wa}>Book a confidential assessment</a> <a class="btn ghost" href="#matrix">See what is tested</a></p>
    <p class="mini">Confidential WhatsApp +92 314 8432789 · Also see the partner's <a href="/services/assessment/female-fertility-assessment">Female Fertility Assessment</a></p>
  </div>
  <div class="hside">
    <ul class="facts">
      <li><b>WHO 2021</b> semen analysis standards</li>
      <li><b>100%</b> confidential, private collection rooms</li>
      <li><b>7</b> diagnostic domains, ordered selectively</li>
      <li><b>3</b> Lahore locations</li>
    </ul>
  </div>
</div></section>

<div class="w layout">
  <aside class="toc" aria-label="On this page"><p>On this page</p>
    {toc.map(([id, l]) => <a href={`#${id}`}>{l}</a>)}
    <a class="btn sm" href={wa}>Book now</a>
  </aside>
  <div class="content">
    <p class="review"><b>Medically authored &amp; reviewed by</b> Dr. Kamran Saleem · Specialist in Reproductive Medicine &amp; Male Infertility Care · Aligned with WHO 6th Edition (2021), EAU and ASRM/AUA guidelines · <a href="/dr-kamran-saleem">About the doctor</a></p>

    <section id="overview">
      <h2>Confidential &amp; Evidence-Based Male Fertility Assessment in Lahore</h2>
      <p>Male reproductive factors contribute to approximately 40% to 50% of all cases where couples face difficulty conceiving. Despite how common male factor infertility is, seeking an assessment can often feel intimidating due to cultural stigma, anxiety, or privacy concerns.</p>
      <p>Under the expert care of Dr. Kamran Saleem (MBBS, FCPS, Specialist in Reproductive Medicine and Fertility Care), a male fertility assessment is conducted in a supportive, non-judgmental, and strictly confidential clinical setting. Rather than relying on a single, isolated lab result, doctor-led evaluation provides a thorough diagnostic understanding of your reproductive history, physical health, endocrine balance, and sperm parameters.</p>
      <p>Whether you are seeking an initial evaluation alongside your partner or following up on a previous abnormal semen report, Dr. Kamran Saleem offers evidence-based diagnostic roadmaps and honest treatment guidance across three modern clinical centers in Lahore. Evaluating both partners concurrently through a parallel <a href="/services/assessment/female-fertility-assessment">Female Fertility Assessment</a> ensures that time is saved and treatment decisions are made with complete clinical clarity.</p>
    </section>

    <section id="matrix">
      <h2>Male Fertility Diagnostic Assessment Matrix</h2>
      <p>A complete male reproductive evaluation goes well beyond basic sperm counting. Following international protocols established by the European Association of Urology (EAU) and the American Urological Association (AUA), diagnostic procedures are ordered selectively based on initial clinical findings:</p>
      <div class="ovwrap">
        <p class="ovtitle">Assessment at a Glance</p>
        <div class="ovrow">
          {overview.map((o, i) => (
            <>
              <a class="ov" href={o.h}>
                <span class="ovl">{o.l}</span>
                <span class="disc"><svg viewBox="0 0 100 100" set:html={o.art} /></span>
                <span class="ovn">{i + 1}</span>
              </a>
              {i < overview.length - 1 ? <span class="chev" aria-hidden="true"><svg viewBox="0 0 36 22"><path d="M3 3l7 8-7 8M14 3l7 8-7 8M25 3l7 8-7 8" /></svg></span> : null}
            </>
          ))}
        </div>
        <p class="ovhint">Select a domain to jump to its row in the matrix below.</p>
      </div>
      <div class="tw"><table>
        <thead><tr><th>Diagnostic Domain</th><th>Core Procedures &amp; Clinical Protocols</th><th>Key Parameters Measured &amp; Indications</th><th>Clinical Guideline &amp; Purpose</th></tr></thead>
        <tbody>{matrix.map((r, i) => <tr id={`d-${i + 1}`}><th scope="row" set:html={r[0]} /><td>{r[1]}</td><td>{r[2]}</td><td>{r[3]}</td></tr>)}</tbody>
      </table></div>
    </section>

    <section id="when-to-book">
      <h2>When to Schedule a Male Fertility Assessment</h2>
      <p>Early clinical evaluation prevents diagnostic delays and provides immediate clarity. Scheduling a confidential consultation with Dr. Kamran Saleem is recommended under any of the following clinical scenarios:</p>
      <div class="cards">
        {when.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p set:html={p} /></div>)}
      </div>
    </section>

    <section id="deep-dive">
      <h2>Clinical Diagnostic Deep-Dive &amp; Medical Standards</h2>
      <h3>1. Semen Analysis &amp; WHO 2021 Reference Limits</h3>
      <p>Semen analysis serves as the fundamental baseline test in male reproductive medicine. To ensure absolute accuracy, testing requested by Dr. Kamran Saleem adheres strictly to the WHO Laboratory Manual for the Examination and Processing of Human Semen (6th Edition, 2021). Read more about <a href="/services/assessment/semen-analysis">semen analysis</a>.</p>
      <div class="cards" style="grid-template-columns:repeat(2,1fr)">
        {semen.map(([h, p]) => <div class="card"><h3>{h}</h3><p>{p}</p></div>)}
      </div>
      <div class="callout"><b>The Clinical Rule of Repeat Testing.</b> Sperm development (spermatogenesis) takes approximately 70 to 90 days. Because sperm parameters naturally fluctuate due to temporary factors such as a high fever, systemic illness, medications, or psychological stress, a single abnormal semen analysis never equals a diagnosis of permanent infertility. International guidelines from the EAU and ASRM mandate a repeat semen analysis after 2 to 3 weeks (or up to 12 weeks for full spermatogenic cycle recovery) to establish a true baseline before confirming a diagnosis or initiating treatment.</div>

      <h3 style="margin-top:30px">2. Physical Examination &amp; Varicocele Grading</h3>
      <p>A semen report reveals cell counts, but a physical examination identifies why parameters may be impaired. Performed in a private exam room, Dr. Kamran Saleem evaluates:</p>
      <div class="cols">
        {exam.map(([h, p]) => <div class="card"><h3>{h}</h3><p>{p}</p></div>)}
      </div>

      <h3 style="margin-top:30px">3. Endocrine Axis Evaluation (Hormonal Testing)</h3>
      <p>Hormonal testing is not required for every patient. According to AUA and EAU guidelines, a blood hormone panel is specifically indicated when sperm concentration is below 15 million/mL, when azoospermia is present, or when clinical signs of hypogonadism occur. See also <a href="/services/assessment/hormonal-analysis">hormonal analysis</a>.</p>
      <div class="cards">
        {hormones.map(([h, p]) => <div class="card"><h3>{h}</h3><p>{p}</p></div>)}
      </div>

      <h3 style="margin-top:30px">4. Genetic &amp; Advanced Diagnostic Panels</h3>
      <p>When severe male factor issues are identified, advanced genetic screening isolates hereditary causes to guide treatment safety:</p>
      <div class="cards" style="grid-template-columns:repeat(2,1fr)">
        {genetic.map(([h, p]) => <div class="card"><h3>{h}</h3><p>{p}</p></div>)}
      </div>
    </section>

    <section id="preparation">
      <h2>Patient Preparation &amp; Semen Collection Protocol</h2>
      <p>Following correct sample preparation instructions is critical to preventing artificial lab errors and avoiding repeat testing.</p>
      <div class="cards">
        {prep.map(([h, l]) => <div class="card"><h3>{h}</h3><ul class="tick">{l.map(x => <li>{x}</li>)}</ul></div>)}
      </div>
    </section>

    <section id="treatment-pathways">
      <h2>Medical Conditions Identified &amp; Targeted Treatment Pathways</h2>
      <p>Following a thorough evaluation, Dr. Kamran Saleem provides a clear clinical diagnosis and formulates an individualized treatment roadmap:</p>
      <div class="cols">
        {paths.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p set:html={p} /></div>)}
      </div>
    </section>

    <section id="couple">
      <h2>Couple-Centered Parallel Diagnostic Care</h2>
      <p>Infertility is a shared medical diagnosis. Attempting to evaluate one partner in isolation often leads to unnecessary delays, emotional stress, and misdirected treatment plans.</p>
      <p>Dr. Kamran Saleem emphasizes a couple-centered diagnostic model. While your male fertility evaluation is conducted, your partner’s ovulation, hormonal health, and tubal status are assessed in parallel through a structured <a href="/services/assessment/female-fertility-assessment">Female Fertility Assessment</a>.</p>
      <p>Evaluating both partners together allows the clinical team to determine the most effective and efficient treatment path immediately, whether that involves conservative ovulation monitoring, <a href={`${T}/iui`}>IUI treatment</a>, or advanced reproductive technology such as <a href={`${T}/ivf`}>IVF</a> and <a href={`${T}/icsi`}>ICSI</a>.</p>
    </section>

    <section id="after">
      <h2>Post-Assessment Guidance &amp; Transparent Care</h2>
      <div class="cols">
        <div class="card"><h3>1. Plain-Language Results Consultation</h3><p>Following your diagnostic testing, Dr. Kamran Saleem conducts a detailed follow-up review. You receive a clear, plain-language explanation of all laboratory metrics and ultrasound findings, ensuring you fully understand your reproductive health status.</p></div>
        <div class="card"><h3>2. Ethical Practice &amp; Financial Transparency</h3><p>Our clinic strictly adheres to transparent, ethical medical guidelines. You will receive:</p><ul class="tick"><li>Honest advice on whether specialized treatment is necessary or if natural conception remains feasible.</li><li>Clear cost outlines for diagnostic procedures, lab panels, and follow-up consultations before any investigation is conducted.</li><li>No unnecessary diagnostic tests or unproven therapies.</li></ul></div>
      </div>
    </section>

    <section id="next-steps">
      <h2>After Your Assessment: Your Treatment Options</h2>
      <p>Your results decide the next step. Depending on your findings, your plan may lead to one of these services.</p>
      <div class="cards">
        {treatments.map(([n, h, d]) => <a class="card link" href={h}><h3>{n}</h3><p>{d}</p></a>)}
      </div>
    </section>

    <section id="faq">
      <h2>Frequently Asked Questions</h2>
      {faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
    </section>
  </div>
</div>

<section class="cta" id="locations"><div class="w">
  <h2>Book Your Confidential Assessment</h2>
  <p>Dr. Kamran Saleem conducts confidential male fertility assessments by appointment across three established hospital centers in Lahore. To schedule your private evaluation or inquire about consultation details, contact our clinical coordinator by phone or WhatsApp on +92 314 8432789 (Mon–Sat 11:00 AM – 9:00 PM; Sun and public holidays closed).</p>
  <a class="btn" href={wa}>Send a confidential WhatsApp message</a>
  <div class="cards c3 locs">
    {locations.map(([n, a, h, l]) => <a class="card link" href={l}><h3>{n}</h3><p>{a}</p><p class="hrs">{h}</p></a>)}
  </div>
  <p style="margin-top:22px"><a style="color:#fff" href={S}>All assessment services</a> · <a style="color:#fff" href={T}>Fertility treatment</a> · <a style="color:#fff" href="/services/support">Second opinions</a></p>
</div></section>
</main>
</div>
</Layout>

<style is:global>
