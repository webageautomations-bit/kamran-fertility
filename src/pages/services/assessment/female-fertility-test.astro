---
import TreatmentPage from "../../../components/TreatmentPage.astro";

const T = "/services/fertility-treatment";
const A = "/services/assessment";

const page = {
  slug: "female-fertility-test",
  name: "Female Fertility Assessment",
  title: "Female Fertility Test & Assessment | Kamran Fertility Clinic",
  description: "Discuss a female fertility test with Dr. Kamran Saleem. Review your history, ovulation, ovarian reserve, scans and tube checks, and plan next steps.",
  eyebrow: "Female Fertility Assessment",
  h1: "Female Fertility Assessment and Clinical Evaluation",
  waText: "Hello, I would like to book a female fertility assessment with Dr. Kamran Saleem.",
  ctaLabel: "Book an assessment",
  heroSub: [
    "A female fertility assessment reviews reproductive history and possible factors affecting conception, including ovulation, hormones, the uterus and the fallopian tubes.",
    "The consultation helps determine which investigations, if any, are appropriate for your situation.",
  ].join(" "),
  leadIn: [
    { rich: ["This assessment is part of a wider fertility evaluation. The tests selected depend on your history, symptoms and previous results. Explore the related ", ["Fertility Assessment & Diagnosis", A], " pathway, or read the educational guide ", ["Fertility Assessment in Lahore", "/resources/fertility-assessment-in-lahore"], "."] },
  ],
  sections: [
    {
      id: "purpose-of-female-assessment",
      title: "What a Female Fertility Assessment Covers",
      intro: "The assessment helps identify which parts of reproductive health may need closer evaluation.",
      icon: "clipboard",
      body: [
        "A consultation may include a review of your menstrual pattern, pregnancy history, medical conditions, medicines and how long you have been trying to conceive.",
        { ul: [
          "Your cycle pattern and possible ovulation concerns",
          "Relevant medical or surgical history",
          "Previous pregnancy history and fertility investigations",
          "Lifestyle factors that may be worth discussing, such as weight, smoking and supplements",
          "Whether additional tests or a follow-up visit may help",
        ] },
      ],
    },
    {
      id: "when-assessment-may-help",
      title: "When to Discuss an Assessment",
      intro: "Consider an appointment when you have questions about fertility or a known concern.",
      icon: "calendar",
      body: [
        { ul: [
          "Trying to conceive for 12 months without success, or 6 months if you are 35 or older",
          "Periods that are irregular, very infrequent or absent",
          "A history of pelvic infection, surgery, endometriosis or a condition that may affect fertility",
          "Repeated pregnancy loss",
          "A known reproductive condition or a previous abnormal test",
          "Planning ahead because of age or a medical treatment that may affect fertility",
        ] },
        "If you are over 35 or already have a known concern, it is reasonable to seek advice earlier rather than waiting a full year.",
      ],
    },
    {
      id: "tests-selected-individually",
      title: "Which Tests May Be Considered",
      intro: "There is no single test that explains every fertility concern.",
      icon: "flask",
      body: [
        { ul: [
          "Pelvic or transvaginal ultrasound to look at the uterus, ovaries and antral follicle count",
          "Ovulation assessment through cycle tracking, progesterone testing or follicle monitoring",
          "Hormone blood tests such as AMH, FSH, LH, TSH or prolactin when relevant",
          "Checking whether the fallopian tubes are open, using a test chosen by the clinician",
          "Screening for other relevant conditions based on your history",
        ] },
        "Not everyone needs every test. The aim is to choose investigations that answer a specific question and avoid unnecessary procedures.",
        { rich: ["For related testing, see ", ["hormonal analysis", `${A}/hormonal-analysis`], " and ", ["ovulation test", `${A}/ovulation-test`], ", or read the educational guide ", ["Fertility Assessment in Lahore", "/resources/fertility-assessment-in-lahore"], "."] },
      ],
    },
    {
      id: "common-female-factors",
      title: "Factors That May Affect Female Fertility",
      intro: "Several overlapping factors can play a part, and sometimes no single cause is found.",
      icon: "compare",
      body: [
        { ul: [
          "Ovulation problems, including those related to PCOS or thyroid disorders",
          "Reduced ovarian reserve, which becomes more common with increasing age",
          "Blocked or damaged fallopian tubes, for example after infection or surgery",
          "Uterine conditions such as fibroids or polyps",
          "Endometriosis",
        ] },
        { rich: ["You can read more in ", ["Female Infertility: Treatment and Next Steps", "/resources/female-infertility-treatment"], " and ", ["PCOS and Fertility", "/resources/pcos-and-fertility"], "."] },
      ],
    },
    {
      id: "both-partners",
      title: "Assessing Both Partners",
      intro: "Fertility is a shared question, and male factors contribute in a significant share of couples.",
      icon: "compare",
      body: [
        "A semen analysis is a simple, early test that is often arranged alongside the female assessment, so that important information is not missed.",
        { rich: ["See ", ["male fertility testing", `${A}/male-fertility-test`], ", ", ["semen analysis", `${A}/semen-analysis`], " and ", ["male infertility assessment", `${A}/male-infertility`], " for the partner’s pathway."] },
      ],
    },
    {
      id: "after-female-assessment",
      title: "What Happens After the Assessment",
      intro: "The next step depends on what the consultation and any tests show.",
      icon: "route",
      body: [
        { ul: [
          "Review the findings with the clinician",
          "Discuss whether further testing is needed",
          "Consider suitable options or referral, if indicated",
          "Ask for a clear explanation of expected fees and follow-up",
        ] },
        { rich: ["If treatment is likely to be useful, you can explore our ", ["fertility treatment", T], " services and discuss which option may fit your circumstances."] },
      ],
    },
  ],
  faqs: [
    { q: "Do all women need the same fertility tests?", a: "No. Tests are selected according to your history, symptoms, age and previous findings." },
    { q: "Can I bring reports from another clinic?", a: "Yes. Bring available reports, scans and a list of medicines so they can be reviewed during the consultation." },
    { q: "Does a normal assessment guarantee pregnancy?", a: "No fertility assessment can guarantee pregnancy. It can help clarify findings and guide decisions." },
    { q: "When should I see a fertility specialist?", a: "Generally after 12 months of trying if you are under 35, or after 6 months if you are 35 or older. See someone sooner if you have irregular periods, known reproductive conditions or repeated pregnancy loss." },
    { q: "Is a fertility test painful?", a: "Most assessments involve a conversation, blood tests and an ultrasound, which are usually well tolerated. Tests to check the tubes may cause cramping, and the clinician can explain what to expect beforehand." },
    { q: "Should my partner be tested too?", a: "Usually yes. Fertility evaluation often considers both partners, and a semen analysis is a straightforward early step." },
  ],
  closingHeading: "Female Fertility Assessment with Dr. Kamran Saleem",
  closingParas: [
    "Dr. Kamran Saleem can review your history and available reports, discuss whether this assessment is appropriate, and explain possible next steps. The exact tests and plan depend on your individual circumstances.",
    "You can ask about the consultation and any separate test fees before confirming an appointment.",
  ],
  resources: [
    { href: "/resources/fertility-assessment-in-lahore", category: "Fertility Assessment", title: "Fertility Assessment in Lahore" },
    { href: "/resources/female-infertility-treatment", category: "Fertility Assessment", title: "Female Infertility: Treatment and Next Steps" },
    { href: "/resources/pcos-and-fertility", category: "Fertility Assessment", title: "PCOS and Fertility" },
  ],
  close: {
    heading: "Need Help Choosing the Right Assessment?",
    body: "Share your symptoms, cycle history or previous reports when booking so the consultation can focus on your questions.",
    cta: "Book an assessment",
  },
};
---

<TreatmentPage {...page} />
