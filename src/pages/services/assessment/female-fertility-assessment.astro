---
// src/pages/services/assessment/female-fertility-assessment.astro  (adjust the slug to match your site)
// Uses the site's own menu/footer via Layout. Match the import path + props to TreatmentPage.astro.
import Layout from "../../../layouts/Layout.astro";
const base = "https://www.kamranfertility.com";
const S = "/services/assessment";
const T = "/services/fertility-treatment";
const url = `${base}${S}/female-fertility-assessment`;
const title = "Female Fertility Assessment in Lahore | Dr. Kamran Saleem";
const description = "Doctor-led female fertility assessment in Lahore: ovulation, AMH, ultrasound and hormone tests with Dr. Kamran Saleem. Clinics in DHA, Gulberg & Shalamar.";
const wa = "https://wa.me/923148432789?text=" + encodeURIComponent("Hello, I would like to book a female fertility assessment with Dr. Kamran Saleem.");

const icons = {
  flask: '<path d="M9 3h6M10 3v6l-5 9a2 2 0 002 3h10a2 2 0 002-3l-5-9V3"/>',
  inject: '<path d="M4 20l9-9M13 11l-2-2 5-5 4 4-5 5zM3 21l2-1"/>',
  bolt: '<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',
  target: '<circle cx="12" cy="12" r="4"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/>',
  cells: '<circle cx="8" cy="8" r="3"/><circle cx="16" cy="8" r="3"/><circle cx="12" cy="16" r="3"/>',
  merge: '<circle cx="9" cy="12" r="5"/><path d="M14 12h7M18 9l3 3-3 3"/>',
  heart: '<path d="M12 21s-7-4.5-7-10a4 4 0 017-2.6A4 4 0 0119 11c0 5.5-7 10-7 10z"/>',
  check: '<path d="M5 12l5 5 9-10"/>',
  clip: '<rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4h6v3H9zM9 12h6M9 16h6"/>',
  alert: '<path d="M12 3l10 18H2zM12 10v5M12 18h.01"/>',
};

const toc = [["evaluation","Evaluation"],["pathway","Diagnostic pathway"],["when-to-book","When to book"],["components","Key components"],["conditions","Conditions found"],["couple","Partner screening"],["what-to-bring","What to bring"],["what-to-expect","What to expect"],["next-steps","Next steps"],["faq","FAQ"],["locations","Locations"]];

const overview = [
  { l: "Ovulation", h: "#d-1", art: '<circle cx="50" cy="50" r="32" fill="#fff" opacity=".75"/><circle cx="50" cy="50" r="18" fill="#60a5fa" stroke="#2563eb" stroke-width="2"/><circle cx="50" cy="50" r="7" fill="#0b1f4b"/>' },
  { l: "Ovarian Reserve", h: "#d-2", art: '<circle cx="50" cy="50" r="38" fill="#fff" opacity=".7"/><g fill="#93c5fd" stroke="#2563eb" stroke-width="2"><circle cx="36" cy="38" r="11"/><circle cx="60" cy="34" r="11"/><circle cx="68" cy="56" r="11"/><circle cx="46" cy="66" r="11"/><circle cx="31" cy="58" r="11"/><circle cx="50" cy="50" r="11"/></g><g fill="#0b1f4b"><circle cx="36" cy="38" r="4"/><circle cx="60" cy="34" r="4"/><circle cx="68" cy="56" r="4"/><circle cx="46" cy="66" r="4"/><circle cx="31" cy="58" r="4"/><circle cx="50" cy="50" r="4"/></g>' },
  { l: "Hormonal Analysis", h: "#d-3", art: '<rect x="37" y="14" width="26" height="7" rx="3" fill="#3b82f6" stroke="#0b1f4b" stroke-width="2"/><rect x="39" y="19" width="22" height="64" rx="11" fill="#e0eeff" stroke="#0b1f4b" stroke-width="3"/><rect x="42" y="44" width="16" height="36" rx="8" fill="#4cc9f0"/><circle cx="47" cy="56" r="2.5" fill="#ffffff"/><circle cx="54" cy="66" r="2" fill="#ffffff"/><circle cx="48" cy="74" r="2.5" fill="#ffffff"/>' },
  { l: "Uterine Cavity", h: "#d-4", art: '<circle cx="50" cy="50" r="38" fill="#fff" stroke="#2563eb" stroke-width="5"/><circle cx="44" cy="52" r="11" fill="#fff" stroke="#0b1f4b" stroke-width="2"/><circle cx="44" cy="52" r="3.5" fill="#0b1f4b"/><path d="M62 38l11-6M64 48l13-2M62 58l11 5" stroke="#0b1f4b" stroke-width="1.8" stroke-linecap="round"/>' },
  { l: "Fallopian Tubes", h: "#d-5", art: '<g transform="rotate(-40 52 46)"><rect x="30" y="39" width="38" height="14" rx="3" fill="#fff" stroke="#0b1f4b" stroke-width="2.5"/><rect x="44" y="39" width="14" height="14" fill="#3b82f6" stroke="#0b1f4b" stroke-width="2"/><rect x="68" y="43" width="14" height="6" fill="#fff" stroke="#0b1f4b" stroke-width="2.5"/><rect x="82" y="37" width="4" height="18" rx="2" fill="#0b1f4b"/><path d="M30 46H16" stroke="#0b1f4b" stroke-width="2"/></g><rect x="22" y="76" width="26" height="11" rx="5.5" fill="#fff" stroke="#0b1f4b" stroke-width="2.5"/><path d="M35 76v11" stroke="#0b1f4b" stroke-width="2"/><rect x="54" y="80" width="22" height="10" rx="5" fill="#0b1f4b"/>' },
  { l: "Partner Assessment", h: "#d-6", art: '<circle cx="50" cy="50" r="40" fill="#3b82f6"/><g fill="#fff"><ellipse cx="30" cy="34" rx="6" ry="4"/><ellipse cx="62" cy="48" rx="6" ry="4"/><ellipse cx="34" cy="66" rx="6" ry="4"/></g><g stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round"><path d="M36 34q8-6 14 0t14 0"/><path d="M68 48q8-6 12 0"/><path d="M40 66q8-6 14 0t12 0"/></g>' },
];

const domains = [
  ["Ovulation Assessment", "Menstrual history tracking, ultrasound follicle monitoring, serum progesterone testing (second half of cycle)", "Confirms whether mature eggs are released regularly; detects ovulation disorders such as PCOS or thyroid dysfunction."],
  ["Ovarian Reserve Evaluation", "Anti-Müllerian Hormone (AMH) blood test & Transvaginal Antral Follicle Count (AFC)", "Measures remaining egg quantity to guide treatment pace and protocol selection (does not measure egg quality independently)."],
  ["<a href='/services/assessment/hormonal-analysis'>Hormonal Analysis</a>", "Blood panel testing: Baseline FSH, LH, TSH (Thyroid), and Prolactin", "Identifies endocrine imbalances or pituitary/thyroid irregularities that disrupt menstrual cycles and egg maturation."],
  ["Uterine Cavity Inspection", "Pelvic or Transvaginal Ultrasound (TVS)", "Evaluates uterine structure and checks for anatomical barriers such as fibroids, endometrial polyps, or ovarian cysts."],
  ["Fallopian Tube Patency", "Specialized tubal imaging / patency evaluation (indicated selectively based on history)", "Determines if fallopian tubes are open and functional, particularly in women with pelvic surgery, infection, or endometriosis history."],
  ["Partner Assessment", "Diagnostic <a href='/services/assessment/semen-analysis'>Semen Analysis</a> (arranged concurrently)", "Evaluates male fertility parameters (count, motility, morphology) to ensure a complete couple-centered evaluation."],
];

const when = [
  ["Trying to Conceive for 12 Months", "You are under 35 years of age and have been trying to conceive through regular, unprotected intercourse for 12 consecutive months without success.", "clip"],
  ["Trying to Conceive for 6 Months (Age 35+)", "You are 35 years of age or older and have been trying to conceive for 6 months. Because ovarian reserve naturally declines with age, earlier assessment provides more treatment flexibility.", "target"],
  ["Irregular or Absent Menstrual Cycles", `Your periods are unpredictable, unusually infrequent, or completely absent, indicating potential ovulatory failure or PCOS. See <a href="${T}/ovulation-induction">ovulation induction & PCOS</a>.`, "egg"],
  ["History of Reproductive Conditions", "You have a documented history of pelvic inflammatory disease (PID), pelvic surgery, severe menstrual cramps, endometriosis, or uterine fibroids.", "alert"],
  ["Recurrent Pregnancy Loss", "You have experienced two or more consecutive miscarriages or pregnancy losses.", "heart"],
  ["Known Endocrine Disorders", "You have a diagnosed thyroid condition, hyperprolactinemia, or other hormonal imbalances affecting reproductive health.", "bolt"],
  ["Proactive Fertility Planning", `You wish to assess your reproductive status ahead of time due to age or prior medical treatments that could impact future fertility. See <a href="${T}/fertility-preservation">egg freezing</a>.`, "check"],
];

const conditions = [
  ["Ovulation Disorders", "Including Polycystic Ovary Syndrome (PCOS), hypothalamic anovulation, and thyroid-related cycle disruption.", "egg"],
  ["Reduced Ovarian Reserve", "Age-related or premature decline in available egg quantity.", "cells"],
  ["Tubal Damage or Blockage", "Fallopian tube occlusion resulting from pelvic infections, past surgeries, or pelvic adhesions.", "merge"],
  ["Uterine Pathology", "Submucosal fibroids, endometrial polyps, uterine septum, or intrauterine adhesions that impair embryo implantation.", "flask"],
  ["Endometriosis", "Inflammation and pelvic tissue scarring affecting ovarian function, tubal mobility, or egg quality.", "alert"],
  ["Unexplained Infertility", "Cases where standard diagnostic parameters (ovulation, uterine cavity, tubal patency, and semen analysis) return normal results, allowing for targeted empirical management.", "target"],
];

const bring = [
  ["A. Prior Diagnostic & Medical Records", ["Hormone & Blood Test Reports: Recent AMH, FSH, LH, Thyroid (TSH), and Prolactin results (preferably within the last 3 to 6 months)", "Pelvic Imaging & Scans: Previous pelvic or transvaginal ultrasounds, Hysterosalpingography (HSG) X-rays, or HyCoSy tubal patency reports", "Surgical & Treatment Summaries: Operative notes or discharge summaries for pelvic surgery, laparoscopy, hysteroscopy, ovarian cyst removal, or past fertility cycles (Ovulation Induction, IUI, or IVF)"]],
  ["B. Menstrual Cycle History & Symptom Log", ["Menstrual Calendar: Details of your last 3 to 6 cycles, including cycle length, predictability, and dates of your most recent periods", "Symptom Profile: Period duration, flow intensity, menstrual pain (dysmenorrhea), severe cramping, irregular spotting, or symptoms associated with PCOS or thyroid conditions"]],
  ["C. Current Medications & Partner Information", ["Medication & Supplement List: All prescribed medications, over-the-counter drugs, fertility vitamins, and herbal supplements", "Partner's Medical Records: Any prior semen analysis reports or male urological evaluation summaries"]],
];

const faqs = [
  ["What is included in a female fertility assessment?", "A female fertility assessment includes a comprehensive review of your medical and cycle history, pelvic/transvaginal ultrasound evaluation, ovarian reserve testing (AMH and AFC), baseline hormonal blood tests (such as FSH, LH, TSH, and Prolactin), and selective fallopian tube testing if clinically indicated."],
  ["Do all women undergo the exact same tests?", "No. Diagnostic testing is tailored to your individual age, symptoms, menstrual pattern, and previous medical history. Unnecessary tests are avoided to ensure efficient and focused care."],
  ["How long does the assessment take to complete?", "The initial clinical consultation and transvaginal ultrasound can typically be completed during a single visit. Hormonal blood tests or secondary investigations may require a short follow-up visit once laboratory findings are available."],
  ["Can I bring medical reports from another clinic or laboratory?", "Yes. Patients are encouraged to bring previous diagnostic reports, blood test results, ultrasound scans, and lists of current medications. Dr. Kamran Saleem will review your existing records to prevent unnecessary repeat testing."],
  ["Is the fertility assessment procedure painful?", "The majority of the evaluation consists of a verbal consultation, standard blood sampling, and a transvaginal ultrasound, all of which are routine and well tolerated. If fallopian tube patency testing is required, mild uterine cramping may occur, and the procedure will be explained in detail beforehand."],
  ["Should my partner be tested at the same time?", "Yes. Evaluating male fertility through a diagnostic semen analysis alongside the female assessment ensures a complete picture for both partners and prevents unnecessary delays in finding an effective solution."],
  ["Does a normal fertility assessment guarantee pregnancy?", "No clinical evaluation can guarantee pregnancy. A normal assessment confirms that key measurable parameters (such as ovulation, uterine cavity, and basic hormones) appear healthy, helping rule out major barriers and guiding appropriate next steps."],
];

const treatments = [
  ["Ovulation Induction & PCOS", `${T}/ovulation-induction`, "Medication and monitoring to restore regular ovulation."],
  ["IUI Treatment", `${T}/iui`, "Washed sperm placed in the uterus around ovulation."],
  ["IVF Treatment", `${T}/ivf`, "Fertilization in the laboratory and embryo transfer."],
  ["ICSI", `${T}/icsi`, "One sperm injected into an egg for male factor infertility."],
  ["Semen Analysis", `${S}/semen-analysis`, "Count, motility and morphology for the male partner."],
  ["Second Opinions", "/services/support", "An independent review of earlier tests or treatment."],
];

const locations = [
  ["DHA Lahore: Rasheed Hospital", "Main Boulevard, DHA Defence, Lahore", "Daily 3:00 PM – 6:00 PM (Closed Saturday & Sunday)", "/locations/dha-lahore"],
  ["Gulberg: TAMC", "M.M. Alam Road, Lahore", "Wednesday 12:00 PM – 3:00 PM (other days by appointment / on-call)", "/locations/mm-alam-road-lahore"],
  ["Shalamar: Shahnaz Hospital", "Shalamar Link Road, Lahore (54000)", "Monday & Thursday 6:00 PM – 9:00 PM (other days closed)", "/locations/shalamar-lahore"],
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "MedicalWebPage", "@id": url, url, name: title, description, inLanguage: "en-PK",
      reviewedBy: { "@type": "Physician", name: "Dr. Kamran Saleem" },
      about: { "@type": "MedicalTest", name: "Female Fertility Assessment", usedToDiagnose: { "@type": "MedicalCondition", name: "Female infertility" } } },
    { "@type": "MedicalClinic", "@id": base + "/#clinic", name: "Kamran Fertility Clinic", url: base, telephone: "+923148432789",
      location: ["Rasheed Hospital (DHA Defence)", "TAMC (M.M. Alam Road, Gulberg)", "Shahnaz Hospital (Shalamar Link Road)"].map(n => ({ "@type": "Place", name: n, address: { "@type": "PostalAddress", addressLocality: "Lahore", addressRegion: "Punjab", addressCountry: "PK" } })) },
    { "@type": "BreadcrumbList", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: base + "/" },
      { "@type": "ListItem", position: 2, name: "Fertility Assessment", item: base + S },
      { "@type": "ListItem", position: 3, name: "Female Fertility Assessment", item: url } ] },
    { "@type": "FAQPage", mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) },
  ],
};
---
<Layout title={title} description={description}>
<div class="ivf">
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<main>
<section class="hero"><div class="w hgrid">
  <div>
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href={S}>Fertility Assessment</a> / Female Fertility Assessment</nav>
    <p class="eye">Doctor-led · Evidence-based · Lahore</p>
    <h1>Female Fertility Assessment in Lahore</h1>
    <p class="sub">A structured, evidence-based evaluation of the factors influencing your ability to conceive, centered on your medical history, cycle patterns and personal timeline. Dr. Kamran Saleem provides honest answers, clear diagnostic options and personalized next steps.</p>
    <p><a class="btn" href={wa}>Book an assessment</a> <a class="btn ghost" href="#pathway">See what is tested</a></p>
    <p class="mini">Medically authored and reviewed by Dr. Kamran Saleem · Phone / WhatsApp +92 314 8432789</p>
  </div>
  <div class="hside">
    <ul class="facts">
      <li><b>6</b> diagnostic domains, tailored to you</li>
      <li><b>1 visit</b> for consultation and ultrasound</li>
      <li><b>No</b> unnecessary tests</li>
      <li><b>3</b> Lahore locations</li>
    </ul>
  </div>
</div></section>

<div class="w layout">
  <aside class="toc" aria-label="On this page"><p>On this page</p>
    {toc.map(([id, l]) => <a href={`#${id}`}>{l}</a>)}
    <a class="btn sm" href={wa}>Book now</a>
  </aside>
  <div class="content">
    <p class="review"><b>Medically authored &amp; reviewed by</b> Dr. Kamran Saleem (MBBS 1988; Diploma, University of Liverpool 1998; PMDC registered) · Specialist Fertility Care in Lahore · <a href="/dr-kamran-saleem">About the doctor</a></p>

    <section id="evaluation">
      <h2>Comprehensive Female Fertility Evaluation in Lahore</h2>
      <p>A female fertility assessment is a structured, evidence-based clinical evaluation designed to identify the biological and physiological factors influencing your ability to conceive. Rather than taking a generic approach, doctor-led care under Dr. Kamran Saleem centers on your individual medical history, cycle patterns, and personal timeline.</p>
      <p>Conception requires seamless coordination between multiple reproductive systems: regular ovulation, adequate egg quantity (ovarian reserve), balanced hormonal signaling, a healthy uterine environment, and clear, open fallopian tubes. When any of these components experience disruption, conceiving naturally can become difficult.</p>
      <p>Dr. Kamran Saleem provides honest answers, clear diagnostic options, and personalized next steps tailored to your specific circumstances across three accessible clinical centers in Lahore.</p>
    </section>

    <section id="pathway">
      <h2>Overview of the Female Fertility Diagnostic Pathway</h2>
      <p>Every fertility evaluation is customized based on your age, symptoms, menstrual history, and any previous medical investigations. Below is a structured summary of the core diagnostic domains.</p>
      <div class="ovwrap">
        <p class="ovtitle">Assessment at a Glance</p>
        <div class="ovrow">
          {overview.map((o, i) => (
            <>
              <a class="ov" href={o.h}>
                <span class="ovl">{o.l}</span>
                <span class="disc"><svg viewBox="0 0 100 100" set:html={o.art} /></span>
                <span class="ovn">{i + 1}</span>
              </a>
              {i < overview.length - 1 ? <span class="chev" aria-hidden="true"><svg viewBox="0 0 36 22"><path d="M3 3l7 8-7 8M14 3l7 8-7 8M25 3l7 8-7 8" /></svg></span> : null}
            </>
          ))}
        </div>
        <p class="ovhint">Select a domain to jump to its row in the table below.</p>
      </div>
      <div class="tw"><table>
        <thead><tr><th>Diagnostic Domain</th><th>Core Investigations &amp; Tools</th><th>Clinical Purpose &amp; What It Measures</th></tr></thead>
        <tbody>{domains.map((r, i) => <tr id={`d-${i + 1}`}><th scope="row" set:html={r[0]} /><td set:html={r[1]} /><td>{r[2]}</td></tr>)}</tbody>
      </table></div>
    </section>

    <section id="when-to-book">
      <h2>When to Schedule a Female Fertility Assessment</h2>
      <p>Seeking an early clinical evaluation can save valuable time and prevent unnecessary stress. Diagnostic guidelines recommend scheduling a consultation under the following circumstances:</p>
      <div class="cards">
        {when.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p set:html={p} /></div>)}
      </div>
    </section>

    <section id="components">
      <h2>Key Components of the Clinical Assessment</h2>
      <h3>Ovulation and Ovarian Reserve Evaluation</h3>
      <p>Determining whether egg maturation occurs regularly and assessing remaining egg supply represent two foundational pillars of female fertility testing.</p>
      <div class="cols">
        <div class="card"><h3>Tracking Ovulation</h3><p>Regularity of your menstrual cycle provides vital clues. Supplemental tracking through cycle history, ultrasound follicle monitoring, and second-half cycle progesterone measurements helps diagnose ovulation failure linked to Polycystic Ovary Syndrome (PCOS) or thyroid imbalances.</p></div>
        <div class="card"><h3>Assessing Ovarian Reserve (AMH &amp; AFC)</h3><p>Ovarian reserve describes the quantity of resting follicles remaining in the ovaries. It is evaluated by combining a blood test for Anti-Müllerian Hormone (AMH) with a transvaginal ultrasound to measure the Antral Follicle Count (AFC).</p></div>
      </div>
      <div class="callout">Ovarian reserve testing helps guide the choice and intensity of fertility treatments (such as Ovulation Induction, IUI, or IVF). It is important to note that AMH levels assess egg quantity, not egg quality, and cannot predict pregnancy on their own.</div>
      <h3 style="margin-top:28px">Uterine Cavity &amp; Fallopian Tube Evaluation</h3>
      <p>For successful conception and implantation, the uterine cavity must be healthy and at least one fallopian tube must be open to allow sperm to meet the egg.</p>
      <div class="cols">
        <div class="card"><h3>Pelvic Ultrasound Assessment</h3><p>High-resolution transvaginal ultrasound imaging allows Dr. Kamran Saleem to inspect the uterine lining, detect endometrial polyps, evaluate uterine fibroids, and check for ovarian cysts or structural variations.</p></div>
        <div class="card"><h3>Selective Fallopian Tube Testing</h3><p>Tubal evaluation is not automatically required for every patient. It is recommended when your medical history indicates risk factors such as prior pelvic infection, abdominal or pelvic surgery, or suspected endometriosis. If tubal testing is indicated, the specific imaging method will be explained thoroughly before proceeding.</p></div>
      </div>
    </section>

    <section id="conditions">
      <h2>Medical Conditions Identified Through Assessment</h2>
      <p>A thorough diagnostic workup helps isolate specific factors contributing to fertility challenges, which may include:</p>
      <div class="cards">
        {conditions.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p>{p}</p></div>)}
      </div>
    </section>

    <section id="couple">
      <h2>Couple-Centered Evaluation &amp; Partner Screening</h2>
      <p>Fertility is a shared journey. Male reproductive factors contribute to difficulty conceiving in a significant proportion of couples.</p>
      <p>To prevent diagnostic delays and avoid incomplete treatment plans, Dr. Kamran Saleem arranges a diagnostic <a href="/services/assessment/semen-analysis">Semen Analysis</a> for male partners alongside the female assessment. Evaluating both partners concurrently ensures that all relevant factors are understood from the very beginning, leading to safer, more effective treatment decisions.</p>
    </section>

    <section id="what-to-bring">
      <h2>What to Bring to Your First Fertility Consultation</h2>
      <p>To make your initial appointment as efficient as possible and avoid unnecessary repeat testing, patients are encouraged to bring any existing medical records. Organizing your information beforehand helps Dr. Kamran Saleem gain a complete understanding of your health history during your very first visit.</p>
      <div class="cards">
        {bring.map(([h, l]) => <div class="card"><h3>{h}</h3><ul class="tick">{l.map(x => <li>{x}</li>)}</ul></div>)}
      </div>
      <p class="note">Note: Digital PDF records on your smartphone and physical printed documents are equally acceptable during your consultation.</p>
    </section>

    <section id="what-to-expect">
      <h2>What to Expect During and After Your Assessment</h2>
      <h3>The Initial Visit</h3>
      <p>Your journey begins with a focused, supportive consultation. Dr. Kamran Saleem takes the time to review your full medical and menstrual history, examine any external medical reports or blood work you bring, and discuss your primary concerns. Rather than ordering exhaustive, unnecessary tests, only investigations that offer true diagnostic value for your specific case are recommended.</p>
      <h3>Comprehensive Findings &amp; Transparency</h3>
      <p>Following your diagnostic evaluation, you receive a clear, plain-language explanation of your results, not just a folder of laboratory reports. Your review includes:</p>
      <ul class="tick">
        <li>Detailed breakdown of all scan and lab findings.</li>
        <li>Honest assessment of whether additional diagnostic testing is necessary.</li>
        <li>Customized treatment recommendations ranging from cycle monitoring, lifestyle modifications, and ovulation induction medication to advanced procedures like IUI, IVF, or ICSI.</li>
        <li>Full transparency regarding diagnostic fees, consultation costs, and follow-up schedules prior to starting any procedure.</li>
      </ul>
    </section>

    <section id="next-steps">
      <h2>After Your Assessment: Your Treatment Options</h2>
      <p>Your results decide the next step. Depending on your findings, your plan may lead to one of these services.</p>
      <div class="cards">
        {treatments.map(([n, h, d]) => <a class="card link" href={h}><h3>{n}</h3><p>{d}</p></a>)}
      </div>
    </section>

    <section id="faq">
      <h2>Frequently Asked Questions</h2>
      {faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
    </section>
  </div>
</div>

<section class="cta" id="locations"><div class="w">
  <h2>Clinic Locations &amp; Appointment Scheduling in Lahore</h2>
  <p>Dr. Kamran Saleem conducts fertility assessments across three clinical locations in Lahore. Consultations and diagnostic investigations are scheduled by appointment. To inquire about consultation fees, contact our team by phone or WhatsApp on +92 314 8432789 (Mon–Sat 11:00 AM – 9:00 PM; Sun and public holidays closed).</p>
  <a class="btn" href={wa}>Book on WhatsApp</a>
  <div class="cards c3 locs">
    {locations.map(([n, a, h, l]) => <a class="card link" href={l}><h3>{n}</h3><p>{a}</p><p class="hrs">{h}</p></a>)}
  </div>
  <p style="margin-top:22px"><a style="color:#fff" href={S}>All assessment services</a> · <a style="color:#fff" href={T}>Fertility treatment</a> · <a style="color:#fff" href="/services/support">Second opinions</a></p>
</div></section>
</main>
</div>
</Layout>

<style is:global>
  .ivf{--c-primary:#2563eb;--c-dark:#0b1f4b;--c-accent:#4cc9f0;--c-tint:#eef5ff;--c-bg:#fff;--c-text:#1e2a4a;--c-muted:#5b6b8c;--c-line:#dbe6f6;
    margin:0;background:var(--c-bg);color:var(--c-text);font:16px/1.7 Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
  .ivf *{box-sizing:border-box}
  .ivf a{color:var(--c-primary)}
  .ivf .w{max-width:1120px;margin:0 auto;padding:0 20px}
  .ivf h1,.ivf h2,.ivf h3{line-height:1.2;color:var(--c-dark);margin:0 0 .5em}
  .ivf h2{font-size:clamp(24px,3vw,32px);margin-top:0}
  .ivf .btn{display:inline-block;background:linear-gradient(135deg,#3b82f6,#1d4ed8);box-shadow:0 6px 14px rgba(29,78,216,.28);color:#fff;padding:13px 24px;border-radius:999px;font-weight:600;text-decoration:none}
