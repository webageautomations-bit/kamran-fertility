---
// src/pages/services/fertility-treatment.astro  (URL: /services/fertility-treatment)
// Same Layout + tokens as the location and assessment pages. Match the import path to your site.
import Layout from "../../layouts/Layout.astro";
const base = "https://www.kamranfertility.com";
const S = "/services/assessment";
const T = "/services/fertility-treatment";
const url = `${base}${T}`;
const title = "Fertility Treatment in Lahore | IVF, ICSI, IUI | Dr. Kamran";
const description = "Fertility treatment in Lahore with Dr. Kamran Saleem: ovulation induction, IUI, IVF, ICSI, FET and freezing for men and women. Book a consultation.";
const wa = "https://wa.me/923148432789?text=" + encodeURIComponent("Hello, I would like to book a fertility treatment consultation with Dr. Kamran Saleem.");

const icons = {
  clip: '<rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4h6v3H9zM9 12h6M9 16h6"/>',
  heart: '<path d="M12 21s-7-4.5-7-10a4 4 0 017-2.6A4 4 0 0119 11c0 5.5-7 10-7 10z"/>',
  target: '<circle cx="12" cy="12" r="4"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/>',
  check: '<path d="M5 12l5 5 9-10"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  pin: '<path d="M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  flask: '<path d="M9 3h6M10 3v6l-5 9a2 2 0 002 3h10a2 2 0 002-3l-5-9V3"/>',
  merge: '<circle cx="9" cy="12" r="5"/><path d="M14 12h7M18 9l3 3-3 3"/>',
  egg: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/>',
  alert: '<path d="M12 3l10 18H2zM12 10v5M12 18h.01"/>',
  coin: '<circle cx="12" cy="12" r="9"/><path d="M14.5 9a3 3 0 00-5 1.5c0 3 5 1.5 5 4.5a3 3 0 01-5 1.5M12 6v2M12 16v2"/>',
};

const art = {
  ovulation: '<circle cx="50" cy="50" r="38" fill="#fff" opacity=".7"/><g transform="rotate(-35 50 50)"><rect x="28" y="40" width="44" height="20" rx="10" fill="#fff" stroke="#2563eb" stroke-width="3"/><rect x="50" y="40" width="22" height="20" rx="10" fill="#60a5fa" stroke="#2563eb" stroke-width="3"/></g>',
  iui: '<path d="M26 26h48c0 22-10 36-24 48C36 62 26 48 26 26z" fill="#fff" stroke="#2563eb" stroke-width="3"/><circle cx="50" cy="46" r="7" fill="#60a5fa" stroke="#2563eb" stroke-width="2"/><g fill="#0b1f4b"><circle cx="38" cy="36" r="2.5"/><circle cx="62" cy="38" r="2.5"/><circle cx="46" cy="62" r="2.5"/><circle cx="56" cy="30" r="2.5"/></g>',
  ivf: '<ellipse cx="50" cy="58" rx="36" ry="14" fill="#fff" stroke="#2563eb" stroke-width="3"/><ellipse cx="50" cy="48" rx="36" ry="14" fill="#e0eeff" stroke="#2563eb" stroke-width="3"/><circle cx="50" cy="48" r="9" fill="#fff" stroke="#2563eb" stroke-width="2"/><circle cx="50" cy="48" r="3.5" fill="#0b1f4b"/><g fill="#0b1f4b"><circle cx="30" cy="46" r="2"/><circle cx="68" cy="52" r="2"/><circle cx="62" cy="42" r="2"/></g>',
  icsi: '<circle cx="58" cy="54" r="24" fill="#fff" stroke="#2563eb" stroke-width="3"/><circle cx="58" cy="54" r="9" fill="#60a5fa"/><path d="M12 18L46 44" stroke="#0b1f4b" stroke-width="3.5" stroke-linecap="round"/><circle cx="12" cy="18" r="4" fill="#0b1f4b"/>',
  fet: '<circle cx="50" cy="50" r="30" fill="#fff" stroke="#2563eb" stroke-width="3"/><g stroke="#2563eb" stroke-width="3" stroke-linecap="round"><path d="M50 26v48M29 38l42 24M29 62l42-24"/></g><circle cx="50" cy="50" r="7" fill="#60a5fa" stroke="#0b1f4b" stroke-width="2"/>',
  pgt: '<circle cx="50" cy="50" r="38" fill="#fff" opacity=".7"/><path d="M36 20c28 16 -28 44 0 60" stroke="#2563eb" stroke-width="4" fill="none"/><path d="M64 20c-28 16 28 44 0 60" stroke="#0b1f4b" stroke-width="4" fill="none"/><g stroke="#60a5fa" stroke-width="3"><path d="M40 32h20M38 50h24M40 68h20"/></g>',
  freeze: '<circle cx="50" cy="50" r="38" fill="#fff" opacity=".7"/><g stroke="#2563eb" stroke-width="3.5" stroke-linecap="round"><path d="M50 18v64M22 34l56 32M22 66l56-32"/><path d="M44 24l6 6 6-6M44 76l6-6 6 6"/></g>',
  male: '<circle cx="50" cy="50" r="38" fill="#fff" opacity=".7"/><ellipse cx="44" cy="40" rx="12" ry="8" fill="#60a5fa" stroke="#2563eb" stroke-width="3" transform="rotate(-30 44 40)"/><path d="M52 46q18 12 8 26t-14 8" stroke="#2563eb" stroke-width="3.5" fill="none" stroke-linecap="round"/>',
  female: '<circle cx="50" cy="50" r="38" fill="#fff" opacity=".7"/><g fill="#93c5fd" stroke="#2563eb" stroke-width="2"><circle cx="36" cy="40" r="10"/><circle cx="62" cy="38" r="10"/><circle cx="50" cy="62" r="10"/></g><g fill="#0b1f4b"><circle cx="36" cy="40" r="3.5"/><circle cx="62" cy="38" r="3.5"/><circle cx="50" cy="62" r="3.5"/></g>',
  couple: '<circle cx="50" cy="50" r="38" fill="#fff" opacity=".7"/><circle cx="38" cy="50" r="17" fill="#bfdbfe" stroke="#2563eb" stroke-width="3"/><circle cx="62" cy="50" r="17" fill="#93c5fd" stroke="#2563eb" stroke-width="3"/>',
};
const toc = [["quick","Overview"],["ladder","Treatment steps"],["options","Treatment options"],["compare","IUI vs IVF vs ICSI"],["ivf-journey","IVF journey"],["suitable","Which may suit you"],["both","Men, women & couples"],["when","When to see a specialist"],["before","Before treatment"],["after-failed","After an unsuccessful cycle"],["cost","Cost"],["where","Where procedures happen"],["outcomes","Outcomes"],["doctor","Your doctor"],["locations","Locations"],["faq","FAQ"]];

const glance = [
  ["target","Cause first","Assessment comes before any treatment decision."],
  ["heart","Both partners","Male, female or combined factors are considered together."],
  ["check","Not always IVF","Medication, ovulation treatment or IUI may be enough for some."],
  ["coin","Costs explained","Stages, medicines and estimates discussed before you start."],
];

const ladder = [
  ["Find the cause", "Assessment of both partners", "clip"],
  ["Treat the cause", "Hormonal or underlying conditions", "flask"],
  ["Ovulation medication", "When ovulation is irregular", "egg"],
  ["IUI", "Selected, milder cases", "target"],
  ["IVF / ICSI", "When other options are unsuitable", "merge"],
];

const options = [
  ["Ovulation Induction & PCOS", `${T}/pcos`, "ovulation", "Medication and monitoring to help regulate or trigger ovulation when it is irregular. Used only under medical supervision."],
  ["IUI Treatment", `${T}/iui`, "iui", "Prepared sperm is placed in the uterus around ovulation. Less complex than IVF and suited to selected cases."],
  ["IVF Treatment", `${T}/ivf`, "ivf", "Eggs are collected and fertilised in a laboratory, then an embryo may be transferred to the uterus."],
  ["ICSI", `${T}/icsi`, "icsi", "A single sperm is injected into an egg as part of IVF, when male-factor or past fertilisation problems make it suitable."],
  ["Frozen Embryo Transfer (FET)", `${T}/fet`, "fet", "A previously frozen embryo is thawed and transferred in a separately prepared cycle."],
  ["Embryo Genetic Testing (PGT)", `${T}/pgt`, "pgt", "Embryos from IVF are tested for specific genetic or chromosomal findings, for selected indications only."],
  ["Egg & Sperm Freezing", `${T}/fertility-preservation`, "freeze", "Eggs, sperm or embryos are stored for future use, for example before medical treatment that may affect fertility."],
  ["Male Infertility Treatment", `${T}/male-infertility`, "male", "Evaluation and management of sperm-related and hormonal causes, with assisted options when needed."],
];

const compare = [
  ["IUI", "iui", "Prepared sperm is placed inside the uterus around ovulation.", "Fertilisation happens inside the body."],
  ["IVF", "ivf", "Eggs are collected and fertilised with sperm in a laboratory.", "Embryos develop outside the body before transfer."],
  ["ICSI", "icsi", "A single sperm is injected directly into an egg.", "A fertilisation technique used as part of IVF."],
];

const journey = [
  ["Assessment", "Review of history, reports and suitability.", "clip"],
  ["Stimulation", "Medicines encourage several follicles to develop.", "flask"],
  ["Monitoring", "Ultrasound and sometimes blood tests track the response.", "clock"],
  ["Egg retrieval", "Mature eggs are collected in a planned procedure.", "egg"],
  ["Fertilisation", "Eggs and sperm are combined in the laboratory, with ICSI when indicated.", "merge"],
  ["Embryo development", "Embryos are observed as they develop.", "target"],
  ["Embryo transfer", "An embryo may be transferred. Others may be frozen.", "heart"],
];

const suitable = [
  ["Irregular or absent ovulation", "Assessment of the cause, treatment of an underlying condition and ovulation medication when appropriate"],
  ["Selected PCOS-related ovulation problems", "Lifestyle and medical management, with ovulation induction where indicated"],
  ["Selected sperm-related concerns", "Male fertility evaluation, management of an identified cause and discussion of assisted reproduction"],
  ["Selected unexplained infertility", "Further evaluation and discussion of IUI or IVF, depending on individual factors"],
  ["Significant male-factor infertility", "Assessment and discussion of IVF with ICSI when clinically appropriate"],
  ["Earlier IVF with frozen embryos", "Review of suitability and planning for frozen embryo transfer"],
  ["Known inherited genetic risk", "Genetic counselling and discussion of PGT where appropriate"],
  ["Planned treatment that may affect fertility", "Discussion of egg, sperm or embryo preservation first"],
];

const both = [
  ["Male fertility", "male", `Semen analysis review, hormone tests and history. See <a href="${T}/male-infertility">male infertility treatment</a>, <a href="${S}/male-fertility-assessment">male fertility assessment</a> and <a href="/services/tests/semen-analysis">semen analysis</a>.`],
  ["Female fertility", "female", `Ovulation, PCOS, tubes, uterus and ovarian reserve. See <a href="${S}/female-fertility-assessment">female fertility assessment</a>, <a href="${T}/pcos">PCOS treatment</a> and <a href="/services/tests/female-fertility-hormone-test">hormone testing</a>.`],
  ["Couple evaluation", "couple", `Assessing both partners avoids overlooking a male contribution. Start with a <a href="${S}">fertility assessment</a>.`],
];

const when = [
  ["12 months, woman under 35", "Evaluation is generally advised after 12 months of regular, unprotected intercourse without pregnancy.", "clock"],
  ["6 months, woman 35 or older", "Earlier evaluation is advised from 35, because fertility declines with age.", "target"],
  ["Earlier if there are concerns", "Irregular or absent periods, PCOS, endometriosis, tubal or uterine problems, pelvic surgery, abnormal semen analysis or repeated miscarriage.", "alert"],
  ["Before medical treatment", "If treatment may affect fertility, ask about egg, sperm or embryo freezing early.", "flask"],
];

const before = [
  ["Initial consultation", "How long you have been trying, previous pregnancies, menstrual history, medicines and any earlier treatment."],
  ["Review of reports", "Bring semen analysis, hormone tests, ultrasound, HSG and previous cycle records."],
  ["Further assessment, if needed", "Extra tests are chosen for your situation, not ordered as a routine package."],
  ["Discussion of options", "Why an option may suit you, its limits and the alternatives."],
  ["Practical details", "Stages, medicines, monitoring, procedures, partner-facility arrangements, estimates and risks."],
];

const cost = [
  "Consultation and assessment fees",
  "The recommended procedure and its stages",
  "Medication and monitoring costs",
  "Laboratory and embryology charges, where applicable",
  "Extras such as ICSI, embryo freezing, storage or genetic testing",
  "Which services are provided directly and which are arranged through partner facilities",
  "What the estimate includes and what is charged separately",
];

const outcomes = [
  "The woman's age",
  "Ovarian reserve and response to medication",
  "Sperm concentration, movement and morphology",
  "The cause and duration of infertility",
  "The condition of the uterus and fallopian tubes",
  "Earlier pregnancies and treatment history",
  "General health and relevant medical conditions",
];

const locations = [
  ["DHA Lahore: Rasheed Hospital", "Main Boulevard, DHA Defence, Lahore", "Daily 3:00 PM – 6:00 PM (Closed Saturday & Sunday)", "/locations/dha-lahore"],
  ["Gulberg: TAMC", "M.M. Alam Road, Gulberg III, Lahore", "Wednesday 12:00 PM – 3:00 PM (other days by appointment)", "/locations/mm-alam-road-lahore"],
  ["Shalamar: Shahnaz Hospital", "Shalamar Link Road, Lahore", "Monday & Thursday 6:00 PM – 9:00 PM", "/locations/shalamar-lahore"],
];

const faqs = [
  ["What is the best fertility treatment in Lahore?", "There is no single treatment that is best for everyone. The right option depends on the cause of infertility, age, sperm and ovulation factors, previous treatment and other medical findings. A fertility assessment helps determine which options may be suitable."],
  ["Is IVF the only treatment for infertility?", "No. Depending on the diagnosis, treatment may involve medication, ovulation induction, IUI, IVF, ICSI, fertility preservation or management of an underlying reproductive health problem. IVF is not automatically required for every couple."],
  ["Can male infertility be treated?", "Some male fertility problems can be managed directly, depending on their cause. Other situations may need further investigation or discussion of assisted options such as IUI, IVF or ICSI."],
  ["What is female infertility treatment?", "It is medical care for conditions that may affect ovulation, the reproductive organs or the ability to conceive. Depending on the diagnosis, options may include medication, ovulation induction, IUI or IVF."],
  ["Do both partners need a fertility assessment?", "Often, yes. Difficulty conceiving can involve male factors, female factors or both. The doctor decides which investigations are relevant to your history and initial findings."],
  ["What is the difference between IUI and IVF?", "IUI places prepared sperm inside the uterus around ovulation, so fertilisation happens inside the body. IVF involves collecting eggs and fertilising them with sperm in a laboratory before an embryo is transferred."],
  ["Is ICSI different from IVF?", "ICSI is a fertilisation technique used as part of IVF. A single sperm is injected directly into an egg. It may be considered when specific sperm-related or earlier fertilisation problems are present."],
  ["How much does fertility treatment cost in Lahore?", "The cost depends on the recommended procedure, medication, investigations, laboratory services and any extras. IUI and IVF have different costs. Ask for an estimate that explains what is included before you begin."],
  ["How long does fertility treatment take?", "It depends on the treatment. Medication-based approaches are planned around the menstrual cycle, while IVF involves several stages from stimulation to embryo transfer. Your doctor can explain the expected timeline for your plan."],
  ["Can I start fertility treatment without tests?", "Treatment should not be chosen without understanding the relevant fertility factors. Your doctor may review existing reports or recommend semen analysis, hormone tests or ultrasound, depending on your circumstances."],
  ["Can I get a second opinion after unsuccessful IVF?", "Yes. Bring your investigation, medication, fertilisation and embryo transfer records. Reviewing the earlier cycle may help clarify what options are appropriate next."],
  ["Does fertility treatment guarantee pregnancy?", "No. Treatment can improve the options available to some patients, but it cannot guarantee pregnancy or live birth. Outcomes depend on individual medical factors and the treatment used."],
  ["Where can I consult Dr. Kamran Saleem?", "At Rasheed Hospital in DHA, TAMC on M.M. Alam Road in Gulberg, and Shahnaz Hospital on Shalamar Link Road. Days and timings vary, so contact the clinic before visiting."],
];

const related = [
  ["Fertility Assessment in Lahore", "/resources/fertility-assessment-in-lahore"],
  ["IVF vs IUI: understanding the difference", "/resources/ivf-vs-iui"],
  ["IVF treatment cost in Pakistan", "/resources/ivf-treatment-cost-pakistan"],
  ["PCOS and fertility: can you get pregnant?", "/resources/pcos-and-fertility"],
  ["Fertility consultation: when to seek advice", "/resources/when-to-seek-fertility-consultation"],
];

const clinicId = base + "/#clinic";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "MedicalWebPage", "@id": url + "#webpage", url, name: title, description, inLanguage: "en-PK",
      breadcrumb: { "@id": url + "#breadcrumb" }, about: { "@id": clinicId },
      reviewedBy: { "@id": base + "/dr-kamran-saleem#physician" } },
    { "@type": "BreadcrumbList", "@id": url + "#breadcrumb", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: base + "/" },
      { "@type": "ListItem", position: 2, name: "Services", item: base + "/services" },
      { "@type": "ListItem", position: 3, name: "Fertility Treatment", item: url } ] },
    { "@type": "MedicalClinic", "@id": clinicId, name: "Kamran Fertility Clinic", url: base, logo: base + "/assets/logo.webp", telephone: "+923148432789",
      location: locations.map(([n, a]) => ({ "@type": "Place", name: n, address: { "@type": "PostalAddress", streetAddress: a, addressLocality: "Lahore", addressRegion: "Punjab", addressCountry: "PK" } })) },
    { "@type": "Physician", "@id": base + "/dr-kamran-saleem#physician", name: "Dr. Kamran Saleem", url: base + "/dr-kamran-saleem", worksFor: { "@id": clinicId } },
    { "@type": "FAQPage", mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) },
  ],
};
---
<Layout title={title} description={description}>
<div class="ivf">
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<main>
<section class="hero"><div class="w hgrid">
  <div>
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/services">Services</a> / Fertility Treatment</nav>
    <p class="eye">Doctor-led · Evidence-based · Lahore</p>
    <h1>Fertility Treatment in Lahore</h1>
    <p class="sub">Personalised care for men and women with Dr. Kamran Saleem. Understand the cause, review your reports and discuss treatment options that fit your medical circumstances. Not every couple needs IVF.</p>
    <p><a class="btn" href={wa}>Book a consultation</a> <a class="btn ghost" href="#options">See treatment options</a></p>
    <p class="mini">Phone / WhatsApp +92 314 8432789 · 3 Lahore locations</p>
  </div>
  <div class="hside">
    <ul class="facts">
      <li><b>Cause first</b> assessment before treatment</li>
      <li><b>8</b> treatment pathways explained</li>
      <li><b>Both partners</b> considered together</li>
      <li><b>No guarantees</b> honest, clear options</li>
    </ul>
  </div>
</div></section>

<div class="w layout">
  <aside class="toc" aria-label="On this page"><p>On this page</p>
    {toc.map(([id, l]) => <a href={`#${id}`}>{l}</a>)}
    <a class="btn sm" href={wa}>Book now</a>
  </aside>
  <div class="content">
    <p class="review"><b>Medically authored &amp; reviewed by</b> Dr. Kamran Saleem (MBBS 1988; Diploma, University of Liverpool 1998; PMDC registered) · <a href="/dr-kamran-saleem">About the doctor</a></p>

    <section id="quick">
      <h2>Fertility treatment in Lahore at a glance</h2>
      <p>Difficulty conceiving can involve men, women or both. The next step may be treating an underlying problem, taking ovulation medication, or considering IUI, IVF or another assisted option. At Kamran Fertility Clinic, Dr. Kamran Saleem takes a doctor-led approach: find the cause, review the reports, then discuss options.</p>
      <div class="cards c4">
        {glance.map(([i, h, p]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p>{p}</p></div>)}
      </div>
      <p>New here? Start with a <a href={S}>fertility assessment</a>, or get an independent view through <a href="/services/support">support &amp; second opinions</a>.</p>
    </section>

    <section id="ladder">
      <h2>How treatment steps usually progress</h2>
      <p>Most couples do not start with IVF. Treatment generally moves from finding the cause towards more involved options only when needed. Your own plan may skip steps or combine them.</p>
      <ol class="ladder">
        {ladder.map(([h, p, i]) => <li><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><div><b>{h}</b><span>{p}</span></div></li>)}
      </ol>
    </section>

    <section id="options">
      <h2>Fertility treatment options in Lahore</h2>
      <p>No single treatment suits everyone. Each option below has its own page with the full detail.</p>
      <div class="cards c3">
        {options.map(([n, h, a, d]) => <a class="card link opt" href={h}><span class="disc"><svg viewBox="0 0 100 100" set:html={art[a]} /></span><h3>{n}</h3><p>{d}</p><span class="more">Read more</span></a>)}
      </div>
    </section>

    <section id="compare">
      <h2>IUI vs IVF vs ICSI: the difference</h2>
      <p>These treatments are related but not the same. The right choice depends on your diagnosis. Read the full guide: <a href="/resources/ivf-vs-iui">IVF vs IUI</a>.</p>
      <div class="cards c3">
        {compare.map(([n, a, d, k]) => <div class="card cmp"><span class="disc"><svg viewBox="0 0 100 100" set:html={art[a]} /></span><h3>{n}</h3><p>{d}</p><p class="key">{k}</p></div>)}
      </div>
      <p class="note">FET is a transfer of a frozen embryo, usually after IVF. PGT is an extra embryo test for selected patients, not a treatment for everyone.</p>
    </section>

    <section id="ivf-journey">
      <h2>What an IVF cycle involves</h2>
      <p>Exact protocols and timing vary between patients, and the stages often take several weeks from stimulation to transfer. See the full <a href={`${T}/ivf`}>IVF treatment</a> and <a href={`${T}/icsi`}>ICSI</a> pages.</p>
      <ol class="steps">
        {journey.map(([h, p], n) => <li class="step"><span class="n">{n + 1}</span><div><h3>{h}</h3><p>{p}</p></div></li>)}
      </ol>
    </section>

    <section id="suitable">
      <h2>Which treatment may suit which concern?</h2>
      <p>These are examples of how options may be considered, not individual recommendations. A table cannot replace an assessment of your history, age and results.</p>
      <div class="tw"><table>
        <thead><tr><th>Fertility concern</th><th>Options that may be discussed</th></tr></thead>
        <tbody>{suitable.map(([a, b]) => <tr><th scope="row">{a}</th><td>{b}</td></tr>)}</tbody>
      </table></div>
    </section>

    <section id="both">
      <h2>Male, female and couple fertility treatment</h2>
      <p>Looking at both partners helps identify relevant factors and avoids missing a male contribution. Not every patient needs every test.</p>
      <div class="cards c3">
        {both.map(([h, a, p]) => <div class="card"><span class="disc sm"><svg viewBox="0 0 100 100" set:html={art[a]} /></span><h3>{h}</h3><p set:html={p} /></div>)}
      </div>
    </section>

    <section id="when">
      <h2>When should you see a fertility specialist?</h2>
      <p>You do not always have to wait a full year. A consultation does not mean you must start medication, IUI or IVF.</p>
      <div class="cards">
        {when.map(([h, p, i]) => <div class="card"><span class="ic"><svg viewBox="0 0 24 24" set:html={icons[i]} /></span><h3>{h}</h3><p>{p}</p></div>)}
      </div>
      <p class="note">Source: <a href="https://prod.asrm.org/globalassets/_asrm/practice-guidance/practice-guidelines/pdf/definition-of-infertility.pdf">ASRM Practice Committee, Definition of infertility (2023)</a>. Read more: <a href="/resources/when-to-seek-fertility-consultation">when to seek a fertility consultation</a>.</p>
    </section>

    <section id="before">
      <h2>What happens before fertility treatment?</h2>
      <ol class="steps">
        {before.map(([h, p], n) => <li class="step"><span class="n">{n + 1}</span><div><h3>{h}</h3><p>{p}</p></div></li>)}
      </ol>
      <p>The aim is an informed decision, not pressure to start treatment.</p>
    </section>

    <section id="after-failed">
      <h2>After an unsuccessful IVF or IUI cycle</h2>
      <p>One unsuccessful cycle does not automatically mean further treatment cannot work. A detailed review of the earlier cycle helps decide what comes next. Bring the diagnosis and tests, stimulation protocol, egg retrieval and fertilisation results, embryo development and transfer details, and semen reports.</p>
      <div class="callout">Options after a review may include more investigation, a change in plan, another approach, or a discussion of whether repeating treatment makes sense. Request an independent <a href="/services/support">fertility second opinion</a>.</div>
    </section>

    <section id="cost">
      <h2>Fertility treatment cost in Lahore</h2>
      <p>Cost varies with the procedure, medication, investigations and laboratory services required. IUI and IVF involve different stages and resources, and an IVF cycle may add costs for ICSI, embryo freezing, genetic testing or storage. No single price fits every patient, so the most useful estimate comes after your findings are reviewed.</p>
      <h3>Ask for a clear explanation of:</h3>
      <ul class="tick">{cost.map(x => <li>{x}</li>)}</ul>
      <p>Read the <a href="/resources/ivf-treatment-cost-pakistan">IVF treatment cost guide</a>, or <a href={wa}>message us on WhatsApp</a> to ask about consultation and treatment estimates.</p>
    </section>

    <section id="where">
      <h2>Where are fertility procedures performed?</h2>
      <p>Consultations, tests, monitoring and laboratory procedures do not always take place at one facility. Dr. Kamran Saleem provides consultations and treatment planning in Lahore, and some investigations, laboratory work or assisted reproduction stages may be coordinated with partner facilities.</p>
      <div class="callout">Before a cycle starts, you should be told where each stage takes place, who is responsible for each procedure, how appointments and monitoring are arranged, who explains your results, and which fees are included.</div>
    </section>

    <section id="outcomes">
      <h2>What influences fertility treatment outcomes?</h2>
      <ul class="tick">{outcomes.map(x => <li>{x}</li>)}</ul>
      <p>When you see success rates, ask what is being measured. A positive pregnancy test, a clinical pregnancy and a live birth are different outcomes, and rates may be reported per cycle started or per embryo transfer. No treatment can promise pregnancy or a live birth.</p>
    </section>

