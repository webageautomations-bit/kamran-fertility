<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="ft">
    <!-- HERO -->
    <section class="hero">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span>
          <a href="/services">Services</a><span aria-hidden="true">/</span>
          <span aria-current="page">Fertility Tests</span>
        </nav>

        <p class="eyebrow"><span class="eyebrow-line"></span>Tests and diagnosis</p>
        <h1>
          Fertility Diagnostic Tests in Lahore
          <span class="h1-sub">Comprehensive Clinical Guide, WHO Parameters &amp; Cost Transparency</span>
        </h1>

        <div class="byline">
          <p><strong>Medically reviewed by:</strong> Dr. Kamran Saleem (MBBS 1988, UK Dip GUM &amp; Ven Univ. of Liverpool 1998; PMDC Registered; 25+ Years Experience)</p>
          <p><strong>Clinical standards compliance:</strong> American Society for Reproductive Medicine (ASRM), European Society of Human Reproduction and Embryology (ESHRE), WHO 6th Edition Laboratory Manual, and PMDC/PMC Standards</p>
          <p><strong>Practice locations:</strong> Rasheed Hospital (DHA Defence Phase 5/6) | TAMC Clinic (M.M. Alam Road, Gulberg III) | Shahnaz Hospital (Shalamar Link Road)</p>
        </div>

        <div class="answer" id="what-are-fertility-tests">
          <h2>What are Fertility Diagnostic Tests?</h2>
          <p>
            Fertility diagnostic tests are a targeted battery of clinical laboratory investigations, hormonal assays, and specialized imaging procedures designed to evaluate both male and female reproductive health. A complete fertility assessment includes a WHO 6th Edition semen analysis and sperm DNA fragmentation index (DFI) for men, alongside Anti-Müllerian Hormone (AMH) testing, baseline gonadotropin panels (FSH, LH, Estradiol), transvaginal ultrasound antral follicle count (AFC), and tubal patency screening (HSG or HyCoSy) for women. At Kamran Fertility Clinic in Lahore, diagnostic evaluation is conducted with clinical restraint—ordering only medically necessary tests to identify the precise root cause of subfertility without imposing unneeded financial burden.
          </p>
        </div>

        <div class="cta-row">
          <a class="btn btn-primary" href={L.contact}>Book a consultation</a>
          <a class="btn btn-ghost" href={WHATSAPP} rel="noopener">Speak to us first on WhatsApp</a>
        </div>
      </div>
    </section>

    <!-- JUMP NAV -->
    <nav class="jump" aria-label="On this page">
      <div class="wrap jump-inner">
        {jump.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      </div>
    </nav>

    <!-- ADDED: where tests sit in the journey -->
    <section class="sec">
      <div class="wrap">
        <h2>Where tests fit in your fertility journey</h2>
        <p class="lead">
          An <a href={L.assessHub}>assessment</a> is the full evaluation of each partner. Tests are the individual investigations used within it. Your diagnosis is the conclusion Dr. Kamran explains once the results are in, and it decides which <a href={L.treatHub}>treatment</a> makes sense.
        </p>
        <ol class="journey">
          <li><a href={L.assessHub}><strong>Assessment</strong><span>History, examination and plan for each partner</span></a></li>
          <li class="here"><strong>Tests</strong><span>The investigations on this page</span></li>
          <li><strong>Diagnosis</strong><span>Explained in your results consultation</span></li>
          <li><a href={L.treatHub}><strong>Treatment</strong><span>IUI, IVF, ICSI and more, only if needed</span></a></li>
        </ol>
      </div>
    </section>

    <!-- ADDED: overview table -->
    <section class="sec sec-tint" id="overview">
      <div class="wrap">
        <h2>Fertility tests at a glance</h2>
        <p class="lead">Every test on this page, who it is for, and when it needs to be done.</p>
        <div class="table-scroll">
          <table>
            <thead><tr><th>Test</th><th>For</th><th>Timing</th><th>Results</th></tr></thead>
            <tbody>
              {overview.map(([t, who, timing, res, href]) => (
                <tr>
                  <td><a href={href}>{t}</a></td><td>{who}</td><td>{timing}</td><td>{res}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
